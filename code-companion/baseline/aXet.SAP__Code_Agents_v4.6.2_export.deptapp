lse},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"e3tmgpe","defaultValue":""},{"label":"Ready For Code","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"readyForCode","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"encew9p","defaultValue":""},{"label":"Has Generated Code","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"hasGeneratedCode","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"eguykpv","defaultValue":""},{"label":"Validation Passed","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"validationPassed","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"eqigatam","defaultValue":""},{"label":"UI Error","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"uiError","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"ejkohkf","defaultValue":""},{"label":"Proceed Requested","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"proceedRequested","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"ej5pif","defaultValue":""},{"label":"Confirmed Requirements","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"confirmedRequirements","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"emecu4e","defaultValue":""},{"label":"Agent Confidence","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"agentConfidence","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"eaqn45i","defaultValue":""},{"label":"Blocking Questions","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"blockingQuestions","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"tableView":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"egann","defaultValue":""},{"label":"SAP Code Agent Browser Controller HTML","tag":"div","className":"sca-browser-controller","attrs":[{"attr":"","value":""}],"content":"<div\n  id=\"sca-browser-controller-anchor\"\n  class=\"sca-browser-controller-anchor\"\n  aria-hidden=\"true\"\n  style=\"display: none !important;\"\n></div>","refreshOnChange":false,"customClass":"","hidden":false,"tableView":false,"modalEdit":false,"key":"sapCodeAgentBrowserController","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"htmlelement","input":false,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"evb5v66"},{"label":"Selected Message ID","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"selectedMessageId","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","tableView":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"e7z3276","defaultValue":""},{"label":"Selected User Prompt","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"selectedUserPrompt","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","tableView":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"e8vhdne","defaultValue":""},{"label":"Selected Download Format","customClass":"","modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"encrypted":false,"redrawOn":"","customDefaultValue":"","calculateValue":"","key":"selectedDownloadFormat","tags":[],"properties":{},"logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"hidden","input":true,"placeholder":"","prefix":"","suffix":"","multiple":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","tableView":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"widget":{"type":"input"},"validateOn":"change","validate":{"required":false,"custom":"","customPrivate":false,"strictDateValidation":false,"unique":false,"multiple":false},"conditional":{"show":null,"when":null,"eq":""},"allowCalculateOverride":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"inputType":"hidden","id":"eppjcc","defaultValue":""},{"content":"/*\n * SAP Code Agent Controller\n *\n * Component:\n * SAP Code Agent UI\n * → SAP Code Agent Chat\n * → Server-side JavaScript Component\n * → SAP Code Agent Controller javascript\n *\n * Version 5.0.0\n *\n * Changes vs 4.0.0:\n *   SCA-01   prompt-budget constants; ENABLE_PROCEED_CHIP feature flag\n *   SCA-04   stale-controller version guard (fixes \"old code still running\")\n *   SCA-09b  live prompt-budget counter (new)\n *   SCA-14b  Proceed to Code chip (new)\n *   SCA-15   chip mounted into the assistant bubble\n *   SCA-21   optimistic-bubble bug fixed; render epoch added\n *   SCA-26   handleInput now drives the counter\n *   SCA-23   New Chat resets the counter and the chip\n */\n\n(function bootstrapSapCodeAgent() {\n  \"use strict\";\n\n  /* =========================================================\n   * SCA-01 — CONSTANTS AND COMPONENT IDENTIFICATION\n   * ========================================================= */\n\n  const COMPONENT_NAME = \"SAP Code Agent Controller javascript\";\n\n  const CONTROLLER_VERSION = \"5.0.1\";\n\n  const SYNC_INTERVAL_MS = 350;\n\n  /*\n   * Set to false to ship the counter and render fixes without the\n   * Proceed to Code chip. Turn on once the backend replacements are\n   * deployed, otherwise the chip has no readiness flag to read.\n   */\n  const ENABLE_PROCEED_CHIP = false;\n\n  /*\n   * These MUST stay identical to VBP-04 in\n   * \"Validate + Build SAP Agent Prompt\".\n   */\n  const MAX_USER_CHARACTERS = 16000;\n  const WARNING_USER_CHARACTERS = 12000;\n  const APPROXIMATE_CHARACTERS_PER_TOKEN = 4;\n\n  /* Text placed in the composer when the chip is used. */\n  const PROCEED_PROMPT = \"Proceed to code. Generate the implementation now.\";\n\n  const GREETING =\n    \"Hello! I’m your SAP Code Agent.\\n\\n\" +\n    \"I can help with ABAP, ABAP Cloud, CDS, RAP, CAP/BTP, OData, \" +\n    \"Fiori/UI5 integration, testing, performance, security, and clean-core development.\\n\\n\" +\n    \"What would you like to build or review?\";\n\n  const STAGE_ORDER = [\"understand\", \"code\", \"validate\", \"complete\"];\n\n  const SELECTORS = {\n    chatLog: \"#sca-chat-log\",\n\n    chatSurface: \"#sca-chat-surface, .sca-chat-surface\",\n\n    form: \".formio-form\",\n\n    messageInput:\n      'textarea[name=\"data[composer][userMessage]\"], ' +\n      'input[name=\"data[composer][userMessage]\"], ' +\n      'textarea[name=\"data[userMessage]\"], ' +\n      'input[name=\"data[userMessage]\"], ' +\n      \".formio-component-userMessage textarea, \" +\n      \".formio-component-userMessage input\",\n\n    sendButton:\n      \".formio-component-sendMessage button, \" +\n      'button[name=\"data[sendMessage]\"], ' +\n      \".sca-send button\",\n\n    newChatButton:\n      \".formio-component-newChat button, \" +\n      'button[name=\"data[newChat]\"]',\n\n    downloadButton:\n      \".formio-component-downloadResponse button, \" +\n      'button[name=\"data[downloadResponse]\"], ' +\n      \".sca-download-submit button\",\n\n    messagesJsonField:\n      'textarea[name=\"data[messagesJson]\"], ' +\n      'input[name=\"data[messagesJson]\"], ' +\n      \".formio-component-messagesJson textarea, \" +\n      \".formio-component-messagesJson input\",\n\n    step: \".sca-step\",\n\n    stepLine: \".sca-step-line\",\n\n    budgetRoot: \"#sca-prompt-budget\",\n\n    budgetText: \"#sca-prompt-budget-text\",\n\n    budgetBar: \"#sca-prompt-budget-bar\",\n\n    budgetTrack: \".sca-prompt-budget-track\"\n  };\n\n  /* =========================================================\n   * SCA-02 — PRODUCTION DIAGNOSTIC LOGGER\n   * ========================================================= */\n\n  function scaLog(level, section, event, details) {\n    const record = {\n      component: COMPONENT_NAME,\n      version: CONTROLLER_VERSION,\n      section: section,\n      event: event,\n      timestamp: new Date().toISOString(),\n      details:\n        details && typeof details === \"object\"\n          ? details\n          : {\n              value: String(\n                details === undefined || details === null ? \"\" : details\n              )\n            }\n    };\n\n    const prefix = \"[SCA][\" + section + \"][\" + event + \"]\";\n\n    if (level === \"error\") {\n      console.error(prefix, record);\n      return;\n    }\n\n    if (level === \"warn\") {\n      console.warn(prefix, record);\n      return;\n    }\n\n    console.info(prefix, record);\n  }\n\n  /* =========================================================\n   * SCA-03 — REACTIVE FORM DATA DISCOVERY\n   * ========================================================= */\n\n  function readReactiveData() {\n    try {\n      if (\n        typeof submission !== \"undefined\" &&\n        submission &&\n        typeof submission === \"object\"\n      ) {\n        if (submission.data && typeof submission.data === \"object\") {\n          return submission.data;\n        }\n\n        return submission;\n      }\n    } catch (error) {\n      scaLog(\"warn\", \"SCA-03\", \"submission-not-readable\", {\n        message: error.message\n      });\n    }\n\n    try {\n      if (typeof data !== \"undefined\" && data && typeof data === \"object\") {\n        return data;\n      }\n    } catch (error) {\n      scaLog(\"warn\", \"SCA-03\", \"data-not-readable\", {\n        message: error.message\n      });\n    }\n\n    scaLog(\"warn\", \"SCA-03\", \"reactive-data-fallback\", {\n      message: \"No readable submission/data object was available.\"\n    });\n\n    return {};\n  }\n\n  const reactiveData = readReactiveData();\n\n  /* =========================================================\n   * SCA-04 — CONTROLLER REUSE AND VERSION GUARD\n   *\n   * v4.0.0 reused any existing controller unconditionally. After a\n   * redeploy the browser therefore kept running the OLD controller\n   * until a hard refresh. The version check below tears down a stale\n   * instance so future deployments take effect on a normal reload.\n   * ========================================================= */\n\n  const existingController = window.__sapCodeAgentController;\n\n  if (\n    existingController &&\n    typeof existingController.acceptFormData === \"function\"\n  ) {\n    if (existingController.version === CONTROLLER_VERSION) {\n      scaLog(\"info\", \"SCA-04\", \"existing-controller-reused\", {\n        version: existingController.version\n      });\n\n      existingController.acceptFormData(reactiveData);\n\n      return typeof value !== \"undefined\" ? value : null;\n    }\n\n    scaLog(\"warn\", \"SCA-04\", \"stale-controller-replaced\", {\n      previousVersion: existingController.version || \"unknown\",\n      newVersion: CONTROLLER_VERSION\n    });\n\n    try {\n      if (typeof existingController.destroy === \"function\") {\n        existingController.destroy();\n      }\n    } catch (error) {\n      scaLog(\"error\", \"SCA-04\", \"stale-controller-destroy-failed\", {\n        message: error.message\n      });\n    }\n\n    window.__sapCodeAgentController = null;\n  }\n\n  /* =========================================================\n   * SCA-05 — CONTROLLER STATE\n   * ========================================================= */\n\n  const controller = {\n    version: CONTROLLER_VERSION,\n\n    latestFormData: reactiveData,\n\n    pending: false,\n\n    pendingQuestion: \"\",\n\n    pendingHistoryLength: 0,\n\n    /*\n     * Incremented on every submission so two identical consecutive\n     * turns never produce an identical render signature.\n     */\n    renderEpoch: 0,\n\n    proceedInFlight: false,\n\n    lastRenderedState: \"\",\n    lastChatLogElement: null,\n    timer: null,\n\n    observer: null,\n\n    destroyed: false,\n\n    /* =======================================================\n     * SCA-06 — DOM LOOKUP HELPERS\n     * ======================================================= */\n\n    find: function (selector) {\n      try {\n        return document.querySelector(selector);\n      } catch (error) {\n        scaLog(\"error\", \"SCA-06\", \"selector-query-failed\", {\n          selector: selector,\n          message: error.message\n        });\n\n        return null;\n      }\n    },\n\n    getChatLog: function () {\n      return this.find(SELECTORS.chatLog);\n    },\n\n    getSurface: function () {\n      return this.find(SELECTORS.chatSurface);\n    },\n\n    getInput: function () {\n      return this.find(SELECTORS.messageInput);\n    },\n\n    getSendButton: function () {\n      return this.find(SELECTORS.sendButton);\n    },\n\n    getDownloadButton: function () {\n      return this.find(SELECTORS.downloadButton);\n    },\n\n    getFormInstance: function () {\n      const formElement = this.find(SELECTORS.form);\n\n      if (formElement && formElement.__formio__) {\n        return formElement.__formio__;\n      }\n\n      return null;\n    },\n\n    getDomMessagesValue: function () {\n      const field = this.find(SELECTORS.messagesJsonField);\n\n      if (field && typeof field.value === \"string\") {\n        return field.value;\n      }\n\n      return \"\";\n    },\n\n    /* =======================================================\n     * SCA-07 — CHAT HISTORY PARSING\n     * ======================================================= */\n\n    parseHistory: function (raw) {\n      if (raw === undefined || raw === null || raw === \"\") {\n        return [];\n      }\n\n      try {\n        const parsed = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n\n        if (!Array.isArray(parsed)) {\n          scaLog(\"warn\", \"SCA-07\", \"history-not-array\", {\n            receivedType: typeof parsed\n          });\n\n          return [];\n        }\n\n        return parsed.filter(function (message) {\n          return (\n            message &&\n            (message.role === \"user\" || message.role === \"assistant\") &&\n            typeof message.content === \"string\" &&\n            message.content.trim() !== \"\"\n          );\n        });\n      } catch (error) {\n        scaLog(\"error\", \"SCA-07\", \"messages-json-parse-failed\", {\n          message: error.message,\n          rawPreview: String(raw).slice(0, 300)\n        });\n\n        return [];\n      }\n    },\n\n    buildCandidateData: function () {\n      const candidates = [];\n\n      if (this.latestFormData && typeof this.latestFormData === \"object\") {\n        candidates.push(this.latestFormData);\n      }\n\n      const form = this.getFormInstance();\n\n      if (\n        form &&\n        form.submission &&\n        form.submission.data &&\n        typeof form.submission.data === \"object\"\n      ) {\n        candidates.push(form.submission.data);\n      }\n\n      const domMessages = this.getDomMessagesValue();\n\n      if (domMessages) {\n        candidates.push({ messagesJson: domMessages });\n      }\n\n      return candidates;\n    },\n\n    getCurrentState: function () {\n      const candidates = this.buildCandidateData();\n\n      let selectedData = {};\n      let selectedHistory = [];\n\n      candidates.forEach(function (candidate) {\n        if (!candidate || typeof candidate !== \"object\") {\n          return;\n        }\n\n        const history = controller.parseHistory(candidate.messagesJson);\n\n        if (history.length > selectedHistory.length) {\n          selectedHistory = history;\n          selectedData = candidate;\n          return;\n        }\n\n        if (\n          history.length === selectedHistory.length &&\n          (candidate.processing === false || candidate.processing === \"false\")\n        ) {\n          selectedData = candidate;\n        }\n      });\n\n      const reactive =\n        this.latestFormData && typeof this.latestFormData === \"object\"\n          ? this.latestFormData\n          : {};\n\n      return {\n        data: Object.assign({}, reactive, selectedData),\n        history: selectedHistory\n      };\n    },\n\n    /* =======================================================\n     * SCA-08 — DATE AND WORKFLOW NORMALIZATION\n     * ======================================================= */\n\n    formatTime: function (createdAt) {\n      const date = createdAt ? new Date(createdAt) : new Date();\n\n      if (Number.isNaN(date.getTime())) {\n        scaLog(\"warn\", \"SCA-08\", \"invalid-message-time\", {\n          createdAt: createdAt\n        });\n\n        return \"\";\n      }\n\n      return date.toLocaleTimeString([], {\n        hour: \"2-digit\",\n        minute: \"2-digit\"\n      });\n    },\n\n    normalizeStage: function (stage) {\n      const value = String(stage || \"\").trim().toLowerCase();\n\n      const aliases = {\n        understand: \"understand\",\n        understanding: \"understand\",\n        input: \"understand\",\n        code: \"code\",\n        coding: \"code\",\n        generate: \"code\",\n        generating: \"code\",\n        revise: \"code\",\n        validate: \"validate\",\n        validation: \"validate\",\n        validating: \"validate\",\n        complete: \"complete\",\n        completed: \"complete\",\n        done: \"complete\"\n      };\n\n      if (aliases[value]) {\n        return aliases[value];\n      }\n\n      if (value && value !== \"error\") {\n        scaLog(\"warn\", \"SCA-08\", \"invalid-workflow-stage\", {\n          receivedStage: value,\n          fallbackStage: \"understand\"\n        });\n      }\n\n      return \"understand\";\n    },\n\n    /* =======================================================\n     * SCA-09 — STATE-DRIVEN PROGRESS STEPPER\n     * ======================================================= */\n\n    updateStepper: function (stage) {\n      const normalized = this.normalizeStage(stage);\n      const activeIndex = STAGE_ORDER.indexOf(normalized);\n\n      const steps = Array.prototype.slice.call(\n        document.querySelectorAll(SELECTORS.step)\n      );\n\n      const lines = Array.prototype.slice.call(\n        document.querySelectorAll(SELECTORS.stepLine)\n      );\n\n      if (steps.length === 0) {\n        scaLog(\"warn\", \"SCA-09\", \"stepper-elements-not-found\", {\n          stage: normalized\n        });\n\n        return;\n      }\n\n      steps.forEach(function (step, index) {\n        step.classList.remove(\"is-active\", \"is-complete\");\n\n        if (index < activeIndex) {\n          step.classList.add(\"is-complete\");\n        } else if (index === activeIndex) {\n          step.classList.add(\"is-active\");\n        }\n\n        step.setAttribute(\n          \"aria-current\",\n          index === activeIndex ? \"step\" : \"false\"\n        );\n      });\n\n      lines.forEach(function (line, index) {\n        line.classList.toggle(\"is-complete\", index < activeIndex);\n      });\n    },\n\n    /* =======================================================\n     * SCA-09b — LIVE PROMPT BUDGET  (NEW)\n     *\n     * The markup and every visual state already existed in the\n     * stylesheet. Only this method was missing, which is why the\n     * counter never moved.\n     * ======================================================= */\n\n    updatePromptBudget: function () {\n      const root = this.find(SELECTORS.budgetRoot);\n      const text = this.find(SELECTORS.budgetText);\n      const bar = this.find(SELECTORS.budgetBar);\n\n      if (!root || !text || !bar) {\n        scaLog(\"warn\", \"SCA-09b\", \"budget-elements-not-found\", {});\n        return;\n      }\n\n      const input = this.getInput();\n\n      const characters =\n        input && typeof input.value === \"string\" ? input.value.length : 0;\n\n      const tokens = Math.ceil(characters / APPROXIMATE_CHARACTERS_PER_TOKEN);\n\n      const percent = Math.min(100, (characters / MAX_USER_CHARACTERS) * 100);\n\n      text.textContent =\n        characters.toLocaleString() +\n        \" / \" +\n        MAX_USER_CHARACTERS.toLocaleString() +\n        \" characters · approximately \" +\n        tokens.toLocaleString() +\n        \" tokens\";\n\n      bar.style.width = percent + \"%\";\n\n      root.classList.toggle(\n        \"is-warning\",\n        characters >= WARNING_USER_CHARACTERS && characters <= MAX_USER_CHARACTERS\n      );\n\n      root.classList.toggle(\"is-exceeded\", characters > MAX_USER_CHARACTERS);\n\n      const track = this.find(SELECTORS.budgetTrack);\n\n      if (track) {\n        track.setAttribute(\"aria-valuenow\", String(Math.round(percent)));\n      }\n    },\n\n    /* =======================================================\n     * SCA-10 — ICON FACTORIES\n     * ======================================================= */\n\n    createAssistantIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M9 3h6v2h2a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h2V3zm-2 4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1H7zm2 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm6 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-6 5h6v1.5H9V15z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createUserIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0-2a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 4c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14zm-6.8 6c.5-2.1 3.5-4 6.8-4s6.3 1.9 6.8 4H5.2z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createCopyIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M8 7V3h13v13h-4v5H3V7h5zm2-2v2h7v7h2V5h-9zm5 4H5v10h10V9z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createCheckIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createDownloadIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3zM5 19h14v2H5v-2z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createPlayIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"M8 5v14l11-7z\"/></svg>'\n      );\n    },\n\n   /* =======================================================\n * SCA-11 — STRUCTURED PLAIN-TEXT / MARKDOWN RENDERING\n *\n * Responsibilities:\n *\n * - headings;\n * - paragraphs;\n * - bold / inline formatting through appendInlineContent();\n * - ordered lists that preserve numbering;\n * - unordered lists;\n * - nested bullets under numbered items;\n * - continuation paragraphs inside list items.\n *\n * Important:\n * Blank lines inside a Markdown list must NOT automatically\n * create a new <ol>, otherwise every numbered item renders\n * as \"1.\".\n * ======================================================= */\nappendInlineContent: function (parent, text) {\n  const value =\n    String(\n      text || \"\"\n    );\n\n  /*\n   * Supported inline Markdown:\n   *\n   * **bold text**\n   * `inline code`\n   *\n   * Keep this intentionally small and deterministic.\n   * Do not use innerHTML with model-generated content.\n   */\n  const pattern =\n    /(\\*\\*[^*]+\\*\\*|`[^`]+`)/g;\n\n  let lastIndex =\n    0;\n\n  let match;\n\n  while (\n    (\n      match =\n        pattern.exec(\n          value\n        )\n    ) !== null\n  ) {\n\n    /*\n     * Normal text before the Markdown token.\n     */\n    if (\n      match.index >\n      lastIndex\n    ) {\n      parent.appendChild(\n        document.createTextNode(\n          value.slice(\n            lastIndex,\n            match.index\n          )\n        )\n      );\n    }\n\n    const token =\n      match[0];\n\n    /*\n     * **bold**\n     */\n    if (\n      token.startsWith(\n        \"**\"\n      ) &&\n      token.endsWith(\n        \"**\"\n      )\n    ) {\n      const strong =\n        document.createElement(\n          \"strong\"\n        );\n\n      strong.className =\n        \"sca-response-strong\";\n\n      strong.textContent =\n        token.slice(\n          2,\n          -2\n        );\n\n      parent.appendChild(\n        strong\n      );\n    }\n\n    /*\n     * `inline code`\n     */\n    else {\n      const code =\n        document.createElement(\n          \"code\"\n        );\n\n      code.className =\n        \"sca-inline-code\";\n\n      code.textContent =\n        token.slice(\n          1,\n          -1\n        );\n\n      parent.appendChild(\n        code\n      );\n    }\n\n    lastIndex =\n      pattern.lastIndex;\n  }\n\n  /*\n   * Remaining plain text after the final Markdown token.\n   */\n  if (\n    lastIndex <\n    value.length\n  ) {\n    parent.appendChild(\n      document.createTextNode(\n        value.slice(\n          lastIndex\n        )\n      )\n    );\n  }\n},\n\nrenderPlainTextBlock: function (container, rawText) {\n\n  const lines =\n    String(rawText || \"\")\n      .replace(/\\r\\n/g, \"\\n\")\n      .split(\"\\n\");\n\n\n  let activeList =\n    null;\n\n  let activeListType =\n    \"\";\n\n  let activeListItem =\n    null;\n\n  let nestedList =\n    null;\n\n  let nestedListType =\n    \"\";\n\n\n  /* -------------------------------------------------------\n   * SCA-11A — RESET NESTED LIST\n   * ------------------------------------------------------- */\n\n  function closeNestedList() {\n    nestedList =\n      null;\n\n    nestedListType =\n      \"\";\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11B — CLOSE ROOT LIST\n   * ------------------------------------------------------- */\n\n  function closeList() {\n    activeList =\n      null;\n\n    activeListType =\n      \"\";\n\n    activeListItem =\n      null;\n\n    closeNestedList();\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11C — CREATE / REUSE ROOT LIST\n   * ------------------------------------------------------- */\n\n  function ensureRootList(type) {\n\n    if (\n      !activeList ||\n      activeListType !== type\n    ) {\n      activeList =\n        document.createElement(\n          type\n        );\n\n      activeList.className =\n        \"sca-response-list\";\n\n      activeListType =\n        type;\n\n      container.appendChild(\n        activeList\n      );\n    }\n\n    return activeList;\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11D — CREATE / REUSE NESTED LIST\n   * ------------------------------------------------------- */\n\n  function ensureNestedList(type) {\n\n    if (\n      !activeListItem\n    ) {\n      return null;\n    }\n\n    if (\n      !nestedList ||\n      nestedListType !== type\n    ) {\n      nestedList =\n        document.createElement(\n          type\n        );\n\n      nestedList.className =\n        \"sca-response-list sca-response-nested-list\";\n\n      nestedListType =\n        type;\n\n      activeListItem.appendChild(\n        nestedList\n      );\n    }\n\n    return nestedList;\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11E — PROCESS LINES\n   * ------------------------------------------------------- */\n\n  for (\n    let index = 0;\n    index < lines.length;\n    index += 1\n  ) {\n\n    const rawLine =\n      String(\n        lines[index] || \"\"\n      );\n\n    const line =\n      rawLine.trimEnd();\n\n    const trimmed =\n      line.trim();\n\n\n    /* -----------------------------------------------------\n     * BLANK LINE\n     *\n     * Do not close an active list merely because Markdown\n     * inserted visual spacing between a numbered item and\n     * its nested description.\n     * ----------------------------------------------------- */\n\n    if (!trimmed) {\n\n      /*\n       * If we are currently inside a list, simply preserve\n       * logical list state.\n       */\n      if (\n        activeList &&\n        activeListItem\n      ) {\n        continue;\n      }\n\n      closeList();\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * HEADING\n     * ----------------------------------------------------- */\n\n    const heading =\n      line.match(\n        /^(#{1,6})\\s+(.+)$/\n      );\n\n    if (heading) {\n\n      closeList();\n\n      /*\n       * Keep chat headings controlled:\n       *\n       * #   -> h2\n       * ##  -> h2\n       * ### -> h3\n       * #### -> h4\n       *\n       * This prevents model-generated H1 content from\n       * overwhelming the application header.\n       */\n      const markdownLevel =\n        heading[1].length;\n\n      const headingLevel =\n        markdownLevel <= 2\n          ? 2\n          : Math.min(\n              markdownLevel,\n              6\n            );\n\n      const element =\n        document.createElement(\n          \"h\" + headingLevel\n        );\n\n      element.className =\n        \"sca-response-heading \" +\n        \"sca-response-heading-\" +\n        headingLevel;\n\n      controller.appendInlineContent(\n        element,\n        heading[2]\n      );\n\n      container.appendChild(\n        element\n      );\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * TOP-LEVEL ORDERED LIST\n     *\n     * Examples:\n     *\n     * 1. System\n     * 2. Package\n     * 3. Authorization\n     * ----------------------------------------------------- */\n\n    const numbered =\n      line.match(\n        /^(\\d+)\\.\\s+(.+)$/\n      );\n\n    if (numbered) {\n\n      closeNestedList();\n\n      const list =\n        ensureRootList(\n          \"ol\"\n        );\n\n      const item =\n        document.createElement(\n          \"li\"\n        );\n\n      /*\n       * Preserve the explicit source number.\n       *\n       * Normally <ol> handles numbering itself, but setting\n       * value also makes rendering resilient when an LLM\n       * intentionally begins at another number.\n       */\n      const requestedNumber =\n        Number(\n          numbered[1]\n        );\n\n      if (\n        Number.isFinite(\n          requestedNumber\n        ) &&\n        requestedNumber > 0\n      ) {\n        item.value =\n          requestedNumber;\n      }\n\n      controller.appendInlineContent(\n        item,\n        numbered[2]\n      );\n\n      list.appendChild(\n        item\n      );\n\n      activeListItem =\n        item;\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * TOP-LEVEL BULLET\n     * ----------------------------------------------------- */\n\n    const bullet =\n      line.match(\n        /^[-*]\\s+(.+)$/\n      );\n\n    if (bullet) {\n\n      closeNestedList();\n\n      const list =\n        ensureRootList(\n          \"ul\"\n        );\n\n      const item =\n        document.createElement(\n          \"li\"\n        );\n\n      controller.appendInlineContent(\n        item,\n        bullet[1]\n      );\n\n      list.appendChild(\n        item\n      );\n\n      activeListItem =\n        item;\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * INDENTED NESTED BULLET\n     *\n     * Example:\n     *\n     * 6. Method signature\n     *\n     *    - iv_kunnr\n     *    - iv_bukrs\n     * ----------------------------------------------------- */\n\n    const nestedBullet =\n      line.match(\n        /^\\s{2,}[-*]\\s+(.+)$/\n      );\n\n    if (\n      nestedBullet &&\n      activeListItem\n    ) {\n\n      const list =\n        ensureNestedList(\n          \"ul\"\n        );\n\n      if (list) {\n\n        const item =\n          document.createElement(\n            \"li\"\n          );\n\n        controller.appendInlineContent(\n          item,\n          nestedBullet[1]\n        );\n\n        list.appendChild(\n          item\n        );\n      }\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * INDENTED NESTED NUMBERED ITEM\n     * ----------------------------------------------------- */\n\n    const nestedNumbered =\n      line.match(\n        /^\\s{2,}(\\d+)\\.\\s+(.+)$/\n      );\n\n    if (\n      nestedNumbered &&\n      activeListItem\n    ) {\n\n      const list =\n        ensureNestedList(\n          \"ol\"\n        );\n\n      if (list) {\n\n        const item =\n          document.createElement(\n            \"li\"\n          );\n\n        const requestedNumber =\n          Number(\n            nestedNumbered[1]\n          );\n\n        if (\n          Number.isFinite(\n            requestedNumber\n          ) &&\n          requestedNumber > 0\n        ) {\n          item.value =\n            requestedNumber;\n        }\n\n        controller.appendInlineContent(\n          item,\n          nestedNumbered[2]\n        );\n\n        list.appendChild(\n          item\n        );\n      }\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * INDENTED CONTINUATION PARAGRAPH\n     *\n     * Example:\n     *\n     * 3. Released CDS source\n     *\n     *    You asked to use released CDS views...\n     *\n     * Keep this text INSIDE item #3 rather than closing the\n     * ordered list.\n     * ----------------------------------------------------- */\n\n    const isIndentedContinuation =\n      /^\\s{2,}\\S/.test(\n        line\n      );\n\n    if (\n      isIndentedContinuation &&\n      activeListItem\n    ) {\n\n      closeNestedList();\n\n      const paragraph =\n        document.createElement(\n          \"p\"\n        );\n\n      paragraph.className =\n        \"sca-response-list-paragraph\";\n\n      controller.appendInlineContent(\n        paragraph,\n        trimmed\n      );\n\n      activeListItem.appendChild(\n        paragraph\n      );\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * NORMAL PARAGRAPH\n     * ----------------------------------------------------- */\n\n    closeList();\n\n    const paragraph =\n      document.createElement(\n        \"p\"\n      );\n\n    paragraph.className =\n      \"sca-response-paragraph\";\n\n    controller.appendInlineContent(\n      paragraph,\n      trimmed\n    );\n\n    container.appendChild(\n      paragraph\n    );\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11F — FINAL CLEANUP\n   * ------------------------------------------------------- */\n\n  closeList();\n},\n\n    /* =======================================================\n     * SCA-12 — FENCED CODE-BLOCK RENDERING\n     * ======================================================= */\n\n    /*\n     * Defence in depth. The backend already strips the sca-state\n     * block, but cached history written by an older version could\n     * still contain one.\n     */\n    stripAgentState: function (text) {\n      return String(text || \"\")\n        .replace(/```[ \\t]*sca-state[ \\t]*\\r?\\n[\\s\\S]*?```/gi, \"\")\n        .trim();\n    },\n\n    renderStructuredContent: function (container, text) {\n      const source = this.stripAgentState(text);\n\n      const fencePattern = /```([A-Za-z0-9_+#.-]*)[ \\t]*\\n?([\\s\\S]*?)```/g;\n\n      let lastIndex = 0;\n      let match;\n\n      while ((match = fencePattern.exec(source)) !== null) {\n        if (match.index > lastIndex) {\n          this.renderPlainTextBlock(\n            container,\n            source.slice(lastIndex, match.index)\n          );\n        }\n\n        const language = String(match[1] || \"code\").toLowerCase();\n\n        const codeText = String(match[2] || \"\").replace(/^\\n|\\n$/g, \"\");\n\n        const wrapper = document.createElement(\"div\");\n        wrapper.className = \"sca-code-block\";\n\n        const header = document.createElement(\"div\");\n        header.className = \"sca-code-header\";\n\n        const languageLabel = document.createElement(\"span\");\n        languageLabel.className = \"sca-code-language\";\n\n        languageLabel.textContent =\n          language === \"abap\" ? \"ABAP\" : language.toUpperCase();\n\n        const copyButton = this.createCodeCopyButton(codeText);\n\n        header.appendChild(languageLabel);\n        header.appendChild(copyButton);\n\n        const pre = document.createElement(\"pre\");\n        const code = document.createElement(\"code\");\n\n        code.className = \"language-\" + language;\n        code.textContent = codeText;\n\n        pre.appendChild(code);\n        wrapper.appendChild(header);\n        wrapper.appendChild(pre);\n\n        container.appendChild(wrapper);\n\n        lastIndex = fencePattern.lastIndex;\n      }\n\n      if (lastIndex < source.length) {\n        this.renderPlainTextBlock(container, source.slice(lastIndex));\n      }\n    },\n\n    /* =======================================================\n     * SCA-13 — CLIPBOARD OPERATIONS\n     * ======================================================= */\n\n    copyText: function (text) {\n      const value = String(text || \"\");\n\n      if (\n        navigator.clipboard &&\n        typeof navigator.clipboard.writeText === \"function\"\n      ) {\n        return navigator.clipboard.writeText(value);\n      }\n\n      return new Promise(function (resolve, reject) {\n        const temporary = document.createElement(\"textarea\");\n\n        temporary.value = value;\n        temporary.setAttribute(\"readonly\", \"readonly\");\n        temporary.style.position = \"fixed\";\n        temporary.style.opacity = \"0\";\n\n        document.body.appendChild(temporary);\n        temporary.select();\n\n        try {\n          const copied = document.execCommand(\"copy\");\n\n          if (!copied) {\n            throw new Error(\"Browser returned false from execCommand('copy').\");\n          }\n\n          resolve();\n        } catch (error) {\n          scaLog(\"error\", \"SCA-13\", \"clipboard-copy-failed\", {\n            message: error.message\n          });\n\n          reject(error);\n        } finally {\n          temporary.remove();\n        }\n      });\n    },\n\n    showActionSuccess: function (button, message) {\n      if (!button) {\n        return;\n      }\n\n      const originalTitle = button.getAttribute(\"title\") || \"\";\n      const originalHtml = button.innerHTML;\n\n      button.classList.add(\"is-success\");\n      button.setAttribute(\"title\", message);\n      button.setAttribute(\"aria-label\", message);\n      button.innerHTML = this.createCheckIcon();\n\n      window.setTimeout(function () {\n        button.classList.remove(\"is-success\");\n        button.setAttribute(\"title\", originalTitle);\n        button.setAttribute(\"aria-label\", originalTitle);\n        button.innerHTML = originalHtml;\n      }, 1400);\n    },\n\n    createCodeCopyButton: function (codeText) {\n      const button = document.createElement(\"button\");\n\n      button.type = \"button\";\n      button.className = \"sca-code-copy-action\";\n      button.setAttribute(\"title\", \"Copy code\");\n      button.setAttribute(\"aria-label\", \"Copy code\");\n      button.innerHTML = this.createCopyIcon();\n\n      button.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller\n          .copyText(String(codeText || \"\"))\n          .then(function () {\n            controller.showActionSuccess(button, \"Code copied\");\n          })\n          .catch(function (error) {\n            scaLog(\"error\", \"SCA-13\", \"code-copy-action-failed\", {\n              message: error.message\n            });\n          });\n      });\n\n      return button;\n    },\n\n    /* =======================================================\n     * SCA-14 — MESSAGE ACTIONS\n     * ======================================================= */\n\n    createMessageActions: function (messageText, messageId, userPrompt) {\n      const actions = document.createElement(\"div\");\n      actions.className = \"sca-message-actions\";\n\n      const copyButton = document.createElement(\"button\");\n\n      copyButton.type = \"button\";\n      copyButton.className = \"sca-message-action sca-copy-action\";\n      copyButton.setAttribute(\"title\", \"Copy response\");\n      copyButton.setAttribute(\"aria-label\", \"Copy response\");\n      copyButton.innerHTML = this.createCopyIcon();\n\n      copyButton.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller\n          .copyText(messageText)\n          .then(function () {\n            controller.showActionSuccess(copyButton, \"Copied\");\n          })\n          .catch(function (error) {\n            scaLog(\"error\", \"SCA-14\", \"message-copy-action-failed\", {\n              message: error.message\n            });\n          });\n      });\n\n      const downloadButton = document.createElement(\"button\");\n\n      downloadButton.type = \"button\";\n      downloadButton.className = \"sca-message-action sca-download-action\";\n      downloadButton.setAttribute(\"title\", \"Download response\");\n      downloadButton.setAttribute(\"aria-label\", \"Download response\");\n      downloadButton.innerHTML = this.createDownloadIcon();\n\n      downloadButton.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller.prepareDownload(\n          messageId,\n          userPrompt,\n          messageText,\n          \"docx\"\n        );\n      });\n\n      actions.appendChild(copyButton);\n      actions.appendChild(downloadButton);\n\n      return actions;\n    },\n\n    /* =======================================================\n     * SCA-14b — PROCEED TO CODE CHIP  (NEW)\n     *\n     * Gated, not hidden. When blocking questions remain the chip\n     * stays clickable but explains the trade-off, so an impatient\n     * user can still generate with TODO placeholders.\n     * ======================================================= */\n\n    createProceedToCodeChip: function (options) {\n      const settings = options || {};\n\n      const wrap = document.createElement(\"div\");\n      wrap.className = \"sca-proceed-wrap\";\n\n      const button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.className = \"sca-proceed-chip\";\n\n      const ready = settings.readyForCode === true;\n\n      button.innerHTML =\n        this.createPlayIcon() + \"<span>Generate the code</span>\";\n\n      const hint = document.createElement(\"span\");\n      hint.className = \"sca-proceed-hint\";\n\n      if (ready) {\n        hint.textContent = \"Every blocking question is answered.\";\n      } else {\n        button.classList.add(\"is-warning\");\n\n        const blockers = Number(settings.blockingQuestions);\n\n        hint.textContent =\n          Number.isFinite(blockers) && blockers > 0\n            ? blockers +\n              \" question\" +\n              (blockers === 1 ? \"\" : \"s\") +\n              \" still open. Answer them for a better result, or generate now with TODO placeholders.\"\n            : \"Generate now, or answer the open questions first for a better result.\";\n      }\n\n      button.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller.requestProceedToCode(button);\n      });\n\n      wrap.appendChild(button);\n      wrap.appendChild(hint);\n\n      return wrap;\n    },\n\n    /*\n     * No new form output is required. The chip writes the proceed\n     * prompt into the composer, raises the proceedRequested flag,\n     * then clicks Send — so the request travels the path that is\n     * already wired. VBP-02 reads the flag and switches to\n     * generate mode.\n     */\n    requestProceedToCode: function (button) {\n      if (this.pending || this.proceedInFlight) {\n        scaLog(\"warn\", \"SCA-14b\", \"proceed-already-in-flight\", {});\n        return;\n      }\n\n      const input = this.getInput();\n\n      if (!input) {\n        scaLog(\"error\", \"SCA-14b\", \"input-not-found-for-proceed\", {});\n        return;\n      }\n\n      const flagWritten = this.setFormField(\"proceedRequested\", \"true\");\n\n      if (!flagWritten) {\n        scaLog(\"error\", \"SCA-14b\", \"proceed-flag-field-missing\", {\n          recommendation:\n            \"Add the proceedRequested hidden component to the form.\"\n        });\n\n        return;\n      }\n\n      this.proceedInFlight = true;\n      \n      /*\n       * Lock the entire composer immediately.\n       * Do not wait for the backend processing flag.\n       */\n      this.updateSendAvailability();\n      \n      if (button) {\n        button.disabled = true;\n        button.classList.add(\"is-busy\");\n      }\n\n      this.setNativeValue(input, PROCEED_PROMPT);\n\n      input.dispatchEvent(new Event(\"input\", { bubbles: true }));\n      input.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      this.updatePromptBudget();\n      this.updateSendAvailability();\n\n      const send = this.getSendButton();\n\n      if (!send) {\n        scaLog(\"error\", \"SCA-14b\", \"send-button-not-found-for-proceed\", {});\n        this.proceedInFlight = false;\n        return;\n      }\n\n      window.setTimeout(function () {\n        send.click();\n\n        controller.proceedInFlight = false;\n      }, 80);\n\n      scaLog(\"info\", \"SCA-14b\", \"proceed-to-code-requested\", {});\n    },\n\n    /* =======================================================\n * SCA-15 — MESSAGE-BUBBLE FACTORY\n *\n * Responsibilities:\n * - render normal user/assistant messages;\n * - render exactly ONE loading message;\n * - render structured assistant content;\n * - attach footer/actions only when appropriate.\n * ======================================================= */\n\ncreateBubble: function (role, text, options) {\n  try {\n    const settings =\n      options &&\n      typeof options === \"object\"\n        ? options\n        : {};\n\n    const isLoading =\n      settings.loading === true;\n\n    /* -------------------------------------------------------\n     * SCA-15A — MESSAGE ROW\n     * ------------------------------------------------------- */\n\n    const row =\n      document.createElement(\n        \"div\"\n      );\n\n    row.className =\n      \"sca-message-row \" +\n      role;\n\n    if (isLoading) {\n      row.classList.add(\n        \"is-loading\"\n      );\n\n      row.setAttribute(\n        \"aria-busy\",\n        \"true\"\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15B — AVATAR\n     * ------------------------------------------------------- */\n\n    const avatar =\n      document.createElement(\n        \"div\"\n      );\n\n    avatar.className =\n      \"sca-avatar \" +\n      role;\n\n    avatar.setAttribute(\n      \"aria-label\",\n      role === \"assistant\"\n        ? \"SAP Code Agent\"\n        : \"User\"\n    );\n\n    avatar.innerHTML =\n      role === \"assistant\"\n        ? this.createAssistantIcon()\n        : this.createUserIcon();\n\n\n    /* -------------------------------------------------------\n     * SCA-15C — BUBBLE\n     * ------------------------------------------------------- */\n\n    const bubble =\n      document.createElement(\n        \"div\"\n      );\n\n    bubble.className =\n      \"sca-message-bubble\";\n\n\n    /* -------------------------------------------------------\n     * SCA-15D — LOADING CONTENT\n     *\n     * IMPORTANT:\n     * Loading and normal text are mutually exclusive.\n     *\n     * The previous implementation rendered `text` first and\n     * then appended another loading row containing the same\n     * \"Working on it...\" text.\n     * ------------------------------------------------------- */\n\n    if (isLoading) {\n      const loading =\n        document.createElement(\n          \"div\"\n        );\n\n      loading.className =\n        \"sca-loading-inline\";\n\n      const spinner =\n        document.createElement(\n          \"span\"\n        );\n\n      spinner.className =\n        \"sca-spinner\";\n\n      spinner.setAttribute(\n        \"aria-hidden\",\n        \"true\"\n      );\n\n      const label =\n        document.createElement(\n          \"span\"\n        );\n\n      label.className =\n        \"sca-loading-label\";\n\n      label.textContent =\n        String(\n          settings.loadingLabel ||\n          text ||\n          \"Working on it...\"\n        ).trim() ||\n        \"Working on it...\";\n\n      loading.appendChild(\n        spinner\n      );\n\n      loading.appendChild(\n        label\n      );\n\n      bubble.appendChild(\n        loading\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15E — NORMAL MESSAGE CONTENT\n     *\n     * This branch deliberately does NOT run for loading\n     * messages.\n     * ------------------------------------------------------- */\n\n    else if (\n      text !== undefined &&\n      text !== null &&\n      String(text) !== \"\"\n    ) {\n      const content =\n        document.createElement(\n          \"div\"\n        );\n\n      content.className =\n        \"sca-message-content\";\n\n      if (\n        role === \"assistant\" &&\n        settings.structured !== false\n      ) {\n        this.renderStructuredContent(\n          content,\n          text\n        );\n      } else {\n        content.textContent =\n          String(text);\n      }\n\n      bubble.appendChild(\n        content\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15F — PROCEED CHIP\n     *\n     * Currently disabled by ENABLE_PROCEED_CHIP = false.\n     * Keep the guard so the feature can be re-enabled later\n     * without changing createBubble again.\n     * ------------------------------------------------------- */\n\n    if (\n      !isLoading &&\n      ENABLE_PROCEED_CHIP &&\n      role === \"assistant\" &&\n      settings.showProceed === true\n    ) {\n      bubble.appendChild(\n        this.createProceedToCodeChip({\n          readyForCode:\n            settings.readyForCode === true,\n\n          blockingQuestions:\n            settings.blockingQuestions\n        })\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15G — MESSAGE FOOTER\n     *\n     * For the processing bubble, show only the timestamp.\n     * Do not show copy/download actions.\n     * ------------------------------------------------------- */\n\n    const footer =\n      document.createElement(\n        \"div\"\n      );\n\n    footer.className =\n      \"sca-message-footer\";\n\n    const time =\n      document.createElement(\n        \"span\"\n      );\n\n    time.className =\n      \"sca-message-time\";\n\n    time.textContent =\n      this.formatTime(\n        settings.createdAt\n      );\n\n    footer.appendChild(\n      time\n    );\n\n    if (\n      !isLoading &&\n      role === \"assistant\" &&\n      settings.actions === true\n    ) {\n      footer.appendChild(\n        this.createMessageActions(\n          String(\n            text || \"\"\n          ),\n          settings.messageId,\n          settings.userPrompt ||\n            \"\"\n        )\n      );\n    }\n\n    bubble.appendChild(\n      footer\n    );\n\n\n    /* -------------------------------------------------------\n     * SCA-15H — ROW ORDER\n     * ------------------------------------------------------- */\n\n    if (\n      role === \"user\"\n    ) {\n      row.appendChild(\n        bubble\n      );\n\n      row.appendChild(\n        avatar\n      );\n    } else {\n      row.appendChild(\n        avatar\n      );\n\n      row.appendChild(\n        bubble\n      );\n    }\n\n    return row;\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-15\",\n      \"message-bubble-create-failed\",\n      {\n        role:\n          String(\n            role || \"\"\n          ),\n\n        loading:\n          Boolean(\n            options &&\n            options.loading\n          ),\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    /*\n     * Defensive fallback.\n     * Never allow one malformed bubble to crash the complete\n     * chat renderer.\n     */\n    const fallbackRow =\n      document.createElement(\n        \"div\"\n      );\n\n    fallbackRow.className =\n      \"sca-message-row assistant\";\n\n    const fallbackBubble =\n      document.createElement(\n        \"div\"\n      );\n\n    fallbackBubble.className =\n      \"sca-message-bubble\";\n\n    fallbackBubble.textContent =\n      options &&\n      options.loading\n        ? \"Working on it...\"\n        : String(\n            text || \"\"\n          );\n\n    fallbackRow.appendChild(\n      fallbackBubble\n    );\n\n    return fallbackRow;\n  }\n},\n    /* =======================================================\n     * SCA-16 — FORM FIELD SYNCHRONIZATION\n     * ======================================================= */\n\n    setNativeValue: function (field, newValue) {\n      if (!field) {\n        return;\n      }\n\n      const prototype = Object.getPrototypeOf(field);\n\n      const descriptor = prototype\n        ? Object.getOwnPropertyDescriptor(prototype, \"value\")\n        : null;\n\n      if (descriptor && typeof descriptor.set === \"function\") {\n        descriptor.set.call(field, newValue);\n      } else {\n        field.value = newValue;\n      }\n    },\n\n    setFormField: function (key, value) {\n      const field =\n        this.find('[name=\"data[' + key + ']\"]') ||\n        this.find(\".formio-component-\" + key + \" textarea\") ||\n        this.find(\".formio-component-\" + key + \" input\");\n\n      if (!field) {\n        scaLog(\"error\", \"SCA-16\", \"form-field-not-found\", { fieldKey: key });\n        return false;\n      }\n\n      this.setNativeValue(\n        field,\n        String(value === undefined || value === null ? \"\" : value)\n      );\n\n      field.dispatchEvent(new Event(\"input\", { bubbles: true }));\n      field.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      return true;\n    },\n\n    /* =======================================================\n     * SCA-17 — RESPONSE DOWNLOAD PREPARATION\n     * ======================================================= */\n\n    prepareDownload: function (\n      messageId,\n      userPrompt,\n      messageContent,\n      format\n    ) {\n      const selectedFormat = format || \"docx\";\n\n      const fieldsUpdated = [\n        this.setFormField(\"selectedMessageId\", messageId),\n        this.setFormField(\"selectedUserPrompt\", userPrompt),\n        this.setFormField(\"selectedMessageContent\", messageContent),\n        this.setFormField(\"selectedDownloadFormat\", selectedFormat)\n      ];\n\n      if (\n        fieldsUpdated.some(function (result) {\n          return result === false;\n        })\n      ) {\n        scaLog(\"error\", \"SCA-17\", \"download-fields-incomplete\", {\n          messageId: messageId\n        });\n\n        return;\n      }\n\n      window.setTimeout(function () {\n        const button = controller.getDownloadButton();\n\n        if (!button) {\n          scaLog(\"error\", \"SCA-17\", \"download-button-not-rendered\", {\n            recommendation:\n              \"Ensure the Download Response Form button is not hidden.\"\n          });\n\n          return;\n        }\n\n        if (button.disabled) {\n          button.disabled = false;\n        }\n\n        button.click();\n      }, 150);\n    },\n\n    /* =======================================================\n     * SCA-18 — INPUT CLEARING\n     * ======================================================= */\n\n    clearInputVisualOnly: function () {\n      const input = this.getInput();\n\n      if (!input) {\n        scaLog(\"warn\", \"SCA-18\", \"input-not-found-for-visual-clear\", {});\n        return;\n      }\n\n      this.setNativeValue(input, \"\");\n\n      this.updatePromptBudget();\n    },\n\n    clearInput: function () {\n      const input = this.getInput();\n\n      if (!input) {\n        scaLog(\"warn\", \"SCA-18\", \"input-not-found-for-clear\", {});\n        return;\n      }\n\n      this.setNativeValue(input, \"\");\n\n      input.dispatchEvent(new Event(\"input\", { bubbles: true }));\n      input.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      input.classList.remove(\"is-invalid\");\n      input.removeAttribute(\"aria-invalid\");\n\n      const wrapper = input.closest(\".formio-component-userMessage\");\n\n      if (wrapper) {\n        wrapper.classList.remove(\n          \"has-error\",\n          \"has-danger\",\n          \"formio-error-wrapper\"\n        );\n\n        wrapper\n          .querySelectorAll(\".help-block, .invalid-feedback, .formio-errors\")\n          .forEach(function (element) {\n            element.style.display = \"none\";\n          });\n      }\n\n      this.updatePromptBudget();\n    },\n\n    /* =======================================================\n * SCA-19 — COMPOSER AVAILABILITY\n *\n * Purpose:\n * 1. Disable Send when input is empty.\n * 2. Disable Send while a request is processing.\n * 3. Disable the message textarea while processing.\n * 4. Block oversized prompts on the client side.\n * 5. Restore the composer automatically after completion/error.\n * ======================================================= */\n\nupdateSendAvailability: function () {\n  try {\n    const button =\n      this.getSendButton();\n\n    const input =\n      this.getInput();\n\n    const current =\n      this.getCurrentState();\n\n    const stateData =\n      current.data || {};\n\n    const question =\n      String(\n        input &&\n        typeof input.value === \"string\"\n          ? input.value\n          : \"\"\n      ).trim();\n\n    const backendProcessing =\n      stateData.processing === true ||\n      stateData.processing === \"true\";\n\n    /*\n     * Local pending state becomes true immediately after Send,\n     * before the backend has had time to refresh Form.io state.\n     *\n     * This prevents the textarea from remaining editable during\n     * that short transition window.\n     */\n    const processing =\n      this.pending ||\n      this.proceedInFlight ||\n      backendProcessing;\n\n    const overCharacterLimit =\n      question.length >\n      MAX_USER_CHARACTERS;\n\n    /* -------------------------------------------------------\n     * Disable/enable message composer\n     * ------------------------------------------------------- */\n\n    if (input) {\n      input.disabled =\n        processing;\n\n      input.readOnly =\n        processing;\n\n      input.setAttribute(\n        \"aria-disabled\",\n        processing\n          ? \"true\"\n          : \"false\"\n      );\n\n      input.setAttribute(\n        \"aria-busy\",\n        processing\n          ? \"true\"\n          : \"false\"\n      );\n\n      input.classList.toggle(\n        \"sca-input-disabled\",\n        processing\n      );\n\n      /*\n       * The explicit attribute gives CSS a stable selector even\n       * if Form.io changes some generated classes.\n       */\n      if (processing) {\n        input.setAttribute(\n          \"data-sca-processing\",\n          \"true\"\n        );\n      } else {\n        input.removeAttribute(\n          \"data-sca-processing\"\n        );\n      }\n    }\n\n    /* -------------------------------------------------------\n     * Disable/enable Send button\n     * ------------------------------------------------------- */\n\n    if (button) {\n      const disabled =\n        !question ||\n        processing ||\n        overCharacterLimit;\n\n      button.disabled =\n        disabled;\n\n      button.setAttribute(\n        \"aria-disabled\",\n        disabled\n          ? \"true\"\n          : \"false\"\n      );\n\n      button.setAttribute(\n        \"aria-busy\",\n        processing\n          ? \"true\"\n          : \"false\"\n      );\n\n      button.classList.toggle(\n        \"sca-is-loading\",\n        processing\n      );\n\n      button.classList.toggle(\n        \"sca-is-over-limit\",\n        overCharacterLimit\n      );\n    } else {\n      scaLog(\n        \"warn\",\n        \"SCA-19\",\n        \"send-button-not-found\",\n        {}\n      );\n    }\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-19\",\n      \"composer-availability-update-failed\",\n      {\n        name:\n          error &&\n          error.name\n            ? error.name\n            : \"Error\",\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n  }\n},\n\n    /* =======================================================\n     * SCA-20 — CHAT SCROLLING\n     * ======================================================= */\n\n    scrollToBottom: function () {\n      const surface = this.getSurface();\n\n      if (!surface) {\n        scaLog(\"warn\", \"SCA-20\", \"chat-surface-not-found\", {});\n        return;\n      }\n\n      window.requestAnimationFrame(function () {\n        window.requestAnimationFrame(function () {\n          surface.scrollTop = surface.scrollHeight;\n        });\n      });\n\n      window.setTimeout(function () {\n        surface.scrollTop = surface.scrollHeight;\n      }, 150);\n    },\n\n    /* =======================================================\n * SCA-21 — CHAT RENDERING\n *\n * Stabilization version:\n *\n * - renders greeting;\n * - renders persisted user/assistant history;\n * - renders optimistic current user turn;\n * - renders Working on it...;\n * - does NOT render Proceed/Generate actions;\n * - does NOT infer workflow state from response text;\n * - backend currentStage/agentPhase is the only stepper source.\n * ======================================================= */\n\nrender: function (\n  force\n) {\n  try {\n    const log =\n      this.getChatLog();\n\n    if (!log) {\n      scaLog(\n        \"warn\",\n        \"SCA-21\",\n        \"chat-log-not-found\",\n        {\n          selector:\n            SELECTORS.chatLog\n        }\n      );\n\n      return;\n    }\n    const logElementChanged =\n      log !== this.lastChatLogElement;\n\n    this.lastChatLogElement =\n      log;\n\n    if (logElementChanged) {\n      force = true;\n      this.lastRenderedState = \"\";\n    }\n\n    const current =\n      this.getCurrentState();\n\n    const stateData =\n      current &&\n      current.data &&\n      typeof current.data === \"object\"\n        ? current.data\n        : {};\n\n    const history =\n      current &&\n      Array.isArray(\n        current.history\n      )\n        ? current.history\n        : [];\n\n    const lastMessage =\n      history.length > 0\n        ? history[\n            history.length - 1\n          ]\n        : null;\n\n    const backendProcessing =\n      stateData.processing === true ||\n      stateData.processing === \"true\";\n\n    const workflowStage =\n      stateData.currentStage ||\n      stateData.agentPhase ||\n      \"understand\";\n\n    /*\n     * Backend workflow state is the ONLY source\n     * of truth for progress.\n     */\n    this.updateStepper(\n      workflowStage\n    );\n\n    /* -------------------------------------------------------\n     * Detect whether the current pending request has completed.\n     * ------------------------------------------------------- */\n\n    const sliceStart =\n      Math.min(\n        Number(\n          this.pendingHistoryLength ||\n          0\n        ),\n        history.length\n      );\n\n    const messagesAfterSubmission =\n      history.slice(\n        sliceStart\n      );\n\n    const assistantAddedAfterSubmission =\n      messagesAfterSubmission.some(\n        function (message) {\n          return (\n            message &&\n            message.role ===\n              \"assistant\" &&\n            typeof message.content ===\n              \"string\" &&\n            message.content.trim() !==\n              \"\"\n          );\n        }\n      );\n\n    const pendingAnswerArrived =\n      Boolean(\n        this.pending &&\n        !backendProcessing &&\n        assistantAddedAfterSubmission &&\n        lastMessage &&\n        lastMessage.role ===\n          \"assistant\"\n      );\n\n    if (\n      pendingAnswerArrived\n    ) {\n      this.pending =\n        false;\n\n      this.pendingQuestion =\n        \"\";\n\n      this.pendingHistoryLength =\n        history.length;\n\n      if (\n        Object.prototype\n          .hasOwnProperty\n          .call(\n            this,\n            \"pendingStartedAt\"\n          )\n      ) {\n        this.pendingStartedAt =\n          \"\";\n      }\n    }\n\n    const shouldShowPending =\n      Boolean(\n        this.pending &&\n        !pendingAnswerArrived\n      );\n\n    /* -------------------------------------------------------\n     * Render signature.\n     *\n     * Include renderEpoch when this controller version has it.\n     * ------------------------------------------------------- */\n\n    const renderState =\n      JSON.stringify({\n        epoch:\n          Number(\n            this.renderEpoch ||\n            0\n          ),\n\n        history:\n          history,\n\n        pending:\n          shouldShowPending,\n\n        pendingQuestion:\n          String(\n            this.pendingQuestion ||\n            \"\"\n          ),\n\n        pendingHistoryLength:\n          Number(\n            this.pendingHistoryLength ||\n            0\n          ),\n\n        processing:\n          backendProcessing,\n\n        stage:\n          workflowStage\n      });\n\n    if (\n      !force &&\n      renderState ===\n        this.lastRenderedState\n    ) {\n      this.updateSendAvailability();\n\n      return;\n    }\n\n    this.lastRenderedState =\n      renderState;\n\n    /*\n     * The Form may have remounted a fresh #sca-chat-log.\n     * Rebuild its complete visible contents.\n     */\n    log.innerHTML =\n      \"\";\n\n    /* -------------------------------------------------------\n     * Greeting\n     * ------------------------------------------------------- */\n\n    log.appendChild(\n      this.createBubble(\n        \"assistant\",\n        GREETING,\n        {\n          actions:\n            false,\n\n          structured:\n            false\n        }\n      )\n    );\n\n    /* -------------------------------------------------------\n     * Persisted chat history\n     * ------------------------------------------------------- */\n\n    let latestUserPrompt =\n      \"\";\n\n    history.forEach(\n      function (\n        message,\n        index\n      ) {\n        if (\n          !message ||\n          typeof message.content !==\n            \"string\" ||\n          !message.content.trim()\n        ) {\n          return;\n        }\n\n        if (\n          message.role ===\n            \"user\"\n        ) {\n          latestUserPrompt =\n            message.content;\n\n          log.appendChild(\n            controller.createBubble(\n              \"user\",\n              message.content,\n              {\n                createdAt:\n                  message.createdAt,\n\n                structured:\n                  false\n              }\n            )\n          );\n\n          return;\n        }\n\n        if (\n          message.role !==\n            \"assistant\"\n        ) {\n          return;\n        }\n\n        const messageId =\n          String(\n            message.id ||\n            message.createdAt ||\n            (\n              \"assistant-\" +\n              index\n            )\n          );\n\n        /*\n         * IMPORTANT:\n         *\n         * No Proceed / Generate button is inserted here.\n         * Workflow controls are intentionally disabled while\n         * state handling is being stabilized.\n         */\n        log.appendChild(\n          controller.createBubble(\n            \"assistant\",\n            message.content,\n            {\n              createdAt:\n                message.createdAt,\n\n              actions:\n                true,\n\n              structured:\n                true,\n\n              messageId:\n                messageId,\n\n              userPrompt:\n                latestUserPrompt\n            }\n          )\n        );\n      }\n    );\n\n    /* -------------------------------------------------------\n     * Optimistic current user message\n     *\n     * Only inspect messages belonging to THIS request.\n     * Identical prompts from old turns must not suppress it.\n     * ------------------------------------------------------- */\n\n    if (\n      shouldShowPending\n    ) {\n      const messagesAddedForCurrentRequest =\n        history.slice(\n          Number(\n            this.pendingHistoryLength ||\n            0\n          )\n        );\n\n      const pendingUserExists =\n        messagesAddedForCurrentRequest.some(\n          function (message) {\n            return (\n              message &&\n              message.role ===\n                \"user\" &&\n              String(\n                message.content ||\n                \"\"\n              ) ===\n                String(\n                  controller\n                    .pendingQuestion ||\n                    \"\"\n                )\n            );\n          }\n        );\n\n      if (\n        this.pendingQuestion &&\n        !pendingUserExists\n      ) {\n        log.appendChild(\n          this.createBubble(\n            \"user\",\n            this.pendingQuestion,\n            {\n              structured:\n                false\n            }\n          )\n        );\n      }\n\n      /* -----------------------------------------------------\n       * Processing bubble\n       * ----------------------------------------------------- */\n\n      const processingText =\n        String(\n          stateData.processingMessage ||\n          \"Working on it...\"\n        ).trim() ||\n        \"Working on it...\";\n\n      log.appendChild(\n        this.createBubble(\n          \"assistant\",\n          processingText,\n          {\n            actions:\n              false,\n\n            structured:\n              false,\n\n            loading:\n              true\n          }\n        )\n      );\n    }\n\n    /* -------------------------------------------------------\n     * Composer state + scrolling\n     * ------------------------------------------------------- */\n\n    this.updateSendAvailability();\n\n    this.scrollToBottom();\n\n    scaLog(\n      \"info\",\n      \"SCA-21\",\n      \"chat-render-complete\",\n      {\n        historyMessages:\n          history.length,\n\n        pending:\n          shouldShowPending,\n\n        processing:\n          backendProcessing,\n\n        stage:\n          workflowStage,\n\n        workflowActionsRendered:\n          false\n      }\n    );\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-21\",\n      \"chat-render-failed\",\n      {\n        name:\n          error &&\n          error.name\n            ? error.name\n            : \"Error\",\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    /*\n     * Never allow a render exception to leave the composer\n     * permanently disabled.\n     */\n    try {\n      this.updateSendAvailability();\n    } catch (\n      availabilityError\n    ) {\n      /* no-op */\n    }\n  }\n},\n\n    /* =======================================================\n * SCA-22 — OPTIMISTIC SUBMISSION\n *\n * Responsibilities:\n * - reject empty submissions;\n * - reject duplicate/programmatic submissions;\n * - capture current history length;\n * - create optimistic user/loading state;\n * - lock composer immediately.\n * ======================================================= */\n\nbeginSubmit: function () {\n  try {\n    const current =\n      this.getCurrentState();\n\n    const stateData =\n      current &&\n      current.data &&\n      typeof current.data === \"object\"\n        ? current.data\n        : {};\n\n    const backendProcessing =\n      stateData.processing === true ||\n      stateData.processing === \"true\";\n\n    /* -------------------------------------------------------\n     * SCA-22A — BLOCK DUPLICATE REQUESTS\n     * ------------------------------------------------------- */\n\n    if (\n      this.pending ||\n      this.proceedInFlight ||\n      backendProcessing\n    ) {\n      scaLog(\n        \"warn\",\n        \"SCA-22\",\n        \"duplicate-submit-blocked\",\n        {\n          pending:\n            this.pending,\n\n          proceedInFlight:\n            this.proceedInFlight,\n\n          backendProcessing:\n            backendProcessing\n        }\n      );\n\n      return false;\n    }\n\n    /* -------------------------------------------------------\n     * SCA-22B — READ INPUT\n     * ------------------------------------------------------- */\n\n    const input =\n      this.getInput();\n\n    if (!input) {\n      scaLog(\n        \"error\",\n        \"SCA-22\",\n        \"message-input-not-found\",\n        {}\n      );\n\n      return false;\n    }\n\n    const question =\n      String(\n        input.value || \"\"\n      ).trim();\n\n    if (!question) {\n      this.updateSendAvailability();\n\n      scaLog(\n        \"info\",\n        \"SCA-22\",\n        \"empty-submit-blocked\",\n        {}\n      );\n\n      return false;\n    }\n\n    /* -------------------------------------------------------\n     * SCA-22C — CLIENT-SIDE SIZE GUARD\n     * ------------------------------------------------------- */\n\n    if (\n      question.length >\n      MAX_USER_CHARACTERS\n    ) {\n      this.updateSendAvailability();\n\n      scaLog(\n        \"warn\",\n        \"SCA-22\",\n        \"oversized-submit-blocked\",\n        {\n          characters:\n            question.length,\n\n          limit:\n            MAX_USER_CHARACTERS\n        }\n      );\n\n      return false;\n    }\n\n    /* -------------------------------------------------------\n     * SCA-22D — CAPTURE PRE-SUBMISSION HISTORY\n     * ------------------------------------------------------- */\n\n    this.pendingHistoryLength =\n      Array.isArray(\n        current.history\n      )\n        ? current.history.length\n        : 0;\n\n    this.pending =\n      true;\n\n    this.pendingQuestion =\n      question;\n\n    this.renderEpoch =\n      Number(\n        this.renderEpoch || 0\n      ) + 1;\n\n    /* -------------------------------------------------------\n     * SCA-22E — OPTIMISTIC UI\n     * ------------------------------------------------------- */\n\n    this.render(\n      true\n    );\n\n    /*\n     * Clear visual composer after the optimistic user bubble\n     * has already captured the question.\n     */\n    window.setTimeout(\n      function () {\n        controller.clearInputVisualOnly();\n\n        controller.updateSendAvailability();\n      },\n      0\n    );\n\n    scaLog(\n      \"info\",\n      \"SCA-22\",\n      \"optimistic-submit-started\",\n      {\n        questionCharacters:\n          question.length,\n\n        existingHistoryMessages:\n          this.pendingHistoryLength,\n\n        epoch:\n          this.renderEpoch\n      }\n    );\n\n    return true;\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-22\",\n      \"optimistic-submit-failed\",\n      {\n        name:\n          error &&\n          error.name\n            ? error.name\n            : \"Error\",\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    this.pending =\n      false;\n\n    this.pendingQuestion =\n      \"\";\n\n    this.updateSendAvailability();\n\n    return false;\n  }\n},\n    /* =======================================================\n     * SCA-23 — NEW CHAT RESET\n     * ======================================================= */\n\n    resetConversationView: function () {\n      this.pending = false;\n      this.pendingQuestion = \"\";\n      this.pendingHistoryLength = 0;\n      this.proceedInFlight = false;\n      this.lastRenderedState = \"\";\n      this.renderEpoch = this.renderEpoch + 1;\n\n      this.latestFormData = {\n        messagesJson: \"[]\",\n        transcript: \"\",\n        currentStage: \"understand\",\n        agentPhase: \"understand\",\n        readyForCode: \"false\",\n        hasGeneratedCode: \"false\",\n        validationPassed: \"false\",\n        confirmedRequirements: \"[]\",\n        proceedRequested: \"false\",\n        agentConfidence: \"\",\n        blockingQuestions: \"\",\n        uiError: \"\",\n        processing: false,\n        processingMessage: \"\",\n        conversationId: \"\",\n        userMessage: \"\",\n        composer: { userMessage: \"\" }\n      };\n\n      this.updateStepper(\"understand\");\n      this.clearInput();\n      this.updateSendAvailability();\n      this.updatePromptBudget();\n      this.render(true);\n\n      scaLog(\"info\", \"SCA-23\", \"conversation-reset\", {});\n    },\n\n    /* =======================================================\n     * SCA-24 — CLICK EVENT HANDLING\n     * ======================================================= */\n\n    handleClick: function (event) {\n      const target = event.target instanceof Element ? event.target : null;\n\n      if (!target) {\n        return;\n      }\n\n      const actionButton = target.closest(\n        \".sca-message-action, .sca-code-copy-action, .sca-proceed-chip\"\n      );\n\n      if (actionButton) {\n        return;\n      }\n\n      const newChatButton = target.closest(SELECTORS.newChatButton);\n\n      if (newChatButton) {\n        this.resetConversationView();\n        return;\n      }\n\n      const sendButton = target.closest(SELECTORS.sendButton);\n\n      if (!sendButton) {\n        return;\n      }\n\n      const allowed = this.beginSubmit();\n\n      if (!allowed) {\n        event.preventDefault();\n        event.stopPropagation();\n        event.stopImmediatePropagation();\n      }\n    },\n\n    /* =======================================================\n     * SCA-25 — KEYBOARD SUBMISSION\n     * ======================================================= */\n\n    handleKeydown: function (event) {\n      const target = event.target instanceof Element ? event.target : null;\n\n      if (!target) {\n        return;\n      }\n\n      const input = target.closest(SELECTORS.messageInput);\n\n      if (!input) {\n        return;\n      }\n\n      if (event.key !== \"Enter\" || event.shiftKey || event.isComposing) {\n        return;\n      }\n\n      const question = String(input.value || \"\").trim();\n\n      if (!question || this.pending) {\n        event.preventDefault();\n        return;\n      }\n\n      const button = this.getSendButton();\n\n      if (!button) {\n        scaLog(\"error\", \"SCA-25\", \"send-button-not-found-for-enter\", {});\n        return;\n      }\n\n      event.preventDefault();\n      event.stopPropagation();\n      event.stopImmediatePropagation();\n\n      button.click();\n    },\n\n    /* =======================================================\n     * SCA-26 — INPUT CHANGE HANDLING\n     * ======================================================= */\n\n    handleInput: function (event) {\n      const target = event.target instanceof Element ? event.target : null;\n\n      if (!target) {\n        return;\n      }\n\n      const input = target.closest(SELECTORS.messageInput);\n\n      if (!input) {\n        return;\n      }\n\n      this.updateSendAvailability();\n      this.updatePromptBudget();\n    },\n\n    /* =======================================================\n * SCA-27 — FORM DATA ACCEPTANCE\n *\n * Prevent a temporary empty Form.io remount payload from\n * destroying an already valid chat history.\n * ======================================================= */\n\nacceptFormData: function (incomingData) {\n  try {\n    if (\n      !incomingData ||\n      typeof incomingData !== \"object\"\n    ) {\n      scaLog(\n        \"warn\",\n        \"SCA-27\",\n        \"incoming-form-data-invalid\",\n        {\n          receivedType:\n            typeof incomingData\n        }\n      );\n\n      this.render(false);\n      return;\n    }\n\n    const previous =\n      this.latestFormData &&\n      typeof this.latestFormData === \"object\"\n        ? this.latestFormData\n        : {};\n\n    const next =\n      Object.assign(\n        {},\n        previous,\n        incomingData\n      );\n\n    const previousHistory =\n      this.parseHistory(\n        previous.messagesJson\n      );\n\n    const incomingHistory =\n      this.parseHistory(\n        incomingData.messagesJson\n      );\n\n    const incomingHasMessagesField =\n      Object.prototype\n        .hasOwnProperty\n        .call(\n          incomingData,\n          \"messagesJson\"\n        );\n\n    /*\n     * A Form remount often emits an empty initial submission.\n     *\n     * Never let that transient empty value erase a populated\n     * conversation already held by the controller.\n     *\n     * New Chat is handled explicitly by resetConversationView(),\n     * so preserving the old history here is safe.\n     */\n    if (\n      incomingHasMessagesField &&\n      previousHistory.length > 0 &&\n      incomingHistory.length === 0 &&\n      !this.pending\n    ) {\n      next.messagesJson =\n        previous.messagesJson;\n\n      if (\n        previous.transcript\n      ) {\n        next.transcript =\n          previous.transcript;\n      }\n\n      scaLog(\n        \"info\",\n        \"SCA-27\",\n        \"transient-empty-history-ignored\",\n        {\n          previousMessages:\n            previousHistory.length\n        }\n      );\n    }\n\n    this.latestFormData =\n      next;\n\n    const effectiveHistory =\n      this.parseHistory(\n        this.latestFormData\n          .messagesJson\n      );\n\n    /*\n     * Keep stepper driven by actual backend state.\n     */\n    this.updateStepper(\n      this.latestFormData.currentStage ||\n      this.latestFormData.agentPhase ||\n      \"understand\"\n    );\n\n    /*\n     * Force a redraw after the Form DOM is remounted.\n     * Otherwise lastRenderedState may match the previous page\n     * even though #sca-chat-log is a brand-new DOM element.\n     */\n \n\n    this.render(false);\n\n    scaLog(\n      \"info\",\n      \"SCA-27\",\n      \"form-data-accepted\",\n      {\n        historyMessages:\n          effectiveHistory.length,\n\n        stage:\n          this.latestFormData.currentStage ||\n          this.latestFormData.agentPhase ||\n          \"understand\"\n      }\n    );\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-27\",\n      \"form-data-acceptance-failed\",\n      {\n        name:\n          error &&\n          error.name,\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    /*\n     * Do not blank the visible chat because of a remount error.\n     */\n    this.render(false);\n  }\n},\n\n   /* =======================================================\n * SCA-28 — PERIODIC FORM SYNCHRONIZATION\n *\n * Do not allow an empty remount snapshot to erase history.\n * ======================================================= */\n\nsync: function () {\n  if (\n    this.destroyed\n  ) {\n    return;\n  }\n\n  try {\n    const form =\n      this.getFormInstance();\n\n    if (\n      !form ||\n      !form.submission ||\n      !form.submission.data ||\n      typeof form.submission.data !== \"object\"\n    ) {\n      this.render(false);\n      return;\n    }\n\n    const incoming =\n      form.submission.data;\n\n    const current =\n      this.latestFormData &&\n      typeof this.latestFormData === \"object\"\n        ? this.latestFormData\n        : {};\n\n    const currentHistory =\n      this.parseHistory(\n        current.messagesJson\n      );\n\n    const incomingHistory =\n      this.parseHistory(\n        incoming.messagesJson\n      );\n\n    const merged =\n      Object.assign(\n        {},\n        current,\n        incoming\n      );\n\n    if (\n      currentHistory.length > 0 &&\n      incomingHistory.length === 0 &&\n      !this.pending\n    ) {\n      merged.messagesJson =\n        current.messagesJson;\n\n      if (\n        current.transcript\n      ) {\n        merged.transcript =\n          current.transcript;\n      }\n    }\n\n    this.latestFormData =\n      merged;\n\n    this.updateStepper(\n      merged.currentStage ||\n      merged.agentPhase ||\n      \"understand\"\n    );\n\n    this.render(false);\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-28\",\n      \"form-synchronization-failed\",\n      {\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n  }\n},\n\n    /* =======================================================\n     * SCA-29 — CONTROLLER CLEANUP\n     * ======================================================= */\n\n    destroy: function () {\n      if (this.destroyed) {\n        return;\n      }\n\n      this.destroyed = true;\n\n      document.removeEventListener(\"click\", this.handleClick, true);\n      document.removeEventListener(\"keydown\", this.handleKeydown, true);\n      document.removeEventListener(\"input\", this.handleInput, true);\n      document.removeEventListener(\"change\", this.handleInput, true);\n\n      if (this.observer) {\n        this.observer.disconnect();\n        this.observer = null;\n      }\n\n      if (this.timer) {\n        window.clearInterval(this.timer);\n        this.timer = null;\n      }\n\n      scaLog(\"info\", \"SCA-29\", \"controller-destroyed\", {});\n    }\n  };\n\n  /* =========================================================\n   * SCA-30 — METHOD BINDING\n   * ========================================================= */\n\n  controller.handleClick = controller.handleClick.bind(controller);\n  controller.handleKeydown = controller.handleKeydown.bind(controller);\n  controller.handleInput = controller.handleInput.bind(controller);\n\n  /* =========================================================\n   * SCA-31 — DOM EVENT REGISTRATION\n   * ========================================================= */\n\n  document.addEventListener(\"click\", controller.handleClick, true);\n  document.addEventListener(\"keydown\", controller.handleKeydown, true);\n  document.addEventListener(\"input\", controller.handleInput, true);\n  document.addEventListener(\"change\", controller.handleInput, true);\n\n  /* =========================================================\n   * SCA-32 — MUTATION OBSERVER\n   * ========================================================= */\n\n  try {\n    controller.observer = new MutationObserver(function () {\n      controller.sync();\n    });\n\n    controller.observer.observe(document.body, {\n      childList: true,\n      subtree: true,\n      characterData: true\n    });\n  } catch (error) {\n    scaLog(\"error\", \"SCA-32\", \"mutation-observer-start-failed\", {\n      message: error.message\n    });\n  }\n\n  /* =========================================================\n   * SCA-33 — PERIODIC SYNCHRONIZATION TIMER\n   * ========================================================= */\n\n  controller.timer = window.setInterval(function () {\n    controller.sync();\n  }, SYNC_INTERVAL_MS);\n\n  /* =========================================================\n   * SCA-34 — GLOBAL CONTROLLER REGISTRATION\n   * ========================================================= */\n\n  window.__sapCodeAgentController = controller;\n\n  /* =========================================================\n   * SCA-35 — INITIAL STATE APPLICATION\n   * ========================================================= */\n\n  controller.acceptFormData(reactiveData);\n\n  controller.updateStepper(\n    reactiveData.currentStage || reactiveData.agentPhase || \"understand\"\n  );\n\n  controller.render(true);\n  controller.updateSendAvailability();\n  controller.updatePromptBudget();\n\n  scaLog(\"info\", \"SCA-35\", \"controller-initialized\", {\n    version: CONTROLLER_VERSION,\n    proceedChipEnabled: ENABLE_PROCEED_CHIP,\n    initialStage: controller.normalizeStage(\n      reactiveData.currentStage || reactiveData.agentPhase || \"understand\"\n    ),\n    historyMessages: controller.parseHistory(reactiveData.messagesJson).length\n  });\n\n  return typeof value !== \"undefined\" ? value : null;\n})();","key":"serverSideJavaScript","type":"customjs","scriptName":"SAP Code Agent Backend Controller","input":true,"tableView":false,"label":"SAP Code Agent Controller","validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"data":{"content":"/*\n * SAP Code Agent Controller\n *\n * Component:\n * SAP Code Agent UI\n * → SAP Code Agent Chat\n * → Server-side JavaScript Component\n * → SAP Code Agent Controller javascript\n *\n * Version 5.0.0\n *\n * Changes vs 4.0.0:\n *   SCA-01   prompt-budget constants; ENABLE_PROCEED_CHIP feature flag\n *   SCA-04   stale-controller version guard (fixes \"old code still running\")\n *   SCA-09b  live prompt-budget counter (new)\n *   SCA-14b  Proceed to Code chip (new)\n *   SCA-15   chip mounted into the assistant bubble\n *   SCA-21   optimistic-bubble bug fixed; render epoch added\n *   SCA-26   handleInput now drives the counter\n *   SCA-23   New Chat resets the counter and the chip\n */\n\n(function bootstrapSapCodeAgent() {\n  \"use strict\";\n\n  /* =========================================================\n   * SCA-01 — CONSTANTS AND COMPONENT IDENTIFICATION\n   * ========================================================= */\n\n  const COMPONENT_NAME = \"SAP Code Agent Controller javascript\";\n\n  const CONTROLLER_VERSION = \"5.0.1\";\n\n  const SYNC_INTERVAL_MS = 350;\n\n  /*\n   * Set to false to ship the counter and render fixes without the\n   * Proceed to Code chip. Turn on once the backend replacements are\n   * deployed, otherwise the chip has no readiness flag to read.\n   */\n  const ENABLE_PROCEED_CHIP = false;\n\n  /*\n   * These MUST stay identical to VBP-04 in\n   * \"Validate + Build SAP Agent Prompt\".\n   */\n  const MAX_USER_CHARACTERS = 16000;\n  const WARNING_USER_CHARACTERS = 12000;\n  const APPROXIMATE_CHARACTERS_PER_TOKEN = 4;\n\n  /* Text placed in the composer when the chip is used. */\n  const PROCEED_PROMPT = \"Proceed to code. Generate the implementation now.\";\n\n  const GREETING =\n    \"Hello! I’m your SAP Code Agent.\\n\\n\" +\n    \"I can help with ABAP, ABAP Cloud, CDS, RAP, CAP/BTP, OData, \" +\n    \"Fiori/UI5 integration, testing, performance, security, and clean-core development.\\n\\n\" +\n    \"What would you like to build or review?\";\n\n  const STAGE_ORDER = [\"understand\", \"code\", \"validate\", \"complete\"];\n\n  const SELECTORS = {\n    chatLog: \"#sca-chat-log\",\n\n    chatSurface: \"#sca-chat-surface, .sca-chat-surface\",\n\n    form: \".formio-form\",\n\n    messageInput:\n      'textarea[name=\"data[composer][userMessage]\"], ' +\n      'input[name=\"data[composer][userMessage]\"], ' +\n      'textarea[name=\"data[userMessage]\"], ' +\n      'input[name=\"data[userMessage]\"], ' +\n      \".formio-component-userMessage textarea, \" +\n      \".formio-component-userMessage input\",\n\n    sendButton:\n      \".formio-component-sendMessage button, \" +\n      'button[name=\"data[sendMessage]\"], ' +\n      \".sca-send button\",\n\n    newChatButton:\n      \".formio-component-newChat button, \" +\n      'button[name=\"data[newChat]\"]',\n\n    downloadButton:\n      \".formio-component-downloadResponse button, \" +\n      'button[name=\"data[downloadResponse]\"], ' +\n      \".sca-download-submit button\",\n\n    messagesJsonField:\n      'textarea[name=\"data[messagesJson]\"], ' +\n      'input[name=\"data[messagesJson]\"], ' +\n      \".formio-component-messagesJson textarea, \" +\n      \".formio-component-messagesJson input\",\n\n    step: \".sca-step\",\n\n    stepLine: \".sca-step-line\",\n\n    budgetRoot: \"#sca-prompt-budget\",\n\n    budgetText: \"#sca-prompt-budget-text\",\n\n    budgetBar: \"#sca-prompt-budget-bar\",\n\n    budgetTrack: \".sca-prompt-budget-track\"\n  };\n\n  /* =========================================================\n   * SCA-02 — PRODUCTION DIAGNOSTIC LOGGER\n   * ========================================================= */\n\n  function scaLog(level, section, event, details) {\n    const record = {\n      component: COMPONENT_NAME,\n      version: CONTROLLER_VERSION,\n      section: section,\n      event: event,\n      timestamp: new Date().toISOString(),\n      details:\n        details && typeof details === \"object\"\n          ? details\n          : {\n              value: String(\n                details === undefined || details === null ? \"\" : details\n              )\n            }\n    };\n\n    const prefix = \"[SCA][\" + section + \"][\" + event + \"]\";\n\n    if (level === \"error\") {\n      console.error(prefix, record);\n      return;\n    }\n\n    if (level === \"warn\") {\n      console.warn(prefix, record);\n      return;\n    }\n\n    console.info(prefix, record);\n  }\n\n  /* =========================================================\n   * SCA-03 — REACTIVE FORM DATA DISCOVERY\n   * ========================================================= */\n\n  function readReactiveData() {\n    try {\n      if (\n        typeof submission !== \"undefined\" &&\n        submission &&\n        typeof submission === \"object\"\n      ) {\n        if (submission.data && typeof submission.data === \"object\") {\n          return submission.data;\n        }\n\n        return submission;\n      }\n    } catch (error) {\n      scaLog(\"warn\", \"SCA-03\", \"submission-not-readable\", {\n        message: error.message\n      });\n    }\n\n    try {\n      if (typeof data !== \"undefined\" && data && typeof data === \"object\") {\n        return data;\n      }\n    } catch (error) {\n      scaLog(\"warn\", \"SCA-03\", \"data-not-readable\", {\n        message: error.message\n      });\n    }\n\n    scaLog(\"warn\", \"SCA-03\", \"reactive-data-fallback\", {\n      message: \"No readable submission/data object was available.\"\n    });\n\n    return {};\n  }\n\n  const reactiveData = readReactiveData();\n\n  /* =========================================================\n   * SCA-04 — CONTROLLER REUSE AND VERSION GUARD\n   *\n   * v4.0.0 reused any existing controller unconditionally. After a\n   * redeploy the browser therefore kept running the OLD controller\n   * until a hard refresh. The version check below tears down a stale\n   * instance so future deployments take effect on a normal reload.\n   * ========================================================= */\n\n  const existingController = window.__sapCodeAgentController;\n\n  if (\n    existingController &&\n    typeof existingController.acceptFormData === \"function\"\n  ) {\n    if (existingController.version === CONTROLLER_VERSION) {\n      scaLog(\"info\", \"SCA-04\", \"existing-controller-reused\", {\n        version: existingController.version\n      });\n\n      existingController.acceptFormData(reactiveData);\n\n      return typeof value !== \"undefined\" ? value : null;\n    }\n\n    scaLog(\"warn\", \"SCA-04\", \"stale-controller-replaced\", {\n      previousVersion: existingController.version || \"unknown\",\n      newVersion: CONTROLLER_VERSION\n    });\n\n    try {\n      if (typeof existingController.destroy === \"function\") {\n        existingController.destroy();\n      }\n    } catch (error) {\n      scaLog(\"error\", \"SCA-04\", \"stale-controller-destroy-failed\", {\n        message: error.message\n      });\n    }\n\n    window.__sapCodeAgentController = null;\n  }\n\n  /* =========================================================\n   * SCA-05 — CONTROLLER STATE\n   * ========================================================= */\n\n  const controller = {\n    version: CONTROLLER_VERSION,\n\n    latestFormData: reactiveData,\n\n    pending: false,\n\n    pendingQuestion: \"\",\n\n    pendingHistoryLength: 0,\n\n    /*\n     * Incremented on every submission so two identical consecutive\n     * turns never produce an identical render signature.\n     */\n    renderEpoch: 0,\n\n    proceedInFlight: false,\n\n    lastRenderedState: \"\",\n    lastChatLogElement: null,\n    timer: null,\n\n    observer: null,\n\n    destroyed: false,\n\n    /* =======================================================\n     * SCA-06 — DOM LOOKUP HELPERS\n     * ======================================================= */\n\n    find: function (selector) {\n      try {\n        return document.querySelector(selector);\n      } catch (error) {\n        scaLog(\"error\", \"SCA-06\", \"selector-query-failed\", {\n          selector: selector,\n          message: error.message\n        });\n\n        return null;\n      }\n    },\n\n    getChatLog: function () {\n      return this.find(SELECTORS.chatLog);\n    },\n\n    getSurface: function () {\n      return this.find(SELECTORS.chatSurface);\n    },\n\n    getInput: function () {\n      return this.find(SELECTORS.messageInput);\n    },\n\n    getSendButton: function () {\n      return this.find(SELECTORS.sendButton);\n    },\n\n    getDownloadButton: function () {\n      return this.find(SELECTORS.downloadButton);\n    },\n\n    getFormInstance: function () {\n      const formElement = this.find(SELECTORS.form);\n\n      if (formElement && formElement.__formio__) {\n        return formElement.__formio__;\n      }\n\n      return null;\n    },\n\n    getDomMessagesValue: function () {\n      const field = this.find(SELECTORS.messagesJsonField);\n\n      if (field && typeof field.value === \"string\") {\n        return field.value;\n      }\n\n      return \"\";\n    },\n\n    /* =======================================================\n     * SCA-07 — CHAT HISTORY PARSING\n     * ======================================================= */\n\n    parseHistory: function (raw) {\n      if (raw === undefined || raw === null || raw === \"\") {\n        return [];\n      }\n\n      try {\n        const parsed = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n\n        if (!Array.isArray(parsed)) {\n          scaLog(\"warn\", \"SCA-07\", \"history-not-array\", {\n            receivedType: typeof parsed\n          });\n\n          return [];\n        }\n\n        return parsed.filter(function (message) {\n          return (\n            message &&\n            (message.role === \"user\" || message.role === \"assistant\") &&\n            typeof message.content === \"string\" &&\n            message.content.trim() !== \"\"\n          );\n        });\n      } catch (error) {\n        scaLog(\"error\", \"SCA-07\", \"messages-json-parse-failed\", {\n          message: error.message,\n          rawPreview: String(raw).slice(0, 300)\n        });\n\n        return [];\n      }\n    },\n\n    buildCandidateData: function () {\n      const candidates = [];\n\n      if (this.latestFormData && typeof this.latestFormData === \"object\") {\n        candidates.push(this.latestFormData);\n      }\n\n      const form = this.getFormInstance();\n\n      if (\n        form &&\n        form.submission &&\n        form.submission.data &&\n        typeof form.submission.data === \"object\"\n      ) {\n        candidates.push(form.submission.data);\n      }\n\n      const domMessages = this.getDomMessagesValue();\n\n      if (domMessages) {\n        candidates.push({ messagesJson: domMessages });\n      }\n\n      return candidates;\n    },\n\n    getCurrentState: function () {\n      const candidates = this.buildCandidateData();\n\n      let selectedData = {};\n      let selectedHistory = [];\n\n      candidates.forEach(function (candidate) {\n        if (!candidate || typeof candidate !== \"object\") {\n          return;\n        }\n\n        const history = controller.parseHistory(candidate.messagesJson);\n\n        if (history.length > selectedHistory.length) {\n          selectedHistory = history;\n          selectedData = candidate;\n          return;\n        }\n\n        if (\n          history.length === selectedHistory.length &&\n          (candidate.processing === false || candidate.processing === \"false\")\n        ) {\n          selectedData = candidate;\n        }\n      });\n\n      const reactive =\n        this.latestFormData && typeof this.latestFormData === \"object\"\n          ? this.latestFormData\n          : {};\n\n      return {\n        data: Object.assign({}, reactive, selectedData),\n        history: selectedHistory\n      };\n    },\n\n    /* =======================================================\n     * SCA-08 — DATE AND WORKFLOW NORMALIZATION\n     * ======================================================= */\n\n    formatTime: function (createdAt) {\n      const date = createdAt ? new Date(createdAt) : new Date();\n\n      if (Number.isNaN(date.getTime())) {\n        scaLog(\"warn\", \"SCA-08\", \"invalid-message-time\", {\n          createdAt: createdAt\n        });\n\n        return \"\";\n      }\n\n      return date.toLocaleTimeString([], {\n        hour: \"2-digit\",\n        minute: \"2-digit\"\n      });\n    },\n\n    normalizeStage: function (stage) {\n      const value = String(stage || \"\").trim().toLowerCase();\n\n      const aliases = {\n        understand: \"understand\",\n        understanding: \"understand\",\n        input: \"understand\",\n        code: \"code\",\n        coding: \"code\",\n        generate: \"code\",\n        generating: \"code\",\n        revise: \"code\",\n        validate: \"validate\",\n        validation: \"validate\",\n        validating: \"validate\",\n        complete: \"complete\",\n        completed: \"complete\",\n        done: \"complete\"\n      };\n\n      if (aliases[value]) {\n        return aliases[value];\n      }\n\n      if (value && value !== \"error\") {\n        scaLog(\"warn\", \"SCA-08\", \"invalid-workflow-stage\", {\n          receivedStage: value,\n          fallbackStage: \"understand\"\n        });\n      }\n\n      return \"understand\";\n    },\n\n    /* =======================================================\n     * SCA-09 — STATE-DRIVEN PROGRESS STEPPER\n     * ======================================================= */\n\n    updateStepper: function (stage) {\n      const normalized = this.normalizeStage(stage);\n      const activeIndex = STAGE_ORDER.indexOf(normalized);\n\n      const steps = Array.prototype.slice.call(\n        document.querySelectorAll(SELECTORS.step)\n      );\n\n      const lines = Array.prototype.slice.call(\n        document.querySelectorAll(SELECTORS.stepLine)\n      );\n\n      if (steps.length === 0) {\n        scaLog(\"warn\", \"SCA-09\", \"stepper-elements-not-found\", {\n          stage: normalized\n        });\n\n        return;\n      }\n\n      steps.forEach(function (step, index) {\n        step.classList.remove(\"is-active\", \"is-complete\");\n\n        if (index < activeIndex) {\n          step.classList.add(\"is-complete\");\n        } else if (index === activeIndex) {\n          step.classList.add(\"is-active\");\n        }\n\n        step.setAttribute(\n          \"aria-current\",\n          index === activeIndex ? \"step\" : \"false\"\n        );\n      });\n\n      lines.forEach(function (line, index) {\n        line.classList.toggle(\"is-complete\", index < activeIndex);\n      });\n    },\n\n    /* =======================================================\n     * SCA-09b — LIVE PROMPT BUDGET  (NEW)\n     *\n     * The markup and every visual state already existed in the\n     * stylesheet. Only this method was missing, which is why the\n     * counter never moved.\n     * ======================================================= */\n\n    updatePromptBudget: function () {\n      const root = this.find(SELECTORS.budgetRoot);\n      const text = this.find(SELECTORS.budgetText);\n      const bar = this.find(SELECTORS.budgetBar);\n\n      if (!root || !text || !bar) {\n        scaLog(\"warn\", \"SCA-09b\", \"budget-elements-not-found\", {});\n        return;\n      }\n\n      const input = this.getInput();\n\n      const characters =\n        input && typeof input.value === \"string\" ? input.value.length : 0;\n\n      const tokens = Math.ceil(characters / APPROXIMATE_CHARACTERS_PER_TOKEN);\n\n      const percent = Math.min(100, (characters / MAX_USER_CHARACTERS) * 100);\n\n      text.textContent =\n        characters.toLocaleString() +\n        \" / \" +\n        MAX_USER_CHARACTERS.toLocaleString() +\n        \" characters · approximately \" +\n        tokens.toLocaleString() +\n        \" tokens\";\n\n      bar.style.width = percent + \"%\";\n\n      root.classList.toggle(\n        \"is-warning\",\n        characters >= WARNING_USER_CHARACTERS && characters <= MAX_USER_CHARACTERS\n      );\n\n      root.classList.toggle(\"is-exceeded\", characters > MAX_USER_CHARACTERS);\n\n      const track = this.find(SELECTORS.budgetTrack);\n\n      if (track) {\n        track.setAttribute(\"aria-valuenow\", String(Math.round(percent)));\n      }\n    },\n\n    /* =======================================================\n     * SCA-10 — ICON FACTORIES\n     * ======================================================= */\n\n    createAssistantIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M9 3h6v2h2a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3h2V3zm-2 4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1H7zm2 3a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm6 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-6 5h6v1.5H9V15z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createUserIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0-2a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 4c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14zm-6.8 6c.5-2.1 3.5-4 6.8-4s6.3 1.9 6.8 4H5.2z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createCopyIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M8 7V3h13v13h-4v5H3V7h5zm2-2v2h7v7h2V5h-9zm5 4H5v10h10V9z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createCheckIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createDownloadIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"' +\n        \"M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3zM5 19h14v2H5v-2z\" +\n        '\"/></svg>'\n      );\n    },\n\n    createPlayIcon: function () {\n      return (\n        '<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">' +\n        '<path fill=\"currentColor\" d=\"M8 5v14l11-7z\"/></svg>'\n      );\n    },\n\n   /* =======================================================\n * SCA-11 — STRUCTURED PLAIN-TEXT / MARKDOWN RENDERING\n *\n * Responsibilities:\n *\n * - headings;\n * - paragraphs;\n * - bold / inline formatting through appendInlineContent();\n * - ordered lists that preserve numbering;\n * - unordered lists;\n * - nested bullets under numbered items;\n * - continuation paragraphs inside list items.\n *\n * Important:\n * Blank lines inside a Markdown list must NOT automatically\n * create a new <ol>, otherwise every numbered item renders\n * as \"1.\".\n * ======================================================= */\nappendInlineContent: function (parent, text) {\n  const value =\n    String(\n      text || \"\"\n    );\n\n  /*\n   * Supported inline Markdown:\n   *\n   * **bold text**\n   * `inline code`\n   *\n   * Keep this intentionally small and deterministic.\n   * Do not use innerHTML with model-generated content.\n   */\n  const pattern =\n    /(\\*\\*[^*]+\\*\\*|`[^`]+`)/g;\n\n  let lastIndex =\n    0;\n\n  let match;\n\n  while (\n    (\n      match =\n        pattern.exec(\n          value\n        )\n    ) !== null\n  ) {\n\n    /*\n     * Normal text before the Markdown token.\n     */\n    if (\n      match.index >\n      lastIndex\n    ) {\n      parent.appendChild(\n        document.createTextNode(\n          value.slice(\n            lastIndex,\n            match.index\n          )\n        )\n      );\n    }\n\n    const token =\n      match[0];\n\n    /*\n     * **bold**\n     */\n    if (\n      token.startsWith(\n        \"**\"\n      ) &&\n      token.endsWith(\n        \"**\"\n      )\n    ) {\n      const strong =\n        document.createElement(\n          \"strong\"\n        );\n\n      strong.className =\n        \"sca-response-strong\";\n\n      strong.textContent =\n        token.slice(\n          2,\n          -2\n        );\n\n      parent.appendChild(\n        strong\n      );\n    }\n\n    /*\n     * `inline code`\n     */\n    else {\n      const code =\n        document.createElement(\n          \"code\"\n        );\n\n      code.className =\n        \"sca-inline-code\";\n\n      code.textContent =\n        token.slice(\n          1,\n          -1\n        );\n\n      parent.appendChild(\n        code\n      );\n    }\n\n    lastIndex =\n      pattern.lastIndex;\n  }\n\n  /*\n   * Remaining plain text after the final Markdown token.\n   */\n  if (\n    lastIndex <\n    value.length\n  ) {\n    parent.appendChild(\n      document.createTextNode(\n        value.slice(\n          lastIndex\n        )\n      )\n    );\n  }\n},\n\nrenderPlainTextBlock: function (container, rawText) {\n\n  const lines =\n    String(rawText || \"\")\n      .replace(/\\r\\n/g, \"\\n\")\n      .split(\"\\n\");\n\n\n  let activeList =\n    null;\n\n  let activeListType =\n    \"\";\n\n  let activeListItem =\n    null;\n\n  let nestedList =\n    null;\n\n  let nestedListType =\n    \"\";\n\n\n  /* -------------------------------------------------------\n   * SCA-11A — RESET NESTED LIST\n   * ------------------------------------------------------- */\n\n  function closeNestedList() {\n    nestedList =\n      null;\n\n    nestedListType =\n      \"\";\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11B — CLOSE ROOT LIST\n   * ------------------------------------------------------- */\n\n  function closeList() {\n    activeList =\n      null;\n\n    activeListType =\n      \"\";\n\n    activeListItem =\n      null;\n\n    closeNestedList();\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11C — CREATE / REUSE ROOT LIST\n   * ------------------------------------------------------- */\n\n  function ensureRootList(type) {\n\n    if (\n      !activeList ||\n      activeListType !== type\n    ) {\n      activeList =\n        document.createElement(\n          type\n        );\n\n      activeList.className =\n        \"sca-response-list\";\n\n      activeListType =\n        type;\n\n      container.appendChild(\n        activeList\n      );\n    }\n\n    return activeList;\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11D — CREATE / REUSE NESTED LIST\n   * ------------------------------------------------------- */\n\n  function ensureNestedList(type) {\n\n    if (\n      !activeListItem\n    ) {\n      return null;\n    }\n\n    if (\n      !nestedList ||\n      nestedListType !== type\n    ) {\n      nestedList =\n        document.createElement(\n          type\n        );\n\n      nestedList.className =\n        \"sca-response-list sca-response-nested-list\";\n\n      nestedListType =\n        type;\n\n      activeListItem.appendChild(\n        nestedList\n      );\n    }\n\n    return nestedList;\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11E — PROCESS LINES\n   * ------------------------------------------------------- */\n\n  for (\n    let index = 0;\n    index < lines.length;\n    index += 1\n  ) {\n\n    const rawLine =\n      String(\n        lines[index] || \"\"\n      );\n\n    const line =\n      rawLine.trimEnd();\n\n    const trimmed =\n      line.trim();\n\n\n    /* -----------------------------------------------------\n     * BLANK LINE\n     *\n     * Do not close an active list merely because Markdown\n     * inserted visual spacing between a numbered item and\n     * its nested description.\n     * ----------------------------------------------------- */\n\n    if (!trimmed) {\n\n      /*\n       * If we are currently inside a list, simply preserve\n       * logical list state.\n       */\n      if (\n        activeList &&\n        activeListItem\n      ) {\n        continue;\n      }\n\n      closeList();\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * HEADING\n     * ----------------------------------------------------- */\n\n    const heading =\n      line.match(\n        /^(#{1,6})\\s+(.+)$/\n      );\n\n    if (heading) {\n\n      closeList();\n\n      /*\n       * Keep chat headings controlled:\n       *\n       * #   -> h2\n       * ##  -> h2\n       * ### -> h3\n       * #### -> h4\n       *\n       * This prevents model-generated H1 content from\n       * overwhelming the application header.\n       */\n      const markdownLevel =\n        heading[1].length;\n\n      const headingLevel =\n        markdownLevel <= 2\n          ? 2\n          : Math.min(\n              markdownLevel,\n              6\n            );\n\n      const element =\n        document.createElement(\n          \"h\" + headingLevel\n        );\n\n      element.className =\n        \"sca-response-heading \" +\n        \"sca-response-heading-\" +\n        headingLevel;\n\n      controller.appendInlineContent(\n        element,\n        heading[2]\n      );\n\n      container.appendChild(\n        element\n      );\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * TOP-LEVEL ORDERED LIST\n     *\n     * Examples:\n     *\n     * 1. System\n     * 2. Package\n     * 3. Authorization\n     * ----------------------------------------------------- */\n\n    const numbered =\n      line.match(\n        /^(\\d+)\\.\\s+(.+)$/\n      );\n\n    if (numbered) {\n\n      closeNestedList();\n\n      const list =\n        ensureRootList(\n          \"ol\"\n        );\n\n      const item =\n        document.createElement(\n          \"li\"\n        );\n\n      /*\n       * Preserve the explicit source number.\n       *\n       * Normally <ol> handles numbering itself, but setting\n       * value also makes rendering resilient when an LLM\n       * intentionally begins at another number.\n       */\n      const requestedNumber =\n        Number(\n          numbered[1]\n        );\n\n      if (\n        Number.isFinite(\n          requestedNumber\n        ) &&\n        requestedNumber > 0\n      ) {\n        item.value =\n          requestedNumber;\n      }\n\n      controller.appendInlineContent(\n        item,\n        numbered[2]\n      );\n\n      list.appendChild(\n        item\n      );\n\n      activeListItem =\n        item;\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * TOP-LEVEL BULLET\n     * ----------------------------------------------------- */\n\n    const bullet =\n      line.match(\n        /^[-*]\\s+(.+)$/\n      );\n\n    if (bullet) {\n\n      closeNestedList();\n\n      const list =\n        ensureRootList(\n          \"ul\"\n        );\n\n      const item =\n        document.createElement(\n          \"li\"\n        );\n\n      controller.appendInlineContent(\n        item,\n        bullet[1]\n      );\n\n      list.appendChild(\n        item\n      );\n\n      activeListItem =\n        item;\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * INDENTED NESTED BULLET\n     *\n     * Example:\n     *\n     * 6. Method signature\n     *\n     *    - iv_kunnr\n     *    - iv_bukrs\n     * ----------------------------------------------------- */\n\n    const nestedBullet =\n      line.match(\n        /^\\s{2,}[-*]\\s+(.+)$/\n      );\n\n    if (\n      nestedBullet &&\n      activeListItem\n    ) {\n\n      const list =\n        ensureNestedList(\n          \"ul\"\n        );\n\n      if (list) {\n\n        const item =\n          document.createElement(\n            \"li\"\n          );\n\n        controller.appendInlineContent(\n          item,\n          nestedBullet[1]\n        );\n\n        list.appendChild(\n          item\n        );\n      }\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * INDENTED NESTED NUMBERED ITEM\n     * ----------------------------------------------------- */\n\n    const nestedNumbered =\n      line.match(\n        /^\\s{2,}(\\d+)\\.\\s+(.+)$/\n      );\n\n    if (\n      nestedNumbered &&\n      activeListItem\n    ) {\n\n      const list =\n        ensureNestedList(\n          \"ol\"\n        );\n\n      if (list) {\n\n        const item =\n          document.createElement(\n            \"li\"\n          );\n\n        const requestedNumber =\n          Number(\n            nestedNumbered[1]\n          );\n\n        if (\n          Number.isFinite(\n            requestedNumber\n          ) &&\n          requestedNumber > 0\n        ) {\n          item.value =\n            requestedNumber;\n        }\n\n        controller.appendInlineContent(\n          item,\n          nestedNumbered[2]\n        );\n\n        list.appendChild(\n          item\n        );\n      }\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * INDENTED CONTINUATION PARAGRAPH\n     *\n     * Example:\n     *\n     * 3. Released CDS source\n     *\n     *    You asked to use released CDS views...\n     *\n     * Keep this text INSIDE item #3 rather than closing the\n     * ordered list.\n     * ----------------------------------------------------- */\n\n    const isIndentedContinuation =\n      /^\\s{2,}\\S/.test(\n        line\n      );\n\n    if (\n      isIndentedContinuation &&\n      activeListItem\n    ) {\n\n      closeNestedList();\n\n      const paragraph =\n        document.createElement(\n          \"p\"\n        );\n\n      paragraph.className =\n        \"sca-response-list-paragraph\";\n\n      controller.appendInlineContent(\n        paragraph,\n        trimmed\n      );\n\n      activeListItem.appendChild(\n        paragraph\n      );\n\n      continue;\n    }\n\n\n    /* -----------------------------------------------------\n     * NORMAL PARAGRAPH\n     * ----------------------------------------------------- */\n\n    closeList();\n\n    const paragraph =\n      document.createElement(\n        \"p\"\n      );\n\n    paragraph.className =\n      \"sca-response-paragraph\";\n\n    controller.appendInlineContent(\n      paragraph,\n      trimmed\n    );\n\n    container.appendChild(\n      paragraph\n    );\n  }\n\n\n  /* -------------------------------------------------------\n   * SCA-11F — FINAL CLEANUP\n   * ------------------------------------------------------- */\n\n  closeList();\n},\n\n    /* =======================================================\n     * SCA-12 — FENCED CODE-BLOCK RENDERING\n     * ======================================================= */\n\n    /*\n     * Defence in depth. The backend already strips the sca-state\n     * block, but cached history written by an older version could\n     * still contain one.\n     */\n    stripAgentState: function (text) {\n      return String(text || \"\")\n        .replace(/```[ \\t]*sca-state[ \\t]*\\r?\\n[\\s\\S]*?```/gi, \"\")\n        .trim();\n    },\n\n    renderStructuredContent: function (container, text) {\n      const source = this.stripAgentState(text);\n\n      const fencePattern = /```([A-Za-z0-9_+#.-]*)[ \\t]*\\n?([\\s\\S]*?)```/g;\n\n      let lastIndex = 0;\n      let match;\n\n      while ((match = fencePattern.exec(source)) !== null) {\n        if (match.index > lastIndex) {\n          this.renderPlainTextBlock(\n            container,\n            source.slice(lastIndex, match.index)\n          );\n        }\n\n        const language = String(match[1] || \"code\").toLowerCase();\n\n        const codeText = String(match[2] || \"\").replace(/^\\n|\\n$/g, \"\");\n\n        const wrapper = document.createElement(\"div\");\n        wrapper.className = \"sca-code-block\";\n\n        const header = document.createElement(\"div\");\n        header.className = \"sca-code-header\";\n\n        const languageLabel = document.createElement(\"span\");\n        languageLabel.className = \"sca-code-language\";\n\n        languageLabel.textContent =\n          language === \"abap\" ? \"ABAP\" : language.toUpperCase();\n\n        const copyButton = this.createCodeCopyButton(codeText);\n\n        header.appendChild(languageLabel);\n        header.appendChild(copyButton);\n\n        const pre = document.createElement(\"pre\");\n        const code = document.createElement(\"code\");\n\n        code.className = \"language-\" + language;\n        code.textContent = codeText;\n\n        pre.appendChild(code);\n        wrapper.appendChild(header);\n        wrapper.appendChild(pre);\n\n        container.appendChild(wrapper);\n\n        lastIndex = fencePattern.lastIndex;\n      }\n\n      if (lastIndex < source.length) {\n        this.renderPlainTextBlock(container, source.slice(lastIndex));\n      }\n    },\n\n    /* =======================================================\n     * SCA-13 — CLIPBOARD OPERATIONS\n     * ======================================================= */\n\n    copyText: function (text) {\n      const value = String(text || \"\");\n\n      if (\n        navigator.clipboard &&\n        typeof navigator.clipboard.writeText === \"function\"\n      ) {\n        return navigator.clipboard.writeText(value);\n      }\n\n      return new Promise(function (resolve, reject) {\n        const temporary = document.createElement(\"textarea\");\n\n        temporary.value = value;\n        temporary.setAttribute(\"readonly\", \"readonly\");\n        temporary.style.position = \"fixed\";\n        temporary.style.opacity = \"0\";\n\n        document.body.appendChild(temporary);\n        temporary.select();\n\n        try {\n          const copied = document.execCommand(\"copy\");\n\n          if (!copied) {\n            throw new Error(\"Browser returned false from execCommand('copy').\");\n          }\n\n          resolve();\n        } catch (error) {\n          scaLog(\"error\", \"SCA-13\", \"clipboard-copy-failed\", {\n            message: error.message\n          });\n\n          reject(error);\n        } finally {\n          temporary.remove();\n        }\n      });\n    },\n\n    showActionSuccess: function (button, message) {\n      if (!button) {\n        return;\n      }\n\n      const originalTitle = button.getAttribute(\"title\") || \"\";\n      const originalHtml = button.innerHTML;\n\n      button.classList.add(\"is-success\");\n      button.setAttribute(\"title\", message);\n      button.setAttribute(\"aria-label\", message);\n      button.innerHTML = this.createCheckIcon();\n\n      window.setTimeout(function () {\n        button.classList.remove(\"is-success\");\n        button.setAttribute(\"title\", originalTitle);\n        button.setAttribute(\"aria-label\", originalTitle);\n        button.innerHTML = originalHtml;\n      }, 1400);\n    },\n\n    createCodeCopyButton: function (codeText) {\n      const button = document.createElement(\"button\");\n\n      button.type = \"button\";\n      button.className = \"sca-code-copy-action\";\n      button.setAttribute(\"title\", \"Copy code\");\n      button.setAttribute(\"aria-label\", \"Copy code\");\n      button.innerHTML = this.createCopyIcon();\n\n      button.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller\n          .copyText(String(codeText || \"\"))\n          .then(function () {\n            controller.showActionSuccess(button, \"Code copied\");\n          })\n          .catch(function (error) {\n            scaLog(\"error\", \"SCA-13\", \"code-copy-action-failed\", {\n              message: error.message\n            });\n          });\n      });\n\n      return button;\n    },\n\n    /* =======================================================\n     * SCA-14 — MESSAGE ACTIONS\n     * ======================================================= */\n\n    createMessageActions: function (messageText, messageId, userPrompt) {\n      const actions = document.createElement(\"div\");\n      actions.className = \"sca-message-actions\";\n\n      const copyButton = document.createElement(\"button\");\n\n      copyButton.type = \"button\";\n      copyButton.className = \"sca-message-action sca-copy-action\";\n      copyButton.setAttribute(\"title\", \"Copy response\");\n      copyButton.setAttribute(\"aria-label\", \"Copy response\");\n      copyButton.innerHTML = this.createCopyIcon();\n\n      copyButton.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller\n          .copyText(messageText)\n          .then(function () {\n            controller.showActionSuccess(copyButton, \"Copied\");\n          })\n          .catch(function (error) {\n            scaLog(\"error\", \"SCA-14\", \"message-copy-action-failed\", {\n              message: error.message\n            });\n          });\n      });\n\n      const downloadButton = document.createElement(\"button\");\n\n      downloadButton.type = \"button\";\n      downloadButton.className = \"sca-message-action sca-download-action\";\n      downloadButton.setAttribute(\"title\", \"Download response\");\n      downloadButton.setAttribute(\"aria-label\", \"Download response\");\n      downloadButton.innerHTML = this.createDownloadIcon();\n\n      downloadButton.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller.prepareDownload(\n          messageId,\n          userPrompt,\n          messageText,\n          \"docx\"\n        );\n      });\n\n      actions.appendChild(copyButton);\n      actions.appendChild(downloadButton);\n\n      return actions;\n    },\n\n    /* =======================================================\n     * SCA-14b — PROCEED TO CODE CHIP  (NEW)\n     *\n     * Gated, not hidden. When blocking questions remain the chip\n     * stays clickable but explains the trade-off, so an impatient\n     * user can still generate with TODO placeholders.\n     * ======================================================= */\n\n    createProceedToCodeChip: function (options) {\n      const settings = options || {};\n\n      const wrap = document.createElement(\"div\");\n      wrap.className = \"sca-proceed-wrap\";\n\n      const button = document.createElement(\"button\");\n      button.type = \"button\";\n      button.className = \"sca-proceed-chip\";\n\n      const ready = settings.readyForCode === true;\n\n      button.innerHTML =\n        this.createPlayIcon() + \"<span>Generate the code</span>\";\n\n      const hint = document.createElement(\"span\");\n      hint.className = \"sca-proceed-hint\";\n\n      if (ready) {\n        hint.textContent = \"Every blocking question is answered.\";\n      } else {\n        button.classList.add(\"is-warning\");\n\n        const blockers = Number(settings.blockingQuestions);\n\n        hint.textContent =\n          Number.isFinite(blockers) && blockers > 0\n            ? blockers +\n              \" question\" +\n              (blockers === 1 ? \"\" : \"s\") +\n              \" still open. Answer them for a better result, or generate now with TODO placeholders.\"\n            : \"Generate now, or answer the open questions first for a better result.\";\n      }\n\n      button.addEventListener(\"click\", function (event) {\n        event.preventDefault();\n        event.stopPropagation();\n\n        controller.requestProceedToCode(button);\n      });\n\n      wrap.appendChild(button);\n      wrap.appendChild(hint);\n\n      return wrap;\n    },\n\n    /*\n     * No new form output is required. The chip writes the proceed\n     * prompt into the composer, raises the proceedRequested flag,\n     * then clicks Send — so the request travels the path that is\n     * already wired. VBP-02 reads the flag and switches to\n     * generate mode.\n     */\n    requestProceedToCode: function (button) {\n      if (this.pending || this.proceedInFlight) {\n        scaLog(\"warn\", \"SCA-14b\", \"proceed-already-in-flight\", {});\n        return;\n      }\n\n      const input = this.getInput();\n\n      if (!input) {\n        scaLog(\"error\", \"SCA-14b\", \"input-not-found-for-proceed\", {});\n        return;\n      }\n\n      const flagWritten = this.setFormField(\"proceedRequested\", \"true\");\n\n      if (!flagWritten) {\n        scaLog(\"error\", \"SCA-14b\", \"proceed-flag-field-missing\", {\n          recommendation:\n            \"Add the proceedRequested hidden component to the form.\"\n        });\n\n        return;\n      }\n\n      this.proceedInFlight = true;\n      \n      /*\n       * Lock the entire composer immediately.\n       * Do not wait for the backend processing flag.\n       */\n      this.updateSendAvailability();\n      \n      if (button) {\n        button.disabled = true;\n        button.classList.add(\"is-busy\");\n      }\n\n      this.setNativeValue(input, PROCEED_PROMPT);\n\n      input.dispatchEvent(new Event(\"input\", { bubbles: true }));\n      input.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      this.updatePromptBudget();\n      this.updateSendAvailability();\n\n      const send = this.getSendButton();\n\n      if (!send) {\n        scaLog(\"error\", \"SCA-14b\", \"send-button-not-found-for-proceed\", {});\n        this.proceedInFlight = false;\n        return;\n      }\n\n      window.setTimeout(function () {\n        send.click();\n\n        controller.proceedInFlight = false;\n      }, 80);\n\n      scaLog(\"info\", \"SCA-14b\", \"proceed-to-code-requested\", {});\n    },\n\n    /* =======================================================\n * SCA-15 — MESSAGE-BUBBLE FACTORY\n *\n * Responsibilities:\n * - render normal user/assistant messages;\n * - render exactly ONE loading message;\n * - render structured assistant content;\n * - attach footer/actions only when appropriate.\n * ======================================================= */\n\ncreateBubble: function (role, text, options) {\n  try {\n    const settings =\n      options &&\n      typeof options === \"object\"\n        ? options\n        : {};\n\n    const isLoading =\n      settings.loading === true;\n\n    /* -------------------------------------------------------\n     * SCA-15A — MESSAGE ROW\n     * ------------------------------------------------------- */\n\n    const row =\n      document.createElement(\n        \"div\"\n      );\n\n    row.className =\n      \"sca-message-row \" +\n      role;\n\n    if (isLoading) {\n      row.classList.add(\n        \"is-loading\"\n      );\n\n      row.setAttribute(\n        \"aria-busy\",\n        \"true\"\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15B — AVATAR\n     * ------------------------------------------------------- */\n\n    const avatar =\n      document.createElement(\n        \"div\"\n      );\n\n    avatar.className =\n      \"sca-avatar \" +\n      role;\n\n    avatar.setAttribute(\n      \"aria-label\",\n      role === \"assistant\"\n        ? \"SAP Code Agent\"\n        : \"User\"\n    );\n\n    avatar.innerHTML =\n      role === \"assistant\"\n        ? this.createAssistantIcon()\n        : this.createUserIcon();\n\n\n    /* -------------------------------------------------------\n     * SCA-15C — BUBBLE\n     * ------------------------------------------------------- */\n\n    const bubble =\n      document.createElement(\n        \"div\"\n      );\n\n    bubble.className =\n      \"sca-message-bubble\";\n\n\n    /* -------------------------------------------------------\n     * SCA-15D — LOADING CONTENT\n     *\n     * IMPORTANT:\n     * Loading and normal text are mutually exclusive.\n     *\n     * The previous implementation rendered `text` first and\n     * then appended another loading row containing the same\n     * \"Working on it...\" text.\n     * ------------------------------------------------------- */\n\n    if (isLoading) {\n      const loading =\n        document.createElement(\n          \"div\"\n        );\n\n      loading.className =\n        \"sca-loading-inline\";\n\n      const spinner =\n        document.createElement(\n          \"span\"\n        );\n\n      spinner.className =\n        \"sca-spinner\";\n\n      spinner.setAttribute(\n        \"aria-hidden\",\n        \"true\"\n      );\n\n      const label =\n        document.createElement(\n          \"span\"\n        );\n\n      label.className =\n        \"sca-loading-label\";\n\n      label.textContent =\n        String(\n          settings.loadingLabel ||\n          text ||\n          \"Working on it...\"\n        ).trim() ||\n        \"Working on it...\";\n\n      loading.appendChild(\n        spinner\n      );\n\n      loading.appendChild(\n        label\n      );\n\n      bubble.appendChild(\n        loading\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15E — NORMAL MESSAGE CONTENT\n     *\n     * This branch deliberately does NOT run for loading\n     * messages.\n     * ------------------------------------------------------- */\n\n    else if (\n      text !== undefined &&\n      text !== null &&\n      String(text) !== \"\"\n    ) {\n      const content =\n        document.createElement(\n          \"div\"\n        );\n\n      content.className =\n        \"sca-message-content\";\n\n      if (\n        role === \"assistant\" &&\n        settings.structured !== false\n      ) {\n        this.renderStructuredContent(\n          content,\n          text\n        );\n      } else {\n        content.textContent =\n          String(text);\n      }\n\n      bubble.appendChild(\n        content\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15F — PROCEED CHIP\n     *\n     * Currently disabled by ENABLE_PROCEED_CHIP = false.\n     * Keep the guard so the feature can be re-enabled later\n     * without changing createBubble again.\n     * ------------------------------------------------------- */\n\n    if (\n      !isLoading &&\n      ENABLE_PROCEED_CHIP &&\n      role === \"assistant\" &&\n      settings.showProceed === true\n    ) {\n      bubble.appendChild(\n        this.createProceedToCodeChip({\n          readyForCode:\n            settings.readyForCode === true,\n\n          blockingQuestions:\n            settings.blockingQuestions\n        })\n      );\n    }\n\n\n    /* -------------------------------------------------------\n     * SCA-15G — MESSAGE FOOTER\n     *\n     * For the processing bubble, show only the timestamp.\n     * Do not show copy/download actions.\n     * ------------------------------------------------------- */\n\n    const footer =\n      document.createElement(\n        \"div\"\n      );\n\n    footer.className =\n      \"sca-message-footer\";\n\n    const time =\n      document.createElement(\n        \"span\"\n      );\n\n    time.className =\n      \"sca-message-time\";\n\n    time.textContent =\n      this.formatTime(\n        settings.createdAt\n      );\n\n    footer.appendChild(\n      time\n    );\n\n    if (\n      !isLoading &&\n      role === \"assistant\" &&\n      settings.actions === true\n    ) {\n      footer.appendChild(\n        this.createMessageActions(\n          String(\n            text || \"\"\n          ),\n          settings.messageId,\n          settings.userPrompt ||\n            \"\"\n        )\n      );\n    }\n\n    bubble.appendChild(\n      footer\n    );\n\n\n    /* -------------------------------------------------------\n     * SCA-15H — ROW ORDER\n     * ------------------------------------------------------- */\n\n    if (\n      role === \"user\"\n    ) {\n      row.appendChild(\n        bubble\n      );\n\n      row.appendChild(\n        avatar\n      );\n    } else {\n      row.appendChild(\n        avatar\n      );\n\n      row.appendChild(\n        bubble\n      );\n    }\n\n    return row;\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-15\",\n      \"message-bubble-create-failed\",\n      {\n        role:\n          String(\n            role || \"\"\n          ),\n\n        loading:\n          Boolean(\n            options &&\n            options.loading\n          ),\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    /*\n     * Defensive fallback.\n     * Never allow one malformed bubble to crash the complete\n     * chat renderer.\n     */\n    const fallbackRow =\n      document.createElement(\n        \"div\"\n      );\n\n    fallbackRow.className =\n      \"sca-message-row assistant\";\n\n    const fallbackBubble =\n      document.createElement(\n        \"div\"\n      );\n\n    fallbackBubble.className =\n      \"sca-message-bubble\";\n\n    fallbackBubble.textContent =\n      options &&\n      options.loading\n        ? \"Working on it...\"\n        : String(\n            text || \"\"\n          );\n\n    fallbackRow.appendChild(\n      fallbackBubble\n    );\n\n    return fallbackRow;\n  }\n},\n    /* =======================================================\n     * SCA-16 — FORM FIELD SYNCHRONIZATION\n     * ======================================================= */\n\n    setNativeValue: function (field, newValue) {\n      if (!field) {\n        return;\n      }\n\n      const prototype = Object.getPrototypeOf(field);\n\n      const descriptor = prototype\n        ? Object.getOwnPropertyDescriptor(prototype, \"value\")\n        : null;\n\n      if (descriptor && typeof descriptor.set === \"function\") {\n        descriptor.set.call(field, newValue);\n      } else {\n        field.value = newValue;\n      }\n    },\n\n    setFormField: function (key, value) {\n      const field =\n        this.find('[name=\"data[' + key + ']\"]') ||\n        this.find(\".formio-component-\" + key + \" textarea\") ||\n        this.find(\".formio-component-\" + key + \" input\");\n\n      if (!field) {\n        scaLog(\"error\", \"SCA-16\", \"form-field-not-found\", { fieldKey: key });\n        return false;\n      }\n\n      this.setNativeValue(\n        field,\n        String(value === undefined || value === null ? \"\" : value)\n      );\n\n      field.dispatchEvent(new Event(\"input\", { bubbles: true }));\n      field.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      return true;\n    },\n\n    /* =======================================================\n     * SCA-17 — RESPONSE DOWNLOAD PREPARATION\n     * ======================================================= */\n\n    prepareDownload: function (\n      messageId,\n      userPrompt,\n      messageContent,\n      format\n    ) {\n      const selectedFormat = format || \"docx\";\n\n      const fieldsUpdated = [\n        this.setFormField(\"selectedMessageId\", messageId),\n        this.setFormField(\"selectedUserPrompt\", userPrompt),\n        this.setFormField(\"selectedMessageContent\", messageContent),\n        this.setFormField(\"selectedDownloadFormat\", selectedFormat)\n      ];\n\n      if (\n        fieldsUpdated.some(function (result) {\n          return result === false;\n        })\n      ) {\n        scaLog(\"error\", \"SCA-17\", \"download-fields-incomplete\", {\n          messageId: messageId\n        });\n\n        return;\n      }\n\n      window.setTimeout(function () {\n        const button = controller.getDownloadButton();\n\n        if (!button) {\n          scaLog(\"error\", \"SCA-17\", \"download-button-not-rendered\", {\n            recommendation:\n              \"Ensure the Download Response Form button is not hidden.\"\n          });\n\n          return;\n        }\n\n        if (button.disabled) {\n          button.disabled = false;\n        }\n\n        button.click();\n      }, 150);\n    },\n\n    /* =======================================================\n     * SCA-18 — INPUT CLEARING\n     * ======================================================= */\n\n    clearInputVisualOnly: function () {\n      const input = this.getInput();\n\n      if (!input) {\n        scaLog(\"warn\", \"SCA-18\", \"input-not-found-for-visual-clear\", {});\n        return;\n      }\n\n      this.setNativeValue(input, \"\");\n\n      this.updatePromptBudget();\n    },\n\n    clearInput: function () {\n      const input = this.getInput();\n\n      if (!input) {\n        scaLog(\"warn\", \"SCA-18\", \"input-not-found-for-clear\", {});\n        return;\n      }\n\n      this.setNativeValue(input, \"\");\n\n      input.dispatchEvent(new Event(\"input\", { bubbles: true }));\n      input.dispatchEvent(new Event(\"change\", { bubbles: true }));\n\n      input.classList.remove(\"is-invalid\");\n      input.removeAttribute(\"aria-invalid\");\n\n      const wrapper = input.closest(\".formio-component-userMessage\");\n\n      if (wrapper) {\n        wrapper.classList.remove(\n          \"has-error\",\n          \"has-danger\",\n          \"formio-error-wrapper\"\n        );\n\n        wrapper\n          .querySelectorAll(\".help-block, .invalid-feedback, .formio-errors\")\n          .forEach(function (element) {\n            element.style.display = \"none\";\n          });\n      }\n\n      this.updatePromptBudget();\n    },\n\n    /* =======================================================\n * SCA-19 — COMPOSER AVAILABILITY\n *\n * Purpose:\n * 1. Disable Send when input is empty.\n * 2. Disable Send while a request is processing.\n * 3. Disable the message textarea while processing.\n * 4. Block oversized prompts on the client side.\n * 5. Restore the composer automatically after completion/error.\n * ======================================================= */\n\nupdateSendAvailability: function () {\n  try {\n    const button =\n      this.getSendButton();\n\n    const input =\n      this.getInput();\n\n    const current =\n      this.getCurrentState();\n\n    const stateData =\n      current.data || {};\n\n    const question =\n      String(\n        input &&\n        typeof input.value === \"string\"\n          ? input.value\n          : \"\"\n      ).trim();\n\n    const backendProcessing =\n      stateData.processing === true ||\n      stateData.processing === \"true\";\n\n    /*\n     * Local pending state becomes true immediately after Send,\n     * before the backend has had time to refresh Form.io state.\n     *\n     * This prevents the textarea from remaining editable during\n     * that short transition window.\n     */\n    const processing =\n      this.pending ||\n      this.proceedInFlight ||\n      backendProcessing;\n\n    const overCharacterLimit =\n      question.length >\n      MAX_USER_CHARACTERS;\n\n    /* -------------------------------------------------------\n     * Disable/enable message composer\n     * ------------------------------------------------------- */\n\n    if (input) {\n      input.disabled =\n        processing;\n\n      input.readOnly =\n        processing;\n\n      input.setAttribute(\n        \"aria-disabled\",\n        processing\n          ? \"true\"\n          : \"false\"\n      );\n\n      input.setAttribute(\n        \"aria-busy\",\n        processing\n          ? \"true\"\n          : \"false\"\n      );\n\n      input.classList.toggle(\n        \"sca-input-disabled\",\n        processing\n      );\n\n      /*\n       * The explicit attribute gives CSS a stable selector even\n       * if Form.io changes some generated classes.\n       */\n      if (processing) {\n        input.setAttribute(\n          \"data-sca-processing\",\n          \"true\"\n        );\n      } else {\n        input.removeAttribute(\n          \"data-sca-processing\"\n        );\n      }\n    }\n\n    /* -------------------------------------------------------\n     * Disable/enable Send button\n     * ------------------------------------------------------- */\n\n    if (button) {\n      const disabled =\n        !question ||\n        processing ||\n        overCharacterLimit;\n\n      button.disabled =\n        disabled;\n\n      button.setAttribute(\n        \"aria-disabled\",\n        disabled\n          ? \"true\"\n          : \"false\"\n      );\n\n      button.setAttribute(\n        \"aria-busy\",\n        processing\n          ? \"true\"\n          : \"false\"\n      );\n\n      button.classList.toggle(\n        \"sca-is-loading\",\n        processing\n      );\n\n      button.classList.toggle(\n        \"sca-is-over-limit\",\n        overCharacterLimit\n      );\n    } else {\n      scaLog(\n        \"warn\",\n        \"SCA-19\",\n        \"send-button-not-found\",\n        {}\n      );\n    }\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-19\",\n      \"composer-availability-update-failed\",\n      {\n        name:\n          error &&\n          error.name\n            ? error.name\n            : \"Error\",\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n  }\n},\n\n    /* =======================================================\n     * SCA-20 — CHAT SCROLLING\n     * ======================================================= */\n\n    scrollToBottom: function () {\n      const surface = this.getSurface();\n\n      if (!surface) {\n        scaLog(\"warn\", \"SCA-20\", \"chat-surface-not-found\", {});\n        return;\n      }\n\n      window.requestAnimationFrame(function () {\n        window.requestAnimationFrame(function () {\n          surface.scrollTop = surface.scrollHeight;\n        });\n      });\n\n      window.setTimeout(function () {\n        surface.scrollTop = surface.scrollHeight;\n      }, 150);\n    },\n\n    /* =======================================================\n * SCA-21 — CHAT RENDERING\n *\n * Stabilization version:\n *\n * - renders greeting;\n * - renders persisted user/assistant history;\n * - renders optimistic current user turn;\n * - renders Working on it...;\n * - does NOT render Proceed/Generate actions;\n * - does NOT infer workflow state from response text;\n * - backend currentStage/agentPhase is the only stepper source.\n * ======================================================= */\n\nrender: function (\n  force\n) {\n  try {\n    const log =\n      this.getChatLog();\n\n    if (!log) {\n      scaLog(\n        \"warn\",\n        \"SCA-21\",\n        \"chat-log-not-found\",\n        {\n          selector:\n            SELECTORS.chatLog\n        }\n      );\n\n      return;\n    }\n    const logElementChanged =\n      log !== this.lastChatLogElement;\n\n    this.lastChatLogElement =\n      log;\n\n    if (logElementChanged) {\n      force = true;\n      this.lastRenderedState = \"\";\n    }\n\n    const current =\n      this.getCurrentState();\n\n    const stateData =\n      current &&\n      current.data &&\n      typeof current.data === \"object\"\n        ? current.data\n        : {};\n\n    const history =\n      current &&\n      Array.isArray(\n        current.history\n      )\n        ? current.history\n        : [];\n\n    const lastMessage =\n      history.length > 0\n        ? history[\n            history.length - 1\n          ]\n        : null;\n\n    const backendProcessing =\n      stateData.processing === true ||\n      stateData.processing === \"true\";\n\n    const workflowStage =\n      stateData.currentStage ||\n      stateData.agentPhase ||\n      \"understand\";\n\n    /*\n     * Backend workflow state is the ONLY source\n     * of truth for progress.\n     */\n    this.updateStepper(\n      workflowStage\n    );\n\n    /* -------------------------------------------------------\n     * Detect whether the current pending request has completed.\n     * ------------------------------------------------------- */\n\n    const sliceStart =\n      Math.min(\n        Number(\n          this.pendingHistoryLength ||\n          0\n        ),\n        history.length\n      );\n\n    const messagesAfterSubmission =\n      history.slice(\n        sliceStart\n      );\n\n    const assistantAddedAfterSubmission =\n      messagesAfterSubmission.some(\n        function (message) {\n          return (\n            message &&\n            message.role ===\n              \"assistant\" &&\n            typeof message.content ===\n              \"string\" &&\n            message.content.trim() !==\n              \"\"\n          );\n        }\n      );\n\n    const pendingAnswerArrived =\n      Boolean(\n        this.pending &&\n        !backendProcessing &&\n        assistantAddedAfterSubmission &&\n        lastMessage &&\n        lastMessage.role ===\n          \"assistant\"\n      );\n\n    if (\n      pendingAnswerArrived\n    ) {\n      this.pending =\n        false;\n\n      this.pendingQuestion =\n        \"\";\n\n      this.pendingHistoryLength =\n        history.length;\n\n      if (\n        Object.prototype\n          .hasOwnProperty\n          .call(\n            this,\n            \"pendingStartedAt\"\n          )\n      ) {\n        this.pendingStartedAt =\n          \"\";\n      }\n    }\n\n    const shouldShowPending =\n      Boolean(\n        this.pending &&\n        !pendingAnswerArrived\n      );\n\n    /* -------------------------------------------------------\n     * Render signature.\n     *\n     * Include renderEpoch when this controller version has it.\n     * ------------------------------------------------------- */\n\n    const renderState =\n      JSON.stringify({\n        epoch:\n          Number(\n            this.renderEpoch ||\n            0\n          ),\n\n        history:\n          history,\n\n        pending:\n          shouldShowPending,\n\n        pendingQuestion:\n          String(\n            this.pendingQuestion ||\n            \"\"\n          ),\n\n        pendingHistoryLength:\n          Number(\n            this.pendingHistoryLength ||\n            0\n          ),\n\n        processing:\n          backendProcessing,\n\n        stage:\n          workflowStage\n      });\n\n    if (\n      !force &&\n      renderState ===\n        this.lastRenderedState\n    ) {\n      this.updateSendAvailability();\n\n      return;\n    }\n\n    this.lastRenderedState =\n      renderState;\n\n    /*\n     * The Form may have remounted a fresh #sca-chat-log.\n     * Rebuild its complete visible contents.\n     */\n    log.innerHTML =\n      \"\";\n\n    /* -------------------------------------------------------\n     * Greeting\n     * ------------------------------------------------------- */\n\n    log.appendChild(\n      this.createBubble(\n        \"assistant\",\n        GREETING,\n        {\n          actions:\n            false,\n\n          structured:\n            false\n        }\n      )\n    );\n\n    /* -------------------------------------------------------\n     * Persisted chat history\n     * ------------------------------------------------------- */\n\n    let latestUserPrompt =\n      \"\";\n\n    history.forEach(\n      function (\n        message,\n        index\n      ) {\n        if (\n          !message ||\n          typeof message.content !==\n            \"string\" ||\n          !message.content.trim()\n        ) {\n          return;\n        }\n\n        if (\n          message.role ===\n            \"user\"\n        ) {\n          latestUserPrompt =\n            message.content;\n\n          log.appendChild(\n            controller.createBubble(\n              \"user\",\n              message.content,\n              {\n                createdAt:\n                  message.createdAt,\n\n                structured:\n                  false\n              }\n            )\n          );\n\n          return;\n        }\n\n        if (\n          message.role !==\n            \"assistant\"\n        ) {\n          return;\n        }\n\n        const messageId =\n          String(\n            message.id ||\n            message.createdAt ||\n            (\n              \"assistant-\" +\n              index\n            )\n          );\n\n        /*\n         * IMPORTANT:\n         *\n         * No Proceed / Generate button is inserted here.\n         * Workflow controls are intentionally disabled while\n         * state handling is being stabilized.\n         */\n        log.appendChild(\n          controller.createBubble(\n            \"assistant\",\n            message.content,\n            {\n              createdAt:\n                message.createdAt,\n\n              actions:\n                true,\n\n              structured:\n                true,\n\n              messageId:\n                messageId,\n\n              userPrompt:\n                latestUserPrompt\n            }\n          )\n        );\n      }\n    );\n\n    /* -------------------------------------------------------\n     * Optimistic current user message\n     *\n     * Only inspect messages belonging to THIS request.\n     * Identical prompts from old turns must not suppress it.\n     * ------------------------------------------------------- */\n\n    if (\n      shouldShowPending\n    ) {\n      const messagesAddedForCurrentRequest =\n        history.slice(\n          Number(\n            this.pendingHistoryLength ||\n            0\n          )\n        );\n\n      const pendingUserExists =\n        messagesAddedForCurrentRequest.some(\n          function (message) {\n            return (\n              message &&\n              message.role ===\n                \"user\" &&\n              String(\n                message.content ||\n                \"\"\n              ) ===\n                String(\n                  controller\n                    .pendingQuestion ||\n                    \"\"\n                )\n            );\n          }\n        );\n\n      if (\n        this.pendingQuestion &&\n        !pendingUserExists\n      ) {\n        log.appendChild(\n          this.createBubble(\n            \"user\",\n            this.pendingQuestion,\n            {\n              structured:\n                false\n            }\n          )\n        );\n      }\n\n      /* -----------------------------------------------------\n       * Processing bubble\n       * ----------------------------------------------------- */\n\n      const processingText =\n        String(\n          stateData.processingMessage ||\n          \"Working on it...\"\n        ).trim() ||\n        \"Working on it...\";\n\n      log.appendChild(\n        this.createBubble(\n          \"assistant\",\n          processingText,\n          {\n            actions:\n              false,\n\n            structured:\n              false,\n\n            loading:\n              true\n          }\n        )\n      );\n    }\n\n    /* -------------------------------------------------------\n     * Composer state + scrolling\n     * ------------------------------------------------------- */\n\n    this.updateSendAvailability();\n\n    this.scrollToBottom();\n\n    scaLog(\n      \"info\",\n      \"SCA-21\",\n      \"chat-render-complete\",\n      {\n        historyMessages:\n          history.length,\n\n        pending:\n          shouldShowPending,\n\n        processing:\n          backendProcessing,\n\n        stage:\n          workflowStage,\n\n        workflowActionsRendered:\n          false\n      }\n    );\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-21\",\n      \"chat-render-failed\",\n      {\n        name:\n          error &&\n          error.name\n            ? error.name\n            : \"Error\",\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    /*\n     * Never allow a render exception to leave the composer\n     * permanently disabled.\n     */\n    try {\n      this.updateSendAvailability();\n    } catch (\n      availabilityError\n    ) {\n      /* no-op */\n    }\n  }\n},\n\n    /* =======================================================\n * SCA-22 — OPTIMISTIC SUBMISSION\n *\n * Responsibilities:\n * - reject empty submissions;\n * - reject duplicate/programmatic submissions;\n * - capture current history length;\n * - create optimistic user/loading state;\n * - lock composer immediately.\n * ======================================================= */\n\nbeginSubmit: function () {\n  try {\n    const current =\n      this.getCurrentState();\n\n    const stateData =\n      current &&\n      current.data &&\n      typeof current.data === \"object\"\n        ? current.data\n        : {};\n\n    const backendProcessing =\n      stateData.processing === true ||\n      stateData.processing === \"true\";\n\n    /* -------------------------------------------------------\n     * SCA-22A — BLOCK DUPLICATE REQUESTS\n     * ------------------------------------------------------- */\n\n    if (\n      this.pending ||\n      this.proceedInFlight ||\n      backendProcessing\n    ) {\n      scaLog(\n        \"warn\",\n        \"SCA-22\",\n        \"duplicate-submit-blocked\",\n        {\n          pending:\n            this.pending,\n\n          proceedInFlight:\n            this.proceedInFlight,\n\n          backendProcessing:\n            backendProcessing\n        }\n      );\n\n      return false;\n    }\n\n    /* -------------------------------------------------------\n     * SCA-22B — READ INPUT\n     * ------------------------------------------------------- */\n\n    const input =\n      this.getInput();\n\n    if (!input) {\n      scaLog(\n        \"error\",\n        \"SCA-22\",\n        \"message-input-not-found\",\n        {}\n      );\n\n      return false;\n    }\n\n    const question =\n      String(\n        input.value || \"\"\n      ).trim();\n\n    if (!question) {\n      this.updateSendAvailability();\n\n      scaLog(\n        \"info\",\n        \"SCA-22\",\n        \"empty-submit-blocked\",\n        {}\n      );\n\n      return false;\n    }\n\n    /* -------------------------------------------------------\n     * SCA-22C — CLIENT-SIDE SIZE GUARD\n     * ------------------------------------------------------- */\n\n    if (\n      question.length >\n      MAX_USER_CHARACTERS\n    ) {\n      this.updateSendAvailability();\n\n      scaLog(\n        \"warn\",\n        \"SCA-22\",\n        \"oversized-submit-blocked\",\n        {\n          characters:\n            question.length,\n\n          limit:\n            MAX_USER_CHARACTERS\n        }\n      );\n\n      return false;\n    }\n\n    /* -------------------------------------------------------\n     * SCA-22D — CAPTURE PRE-SUBMISSION HISTORY\n     * ------------------------------------------------------- */\n\n    this.pendingHistoryLength =\n      Array.isArray(\n        current.history\n      )\n        ? current.history.length\n        : 0;\n\n    this.pending =\n      true;\n\n    this.pendingQuestion =\n      question;\n\n    this.renderEpoch =\n      Number(\n        this.renderEpoch || 0\n      ) + 1;\n\n    /* -------------------------------------------------------\n     * SCA-22E — OPTIMISTIC UI\n     * ------------------------------------------------------- */\n\n    this.render(\n      true\n    );\n\n    /*\n     * Clear visual composer after the optimistic user bubble\n     * has already captured the question.\n     */\n    window.setTimeout(\n      function () {\n        controller.clearInputVisualOnly();\n\n        controller.updateSendAvailability();\n      },\n      0\n    );\n\n    scaLog(\n      \"info\",\n      \"SCA-22\",\n      \"optimistic-submit-started\",\n      {\n        questionCharacters:\n          question.length,\n\n        existingHistoryMessages:\n          this.pendingHistoryLength,\n\n        epoch:\n          this.renderEpoch\n      }\n    );\n\n    return true;\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-22\",\n      \"optimistic-submit-failed\",\n      {\n        name:\n          error &&\n          error.name\n            ? error.name\n            : \"Error\",\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    this.pending =\n      false;\n\n    this.pendingQuestion =\n      \"\";\n\n    this.updateSendAvailability();\n\n    return false;\n  }\n},\n    /* =======================================================\n     * SCA-23 — NEW CHAT RESET\n     * ======================================================= */\n\n    resetConversationView: function () {\n      this.pending = false;\n      this.pendingQuestion = \"\";\n      this.pendingHistoryLength = 0;\n      this.proceedInFlight = false;\n      this.lastRenderedState = \"\";\n      this.renderEpoch = this.renderEpoch + 1;\n\n      this.latestFormData = {\n        messagesJson: \"[]\",\n        transcript: \"\",\n        currentStage: \"understand\",\n        agentPhase: \"understand\",\n        readyForCode: \"false\",\n        hasGeneratedCode: \"false\",\n        validationPassed: \"false\",\n        confirmedRequirements: \"[]\",\n        proceedRequested: \"false\",\n        agentConfidence: \"\",\n        blockingQuestions: \"\",\n        uiError: \"\",\n        processing: false,\n        processingMessage: \"\",\n        conversationId: \"\",\n        userMessage: \"\",\n        composer: { userMessage: \"\" }\n      };\n\n      this.updateStepper(\"understand\");\n      this.clearInput();\n      this.updateSendAvailability();\n      this.updatePromptBudget();\n      this.render(true);\n\n      scaLog(\"info\", \"SCA-23\", \"conversation-reset\", {});\n    },\n\n    /* =======================================================\n     * SCA-24 — CLICK EVENT HANDLING\n     * ======================================================= */\n\n    handleClick: function (event) {\n      const target = event.target instanceof Element ? event.target : null;\n\n      if (!target) {\n        return;\n      }\n\n      const actionButton = target.closest(\n        \".sca-message-action, .sca-code-copy-action, .sca-proceed-chip\"\n      );\n\n      if (actionButton) {\n        return;\n      }\n\n      const newChatButton = target.closest(SELECTORS.newChatButton);\n\n      if (newChatButton) {\n        this.resetConversationView();\n        return;\n      }\n\n      const sendButton = target.closest(SELECTORS.sendButton);\n\n      if (!sendButton) {\n        return;\n      }\n\n      const allowed = this.beginSubmit();\n\n      if (!allowed) {\n        event.preventDefault();\n        event.stopPropagation();\n        event.stopImmediatePropagation();\n      }\n    },\n\n    /* =======================================================\n     * SCA-25 — KEYBOARD SUBMISSION\n     * ======================================================= */\n\n    handleKeydown: function (event) {\n      const target = event.target instanceof Element ? event.target : null;\n\n      if (!target) {\n        return;\n      }\n\n      const input = target.closest(SELECTORS.messageInput);\n\n      if (!input) {\n        return;\n      }\n\n      if (event.key !== \"Enter\" || event.shiftKey || event.isComposing) {\n        return;\n      }\n\n      const question = String(input.value || \"\").trim();\n\n      if (!question || this.pending) {\n        event.preventDefault();\n        return;\n      }\n\n      const button = this.getSendButton();\n\n      if (!button) {\n        scaLog(\"error\", \"SCA-25\", \"send-button-not-found-for-enter\", {});\n        return;\n      }\n\n      event.preventDefault();\n      event.stopPropagation();\n      event.stopImmediatePropagation();\n\n      button.click();\n    },\n\n    /* =======================================================\n     * SCA-26 — INPUT CHANGE HANDLING\n     * ======================================================= */\n\n    handleInput: function (event) {\n      const target = event.target instanceof Element ? event.target : null;\n\n      if (!target) {\n        return;\n      }\n\n      const input = target.closest(SELECTORS.messageInput);\n\n      if (!input) {\n        return;\n      }\n\n      this.updateSendAvailability();\n      this.updatePromptBudget();\n    },\n\n    /* =======================================================\n * SCA-27 — FORM DATA ACCEPTANCE\n *\n * Prevent a temporary empty Form.io remount payload from\n * destroying an already valid chat history.\n * ======================================================= */\n\nacceptFormData: function (incomingData) {\n  try {\n    if (\n      !incomingData ||\n      typeof incomingData !== \"object\"\n    ) {\n      scaLog(\n        \"warn\",\n        \"SCA-27\",\n        \"incoming-form-data-invalid\",\n        {\n          receivedType:\n            typeof incomingData\n        }\n      );\n\n      this.render(false);\n      return;\n    }\n\n    const previous =\n      this.latestFormData &&\n      typeof this.latestFormData === \"object\"\n        ? this.latestFormData\n        : {};\n\n    const next =\n      Object.assign(\n        {},\n        previous,\n        incomingData\n      );\n\n    const previousHistory =\n      this.parseHistory(\n        previous.messagesJson\n      );\n\n    const incomingHistory =\n      this.parseHistory(\n        incomingData.messagesJson\n      );\n\n    const incomingHasMessagesField =\n      Object.prototype\n        .hasOwnProperty\n        .call(\n          incomingData,\n          \"messagesJson\"\n        );\n\n    /*\n     * A Form remount often emits an empty initial submission.\n     *\n     * Never let that transient empty value erase a populated\n     * conversation already held by the controller.\n     *\n     * New Chat is handled explicitly by resetConversationView(),\n     * so preserving the old history here is safe.\n     */\n    if (\n      incomingHasMessagesField &&\n      previousHistory.length > 0 &&\n      incomingHistory.length === 0 &&\n      !this.pending\n    ) {\n      next.messagesJson =\n        previous.messagesJson;\n\n      if (\n        previous.transcript\n      ) {\n        next.transcript =\n          previous.transcript;\n      }\n\n      scaLog(\n        \"info\",\n        \"SCA-27\",\n        \"transient-empty-history-ignored\",\n        {\n          previousMessages:\n            previousHistory.length\n        }\n      );\n    }\n\n    this.latestFormData =\n      next;\n\n    const effectiveHistory =\n      this.parseHistory(\n        this.latestFormData\n          .messagesJson\n      );\n\n    /*\n     * Keep stepper driven by actual backend state.\n     */\n    this.updateStepper(\n      this.latestFormData.currentStage ||\n      this.latestFormData.agentPhase ||\n      \"understand\"\n    );\n\n    /*\n     * Force a redraw after the Form DOM is remounted.\n     * Otherwise lastRenderedState may match the previous page\n     * even though #sca-chat-log is a brand-new DOM element.\n     */\n \n\n    this.render(false);\n\n    scaLog(\n      \"info\",\n      \"SCA-27\",\n      \"form-data-accepted\",\n      {\n        historyMessages:\n          effectiveHistory.length,\n\n        stage:\n          this.latestFormData.currentStage ||\n          this.latestFormData.agentPhase ||\n          \"understand\"\n      }\n    );\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-27\",\n      \"form-data-acceptance-failed\",\n      {\n        name:\n          error &&\n          error.name,\n\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n\n    /*\n     * Do not blank the visible chat because of a remount error.\n     */\n    this.render(false);\n  }\n},\n\n   /* =======================================================\n * SCA-28 — PERIODIC FORM SYNCHRONIZATION\n *\n * Do not allow an empty remount snapshot to erase history.\n * ======================================================= */\n\nsync: function () {\n  if (\n    this.destroyed\n  ) {\n    return;\n  }\n\n  try {\n    const form =\n      this.getFormInstance();\n\n    if (\n      !form ||\n      !form.submission ||\n      !form.submission.data ||\n      typeof form.submission.data !== \"object\"\n    ) {\n      this.render(false);\n      return;\n    }\n\n    const incoming =\n      form.submission.data;\n\n    const current =\n      this.latestFormData &&\n      typeof this.latestFormData === \"object\"\n        ? this.latestFormData\n        : {};\n\n    const currentHistory =\n      this.parseHistory(\n        current.messagesJson\n      );\n\n    const incomingHistory =\n      this.parseHistory(\n        incoming.messagesJson\n      );\n\n    const merged =\n      Object.assign(\n        {},\n        current,\n        incoming\n      );\n\n    if (\n      currentHistory.length > 0 &&\n      incomingHistory.length === 0 &&\n      !this.pending\n    ) {\n      merged.messagesJson =\n        current.messagesJson;\n\n      if (\n        current.transcript\n      ) {\n        merged.transcript =\n          current.transcript;\n      }\n    }\n\n    this.latestFormData =\n      merged;\n\n    this.updateStepper(\n      merged.currentStage ||\n      merged.agentPhase ||\n      \"understand\"\n    );\n\n    this.render(false);\n  } catch (error) {\n    scaLog(\n      \"error\",\n      \"SCA-28\",\n      \"form-synchronization-failed\",\n      {\n        message:\n          error &&\n          error.message\n            ? error.message\n            : String(error)\n      }\n    );\n  }\n},\n\n    /* =======================================================\n     * SCA-29 — CONTROLLER CLEANUP\n     * ======================================================= */\n\n    destroy: function () {\n      if (this.destroyed) {\n        return;\n      }\n\n      this.destroyed = true;\n\n      document.removeEventListener(\"click\", this.handleClick, true);\n      document.removeEventListener(\"keydown\", this.handleKeydown, true);\n      document.removeEventListener(\"input\", this.handleInput, true);\n      document.removeEventListener(\"change\", this.handleInput, true);\n\n      if (this.observer) {\n        this.observer.disconnect();\n        this.observer = null;\n      }\n\n      if (this.timer) {\n        window.clearInterval(this.timer);\n        this.timer = null;\n      }\n\n      scaLog(\"info\", \"SCA-29\", \"controller-destroyed\", {});\n    }\n  };\n\n  /* =========================================================\n   * SCA-30 — METHOD BINDING\n   * ========================================================= */\n\n  controller.handleClick = controller.handleClick.bind(controller);\n  controller.handleKeydown = controller.handleKeydown.bind(controller);\n  controller.handleInput = controller.handleInput.bind(controller);\n\n  /* =========================================================\n   * SCA-31 — DOM EVENT REGISTRATION\n   * ========================================================= */\n\n  document.addEventListener(\"click\", controller.handleClick, true);\n  document.addEventListener(\"keydown\", controller.handleKeydown, true);\n  document.addEventListener(\"input\", controller.handleInput, true);\n  document.addEventListener(\"change\", controller.handleInput, true);\n\n  /* =========================================================\n   * SCA-32 — MUTATION OBSERVER\n   * ========================================================= */\n\n  try {\n    controller.observer = new MutationObserver(function () {\n      controller.sync();\n    });\n\n    controller.observer.observe(document.body, {\n      childList: true,\n      subtree: true,\n      characterData: true\n    });\n  } catch (error) {\n    scaLog(\"error\", \"SCA-32\", \"mutation-observer-start-failed\", {\n      message: error.message\n    });\n  }\n\n  /* =========================================================\n   * SCA-33 — PERIODIC SYNCHRONIZATION TIMER\n   * ========================================================= */\n\n  controller.timer = window.setInterval(function () {\n    controller.sync();\n  }, SYNC_INTERVAL_MS);\n\n  /* =========================================================\n   * SCA-34 — GLOBAL CONTROLLER REGISTRATION\n   * ========================================================= */\n\n  window.__sapCodeAgentController = controller;\n\n  /* =========================================================\n   * SCA-35 — INITIAL STATE APPLICATION\n   * ========================================================= */\n\n  controller.acceptFormData(reactiveData);\n\n  controller.updateStepper(\n    reactiveData.currentStage || reactiveData.agentPhase || \"understand\"\n  );\n\n  controller.render(true);\n  controller.updateSendAvailability();\n  controller.updatePromptBudget();\n\n  scaLog(\"info\", \"SCA-35\", \"controller-initialized\", {\n    version: CONTROLLER_VERSION,\n    proceedChipEnabled: ENABLE_PROCEED_CHIP,\n    initialStage: controller.normalizeStage(\n      reactiveData.currentStage || reactiveData.agentPhase || \"understand\"\n    ),\n    historyMessages: controller.parseHistory(reactiveData.messagesJson).length\n  });\n\n  return typeof value !== \"undefined\" ? value : null;\n})();"},"jsProperties":{"first":false},"persistent":false,"hideLabel":false,"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"customConditional":"","id":"eu3ukcl"}]},"associatedEntityMetamodel":null,"associatedEntityFormType":null,"associatedContractModelMetamodel":null,"associatedPersistantFormId":null,"associatedLocalStorageDatabaseId":null,"buttons":[{"label":"New Chat","action":"submit","showValidations":false,"theme":"secondary","size":"md","block":false,"leftIcon":"fa fa-plus","rightIcon":"","shortcut":"","description":"","tooltip":"","customClass":"sca-new-chat","tabindex":"","disableOnInvalid":false,"hidden":false,"autofocus":false,"disabled":false,"tableView":false,"modalEdit":false,"key":"newChat","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"button","input":true,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","errorLabel":"","hideLabel":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"dataGridLabel":true,"id":"ezp7i6j"},{"label":"Send","showValidations":false,"rightIcon":"fa fa-paper-plane","customClass":"sca-send","tableView":false,"key":"sendMessage","type":"button","input":true,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"attributes":{},"validateOn":"change","conditional":{"show":null,"when":null,"eq":""},"overlay":{"style":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"properties":{},"allowMultipleMasks":false,"size":"md","leftIcon":"","block":false,"action":"submit","disableOnInvalid":false,"theme":"primary","dataGridLabel":true,"id":"et0muwu"},{"label":"Download Response","action":"submit","showValidations":false,"theme":"primary","size":"md","block":false,"leftIcon":"","rightIcon":"","shortcut":"","description":"","tooltip":"","customClass":"sca-download-submit","tabindex":"","disableOnInvalid":false,"hidden":false,"autofocus":false,"disabled":false,"tableView":false,"modalEdit":false,"key":"submit","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"type":"button","input":true,"validate":{"unique":false,"multiple":false,"required":false,"custom":"","customPrivate":false,"strictDateValidation":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","errorLabel":"","hideLabel":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":{"type":"input"},"validateOn":"change","allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"dataGridLabel":true,"id":"exbf7uo"}],"outputs":4,"x":180,"y":360,"wires":[["ccee2b866e924cdc","75a22bc1726728e2"],["50e68ff760a65abe","24a3f916d03c4aa6"],["0260a755a483fd25","f45dfbb32ca365bf"],["88e1d3490dc5555e"]]},{"id":"1a97d1f518d88501","type":"comment","z":"cab2b2152508727e","name":"SETUP","info":"1) Import the JSON.\n2) Open the Enabler LLM node on the Backend tab and select your authorized Project ID and model.\n3) Deploy Full.\n4) Open the SAP Code Agent application node.\n5) For local PoC, authNone is enabled. Switch the Application node to your existing OKTA Auto-Assistant Config after the chat works.","x":140,"y":160,"wires":[]},{"id":"ccee2b866e924cdc","type":"debug","z":"cab2b2152508727e","name":"debug 1","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":360,"y":280,"wires":[]},{"id":"50e68ff760a65abe","type":"debug","z":"cab2b2152508727e","name":"debug 2","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":360,"y":360,"wires":[]},{"id":"88e1d3490dc5555e","type":"debug","z":"cab2b2152508727e","name":"debug 3","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":360,"y":440,"wires":[]},{"id":"24a3f916d03c4aa6","type":"link out","z":"cab2b2152508727e","name":"SAP Chat Request","mode":"link","links":["fa06c3f2e91da071"],"x":360,"y":540,"wires":[]},{"id":"75a22bc1726728e2","type":"link out","z":"cab2b2152508727e","name":"SAP New Chat","mode":"link","links":["c371eacfad14ab9d"],"x":360,"y":220,"wires":[]},{"id":"0260a755a483fd25","type":"debug","z":"cab2b2152508727e","name":"Debug Download Request","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":360,"y":100,"wires":[]},{"id":"f45dfbb32ca365bf","type":"function","z":"cab2b2152508727e","name":"Build Response DOCX","func":"/*\n * Build Response DOCX\n *\n * Creates a properly formatted Word document containing:\n * - SAP Code Agent title\n * - generation timestamp\n * - associated user prompt\n * - selected assistant response\n * - headings, lists, paragraphs and fenced code blocks\n *\n * Input may exist under:\n * - msg.data\n * - msg.submission\n * - msg.submission.data\n *\n * Output:\n * - msg.payload: DOCX as base64\n * - msg.downloadFileSubmission\n */\n\n/*\n * Dependency:\n * Install the \"pizzip\" package if it is not already available.\n */\nlet PizZip;\n\ntry {\n  PizZip =\n    global.get(\"PizZip\") ||\n    require(\"pizzip\");\n} catch (error) {\n  node.error(\n    \"Build Response DOCX requires the 'pizzip' library. \" +\n    \"Install pizzip and deploy again. Details: \" +\n    error.message,\n    msg\n  );\n\n  return null;\n}\n\n/* ---------------------------------------------------------\n * Input helpers\n * --------------------------------------------------------- */\n\nfunction getObject(value) {\n  return value &&\n    typeof value === \"object\"\n      ? value\n      : {};\n}\n\nconst topData =\n  getObject(msg.data);\n\nconst submission =\n  getObject(msg.submission);\n\nconst nestedSubmissionData =\n  getObject(submission.data);\n\nfunction pickValue(key) {\n  const candidates = [\n    topData[key],\n    nestedSubmissionData[key],\n    submission[key],\n    msg[key]\n  ];\n\n  for (\n    let index = 0;\n    index < candidates.length;\n    index += 1\n  ) {\n    const value =\n      candidates[index];\n\n    if (\n      value !== undefined &&\n      value !== null &&\n      String(value).trim() !== \"\"\n    ) {\n      return value;\n    }\n  }\n\n  return \"\";\n}\n\n/* ---------------------------------------------------------\n * Read selected content\n * --------------------------------------------------------- */\n\nconst selectedContent =\n  String(\n    pickValue(\n      \"selectedMessageContent\"\n    ) || \"\"\n  ).trim();\n\nif (!selectedContent) {\n  node.error(\n    \"No assistant response was selected for download.\",\n    msg\n  );\n\n  return null;\n}\n\nlet selectedUserPrompt =\n  String(\n    pickValue(\n      \"selectedUserPrompt\"\n    ) || \"\"\n  ).trim();\n\nconst selectedMessageId =\n  String(\n    pickValue(\n      \"selectedMessageId\"\n    ) || \"\"\n  ).trim();\n\nconst selectedFormat =\n  String(\n    pickValue(\n      \"selectedDownloadFormat\"\n    ) || \"docx\"\n  )\n    .trim()\n    .toLowerCase();\n\n/* ---------------------------------------------------------\n * Derive the matching user prompt when the hidden field\n * was not populated by Form.io\n * --------------------------------------------------------- */\n\nlet history = [];\n\nconst rawMessages =\n  pickValue(\"messagesJson\");\n\ntry {\n  const parsed =\n    typeof rawMessages === \"string\"\n      ? JSON.parse(rawMessages)\n      : rawMessages;\n\n  if (Array.isArray(parsed)) {\n    history = parsed;\n  }\n} catch (error) {\n  node.warn(\n    \"Build Response DOCX: messagesJson could not be parsed. \" +\n    error.message\n  );\n}\n\nif (!selectedUserPrompt && history.length) {\n  let assistantIndex = -1;\n\n  /*\n   * First try to find the exact selected assistant response.\n   */\n  for (\n    let index =\n      history.length - 1;\n    index >= 0;\n    index -= 1\n  ) {\n    const item =\n      history[index] || {};\n\n    if (\n      item.role === \"assistant\" &&\n      String(item.content || \"\") ===\n        selectedContent\n    ) {\n      assistantIndex = index;\n      break;\n    }\n  }\n\n  /*\n   * Fallback to the latest assistant message.\n   */\n  if (assistantIndex < 0) {\n    for (\n      let index =\n        history.length - 1;\n      index >= 0;\n      index -= 1\n    ) {\n      if (\n        history[index] &&\n        history[index].role ===\n          \"assistant\"\n      ) {\n        assistantIndex = index;\n        break;\n      }\n    }\n  }\n\n  /*\n   * Find the closest preceding user message.\n   */\n  if (assistantIndex >= 0) {\n    for (\n      let index =\n        assistantIndex - 1;\n      index >= 0;\n      index -= 1\n    ) {\n      const item =\n        history[index] || {};\n\n      if (\n        item.role === \"user\" &&\n        String(\n          item.content || \"\"\n        ).trim()\n      ) {\n        selectedUserPrompt =\n          String(item.content).trim();\n\n        break;\n      }\n    }\n  }\n}\n\nif (!selectedUserPrompt) {\n  selectedUserPrompt =\n    \"User prompt was not available in the submitted Form data.\";\n}\n\n/* ---------------------------------------------------------\n * XML helpers\n * --------------------------------------------------------- */\n\nfunction escapeXml(value) {\n  return String(\n    value === undefined ||\n    value === null\n      ? \"\"\n      : value\n  )\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&apos;\");\n}\n\nfunction removeMarkdownMarkers(value) {\n  return String(value || \"\")\n    .replace(/\\*\\*([^*]+)\\*\\*/g, \"$1\")\n    .replace(/__([^_]+)__/g, \"$1\")\n    .replace(/`([^`]+)`/g, \"$1\")\n    .replace(/\\*([^*]+)\\*/g, \"$1\")\n    .trim();\n}\n\nfunction paragraphXml(\n  text,\n  styleId,\n  options\n) {\n  const settings =\n    options || {};\n\n  const paragraphStyle =\n    styleId || \"Normal\";\n\n  const indentation =\n    settings.indent\n      ? (\n          '<w:ind w:left=\"' +\n          settings.indent +\n          '\"/>'\n        )\n      : \"\";\n\n  const spacing =\n    settings.spacingAfter !== undefined\n      ? (\n          '<w:spacing w:after=\"' +\n          settings.spacingAfter +\n          '\"/>'\n        )\n      : \"\";\n\n  const keepNext =\n    settings.keepNext\n      ? \"<w:keepNext/>\"\n      : \"\";\n\n  const runProperties = [\n    settings.bold\n      ? \"<w:b/>\"\n      : \"\",\n    settings.italic\n      ? \"<w:i/>\"\n      : \"\",\n    settings.color\n      ? (\n          '<w:color w:val=\"' +\n          settings.color +\n          '\"/>'\n        )\n      : \"\",\n    settings.font\n      ? (\n          '<w:rFonts w:ascii=\"' +\n          settings.font +\n          '\" w:hAnsi=\"' +\n          settings.font +\n          '\" w:eastAsia=\"' +\n          settings.font +\n          '\"/>'\n        )\n      : \"\",\n    settings.size\n      ? (\n          '<w:sz w:val=\"' +\n          settings.size +\n          '\"/>'\n        )\n      : \"\"\n  ].join(\"\");\n\n  return (\n    \"<w:p>\" +\n      \"<w:pPr>\" +\n        '<w:pStyle w:val=\"' +\n        paragraphStyle +\n        '\"/>' +\n        indentation +\n        spacing +\n        keepNext +\n      \"</w:pPr>\" +\n      \"<w:r>\" +\n        (\n          runProperties\n            ? (\n                \"<w:rPr>\" +\n                runProperties +\n                \"</w:rPr>\"\n              )\n            : \"\"\n        ) +\n        '<w:t xml:space=\"preserve\">' +\n        escapeXml(text) +\n        \"</w:t>\" +\n      \"</w:r>\" +\n    \"</w:p>\"\n  );\n}\n\nfunction emptyParagraphXml() {\n  return \"<w:p/>\";\n}\n\nfunction bulletParagraphXml(\n  text,\n  ordered,\n  level\n) {\n  const depth =\n    Number.isFinite(level)\n      ? level\n      : 0;\n\n  const leftIndent =\n    420 + depth * 360;\n\n  const prefix =\n    ordered\n      ? \"\"\n      : \"• \";\n\n  return paragraphXml(\n    prefix +\n    removeMarkdownMarkers(text),\n    \"ListParagraph\",\n    {\n      indent: leftIndent,\n      spacingAfter: 80\n    }\n  );\n}\n\nfunction codeLineXml(text) {\n  return (\n    \"<w:p>\" +\n      \"<w:pPr>\" +\n        '<w:pStyle w:val=\"Code\"/>' +\n        '<w:spacing w:after=\"0\"/>' +\n        '<w:shd w:val=\"clear\" ' +\n        'w:color=\"auto\" ' +\n        'w:fill=\"F3F5F7\"/>' +\n        '<w:ind w:left=\"180\" ' +\n        'w:right=\"180\"/>' +\n      \"</w:pPr>\" +\n      \"<w:r>\" +\n        \"<w:rPr>\" +\n          '<w:rFonts ' +\n          'w:ascii=\"Consolas\" ' +\n          'w:hAnsi=\"Consolas\" ' +\n          'w:eastAsia=\"Consolas\"/>' +\n          '<w:sz w:val=\"19\"/>' +\n          '<w:color w:val=\"172033\"/>' +\n        \"</w:rPr>\" +\n        '<w:t xml:space=\"preserve\">' +\n        escapeXml(\n          text === \"\"\n            ? \" \"\n            : text\n        ) +\n        \"</w:t>\" +\n      \"</w:r>\" +\n    \"</w:p>\"\n  );\n}\n\n/* ---------------------------------------------------------\n * Markdown-like response parser\n * --------------------------------------------------------- */\n\nfunction parseResponseBlocks(\n  responseText\n) {\n  const normalized =\n    String(responseText || \"\")\n      .replace(/\\r\\n/g, \"\\n\")\n      .replace(/\\r/g, \"\\n\");\n\n  const lines =\n    normalized.split(\"\\n\");\n\n  const blocks = [];\n\n  let inCode = false;\n  let codeLanguage = \"\";\n  let codeLines = [];\n\n  lines.forEach(\n    function (line) {\n      const fence =\n        line.match(\n          /^\\s*```([A-Za-z0-9_+#.-]*)\\s*$/\n        );\n\n      if (fence) {\n        if (!inCode) {\n          inCode = true;\n          codeLanguage =\n            String(\n              fence[1] || \"code\"\n            ).toUpperCase();\n\n          codeLines = [];\n        } else {\n          blocks.push({\n            type: \"code\",\n            language:\n              codeLanguage,\n            lines:\n              codeLines.slice()\n          });\n\n          inCode = false;\n          codeLanguage = \"\";\n          codeLines = [];\n        }\n\n        return;\n      }\n\n      if (inCode) {\n        codeLines.push(line);\n        return;\n      }\n\n      if (!line.trim()) {\n        blocks.push({\n          type: \"blank\"\n        });\n\n        return;\n      }\n\n      const heading =\n        line.match(\n          /^\\s*(#{1,6})\\s+(.+)$/\n        );\n\n      if (heading) {\n        blocks.push({\n          type: \"heading\",\n          level:\n            heading[1].length,\n          text:\n            removeMarkdownMarkers(\n              heading[2]\n            )\n        });\n\n        return;\n      }\n\n      const ordered =\n        line.match(\n          /^\\s*(\\d+)\\.\\s+(.+)$/\n        );\n\n      if (ordered) {\n        blocks.push({\n          type: \"ordered\",\n          text:\n            ordered[1] +\n            \". \" +\n            removeMarkdownMarkers(\n              ordered[2]\n            )\n        });\n\n        return;\n      }\n\n      const bullet =\n        line.match(\n          /^\\s*[-*]\\s+(.+)$/\n        );\n\n      if (bullet) {\n        blocks.push({\n          type: \"bullet\",\n          text:\n            removeMarkdownMarkers(\n              bullet[1]\n            )\n        });\n\n        return;\n      }\n\n      blocks.push({\n        type: \"paragraph\",\n        text:\n          removeMarkdownMarkers(\n            line\n          )\n      });\n    }\n  );\n\n  /*\n   * Preserve an unclosed fenced block rather than losing it.\n   */\n  if (inCode) {\n    blocks.push({\n      type: \"code\",\n      language:\n        codeLanguage || \"CODE\",\n      lines:\n        codeLines.slice()\n    });\n  }\n\n  return blocks;\n}\n\nfunction buildResponseBodyXml(\n  responseText\n) {\n  const blocks =\n    parseResponseBlocks(\n      responseText\n    );\n\n  let xml = \"\";\n\n  blocks.forEach(\n    function (block) {\n      if (\n        block.type === \"blank\"\n      ) {\n        xml +=\n          emptyParagraphXml();\n\n        return;\n      }\n\n      if (\n        block.type === \"heading\"\n      ) {\n        const style =\n          block.level <= 1\n            ? \"Heading1\"\n            : block.level === 2\n              ? \"Heading2\"\n              : \"Heading3\";\n\n        xml += paragraphXml(\n          block.text,\n          style,\n          {\n            keepNext: true,\n            spacingAfter: 100\n          }\n        );\n\n        return;\n      }\n\n      if (\n        block.type === \"ordered\"\n      ) {\n        xml += bulletParagraphXml(\n          block.text,\n          true,\n          0\n        );\n\n        return;\n      }\n\n      if (\n        block.type === \"bullet\"\n      ) {\n        xml += bulletParagraphXml(\n          block.text,\n          false,\n          0\n        );\n\n        return;\n      }\n\n      if (\n        block.type === \"code\"\n      ) {\n        xml += paragraphXml(\n          block.language ||\n          \"CODE\",\n          \"CodeLabel\",\n          {\n            bold: true,\n            color: \"FFFFFF\",\n            font: \"Consolas\",\n            size: 18,\n            spacingAfter: 0\n          }\n        );\n\n        const lines =\n          block.lines &&\n          block.lines.length\n            ? block.lines\n            : [\"\"];\n\n        lines.forEach(\n          function (codeLine) {\n            xml +=\n              codeLineXml(\n                codeLine\n              );\n          }\n        );\n\n        xml +=\n          emptyParagraphXml();\n\n        return;\n      }\n\n      xml += paragraphXml(\n        block.text,\n        \"Normal\",\n        {\n          spacingAfter: 120\n        }\n      );\n    }\n  );\n\n  return xml;\n}\n\n/* ---------------------------------------------------------\n * Document content\n * --------------------------------------------------------- */\n\nconst now =\n  new Date();\n\nconst generatedAt =\n  now.toLocaleString(\n    \"en-US\",\n    {\n      year: \"numeric\",\n      month: \"long\",\n      day: \"2-digit\",\n      hour: \"2-digit\",\n      minute: \"2-digit\"\n    }\n  );\n\nlet documentBody = \"\";\n\ndocumentBody += paragraphXml(\n  \"SAP Code Agent\",\n  \"Title\",\n  {\n    keepNext: true\n  }\n);\n\ndocumentBody += paragraphXml(\n  \"ABAP Cloud & Clean Core Assistant\",\n  \"Subtitle\",\n  {\n    keepNext: true\n  }\n);\n\ndocumentBody += paragraphXml(\n  \"Generated: \" + generatedAt,\n  \"Metadata\",\n  {\n    spacingAfter: 240\n  }\n);\n\ndocumentBody += paragraphXml(\n  \"User Request\",\n  \"Heading1\",\n  {\n    keepNext: true\n  }\n);\n\ndocumentBody += paragraphXml(\n  selectedUserPrompt,\n  \"Prompt\",\n  {\n    spacingAfter: 240\n  }\n);\n\ndocumentBody += paragraphXml(\n  \"Assistant Response\",\n  \"Heading1\",\n  {\n    keepNext: true\n  }\n);\n\ndocumentBody +=\n  buildResponseBodyXml(\n    selectedContent\n  );\n\ndocumentBody +=\n  emptyParagraphXml();\n\ndocumentBody += paragraphXml(\n  \"Clean-Core Notice\",\n  \"Heading2\",\n  {\n    keepNext: true\n  }\n);\n\ndocumentBody += paragraphXml(\n  \"Generated code must be validated against the released objects, \" +\n  \"API state, authorization model, ATC checks, and ABAP Cloud rules \" +\n  \"available in the target SAP system.\",\n  \"Notice\",\n  {\n    spacingAfter: 160\n  }\n);\n\nif (selectedMessageId) {\n  documentBody += paragraphXml(\n    \"Response reference: \" +\n    selectedMessageId,\n    \"Metadata\",\n    {\n      spacingAfter: 80\n    }\n  );\n}\n\n/* ---------------------------------------------------------\n * OOXML package files\n * --------------------------------------------------------- */\n\nconst contentTypes =\n  '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +\n  '<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">' +\n    '<Default Extension=\"rels\" ' +\n    'ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>' +\n    '<Default Extension=\"xml\" ' +\n    'ContentType=\"application/xml\"/>' +\n    '<Override PartName=\"/word/document.xml\" ' +\n    'ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/>' +\n    '<Override PartName=\"/word/styles.xml\" ' +\n    'ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml\"/>' +\n  \"</Types>\";\n\nconst packageRelationships =\n  '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +\n  '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">' +\n    '<Relationship Id=\"rId1\" ' +\n    'Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" ' +\n    'Target=\"word/document.xml\"/>' +\n  \"</Relationships>\";\n\nconst documentRelationships =\n  '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +\n  '<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">' +\n    '<Relationship Id=\"rId1\" ' +\n    'Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" ' +\n    'Target=\"styles.xml\"/>' +\n  \"</Relationships>\";\n\nconst stylesXml =\n  '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +\n  '<w:styles xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">' +\n\n    '<w:style w:type=\"paragraph\" w:default=\"1\" w:styleId=\"Normal\">' +\n      '<w:name w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        '<w:rFonts w:ascii=\"Aptos\" w:hAnsi=\"Aptos\" w:eastAsia=\"Aptos\"/>' +\n        '<w:sz w:val=\"22\"/>' +\n        '<w:color w:val=\"26374A\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr><w:spacing w:after=\"120\" w:line=\"300\" w:lineRule=\"auto\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Title\">' +\n      '<w:name w:val=\"Title\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        \"<w:b/>\" +\n        '<w:color w:val=\"0A6ED1\"/>' +\n        '<w:sz w:val=\"38\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr><w:spacing w:after=\"60\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Subtitle\">' +\n      '<w:name w:val=\"Subtitle\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        '<w:color w:val=\"66758C\"/>' +\n        '<w:sz w:val=\"24\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr><w:spacing w:after=\"80\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Metadata\">' +\n      '<w:name w:val=\"Metadata\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        '<w:color w:val=\"7A899C\"/>' +\n        '<w:sz w:val=\"18\"/>' +\n      \"</w:rPr>\" +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Heading1\">' +\n      '<w:name w:val=\"Heading 1\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        \"<w:b/>\" +\n        '<w:color w:val=\"10213D\"/>' +\n        '<w:sz w:val=\"30\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr><w:spacing w:before=\"220\" w:after=\"100\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Heading2\">' +\n      '<w:name w:val=\"Heading 2\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        \"<w:b/>\" +\n        '<w:color w:val=\"17365D\"/>' +\n        '<w:sz w:val=\"26\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr><w:spacing w:before=\"180\" w:after=\"90\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Heading3\">' +\n      '<w:name w:val=\"Heading 3\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        \"<w:b/>\" +\n        '<w:color w:val=\"284B73\"/>' +\n        '<w:sz w:val=\"23\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr><w:spacing w:before=\"140\" w:after=\"80\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Prompt\">' +\n      '<w:name w:val=\"User Prompt\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        '<w:color w:val=\"1D334D\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr>' +\n        '<w:shd w:val=\"clear\" w:color=\"auto\" w:fill=\"EAF3FF\"/>' +\n        '<w:ind w:left=\"240\" w:right=\"240\"/>' +\n        '<w:spacing w:before=\"120\" w:after=\"160\"/>' +\n      \"</w:pPr>\" +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"ListParagraph\">' +\n      '<w:name w:val=\"List Paragraph\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:pPr><w:spacing w:after=\"80\"/></w:pPr>' +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"CodeLabel\">' +\n      '<w:name w:val=\"Code Label\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        \"<w:b/>\" +\n        '<w:rFonts w:ascii=\"Consolas\" w:hAnsi=\"Consolas\"/>' +\n        '<w:color w:val=\"FFFFFF\"/>' +\n        '<w:sz w:val=\"18\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr>' +\n        '<w:shd w:val=\"clear\" w:color=\"auto\" w:fill=\"26364A\"/>' +\n        '<w:ind w:left=\"180\" w:right=\"180\"/>' +\n        '<w:spacing w:before=\"140\" w:after=\"0\"/>' +\n      \"</w:pPr>\" +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Code\">' +\n      '<w:name w:val=\"Code\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        '<w:rFonts w:ascii=\"Consolas\" w:hAnsi=\"Consolas\" w:eastAsia=\"Consolas\"/>' +\n        '<w:color w:val=\"172033\"/>' +\n        '<w:sz w:val=\"19\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr>' +\n        '<w:shd w:val=\"clear\" w:color=\"auto\" w:fill=\"F3F5F7\"/>' +\n        '<w:ind w:left=\"180\" w:right=\"180\"/>' +\n        '<w:spacing w:after=\"0\"/>' +\n      \"</w:pPr>\" +\n    \"</w:style>\" +\n\n    '<w:style w:type=\"paragraph\" w:styleId=\"Notice\">' +\n      '<w:name w:val=\"Notice\"/>' +\n      '<w:basedOn w:val=\"Normal\"/>' +\n      '<w:rPr>' +\n        '<w:color w:val=\"5B4A00\"/>' +\n      \"</w:rPr>\" +\n      '<w:pPr>' +\n        '<w:shd w:val=\"clear\" w:color=\"auto\" w:fill=\"FFF8D6\"/>' +\n        '<w:ind w:left=\"220\" w:right=\"220\"/>' +\n        '<w:spacing w:before=\"100\" w:after=\"160\"/>' +\n      \"</w:pPr>\" +\n    \"</w:style>\" +\n\n  \"</w:styles>\";\n\nconst documentXml =\n  '<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>' +\n  '<w:document ' +\n  'xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">' +\n    \"<w:body>\" +\n      documentBody +\n      \"<w:sectPr>\" +\n        '<w:pgSz w:w=\"11906\" w:h=\"16838\"/>' +\n        '<w:pgMar ' +\n        'w:top=\"1080\" ' +\n        'w:right=\"1080\" ' +\n        'w:bottom=\"1080\" ' +\n        'w:left=\"1080\" ' +\n        'w:header=\"720\" ' +\n        'w:footer=\"720\" ' +\n        'w:gutter=\"0\"/>' +\n      \"</w:sectPr>\" +\n    \"</w:body>\" +\n  \"</w:document>\";\n\n/* ---------------------------------------------------------\n * Generate DOCX\n * --------------------------------------------------------- */\n\ntry {\n  const zip =\n    new PizZip();\n\n  zip.file(\n    \"[Content_Types].xml\",\n    contentTypes\n  );\n\n  zip.file(\n    \"_rels/.rels\",\n    packageRelationships\n  );\n\n  zip.file(\n    \"word/_rels/document.xml.rels\",\n    documentRelationships\n  );\n\n  zip.file(\n    \"word/document.xml\",\n    documentXml\n  );\n\n  zip.file(\n    \"word/styles.xml\",\n    stylesXml\n  );\n\n  const buffer =\n    zip.generate({\n      type: \"nodebuffer\",\n      compression: \"DEFLATE\"\n    });\n\n  const base64 =\n    buffer.toString(\"base64\");\n\n  const safeTimestamp =\n    now\n      .toISOString()\n      .replace(/[:.]/g, \"-\");\n\n  const fileName =\n    \"SAP_Code_Agent_Response_\" +\n    safeTimestamp +\n    \".docx\";\n\n  msg.payload =\n    base64;\n\n  msg.fsFileName =\n    fileName;\n\n  msg.fsMimeType =\n    \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\";\n\n  msg.downloadFileSubmission = {\n    data: base64,\n    fileName: fileName,\n    inputType: \"base64\"\n  };\n\n  /*\n   * Preserve the current Form submission.\n   * The View Action requires the original Form metadata.\n   */\n  msg.submission =\n    submission;\n\n  node.warn({\n    stage:\n      \"docx-ready\",\n    fileName:\n      fileName,\n    selectedFormat:\n      selectedFormat,\n    responseCharacters:\n      selectedContent.length,\n    userPromptCharacters:\n      selectedUserPrompt.length,\n    base64Characters:\n      base64.length\n  });\n\n  return msg;\n} catch (error) {\n  node.error(\n    \"SAP Code Agent DOCX generation failed: \" +\n    error.message,\n    msg\n  );\n\n  return null;\n}","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is started.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":520,"y":160,"wires":[["703bcb1e38730e10","efce20229376fc3b"]]},{"id":"703bcb1e38730e10","type":"axetflows-view-action","z":"cab2b2152508727e","name":"Download Response File","action":"update","redirectPage":null,"downloadFile":true,"fileName":"","inputType":"base64","message":"","messageType":"info","x":680,"y":240,"wires":[]},{"id":"efce20229376fc3b","type":"debug","z":"cab2b2152508727e","name":"Debug DOCX","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":676.1700000000001,"y":80,"wires":[]},{"id":"d870761d294014c0","type":"function","z":"6a7c6094850c144e","name":"Validate + Build SAP Agent Prompt","func":"/*\n * Validate + Build SAP Agent Prompt\n *\n * Output 1:\n * Valid SAP coding request → LLM\n *\n * Output 2:\n * Validation failure → Prepare Validation Message\n *\n * Production diagnostic sections:\n *\n * VBP-01  Input normalization\n * VBP-02  Form-state preservation\n * VBP-03  Input validation\n * VBP-04  Request-size guard\n * VBP-05  History restoration\n * VBP-06  System instruction\n * VBP-07  LLM request creation\n * VBP-08  UI processing state\n * VBP-09  Final routing\n */\n\n/* =========================================================\n * VBP-01 — NORMALIZE FORM INPUT\n * ========================================================= */\n\nfunction isPlainObject(value) {\n  return (\n    value &&\n    typeof value === \"object\" &&\n    !Array.isArray(value)\n  );\n}\n\nfunction asObject(value) {\n  return isPlainObject(value)\n    ? value\n    : {};\n}\n\nfunction asTrimmedText(value) {\n  return typeof value === \"string\"\n    ? value.trim()\n    : \"\";\n}\n\nconst existingSubmission =\n  asObject(\n    msg.submission\n  );\n\nconst submissionData =\n  isPlainObject(\n    existingSubmission.data\n  )\n    ? existingSubmission.data\n    : existingSubmission;\n\nconst rawPayload =\n  asObject(\n    msg.payload\n  );\n\nconst payloadData =\n  isPlainObject(\n    rawPayload.data\n  )\n    ? rawPayload.data\n    : rawPayload;\n\nconst topLevelData =\n  asObject(\n    msg.data\n  );\n\nconst normalizedData =\n  Object.assign(\n    {},\n    topLevelData,\n    payloadData,\n    submissionData\n  );\n\nconst submissionComposer =\n  asObject(\n    submissionData.composer\n  );\n\nconst payloadComposer =\n  asObject(\n    payloadData.composer\n  );\n\nconst normalizedComposer =\n  asObject(\n    normalizedData.composer\n  );\n\nconst question =\n  asTrimmedText(\n    submissionData.userMessage\n  ) ||\n  asTrimmedText(\n    submissionComposer.userMessage\n  ) ||\n  asTrimmedText(\n    payloadData.userMessage\n  ) ||\n  asTrimmedText(\n    payloadComposer.userMessage\n  ) ||\n  asTrimmedText(\n    normalizedData.userMessage\n  ) ||\n  asTrimmedText(\n    normalizedComposer.userMessage\n  ) ||\n  asTrimmedText(\n    topLevelData.userMessage\n  );\n\nnode.warn({\n  component:\n    \"Validate + Build SAP Agent Prompt\",\n\n  section:\n    \"VBP-01\",\n\n  event:\n    \"input-normalized\",\n\n  questionCharacters:\n    question.length,\n\n  clickedButton:\n    msg.__deptAppsFormioButtonClicked ||\n    \"\"\n});\n\n/* =========================================================\n * VBP-02 — PRESERVE FORM STATE AND METADATA\n * ========================================================= */\n\nmsg.submission =\n  isPlainObject(\n    msg.submission\n  )\n    ? msg.submission\n    : {};\n\nmsg.submission.data =\n  isPlainObject(\n    msg.submission.data\n  )\n    ? msg.submission.data\n    : {};\n\nObject.assign(\n  msg.submission.data,\n  normalizedData\n);\n\nconst data =\n  msg.submission.data;\n\ndata.composer =\n  isPlainObject(\n    data.composer\n  )\n    ? data.composer\n    : {};\n\ndata.userMessage =\n  question;\n\ndata.composer.userMessage =\n  question;\n\nmsg.userQuestion =\n  question;\n\n/* =========================================================\n * REQUEST MODE\n *\n * Current stabilization mode:\n * normal user submissions remain Understand.\n * ========================================================= */\n\n/* =========================================================\n * VBP-02A — RESPONSE-DRIVEN WORKFLOW MODE\n *\n * No Proceed / Generate buttons are used.\n *\n * The previous completed stage determines what the next\n * real user message means.\n * ========================================================= */\n\nconst previousStage =\n  String(\n    data.currentStage ||\n    data.agentPhase ||\n    \"understand\"\n  )\n    .trim()\n    .toLowerCase();\n\nlet normalizedRequestMode =\n  \"understand\";\n\n/*\n * Understand:\n * User is still defining / confirming requirements.\n */\nif (\n  previousStage === \"understand\"\n) {\n  normalizedRequestMode =\n    \"understand\";\n\n/*\n * Code:\n * Code has already been generated.\n * The user's next reply is treated as validation feedback.\n */\n} else if (\n  previousStage === \"code\"\n) {\n  normalizedRequestMode =\n    \"validate\";\n\n/*\n * Validate:\n * The user's next reply is treated as the final confirmation\n * or correction after validation.\n */\n} else if (\n  previousStage === \"validate\"\n) {\n  normalizedRequestMode =\n    \"complete\";\n\n/*\n * Complete:\n * Remain complete for ordinary follow-up questions.\n */\n} else if (\n  previousStage === \"complete\"\n) {\n  normalizedRequestMode =\n    \"complete\";\n}\n\n\nmsg.agentRequestMode =\n  normalizedRequestMode;\n\nmsg.isProceedToCode =\n  false;\n\nmsg.skipUserHistoryAppend =\n  false;\n\n/*\n * Remove legacy one-shot button state.\n */\ndata.proceedRequested =\n  \"false\";\n/*\n * Keep payload shape consistent with downstream Form nodes.\n */\nmsg.payload =\n  isPlainObject(\n    msg.payload\n  )\n    ? msg.payload\n    : {};\n\nmsg.payload.data =\n  data;\n\n/* =========================================================\n * VBP-03 — EMPTY-INPUT VALIDATION\n * ========================================================= */\n\nif (!question) {\n  data.currentStage =\n    \"understand\";\n\n  data.agentPhase =\n    \"understand\";\n\n  data.processing =\n    false;\n\n  data.processingMessage =\n    \"\";\n\n  data.uiError =\n    \"Please enter an SAP coding-related question.\";\n\n  msg.uiError =\n    data.uiError;\n\n  msg.payload.data =\n    data;\n\n  node.warn({\n    component:\n      \"Validate + Build SAP Agent Prompt\",\n\n    section:\n      \"VBP-03\",\n\n    event:\n      \"empty-question-rejected\"\n  });\n\n  return [\n    null,\n    msg\n  ];\n}\n\n/* =========================================================\n * VBP-04 — MODEL-AGNOSTIC REQUEST-SIZE GUARD\n *\n * The frontend uses the same values.\n *\n * Token count is only an estimate because each model uses\n * a different tokenizer.\n * ========================================================= */\n\nconst MAX_USER_CHARACTERS =\n  16000;\n\nconst WARNING_USER_CHARACTERS =\n  12000;\n\nconst APPROXIMATE_CHARACTERS_PER_TOKEN =\n  4;\n\nconst questionCharacters =\n  question.length;\n\nconst estimatedQuestionTokens =\n  Math.ceil(\n    questionCharacters /\n    APPROXIMATE_CHARACTERS_PER_TOKEN\n  );\n\nif (\n  questionCharacters >\n  MAX_USER_CHARACTERS\n) {\n  data.currentStage =\n    \"understand\";\n\n  data.agentPhase =\n    \"understand\";\n\n  data.processing =\n    false;\n\n  data.processingMessage =\n    \"\";\n\n  data.uiError =\n    \"Your request is too long. \" +\n    \"The application limit is \" +\n    MAX_USER_CHARACTERS.toLocaleString() +\n    \" characters. Your request contains \" +\n    questionCharacters.toLocaleString() +\n    \" characters. Please shorten it or divide it into smaller requests.\";\n\n  msg.uiError =\n    data.uiError;\n\n  msg.payload.data =\n    data;\n\n  node.warn({\n    component:\n      \"Validate + Build SAP Agent Prompt\",\n\n    section:\n      \"VBP-04\",\n\n    event:\n      \"request-size-limit-exceeded\",\n\n    questionCharacters:\n      questionCharacters,\n\n    estimatedQuestionTokens:\n      estimatedQuestionTokens,\n\n    maximumCharacters:\n      MAX_USER_CHARACTERS\n  });\n\n  return [\n    null,\n    msg\n  ];\n}\n\nif (\n  questionCharacters >=\n  WARNING_USER_CHARACTERS\n) {\n  node.warn({\n    component:\n      \"Validate + Build SAP Agent Prompt\",\n\n    section:\n      \"VBP-04\",\n\n    event:\n      \"request-near-size-limit\",\n\n    questionCharacters:\n      questionCharacters,\n\n    estimatedQuestionTokens:\n      estimatedQuestionTokens,\n\n    warningCharacters:\n      WARNING_USER_CHARACTERS,\n\n    maximumCharacters:\n      MAX_USER_CHARACTERS\n  });\n}\n\n/* =========================================================\n * VBP-05 — RESTORE AND NORMALIZE CONVERSATION HISTORY\n * ========================================================= */\n\nlet history = [];\n\nconst rawHistory =\n  data.messagesJson !==\n    undefined\n    ? data.messagesJson\n    : payloadData.messagesJson;\n\ntry {\n  const parsedHistory =\n    typeof rawHistory === \"string\"\n      ? JSON.parse(\n          rawHistory || \"[]\"\n        )\n      : rawHistory;\n\n  history =\n    Array.isArray(\n      parsedHistory\n    )\n      ? parsedHistory\n      : [];\n} catch (error) {\n  history =\n    [];\n\n  node.warn({\n    component:\n      \"Validate + Build SAP Agent Prompt\",\n\n    section:\n      \"VBP-05\",\n\n    event:\n      \"history-parse-failed\",\n\n    message:\n      error.message\n  });\n}\n\n/*\n * Keep only valid user and assistant messages.\n *\n * The visible UI may retain 20 messages, while the LLM request\n * uses the most recent 12 to control prompt size.\n */\nhistory =\n  history\n    .filter(\n      function (item) {\n        return (\n          item &&\n          (\n            item.role === \"user\" ||\n            item.role === \"assistant\"\n          ) &&\n          typeof item.content ===\n            \"string\" &&\n          item.content.trim() !==\n            \"\"\n        );\n      }\n    )\n    .slice(\n      -12\n    )\n    .map(\n      function (item) {\n        return {\n          role:\n            item.role,\n\n          content:\n            item.content.trim()\n        };\n      }\n    );\n\n/* =========================================================\n * VBP-06 — SAP CODE AGENT SYSTEM INSTRUCTION\n * ========================================================= */\n\nconst SYSTEM_INSTRUCTION =\n  String.raw`\nAgent to generate enterprise grade code based. \nYou are an SAP Code Agent. Your role is to help design, generate, review, refactor, and test SAP-related code with an enterprise-grade, clean-core mindset.\n  \nCore principles:\n1. Prefer SAP standard capabilities before custom code.\n2. Follow SAP clean-core guidance: use released APIs, released CDS views, RAP, BAdIs, key-user extensibility, or side-by-side BTP extensions before modifying core objects.\n3. Never suggest direct modifications to SAP standard objects unless explicitly approved and clearly labeled as non-clean-core.\n4. Prioritize upgrade-safe, maintainable, secure, and testable solutions.\n5. Ask for missing SAP context when required: system type, S/4HANA version, cloud/private/on-prem, ABAP Cloud availability, package, transport path, namespace, and target object type.\n\nSupported SAP areas:\n- ABAP and ABAP OO\n- ABAP Cloud\n- CDS views and annotations\n- RAP business objects, behavior definitions, projections, service bindings\n- OData services\n- SAP Fiori/UI5 integration points\n- CAP applications on SAP BTP\n- Integration code using released APIs, events, IDocs, BAPIs, RFCs, or APIs where appropriate\n- Unit tests, ATC readiness, performance review, and transport guidance\n\nCoding standards:\n- Use modern ABAP syntax where compatible.\n- Prefer object-oriented design over procedural code.\n- Avoid SELECT *.\n- Use authorization checks where business data is accessed.\n- Avoid hard-coded values; use customizing, constants, or configuration.\n- Handle errors explicitly and return meaningful messages.\n- Optimize database access: avoid nested SELECTs, reduce round trips, use CDS or joins where appropriate.\n- Ensure generated code is readable, named clearly, and commented only where comments add value.\n\nABAP/RAP rules:\n- Prefer RAP for new transactional Fiori/OData applications.\n- Use CDS interface views, projection views, behavior definitions, behavior implementations, service definitions, and service bindings consistently.\n- Keep business logic in behavior implementation classes or domain services, not UI annotations.\n- Use determinations, validations, and actions appropriately.\n- Do not bypass RAP transactional handling unless there is a justified exception.\n- For ABAP Cloud, use only released APIs and syntax allowed by the ABAP Cloud development model.\n\nCAP/BTP rules:\n- Prefer CAP for side-by-side extensions and cloud-native SAP BTP services.\n- Model domain entities in CDS.\n- Keep service definitions separate from persistence models.\n- Use handlers for business logic.\n- Use SAP Destination Service, XSUAA, and connectivity patterns instead of hard-coded credentials.\n- Never expose secrets, tokens, passwords, or private keys.\n\nSecurity:\n- Never generate code that stores credentials in source files.\n- Validate and sanitize external input.\n- Apply authorization checks.\n- Avoid dynamic SQL unless absolutely necessary; if used, explain the risk and mitigation.\n- Respect data privacy and least-privilege principles.\n\nTesting and quality:\n- Generate ABAP Unit tests where feasible.\n- Include test doubles or seams for external dependencies.\n- Recommend ATC checks before transport.\n- Include performance considerations for database-heavy code.\n- For generated code, provide:\n  1. Assumptions\n  2. Code\n  3. Explanation\n  4. Test strategy\n  5. Deployment or transport notes\n  6. Clean-core impact\n\nWhen reviewing code:\n- Identify bugs, syntax issues, performance risks, security risks, clean-core violations, and maintainability problems.\n- Separate findings by severity: Critical, High, Medium, Low.\n- Provide corrected code where possible.\n- Explain why the change matters in SAP terms.\n\nWhen information is missing:\n- Make the safest reasonable assumption.\n- Clearly state assumptions.\n- Ask only essential questions.\n- Do not invent SAP object names, tables, APIs, or released status.\n\nResponse format:\n- Be concise and practical.\n- Prefer SAP-native terminology.\n- Include code blocks with language labels such as abap, cds, javascript, typescript, xml, or sql.\n- Never claim code is production-ready unless it includes testing, authorization, error handling, and deployment notes.\n\nExecution workflow:\n\nStep 1 — Understand\n\nAnalyze the user's requirement.\n\nIf important information is missing, state only the essential\nassumptions or questions required to produce a useful solution.\n\nDo not generate implementation code yet.\n\nPresent assumptions using clear headings and properly incremented\nnumbered lists.\n\nEnd the response with:\n\n## Ready for implementation\n\n**If these assumptions are correct, confirm them and I will generate the implementation.**\n\n\nStep 2 — Code\n\nAfter the user confirms the requirements, generate the requested\nimplementation.\n\nEvery source artifact must be inside a complete Markdown fenced\ncode block with the appropriate language identifier.\n\nUse clear headings for each artifact.\n\nAfter the implementation and a short explanation, end with:\n\n## Validation\n\n**Does this solution satisfy your requirements?**\n\nIf not, tell me what should be corrected or improved.\n\n\nStep 3 — Validate\n\nWhen the user responds after code generation, review the delivered\nsolution against the original requirements and the user's feedback.\n\nIdentify any important issue and provide corrected code only when\nnecessary.\n\nEnd with:\n\n## Validation result\n\nUse either:\n\n**The solution satisfies the stated requirements.**\n\nor:\n\n**The solution still requires the following corrections:**\n\nThen explain the remaining corrections clearly.\n\n\nStep 4 — Complete\n\nOnce validation succeeds, provide a concise final summary containing:\n\n- what was delivered;\n- key validation result;\n- testing recommendation;\n- deployment / transport note;\n- clean-core impact.\n\nDo not regenerate all source code unless the user explicitly asks.`.trim();\n\n/*\n * Make the same system instruction available to the\n * Proceed-to-Code and validation request nodes.\n */\nflow.set(\n  \"sapCodeAgentSystemInstruction\",\n  SYSTEM_INSTRUCTION\n);\n\n/* =========================================================\n * VBP-07 — MODE-SPECIFIC INSTRUCTION\n * ========================================================= */\n\nlet MODE_SPECIFIC_INSTRUCTION =\n  \"\";\n\nif (\n  normalizedRequestMode === \"generate\" ||\n  normalizedRequestMode === \"revise\"\n) {\n  MODE_SPECIFIC_INSTRUCTION =\n    String.raw`\nGenerate the requested implementation.\n\nPut source code inside complete Markdown fenced code blocks\nwith the appropriate language identifier.\n\nKeep explanations concise.\n`.trim();\n\n} else if (\n  normalizedRequestMode === \"validate\"\n) {\n  MODE_SPECIFIC_INSTRUCTION =\n    String.raw`\nReview the current implementation.\n\nIdentify important syntax, design, performance, security,\nclean-core, or maintainability issues.\n\nProvide concise corrections and recommendations.\n`.trim();\n\n} else if (\n  normalizedRequestMode === \"complete\"\n) {\n  MODE_SPECIFIC_INSTRUCTION =\n    String.raw`\nThis conversation is now complete. Produce the final wrap-up.\n\nDo NOT regenerate the implementation. Do NOT repeat the full code.\n\nProvide, concisely:\n- Explanation of the delivered solution\n- Test strategy\n- Deployment and transport notes\n- Clean-core impact\n- A short summary of what was delivered\n\nIf the user's message asks a specific follow-up question, answer it\nfirst, then give the wrap-up.\n`.trim();\n\n} else {\n  MODE_SPECIFIC_INSTRUCTION =\n    String.raw`\nUnderstand the user's SAP requirement and respond helpfully.\n\nSummarize important assumptions or missing information when useful.\n\nDo not force a rigid questionnaire.\n`.trim();\n}\n\n\n/* =========================================================\n * VBP-08 — FINAL SYSTEM INSTRUCTION\n * ========================================================= */\n\nconst FINAL_SYSTEM_INSTRUCTION =\n  [\n    SYSTEM_INSTRUCTION,\n    MODE_SPECIFIC_INSTRUCTION\n  ]\n    .filter(function (item) {\n      return (\n        typeof item === \"string\" &&\n        item.trim() !== \"\"\n      );\n    })\n    .join(\"\\n\\n\");\n\n\nnode.warn({\n  component:\n    \"Validate + Build SAP Agent Prompt\",\n\n  section:\n    \"VBP-08\",\n\n  event:\n    \"system-instruction-built\",\n\n  requestMode:\n    normalizedRequestMode,\n\n  characters:\n    FINAL_SYSTEM_INSTRUCTION.length\n});\n\n\n/* =========================================================\n * VBP-09 — BUILD ENABLER REQUEST SAFELY\n *\n * This section deliberately contains its own try/catch.\n *\n * A prompt-builder programming error must NOT be presented\n * as an LLM/backend outage.\n * ========================================================= */\n\ntry {\n\n  /* -------------------------------------------------------\n   * VBP-09A — NORMALIZE HISTORY\n   *\n   * Enabler accepts system/user roles.\n   * Previous assistant replies are therefore supplied as\n   * system-context records.\n   * ------------------------------------------------------- */\n\n  const enablerHistory =\n    Array.isArray(history)\n      ? history\n          .filter(\n            function (item) {\n              return (\n                item &&\n                (\n                  item.role === \"user\" ||\n                  item.role === \"assistant\"\n                ) &&\n                typeof item.content === \"string\" &&\n                item.content.trim() !== \"\"\n              );\n            }\n          )\n          .map(\n            function (item) {\n              const content =\n                String(\n                  item.content || \"\"\n                ).trim();\n\n              if (\n                item.role === \"user\"\n              ) {\n                return {\n                  role:\n                    \"user\",\n\n                  content:\n                    content\n                };\n              }\n\n              return {\n                role:\n                  \"system\",\n\n                content:\n                  \"Previous SAP Code Agent response:\\n\" +\n                  content\n              };\n            }\n          )\n      : [];\n\n\n  node.warn(\n    JSON.stringify({\n      component:\n        \"Validate + Build SAP Agent Prompt\",\n\n      section:\n        \"VBP-09A\",\n\n      event:\n        \"history-normalized\",\n\n      sourceHistoryMessages:\n        Array.isArray(history)\n          ? history.length\n          : 0,\n\n      enablerHistoryMessages:\n        enablerHistory.length\n    })\n  );\n\n\n  /* =======================================================\n   * VBP-10 — BUILD msg.messages\n   * ======================================================= */\n\n  const cleanQuestion =\n    String(\n      question || \"\"\n    ).trim();\n\n  if (!cleanQuestion) {\n    throw new Error(\n      \"VBP-10: question became empty before Enabler request creation.\"\n    );\n  }\n\n  if (\n    typeof FINAL_SYSTEM_INSTRUCTION !==\n      \"string\" ||\n    FINAL_SYSTEM_INSTRUCTION.trim() ===\n      \"\"\n  ) {\n    throw new Error(\n      \"VBP-10: FINAL_SYSTEM_INSTRUCTION is empty or invalid.\"\n    );\n  }\n\n\n  msg.messages =\n    [\n      {\n        role:\n          \"system\",\n\n        content:\n          FINAL_SYSTEM_INSTRUCTION.trim()\n      }\n    ]\n      .concat(\n        enablerHistory\n      )\n      .concat(\n        [\n          {\n            role:\n              \"user\",\n\n            content:\n              cleanQuestion\n          }\n        ]\n      );\n\n\n  /* -------------------------------------------------------\n   * VBP-10A — STRICT MESSAGE SHAPE VALIDATION\n   * ------------------------------------------------------- */\n\n  if (\n    !Array.isArray(\n      msg.messages\n    ) ||\n    msg.messages.length === 0\n  ) {\n    throw new Error(\n      \"VBP-10A: msg.messages was not created correctly.\"\n    );\n  }\n\n\n  const invalidMessageIndex =\n    msg.messages.findIndex(\n      function (item) {\n        return !(\n          item &&\n          typeof item === \"object\" &&\n          !Array.isArray(item) &&\n          (\n            item.role === \"system\" ||\n            item.role === \"user\"\n          ) &&\n          typeof item.content === \"string\" &&\n          item.content.trim() !== \"\"\n        );\n      }\n    );\n\n\n  if (\n    invalidMessageIndex !== -1\n  ) {\n    const invalidItem =\n      msg.messages[\n        invalidMessageIndex\n      ];\n\n    throw new Error(\n      \"VBP-10A: invalid Enabler message at index \" +\n      invalidMessageIndex +\n      \". role=\" +\n      String(\n        invalidItem &&\n        invalidItem.role\n      ) +\n      \", contentType=\" +\n      typeof (\n        invalidItem &&\n        invalidItem.content\n      )\n    );\n  }\n\n\n  /* =======================================================\n   * VBP-11 — REQUEST METADATA\n   * ======================================================= */\n\n  msg.query =\n    cleanQuestion;\n\n  msg.userQuestion =\n    cleanQuestion;\n\n  msg.chatHistory =\n    Array.isArray(history)\n      ? history\n      : [];\n\n  msg.agentRequestMode =\n    normalizedRequestMode;\n\n  msg.isProceedToCode =\n    normalizedRequestMode ===\n    \"generate\";\n\n/*\n   * No Proceed-to-Code chip in this design — every user\n   * message is a real, visible turn.\n   */\n  msg.skipUserHistoryAppend =\n    false;\n\n\n  /*\n   * Keep generation parameters as NUMBER values.\n   */\n  msg.temperature =\n    0.2;\n\n  msg.top_p =\n    1;\n\n  msg.n =\n    1;\n\n\n  if (\n    normalizedRequestMode ===\n      \"generate\" ||\n    normalizedRequestMode ===\n      \"revise\"\n  ) {\n    msg.max_tokens =\n      6000;\n\n  } else if (\n    normalizedRequestMode ===\n      \"validate\"\n  ) {\n    msg.max_tokens =\n      3000;\n\n  } else if (\n    normalizedRequestMode ===\n      \"complete\"\n  ) {\n    msg.max_tokens =\n      1800;\n\n  } else {\n    msg.max_tokens =\n      2200;\n  }\n\n\n  /* =======================================================\n   * VBP-12 — PROCESSING STATE\n   * ======================================================= */\n\n  data.processing =\n    true;\n\n  data.uiError =\n    \"\";\n\n\n  if (\n    normalizedRequestMode ===\n      \"generate\" ||\n    normalizedRequestMode ===\n      \"revise\"\n  ) {\n    data.currentStage =\n      \"code\";\n\n    data.agentPhase =\n      \"code\";\n\n    data.processingMessage =\n      normalizedRequestMode ===\n        \"revise\"\n        ? \"Revising the SAP implementation…\"\n        : \"Generating the SAP implementation…\";\n\n    data.validationPassed =\n      \"false\";\n\n  } else if (\n    normalizedRequestMode ===\n      \"validate\"\n  ) {\n    data.currentStage =\n      \"validate\";\n\n    data.agentPhase =\n      \"validate\";\n\n    data.processingMessage =\n      \"Validating the SAP implementation…\";\n\n  } else if (\n    normalizedRequestMode ===\n      \"complete\"\n  ) {\n    data.currentStage =\n      \"complete\";\n\n    data.agentPhase =\n      \"complete\";\n\n    data.processingMessage =\n      \"Preparing the final response…\";\n\n  } else {\n    data.currentStage =\n      \"understand\";\n\n    data.agentPhase =\n      \"understand\";\n\n    data.processingMessage =\n      \"Working on it…\";\n\n    data.validationPassed =\n      \"false\";\n  }\n\n\n  /* =======================================================\n   * VBP-13 — COMPATIBILITY COPIES\n   *\n   * IMPORTANT:\n   * Do not replace msg with a new object.\n   * Do not place req/res/runtime objects inside data.\n   * ======================================================= */\n\n  msg.processing =\n    true;\n\n  msg.currentStage =\n    data.currentStage;\n\n  msg.agentPhase =\n    data.agentPhase;\n\n\n  msg.submission =\n    isPlainObject(\n      msg.submission\n    )\n      ? msg.submission\n      : {};\n\n  msg.submission.data =\n    isPlainObject(\n      msg.submission.data\n    )\n      ? msg.submission.data\n      : {};\n\n\n  msg.submission.data.processing =\n    data.processing;\n\n  msg.submission.data.processingMessage =\n    data.processingMessage;\n\n  msg.submission.data.currentStage =\n    data.currentStage;\n\n  msg.submission.data.agentPhase =\n    data.agentPhase;\n\n  msg.submission.data.uiError =\n    \"\";\n\n\n  /*\n   * Do NOT attach Form data to msg.payload here.\n   *\n   * The Enabler node owns msg.payload as its output field.\n   * Keeping the request payload clean also avoids accidental\n   * circular data structures.\n   */\n  msg.payload =\n    null;\n\n\n  /* =======================================================\n   * VBP-14 — FINAL REQUEST DIAGNOSTICS\n   * ======================================================= */\n\n  node.status({\n    fill:\n      \"blue\",\n\n    shape:\n      \"dot\",\n\n    text:\n      \"LLM request: \" +\n      normalizedRequestMode\n  });\n\n\n  node.warn(\n    JSON.stringify({\n      component:\n        \"Validate + Build SAP Agent Prompt\",\n\n      section:\n        \"VBP-14\",\n\n      event:\n        \"llm-request-ready\",\n\n      requestMode:\n        normalizedRequestMode,\n\n      questionCharacters:\n        cleanQuestion.length,\n\n      historyMessages:\n        Array.isArray(history)\n          ? history.length\n          : 0,\n\n      enablerHistoryMessages:\n        enablerHistory.length,\n\n      totalMessages:\n        msg.messages.length,\n\n      roles:\n        msg.messages.map(\n          function (item) {\n            return item.role;\n          }\n        ),\n\n      currentStage:\n        data.currentStage,\n\n      processing:\n        data.processing,\n\n      maxTokens:\n        msg.max_tokens,\n\n      temperature:\n        msg.temperature,\n\n      systemInstructionCharacters:\n        FINAL_SYSTEM_INSTRUCTION.length\n    })\n  );\n\n\n  return [\n    msg,\n    null\n  ];\n\n\n/* =========================================================\n * VBP-15 — INTERNAL REQUEST-BUILDER FAILURE\n *\n * Programming/configuration failures in this Function node\n * are validation/internal errors, NOT LLM outages.\n * ========================================================= */\n\n} catch (error) {\n\n  const builderErrorMessage =\n    error &&\n    error.message\n      ? error.message\n      : String(error);\n\n\n  node.warn(\n    JSON.stringify({\n      component:\n        \"Validate + Build SAP Agent Prompt\",\n\n      section:\n        \"VBP-15\",\n\n      event:\n        \"request-builder-failed\",\n\n      errorName:\n        error &&\n        error.name\n          ? error.name\n          : \"Error\",\n\n      errorMessage:\n        builderErrorMessage,\n\n      stack:\n        error &&\n        error.stack\n          ? String(\n              error.stack\n            ).slice(\n              0,\n              1200\n            )\n          : \"\"\n    })\n  );\n\n\n  data.processing =\n    false;\n\n  data.processingMessage =\n    \"\";\n\n  data.currentStage =\n    \"understand\";\n\n  data.agentPhase =\n    \"understand\";\n\n  data.uiError =\n    \"The SAP Code Agent request could not be prepared. Please try again.\";\n\n\n  msg.uiError =\n    data.uiError;\n\n  msg.processing =\n    false;\n\n  msg.currentStage =\n    \"understand\";\n\n  msg.agentPhase =\n    \"understand\";\n\n\n  /*\n   * Route to Prepare Validation Message rather than Catch.\n   *\n   * Output 2 is already your clean validation path.\n   */\n  return [\n    null,\n    msg\n  ];\n}","outputs":2,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// No external dependencies required.","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":360,"y":220,"wires":[["74d5dc7181cddcce"],["fa1f74bc3a64ae52"]]},{"id":"d492b7e1bb27abfd","type":"function","z":"6a7c6094850c144e","name":"Extract Response + Update Chat","func":"/*\n * ============================================================\n * EXTRACT RESPONSE + UPDATE CHAT\n * Stabilization version\n * ============================================================\n *\n * Responsibilities:\n *\n * 1. Determine request mode.\n * 2. Extract Enabler response safely.\n * 3. Parse optional SAP_AGENT_STATE metadata.\n * 4. Remove metadata from visible answer.\n * 5. Maintain chat history.\n * 6. Resolve workflow stage deterministically.\n * 7. Stop processing state.\n * 8. Prepare Form/View Action-compatible state.\n *\n * Workflow:\n *\n * understand\n *   -> Understand\n *\n * generate / revise\n *   -> Code\n *\n * validate while running\n *   -> Validate\n *\n * validate pass\n *   -> Complete\n *\n * validate fail\n *   -> Code\n *\n * IMPORTANT:\n * Merely receiving code NEVER means Complete.\n * ============================================================\n */\n\n\n/* =========================================================\n * ER-01 — REQUEST MODE\n *\n * No Proceed / Generate buttons.\n * Workflow is driven only by backend stage + user turn.\n * ========================================================= */\n\nconst requestMode =\n  String(\n    msg.agentRequestMode ||\n    \"understand\"\n  )\n    .trim()\n    .toLowerCase();\n\nconst normalizedRequestMode =\n  [\n    \"understand\",\n    \"generate\",\n    \"revise\",\n    \"validate\",\n    \"complete\"\n  ].includes(\n    requestMode\n  )\n    ? requestMode\n    : \"understand\";\n\n\nnode.warn(\n  JSON.stringify({\n    component:\n      \"Extract Response + Update Chat\",\n\n    section:\n      \"ER-01\",\n\n    event:\n      \"request-mode-resolved\",\n\n    requestMode:\n      normalizedRequestMode\n  })\n);\n\n/* =========================================================\n * ER-02 — RAW RESPONSE EXTRACTION\n *\n * Enabler/model-neutral response extraction.\n *\n * IMPORTANT:\n * Do not assume a single provider response shape.\n * Different Enabler-backed models can return content in\n * different locations.\n * ========================================================= */\n\nconst rawPayload =\n  msg.payload;\n\nfunction asText(value) {\n  return typeof value === \"string\"\n    ? value.trim()\n    : \"\";\n}\n\nlet rawAnswer =\n  \"\";\n\n\n/* ---------------------------------------------------------\n * ER-02A — Payload itself is text\n * --------------------------------------------------------- */\n\nrawAnswer =\n  asText(\n    rawPayload\n  );\n\n\n/* ---------------------------------------------------------\n * ER-02B — OpenAI-compatible choices[]\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  Array.isArray(\n    rawPayload.choices\n  )\n) {\n  for (\n    const choice of\n      rawPayload.choices\n  ) {\n    const candidate =\n      asText(\n        choice &&\n        choice.message &&\n        choice.message.content\n      ) ||\n      asText(\n        choice &&\n        choice.text\n      );\n\n    if (candidate) {\n      rawAnswer =\n        candidate;\n\n      break;\n    }\n  }\n}\n\n\n/* ---------------------------------------------------------\n * ER-02C — Direct response fields\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  typeof rawPayload === \"object\"\n) {\n  rawAnswer =\n    asText(\n      rawPayload.response\n    ) ||\n    asText(\n      rawPayload.agent_response\n    ) ||\n    asText(\n      rawPayload.content\n    ) ||\n    asText(\n      rawPayload.text\n    ) ||\n    asText(\n      rawPayload.output\n    ) ||\n    asText(\n      rawPayload.output_text\n    ) ||\n    asText(\n      rawPayload.answer\n    );\n}\n\n\n/* ---------------------------------------------------------\n * ER-02D — message may be text or object\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  typeof rawPayload === \"object\"\n) {\n  rawAnswer =\n    asText(\n      rawPayload.message\n    ) ||\n    asText(\n      rawPayload.message &&\n      rawPayload.message.content\n    ) ||\n    asText(\n      rawPayload.message &&\n      rawPayload.message.text\n    );\n}\n\n\n/* ---------------------------------------------------------\n * ER-02E — Nested data.*\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  rawPayload.data &&\n  typeof rawPayload.data === \"object\"\n) {\n  const nestedData =\n    rawPayload.data;\n\n  rawAnswer =\n    asText(\n      nestedData.response\n    ) ||\n    asText(\n      nestedData.agent_response\n    ) ||\n    asText(\n      nestedData.content\n    ) ||\n    asText(\n      nestedData.text\n    ) ||\n    asText(\n      nestedData.output\n    ) ||\n    asText(\n      nestedData.output_text\n    ) ||\n    asText(\n      nestedData.result\n    ) ||\n    asText(\n      nestedData.answer\n    ) ||\n    asText(\n      nestedData.message\n    ) ||\n    asText(\n      nestedData.message &&\n      nestedData.message.content\n    ) ||\n    asText(\n      nestedData.message &&\n      nestedData.message.text\n    );\n}\n\n\n/* ---------------------------------------------------------\n * ER-02F — Nested result/output/response objects\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  typeof rawPayload === \"object\"\n) {\n  rawAnswer =\n    asText(\n      rawPayload.result &&\n      rawPayload.result.content\n    ) ||\n    asText(\n      rawPayload.result &&\n      rawPayload.result.text\n    ) ||\n    asText(\n      rawPayload.result &&\n      rawPayload.result.response\n    ) ||\n    asText(\n      rawPayload.output &&\n      rawPayload.output.content\n    ) ||\n    asText(\n      rawPayload.output &&\n      rawPayload.output.text\n    ) ||\n    asText(\n      rawPayload.response &&\n      rawPayload.response.content\n    ) ||\n    asText(\n      rawPayload.response &&\n      rawPayload.response.text\n    );\n}\n\n\n/* ---------------------------------------------------------\n * ER-02G — Anthropic/content-array style\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  Array.isArray(\n    rawPayload.content\n  )\n) {\n  rawAnswer =\n    rawPayload.content\n      .map(\n        function (item) {\n          if (\n            typeof item ===\n              \"string\"\n          ) {\n            return item;\n          }\n\n          if (\n            !item ||\n            typeof item !==\n              \"object\"\n          ) {\n            return \"\";\n          }\n\n          return (\n            asText(\n              item.text\n            ) ||\n            asText(\n              item.content\n            )\n          );\n        }\n      )\n      .filter(\n        Boolean\n      )\n      .join(\n        \"\\n\"\n      )\n      .trim();\n}\n\n\n/* ---------------------------------------------------------\n * ER-02H — Nested data.content[] array\n * --------------------------------------------------------- */\n\nif (\n  !rawAnswer &&\n  rawPayload &&\n  rawPayload.data &&\n  Array.isArray(\n    rawPayload.data.content\n  )\n) {\n  rawAnswer =\n    rawPayload.data.content\n      .map(\n        function (item) {\n          if (\n            typeof item ===\n              \"string\"\n          ) {\n            return item;\n          }\n\n          if (\n            !item ||\n            typeof item !==\n              \"object\"\n          ) {\n            return \"\";\n          }\n\n          return (\n            asText(\n              item.text\n            ) ||\n            asText(\n              item.content\n            )\n          );\n        }\n      )\n      .filter(\n        Boolean\n      )\n      .join(\n        \"\\n\"\n      )\n      .trim();\n}\n\n\n/* ---------------------------------------------------------\n * ER-02I — Values outside msg.payload\n * --------------------------------------------------------- */\n\nif (!rawAnswer) {\n  rawAnswer =\n    asText(\n      msg.agentAnswer\n    ) ||\n    asText(\n      msg.assistantResponse\n    ) ||\n    asText(\n      msg.response\n    ) ||\n    asText(\n      msg.responseText\n    ) ||\n    asText(\n      msg.result\n    ) ||\n    asText(\n      msg.content\n    );\n}\n\n\n/* ---------------------------------------------------------\n * ER-02J — Failure diagnostics\n * --------------------------------------------------------- */\n\nif (!rawAnswer) {\n  const payloadKeys =\n    rawPayload &&\n    typeof rawPayload ===\n      \"object\" &&\n    !Array.isArray(\n      rawPayload\n    )\n      ? Object.keys(\n          rawPayload\n        )\n      : [];\n\n  node.warn({\n    component:\n      \"Extract Response + Update Chat\",\n\n    section:\n      \"ER-02\",\n\n    event:\n      \"no-readable-response\",\n\n    requestMode:\n      normalizedRequestMode,\n\n    payloadType:\n      Array.isArray(\n        rawPayload\n      )\n        ? \"array\"\n        : typeof rawPayload,\n\n    payloadKeys:\n      payloadKeys\n  });\n\n  const errorMessage =\n    \"The SAP Code Agent received a response from the model, \" +\n    \"but its response format could not be read.\";\n\n  node.error(\n    errorMessage,\n    msg\n  );\n\n  return null;\n}\n\n\n/* ---------------------------------------------------------\n * ER-02K — Success diagnostic\n * --------------------------------------------------------- */\n\nnode.warn({\n  component:\n    \"Extract Response + Update Chat\",\n\n  section:\n    \"ER-02\",\n\n  event:\n    \"response-extracted\",\n\n  requestMode:\n    normalizedRequestMode,\n\n  characters:\n    rawAnswer.length\n});\n\n\n/* =========================================================\n * ER-03 — JSON-SAFE DEBUG SNAPSHOT\n * ========================================================= */\n\ntry {\n  msg.llmRawPayload =\n    JSON.parse(\n      JSON.stringify(\n        rawPayload\n      )\n    );\n} catch (error) {\n  msg.llmRawPayload =\n    \"[raw payload omitted: non-serializable data]\";\n\n  node.warn({\n    component:\n      \"Extract Response + Update Chat\",\n\n    section:\n      \"ER-03\",\n\n    event:\n      \"raw-payload-not-serializable\",\n\n    message:\n      error.message\n  });\n}\n\n\n/* =========================================================\n * ER-04 — SAP_AGENT_STATE EXTRACTION\n * ========================================================= */\n\nconst statePattern =\n  /\\[\\[\\s*SAP_AGENT_STATE\\s*\\]\\]\\s*([\\s\\S]*?)\\s*\\[\\[\\s*\\/SAP_AGENT_STATE\\s*\\]\\]/i;\n\nconst stateMatch =\n  rawAnswer.match(\n    statePattern\n  );\n\nlet stateFound =\n  false;\n\nlet agentState = {\n  phase:\n    \"understand\",\n\n  readyForCode:\n    false,\n\n  missingRequirements:\n    [],\n\n  hasGeneratedCode:\n    false,\n\n  validationPassed:\n    false\n};\n\n\nif (stateMatch) {\n  try {\n    const stateJson =\n      String(\n        stateMatch[1] ||\n        \"\"\n      )\n        .trim()\n        .replace(\n          /^```json\\s*/i,\n          \"\"\n        )\n        .replace(\n          /^```\\s*/i,\n          \"\"\n        )\n        .replace(\n          /\\s*```$/i,\n          \"\"\n        )\n        .trim();\n\n    const parsedState =\n      JSON.parse(\n        stateJson\n      );\n\n    stateFound =\n      true;\n\n    agentState = {\n      phase:\n        String(\n          parsedState.phase ||\n          \"understand\"\n        )\n          .trim()\n          .toLowerCase(),\n\n      readyForCode:\n        parsedState.readyForCode ===\n        true,\n\n      missingRequirements:\n        Array.isArray(\n          parsedState\n            .missingRequirements\n        )\n          ? parsedState\n              .missingRequirements\n              .map(\n                function (\n                  item\n                ) {\n                  return String(\n                    item || \"\"\n                  ).trim();\n                }\n              )\n              .filter(\n                Boolean\n              )\n          : [],\n\n      hasGeneratedCode:\n        parsedState.hasGeneratedCode ===\n        true,\n\n      validationPassed:\n        parsedState.validationPassed ===\n        true\n    };\n  } catch (error) {\n    node.warn({\n      component:\n        \"Extract Response + Update Chat\",\n\n      section:\n        \"ER-04\",\n\n      event:\n        \"agent-state-invalid-json\",\n\n      message:\n        error.message\n    });\n  }\n}\n\n\n/* =========================================================\n * ER-05 — VISIBLE RESPONSE + SAFE FENCE NORMALIZATION\n * ========================================================= */\n\nlet answer =\n  rawAnswer\n    .replace(\n      statePattern,\n      \"\"\n    )\n    .trim();\n\n\nif (!answer) {\n  node.error(\n    \"The SAP Code Agent returned workflow metadata but no visible answer.\",\n    msg\n  );\n\n  return null;\n}\n\n\n/* ---------------------------------------------------------\n * ER-05A — REPAIR WHOLE-RESPONSE LANGUAGE MARKER\n *\n * Some models return:\n *\n *   abap\n *   CLASS ...\n *   ```\n *   METHOD ...\n *   ```\n *\n * instead of:\n *\n *   ```abap\n *   CLASS ...\n *   METHOD ...\n *   ```\n *\n * If the response STARTS with a supported language name,\n * treat the whole response as one implementation artifact.\n *\n * We deliberately do not try to guess code boundaries in\n * normal mixed prose responses.\n * --------------------------------------------------------- */\n\nconst supportedCodeLanguages =\n  [\n    \"abap\",\n    \"cds\",\n    \"javascript\",\n    \"typescript\",\n    \"json\",\n    \"xml\",\n    \"sql\",\n    \"yaml\",\n    \"html\",\n    \"css\",\n    \"text\"\n  ];\n\nfunction normalizeWholeResponseFence(\n  value\n) {\n  const source =\n    String(\n      value || \"\"\n    ).trim();\n\n  if (!source) {\n    return {\n      text:\n        \"\",\n\n      repaired:\n        false,\n\n      language:\n        \"\"\n    };\n  }\n\n  /*\n   * Already starts with a proper Markdown fence.\n   * Leave it untouched.\n   */\n  if (\n    /^```/i.test(\n      source\n    )\n  ) {\n    return {\n      text:\n        source,\n\n      repaired:\n        false,\n\n      language:\n        \"\"\n    };\n  }\n\n  const firstLineMatch =\n    source.match(\n      /^([A-Za-z0-9_+#.-]+)[ \\t]*\\r?\\n([\\s\\S]+)$/\n    );\n\n  if (\n    !firstLineMatch\n  ) {\n    return {\n      text:\n        source,\n\n      repaired:\n        false,\n\n      language:\n        \"\"\n    };\n  }\n\n  const language =\n    String(\n      firstLineMatch[1] ||\n      \"\"\n    )\n      .trim()\n      .toLowerCase();\n\n  if (\n    !supportedCodeLanguages.includes(\n      language\n    )\n  ) {\n    return {\n      text:\n        source,\n\n      repaired:\n        false,\n\n      language:\n        \"\"\n    };\n  }\n\n  let body =\n    String(\n      firstLineMatch[2] ||\n      \"\"\n    );\n\n  /*\n   * The model may have inserted random fence delimiters\n   * inside the artifact.\n   *\n   * Remove ONLY standalone Markdown fence lines.\n   * Do not modify normal backticks inside actual code.\n   */\n  body =\n    body.replace(\n      /^[ \\t]*```(?:[A-Za-z0-9_+#.-]+)?[ \\t]*$/gm,\n      \"\"\n    );\n\n  body =\n    body.trim();\n\n  if (!body) {\n    return {\n      text:\n        source,\n\n      repaired:\n        false,\n\n      language:\n        \"\"\n    };\n  }\n\n  return {\n    text:\n      \"```\" +\n      language +\n      \"\\n\" +\n      body +\n      \"\\n```\",\n\n    repaired:\n      true,\n\n    language:\n      language\n  };\n}\n\n\nconst fenceNormalization =\n  normalizeWholeResponseFence(\n    answer\n  );\n\nanswer =\n  fenceNormalization.text;\n\n\nif (\n  fenceNormalization.repaired\n) {\n  node.warn(\n    JSON.stringify({\n      component:\n        \"Extract Response + Update Chat\",\n\n      section:\n        \"ER-05A\",\n\n      event:\n        \"whole-response-code-fence-repaired\",\n\n      language:\n        fenceNormalization.language,\n\n      answerCharacters:\n        answer.length\n    })\n  );\n}\n\n\n/* =========================================================\n * ER-06 — IMPLEMENTATION DETECTION\n * ========================================================= */\n\n/*\n * Detect any complete Markdown fenced block with content.\n *\n * Do not restrict detection to only a hardcoded language\n * because a provider may omit or introduce another language\n * identifier.\n */\nconst implementationFencePattern =\n  /```[A-Za-z0-9_+#.-]*[ \\t]*\\r?\\n[\\s\\S]+?```/;\n\nconst containsImplementationCode =\n  implementationFencePattern.test(\n    answer\n  );\n\n\n/* ---------------------------------------------------------\n * ER-06A — FENCE BALANCE DIAGNOSTIC\n * --------------------------------------------------------- */\n\nconst fenceDelimiterCount =\n  (\n    answer.match(\n      /```/g\n    ) ||\n    []\n  ).length;\n\nconst hasBalancedFences =\n  fenceDelimiterCount % 2 ===\n  0;\n\n\nif (\n  fenceDelimiterCount > 0 &&\n  !hasBalancedFences\n) {\n  node.warn(\n    JSON.stringify({\n      component:\n        \"Extract Response + Update Chat\",\n\n      section:\n        \"ER-06A\",\n\n      event:\n        \"unbalanced-markdown-fences-detected\",\n\n      fenceDelimiterCount:\n        fenceDelimiterCount,\n\n      requestMode:\n        normalizedRequestMode\n    })\n  );\n}\n\n/* =========================================================\n * ER-07 — FORM STATE\n * ========================================================= */\n\nmsg.submission =\n  msg.submission &&\n  typeof msg.submission ===\n    \"object\"\n    ? msg.submission\n    : {};\n\nmsg.submission.data =\n  msg.submission.data &&\n  typeof msg.submission.data ===\n    \"object\"\n    ? msg.submission.data\n    : {};\n\nconst data =\n  msg.submission.data;\n\n\n/* =========================================================\n * ER-08 — USER QUESTION\n * ========================================================= */\n\nconst question =\n  String(\n    msg.userQuestion ||\n    data.userMessage ||\n    (\n      data.composer &&\n      data.composer.userMessage\n    ) ||\n    \"\"\n  ).trim();\n\n\n/* =========================================================\n * ER-09 — CHAT HISTORY\n * ========================================================= */\n\nlet history =\n  [];\n\ntry {\n  const parsedHistory =\n    typeof data.messagesJson ===\n      \"string\"\n      ? JSON.parse(\n          data.messagesJson ||\n          \"[]\"\n        )\n      : data.messagesJson;\n\n  history =\n    Array.isArray(\n      parsedHistory\n    )\n      ? parsedHistory\n      : [];\n} catch (error) {\n  history =\n    [];\n\n  node.warn({\n    component:\n      \"Extract Response + Update Chat\",\n\n    section:\n      \"ER-09\",\n\n    event:\n      \"history-parse-failed\",\n\n    message:\n      error.message\n  });\n}\n\n\n/*\n * Keep only valid visible chat messages.\n */\n\nhistory =\n  history.filter(\n    function (\n      item\n    ) {\n      return (\n        item &&\n        (\n          item.role ===\n            \"user\" ||\n          item.role ===\n            \"assistant\"\n        ) &&\n        typeof item.content ===\n          \"string\" &&\n        item.content.trim() !==\n          \"\"\n      );\n    }\n  );\n\n\n/* =========================================================\n * ER-10 — APPEND USER TURN\n * ========================================================= */\n\nconst lastHistoryMessage =\n  history.length > 0\n    ? history[\n        history.length - 1\n      ]\n    : null;\n\nconst duplicateCurrentUser =\n  Boolean(\n    question &&\n    lastHistoryMessage &&\n    lastHistoryMessage.role ===\n      \"user\" &&\n    lastHistoryMessage.content ===\n      question\n  );\n\n\n/*\n * Normal Send:\n * append current question.\n *\n * Internal generate/revise/validate requests may intentionally\n * avoid adding another visible user turn.\n */\n\n/*\n * Trust the backend flag alone. It is now scoped specifically\n * to the Proceed chip's synthetic message — a stage-driven\n * plain-text turn must remain visible in the transcript.\n */\nconst skipUserAppend =\n  msg.skipUserHistoryAppend ===\n  true;\n\n\nif (\n  question &&\n  !skipUserAppend &&\n  !duplicateCurrentUser\n) {\n  history.push({\n    id:\n      \"user-\" +\n      Date.now(),\n\n    role:\n      \"user\",\n\n    content:\n      question,\n\n    text:\n      question,\n\n    createdAt:\n      new Date()\n        .toISOString()\n  });\n}\n\n\n/* =========================================================\n * ER-11 — APPEND ASSISTANT TURN\n * ========================================================= */\n\nhistory.push({\n  id:\n    \"assistant-\" +\n    Date.now(),\n\n  role:\n    \"assistant\",\n\n  content:\n    answer,\n\n  text:\n    answer,\n\n  createdAt:\n    new Date()\n      .toISOString()\n});\n\n\nhistory =\n  history.slice(\n    -20\n  );\n\n\n/* =========================================================\n * ER-12 — RESPONSE-DRIVEN WORKFLOW STATE\n *\n * The stage reflects what the agent ACTUALLY returned.\n *\n * Understand:\n *   requirements / assumptions / clarification\n *\n * Code:\n *   implementation code has actually been returned\n *\n * Validate:\n *   validation/review response has been returned\n *\n * Complete:\n *   final confirmation / completion response has been returned\n * ========================================================= */\n\n\n/* ---------------------------------------------------------\n * ER-12A — UNDERSTAND RESPONSE\n * --------------------------------------------------------- */\n\nif (\n  normalizedRequestMode ===\n  \"understand\"\n) {\n\n  /*\n   * If the user confirmed assumptions and the model returned\n   * actual implementation code during this turn, promote the\n   * workflow to Code.\n   */\n  if (\n    containsImplementationCode\n  ) {\n    data.currentStage =\n      \"code\";\n\n    data.agentPhase =\n      \"code\";\n\n    data.hasGeneratedCode =\n      \"true\";\n\n    data.readyForCode =\n      \"true\";\n\n  } else {\n    data.currentStage =\n      \"understand\";\n\n    data.agentPhase =\n      \"understand\";\n\n    data.hasGeneratedCode =\n      \"false\";\n\n    /*\n     * Keep model metadata when supplied, otherwise false.\n     */\n    data.readyForCode =\n      agentState.readyForCode\n        ? \"true\"\n        : \"false\";\n  }\n\n  data.validationPassed =\n    \"false\";\n}\n\n\n/* ---------------------------------------------------------\n * ER-12B — GENERATE RESPONSE\n * --------------------------------------------------------- */\n\nelse if (\n  normalizedRequestMode ===\n  \"generate\"\n) {\n\n  /*\n   * Generation mode should only be considered Code when\n   * implementation content is actually present.\n   */\n  if (\n    containsImplementationCode\n  ) {\n    data.currentStage =\n      \"code\";\n\n    data.agentPhase =\n      \"code\";\n\n    data.hasGeneratedCode =\n      \"true\";\n\n  } else {\n    /*\n     * Generation request returned no code.\n     * Stay in Understand rather than falsely advancing.\n     */\n    data.currentStage =\n      \"understand\";\n\n    data.agentPhase =\n      \"understand\";\n\n    data.hasGeneratedCode =\n      \"false\";\n  }\n\n  data.readyForCode =\n    \"true\";\n\n  data.validationPassed =\n    \"false\";\n}\n\n\n/* ---------------------------------------------------------\n * ER-12C — REVISE RESPONSE\n * --------------------------------------------------------- */\n\nelse if (\n  normalizedRequestMode ===\n  \"revise\"\n) {\n\n  data.currentStage =\n    \"code\";\n\n  data.agentPhase =\n    \"code\";\n\n  data.hasGeneratedCode =\n    (\n      containsImplementationCode ||\n      agentState.hasGeneratedCode\n    )\n      ? \"true\"\n      : \"false\";\n\n  data.readyForCode =\n    \"true\";\n\n  data.validationPassed =\n    \"false\";\n}\n\n\n/* ---------------------------------------------------------\n * ER-12D — VALIDATE RESPONSE\n * --------------------------------------------------------- */\n\nelse if (\n  normalizedRequestMode ===\n  \"validate\"\n) {\n\n  /*\n   * The validation request has now actually completed.\n   * Therefore the progress bar may advance to Validate.\n   *\n   * Do NOT jump to Complete here.\n   */\n  data.currentStage =\n    \"validate\";\n\n  data.agentPhase =\n    \"validate\";\n\n  data.hasGeneratedCode =\n    \"true\";\n\n  data.readyForCode =\n    \"true\";\n\n  data.validationPassed =\n    agentState.validationPassed ===\n      true\n      ? \"true\"\n      : \"false\";\n}\n\n\n/* ---------------------------------------------------------\n * ER-12E — COMPLETE RESPONSE\n * --------------------------------------------------------- */\n\nelse if (\n  normalizedRequestMode ===\n  \"complete\"\n) {\n\n  data.currentStage =\n    \"complete\";\n\n  data.agentPhase =\n    \"complete\";\n\n  data.hasGeneratedCode =\n    \"true\";\n\n  data.readyForCode =\n    \"true\";\n\n  data.validationPassed =\n    \"true\";\n}\n\n\n/* ---------------------------------------------------------\n * ER-12F — PRODUCTION DIAGNOSTIC\n * --------------------------------------------------------- */\n\nnode.warn(\n  JSON.stringify({\n    component:\n      \"Extract Response + Update Chat\",\n\n    section:\n      \"ER-12\",\n\n    event:\n      \"workflow-stage-resolved\",\n\n    requestMode:\n      normalizedRequestMode,\n\n    containsImplementationCode:\n      containsImplementationCode,\n\n    currentStage:\n      data.currentStage,\n\n    agentPhase:\n      data.agentPhase,\n\n    hasGeneratedCode:\n      data.hasGeneratedCode,\n\n    validationPassed:\n      data.validationPassed\n  })\n);\n\n/* =========================================================\n * ER-13 — METADATA FIELDS\n * ========================================================= */\n\ndata.missingRequirementsJson =\n  JSON.stringify(\n    agentState\n      .missingRequirements ||\n    []\n  );\n\ndata.processing =\n  false;\n\ndata.processingMessage =\n  \"\";\n\ndata.uiError =\n  \"\";\n\ndata.lastAnswer =\n  answer;\n\n\n/* =========================================================\n * ER-14 — CHAT SERIALIZATION\n * ========================================================= */\n\ndata.messagesJson =\n  JSON.stringify(\n    history\n  );\n\ndata.transcript =\n  history\n    .map(\n      function (\n        item\n      ) {\n        return (\n          (\n            item.role ===\n              \"user\"\n              ? \"You\"\n              : \"SAP Code Agent\"\n          ) +\n          \":\\n\" +\n          item.content\n        );\n      }\n    )\n    .join(\n      \"\\n\\n\"\n    );\n\n\n/* =========================================================\n * ER-15 — CLEAR COMPOSER\n * ========================================================= */\n\ndata.userMessage =\n  \"\";\n\ndata.composer =\n  data.composer &&\n  typeof data.composer ===\n    \"object\"\n    ? data.composer\n    : {};\n\ndata.composer.userMessage =\n  \"\";\n\n\n/* =========================================================\n * ER-16 — ROOT-LEVEL COMPATIBILITY\n * ========================================================= */\n\nmsg.submission.messagesJson =\n  data.messagesJson;\n\nmsg.submission.transcript =\n  data.transcript;\n\nmsg.submission.currentStage =\n  data.currentStage;\n\nmsg.submission.agentPhase =\n  data.agentPhase;\n\nmsg.submission.readyForCode =\n  data.readyForCode;\n\nmsg.submission.hasGeneratedCode =\n  data.hasGeneratedCode;\n\nmsg.submission.validationPassed =\n  data.validationPassed;\n\nmsg.submission.missingRequirementsJson =\n  data.missingRequirementsJson;\n\nmsg.submission.processing =\n  false;\n\nmsg.submission.processingMessage =\n  \"\";\n\nmsg.submission.uiError =\n  \"\";\n\nmsg.submission.lastAnswer =\n  answer;\n\nmsg.submission.userMessage =\n  \"\";\n\nmsg.submission.composer = {\n  userMessage:\n    \"\"\n};\n\n\n/* =========================================================\n * ER-17 — NORMALIZED DOWNSTREAM VALUES\n * ========================================================= */\n\nmsg.agentAnswer =\n  answer;\n\nmsg.assistantResponse =\n  answer;\n\nmsg.responseText =\n  answer;\n\nmsg.chatHistory =\n  history;\n\nmsg.agentState =\n  agentState;\n\nmsg.processing =\n  false;\n\nmsg.currentStage =\n  data.currentStage;\n\nmsg.agentPhase =\n  data.agentPhase;\n\nmsg.validationPassed =\n  data.validationPassed ===\n  \"true\";\n\n\n/*\n * Keep payload suitable for the subsequent View Action path.\n */\n\nmsg.payload = {\n  data:\n    data\n};\n\n\n/* =========================================================\n * ER-18 — DIAGNOSTICS\n * ========================================================= */\n\nnode.status({\n  fill:\n    \"green\",\n\n  shape:\n    \"dot\",\n\n  text:\n    normalizedRequestMode +\n    \" → \" +\n    data.currentStage\n});\n\n\nnode.warn({\n  component:\n    \"Extract Response + Update Chat\",\n\n  section:\n    \"ER-18\",\n\n  event:\n    \"response-state-resolved\",\n\n  requestMode:\n    normalizedRequestMode,\n\n  stateFound:\n    stateFound,\n\n  visibleAnswerCharacters:\n    answer.length,\n\n  containsImplementationCode:\n    containsImplementationCode,\n\n  readyForCode:\n    data.readyForCode,\n\n  hasGeneratedCode:\n    data.hasGeneratedCode,\n\n  validationPassed:\n    data.validationPassed,\n\n  currentStage:\n    data.currentStage,\n\n  historyMessages:\n    history.length\n});\n\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// No external dependencies required.","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":740,"y":160,"wires":[["bef6f8c9e8906e23","cb24dce39483af25","d08883b726fb2082"]]},{"id":"fa1f74bc3a64ae52","type":"function","z":"6a7c6094850c144e","name":"Prepare Validation Message","func":"/*\n * Prepare Validation Message\n *\n * Purpose:\n * 1. Normalize validation failures from the request-builder node.\n * 2. Stop the frontend processing/loading state.\n * 3. Return the workflow to Understand.\n * 4. Preserve Form.io submission data and aXet request metadata.\n * 5. Prepare messages.error and messages.errorTitle for the\n *    Show Validation Error view-action.\n *\n * Production diagnostic sections:\n *\n * PVM-01  Helper functions\n * PVM-02  Submission normalization\n * PVM-03  Validation-message resolution\n * PVM-04  Workflow-state recovery\n * PVM-05  View-action payload preparation\n * PVM-06  Final diagnostics\n */\n\n/* =========================================================\n * PVM-01 — HELPERS\n * ========================================================= */\n\nfunction isPlainObject(value) {\n  return (\n    value &&\n    typeof value === \"object\" &&\n    !Array.isArray(value)\n  );\n}\n\nfunction asText(value) {\n  return typeof value === \"string\"\n    ? value.trim()\n    : \"\";\n}\n\n/* =========================================================\n * PVM-02 — NORMALIZE FORM SUBMISSION\n * ========================================================= */\n\nmsg.submission =\n  isPlainObject(\n    msg.submission\n  )\n    ? msg.submission\n    : {};\n\nmsg.submission.data =\n  isPlainObject(\n    msg.submission.data\n  )\n    ? msg.submission.data\n    : {};\n\nconst data =\n  msg.submission.data;\n\ndata.composer =\n  isPlainObject(\n    data.composer\n  )\n    ? data.composer\n    : {};\n\n/*\n * Preserve any normalized Form data that may have arrived\n * through msg.payload.data.\n */\n\nif (\n  isPlainObject(\n    msg.payload\n  ) &&\n  isPlainObject(\n    msg.payload.data\n  )\n) {\n  Object.assign(\n    data,\n    msg.payload.data\n  );\n\n  data.composer =\n    isPlainObject(\n      data.composer\n    )\n      ? data.composer\n      : {};\n}\n\n/* =========================================================\n * PVM-03 — RESOLVE VALIDATION MESSAGE\n * ========================================================= */\n\nconst validationMessage =\n  asText(\n    msg.uiError\n  ) ||\n  asText(\n    data.uiError\n  ) ||\n  asText(\n    msg.validationError\n  ) ||\n  \"Please enter an SAP coding-related question.\";\n\nlet validationTitle =\n  \"Check your request\";\n\n/*\n * Provide a clearer title for the known request-size error.\n */\n\nif (\n  /too long|character limit|characters or fewer|shorten/i\n    .test(\n      validationMessage\n    )\n) {\n  validationTitle =\n    \"Request is too long\";\n} else if (\n  /please enter|empty|cannot be blank|required/i\n    .test(\n      validationMessage\n    )\n) {\n  validationTitle =\n    \"Enter a request\";\n}\n\n/* =========================================================\n * PVM-04 — RECOVER WORKFLOW AND FORM STATE\n * ========================================================= */\n\ndata.currentStage =\n  \"understand\";\n\ndata.agentPhase =\n  \"understand\";\n\ndata.processing =\n  false;\n\ndata.processingMessage =\n  \"\";\n\ndata.uiError =\n  validationMessage;\n\n/*\n * Preserve the user's current input so they can correct an\n * oversized or invalid request instead of losing it.\n *\n * For an empty request these values naturally remain empty.\n */\n\ndata.userMessage =\n  asText(\n    data.userMessage\n  );\n\ndata.composer.userMessage =\n  asText(\n    data.composer.userMessage\n  ) ||\n  data.userMessage;\n\n/*\n * Validation failure does not imply generated code or\n * successful validation.\n */\n\ndata.hasGeneratedCode =\n  data.hasGeneratedCode === true ||\n  data.hasGeneratedCode === \"true\"\n    ? \"true\"\n    : \"false\";\n\ndata.validationPassed =\n  \"false\";\n\ndata.readyForCode =\n  data.readyForCode === true ||\n  data.readyForCode === \"true\"\n    ? \"true\"\n    : \"false\";\n\nmsg.uiError =\n  validationMessage;\n\nmsg.processing =\n  false;\n\nmsg.currentStage =\n  \"understand\";\n\nmsg.agentPhase =\n  \"understand\";\n\n/* =========================================================\n * PVM-05 — PREPARE VIEW-ACTION PAYLOAD\n * ========================================================= */\n\n/*\n * The validation view-action reads:\n *\n * messages.errorTitle\n * messages.error\n */\n\nmsg.messages = {\n  errorTitle:\n    validationTitle,\n\n  error:\n    validationMessage\n};\n\n/*\n * Preserve the standard Form payload shape.\n */\n\nmsg.payload = {\n  data:\n    data\n};\n\n/*\n * Keep root-level compatibility copies for older Form.io or\n * view-action implementations.\n */\n\nmsg.submission.currentStage =\n  data.currentStage;\n\nmsg.submission.agentPhase =\n  data.agentPhase;\n\nmsg.submission.processing =\n  false;\n\nmsg.submission.processingMessage =\n  \"\";\n\nmsg.submission.uiError =\n  validationMessage;\n\nmsg.submission.userMessage =\n  data.userMessage;\n\nmsg.submission.composer = {\n  userMessage:\n    data.composer.userMessage\n};\n\n/* =========================================================\n * PVM-06 — FINAL DIAGNOSTICS\n * ========================================================= */\n\nnode.status({\n  fill:\n    \"yellow\",\n\n  shape:\n    \"ring\",\n\n  text:\n    validationTitle\n});\n\nnode.warn({\n  component:\n    \"Prepare Validation Message\",\n\n  section:\n    \"PVM-06\",\n\n  event:\n    \"validation-message-ready\",\n\n  title:\n    validationTitle,\n\n  message:\n    validationMessage,\n\n  currentStage:\n    data.currentStage,\n\n  processing:\n    data.processing,\n\n  inputCharacters:\n    Math.max(\n      data.userMessage.length,\n      data.composer.userMessage.length\n    ),\n\n  hasReq:\n    Boolean(\n      msg.req\n    ),\n\n  hasRes:\n    Boolean(\n      msg.res\n    )\n});\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// No external dependencies required.","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":500,"y":260,"wires":[["1210d9e532f0c300","e9ca05d32321115f"]]},{"id":"1210d9e532f0c300","type":"axetflows-view-action","z":"6a7c6094850c144e","name":"Show Validation Error","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"<strong><%= messages.errorTitle %></strong><br>\n<%= messages.error %>","messageType":"danger","x":700,"y":260,"wires":[]},{"id":"949bbf5a8839bf91","type":"function","z":"6a7c6094850c144e","name":"Clear Conversation","func":"/*\n * Clear Conversation\n *\n * Resets the SAP Code Agent state and prepares a fresh\n * submission for redirecting back to the Chat Form.\n */\n\nconst securityContext =\n  msg.__axetFlowsSecurityContext &&\n  typeof msg.__axetFlowsSecurityContext === \"object\"\n    ? msg.__axetFlowsSecurityContext\n    : {};\n\nconst userId =\n  String(\n    msg.userid ||\n    securityContext.userid ||\n    securityContext.userId ||\n    securityContext.sub ||\n    securityContext.user?.id ||\n    \"\"\n  ).trim();\n\n/*\n * Clear user-specific state if it was previously stored.\n */\nif (userId) {\n  const stateKey =\n    \"sapCodeAgentChat:\" + userId;\n\n  flow.set(stateKey, null);\n}\n\n/*\n * Clear any general chat state used by the flow.\n */\nflow.set(\n  \"sapCodeAgentChat\",\n  null\n);\n\nflow.set(\n  \"sapCodeAgentConversation\",\n  null\n);\n\n/*\n * Create a fresh conversation identifier.\n */\nconst conversationId =\n  \"sap-\" +\n  Date.now().toString(36) +\n  \"-\" +\n  Math.random()\n    .toString(36)\n    .slice(2, 10);\n\n/*\n * Redirect initialization data.\n *\n * Return to Chat must be configured as a Redirect action.\n */\nmsg.onInitSubmission = {\n  messagesJson: \"[]\",\n  transcript: \"\",\n  currentStage: \"understand\",\n  processing: false,\n  conversationId: conversationId,\n  userMessage: \"\",\n  composer: {\n    userMessage: \"\"\n  }\n};\n\n/*\n * Keep msg.submission synchronized for compatibility.\n */\nmsg.submission =\n  msg.submission &&\n  typeof msg.submission === \"object\"\n    ? msg.submission\n    : {};\n\nmsg.submission.messagesJson =\n  \"[]\";\n\nmsg.submission.transcript =\n  \"\";\n\nmsg.submission.currentStage =\n  \"understand\";\n\nmsg.submission.processing =\n  false;\n\nmsg.submission.conversationId =\n  conversationId;\n\nmsg.submission.userMessage =\n  \"\";\n\nmsg.submission.composer = {\n  userMessage: \"\"\n};\n\n/*\n * Remove stale backend values from the previous conversation.\n */\ndelete msg.agentAnswer;\ndelete msg.userQuestion;\ndelete msg.chatHistory;\ndelete msg.messages;\ndelete msg.formData;\ndelete msg.data;\n\n/*\n * Optional diagnostic output.\n */\nnode.warn({\n  stage: \"conversation-cleared\",\n  userId: userId,\n  conversationId: conversationId,\n  messagesJson:\n    msg.onInitSubmission.messagesJson\n});\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// No external dependencies required.","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":640,"y":400,"wires":[["2566f449dc0447b5"]]},{"id":"2566f449dc0447b5","type":"axetflows-view-action","z":"6a7c6094850c144e","name":"Refresh New Chat","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":860,"y":400,"wires":[]},{"id":"d6d552afce711d54","type":"catch","z":"6a7c6094850c144e","name":"Catch Backend Errors","scope":["d870761d294014c0","d492b7e1bb27abfd","74d5dc7181cddcce"],"uncaught":false,"x":220,"y":540,"wires":[["55d86cb7372e978c"]]},{"id":"ecbc067adc783c32","type":"function","z":"6a7c6094850c144e","name":"Prepare Safe Error","func":"/*\n * Prepare Safe Error\n *\n * Purpose:\n * 1. Convert backend/LLM failures into a safe user-facing message.\n * 2. Clear processing/loading state.\n * 3. Preserve conversation history and Form metadata.\n * 4. Avoid exposing stack traces, credentials, project IDs,\n *    internal URLs, or raw provider responses to users.\n * 5. Prepare msg.messages.error for the Show Safe Error\n *    view-action.\n *\n * Production diagnostic sections:\n *\n * PSE-01  Error normalization\n * PSE-02  Safe-message classification\n * PSE-03  Form-state recovery\n * PSE-04  Optional chat-history entry\n * PSE-05  View-action payload preparation\n */\n\n/* =========================================================\n * PSE-01 — NORMALIZE ERROR INPUT\n * ========================================================= */\n\nfunction isPlainObject(value) {\n  return (\n    value &&\n    typeof value === \"object\" &&\n    !Array.isArray(value)\n  );\n}\n\nfunction asText(value) {\n  if (\n    value === undefined ||\n    value === null\n  ) {\n    return \"\";\n  }\n\n  return typeof value === \"string\"\n    ? value.trim()\n    : String(\n        value\n      ).trim();\n}\n\nconst backendError =\n  isPlainObject(\n    msg.backendError\n  )\n    ? msg.backendError\n    : {};\n\nconst existingSafeError =\n  isPlainObject(\n    msg.safeError\n  )\n    ? msg.safeError\n    : {};\n\nconst rawInternalMessage =\n  asText(\n    existingSafeError.internalMessage\n  ) ||\n  asText(\n    existingSafeError.message\n  ) ||\n  asText(\n    backendError.message\n  ) ||\n  asText(\n    msg.error &&\n    msg.error.message\n  ) ||\n  asText(\n    msg.error\n  ) ||\n  \"An unexpected backend error occurred.\";\n\nconst statusCodeCandidate =\n  existingSafeError.statusCode ||\n  backendError.statusCode ||\n  msg.statusCode ||\n  0;\n\nconst statusCode =\n  Number.isFinite(\n    Number(\n      statusCodeCandidate\n    )\n  )\n    ? Number(\n        statusCodeCandidate\n      )\n    : 0;\n\nconst normalizedErrorText =\n  rawInternalMessage\n    .toLowerCase();\n\nconst retryAttempted =\n  existingSafeError.retryAttempted === true ||\n  backendError.retryAttempted === true ||\n  Number(\n    msg.sapAgentRetryCount ||\n    0\n  ) > 0;\n\nconst retryExhausted =\n  existingSafeError.retryExhausted === true ||\n  backendError.retryExhausted === true;\n\nnode.warn({\n  component:\n    \"Prepare Safe Error\",\n\n  section:\n    \"PSE-01\",\n\n  event:\n    \"safe-error-input-normalized\",\n\n  statusCode:\n    statusCode,\n\n  retryAttempted:\n    retryAttempted,\n\n  retryExhausted:\n    retryExhausted,\n\n  internalMessage:\n    rawInternalMessage\n});\n\n/* =========================================================\n * PSE-02 — CLASSIFY AND BUILD USER-SAFE MESSAGE\n * ========================================================= */\n\nconst isGatewayTimeout =\n  statusCode === 504 ||\n  normalizedErrorText.includes(\n    \"504\"\n  ) ||\n  normalizedErrorText.includes(\n    \"gateway timeout\"\n  ) ||\n  normalizedErrorText.includes(\n    \"gateway time-out\"\n  );\n\nconst isServiceUnavailable =\n  statusCode === 503 ||\n  normalizedErrorText.includes(\n    \"service unavailable\"\n  );\n\nconst isRateLimited =\n  statusCode === 429 ||\n  normalizedErrorText.includes(\n    \"too many requests\"\n  ) ||\n  normalizedErrorText.includes(\n    \"rate limit\"\n  );\n\nconst isAuthenticationFailure =\n  statusCode === 401 ||\n  statusCode === 403 ||\n  normalizedErrorText.includes(\n    \"unauthorized\"\n  ) ||\n  normalizedErrorText.includes(\n    \"forbidden\"\n  ) ||\n  normalizedErrorText.includes(\n    \"access denied\"\n  );\n\nconst isConnectionFailure =\n  normalizedErrorText.includes(\n    \"econnreset\"\n  ) ||\n  normalizedErrorText.includes(\n    \"etimedout\"\n  ) ||\n  normalizedErrorText.includes(\n    \"socket hang up\"\n  ) ||\n  normalizedErrorText.includes(\n    \"network error\"\n  ) ||\n  normalizedErrorText.includes(\n    \"connection reset\"\n  );\n\nlet safeTitle =\n  \"Unable to generate a response\";\n\nlet safeMessage =\n  \"The SAP Code Agent could not complete this request. Please try again.\";\n\nif (\n  isGatewayTimeout\n) {\n  safeTitle =\n    \"The request took too long\";\n\n  safeMessage =\n    retryAttempted\n      ? (\n          \"The SAP Code Agent timed out again after an automatic retry. \" +\n          \"Please shorten the request, divide it into smaller steps, or try again shortly.\"\n        )\n      : (\n          \"The SAP Code Agent timed out before completing the response. \" +\n          \"Please try again or divide the request into smaller steps.\"\n        );\n} else if (\n  isServiceUnavailable\n) {\n  safeTitle =\n    \"The AI service is temporarily unavailable\";\n\n  safeMessage =\n    \"The SAP Code Agent service is temporarily unavailable. Please try again shortly.\";\n} else if (\n  isRateLimited\n) {\n  safeTitle =\n    \"The AI service is busy\";\n\n  safeMessage =\n    \"The SAP Code Agent is currently receiving too many requests. Please wait briefly and try again.\";\n} else if (\n  isAuthenticationFailure\n) {\n  safeTitle =\n    \"The AI service could not be accessed\";\n\n  safeMessage =\n    \"The configured AI project or model could not be accessed. Please contact the application support team.\";\n} else if (\n  isConnectionFailure\n) {\n  safeTitle =\n    \"The connection was interrupted\";\n\n  safeMessage =\n    \"The connection to the SAP Code Agent service was interrupted. Please try again.\";\n}\n\n/* =========================================================\n * PSE-03 — RECOVER FORM AND WORKFLOW STATE\n * ========================================================= */\n\nmsg.submission =\n  isPlainObject(\n    msg.submission\n  )\n    ? msg.submission\n    : {};\n\nmsg.submission.data =\n  isPlainObject(\n    msg.submission.data\n  )\n    ? msg.submission.data\n    : {};\n\nconst data =\n  msg.submission.data;\n\nconst requestMode =\n  String(\n    msg.agentRequestMode ||\n    data.requestedAction ||\n    \"understand\"\n  )\n    .trim()\n    .toLowerCase();\n\n/*\n * Keep the user at the meaningful workflow stage where the\n * failure occurred. Do not mark the workflow Complete.\n */\n\nif (\n  requestMode === \"generate\" ||\n  requestMode === \"revise\"\n) {\n  data.currentStage =\n    \"code\";\n\n  data.agentPhase =\n    \"code\";\n} else if (\n  requestMode === \"validate\"\n) {\n  data.currentStage =\n    \"validate\";\n\n  data.agentPhase =\n    \"validate\";\n} else if (\n  requestMode === \"complete\"\n) {\n  data.currentStage = \"complete\";\n  data.agentPhase = \"complete\";\n} else {\n  data.currentStage =\n    \"understand\";\n\n  data.agentPhase =\n    \"understand\";\n}\n\ndata.processing =\n  false;\n\ndata.processingMessage =\n  \"\";\n\ndata.uiError =\n  safeMessage;\n\ndata.userMessage =\n  \"\";\n\ndata.composer =\n  isPlainObject(\n    data.composer\n  )\n    ? data.composer\n    : {};\n\ndata.composer.userMessage =\n  \"\";\n\ndata.lastError = {\n  title:\n    safeTitle,\n\n  message:\n    safeMessage,\n\n  statusCode:\n    statusCode,\n\n  retryAttempted:\n    retryAttempted,\n\n  occurredAt:\n    new Date().toISOString()\n};\n\n/*\n * Preserve generated-code state when validation or revision\n * fails. Do not falsely clear previously generated code.\n */\n\nif (\n  requestMode === \"understand\"\n) {\n  data.readyForCode =\n    data.readyForCode === true ||\n    data.readyForCode === \"true\"\n      ? \"true\"\n      : \"false\";\n}\n\ndata.hasGeneratedCode =\n  data.hasGeneratedCode === true ||\n  data.hasGeneratedCode === \"true\"\n    ? \"true\"\n    : \"false\";\n\ndata.validationPassed =\n  \"false\";\n\n/* =========================================================\n * PSE-04 — OPTIONAL SAFE ERROR ENTRY IN CHAT HISTORY\n * ========================================================= */\n\n/*\n * Append one safe assistant message so the error is visible\n * in the conversation after the Form refresh.\n *\n * Do not append internal error details.\n */\n\nlet history = [];\n\ntry {\n  const parsedHistory =\n    typeof data.messagesJson === \"string\"\n      ? JSON.parse(\n          data.messagesJson || \"[]\"\n        )\n      : data.messagesJson;\n\n  history =\n    Array.isArray(\n      parsedHistory\n    )\n      ? parsedHistory\n      : [];\n} catch (error) {\n  history =\n    [];\n\n  node.warn({\n    component:\n      \"Prepare Safe Error\",\n\n    section:\n      \"PSE-04\",\n\n    event:\n      \"history-parse-failed\",\n\n    message:\n      error.message\n  });\n}\n\nhistory =\n  history.filter(\n    function (item) {\n      return (\n        item &&\n        (\n          item.role === \"user\" ||\n          item.role === \"assistant\"\n        ) &&\n        typeof item.content === \"string\" &&\n        item.content.trim() !== \"\"\n      );\n    }\n  );\n\nconst lastHistoryMessage =\n  history[\n    history.length - 1\n  ];\n\nconst duplicateSafeError =\n  lastHistoryMessage &&\n  lastHistoryMessage.role === \"assistant\" &&\n  lastHistoryMessage.content === safeMessage;\n\nif (\n  !duplicateSafeError\n) {\n  history.push({\n    id:\n      \"assistant-error-\" +\n      Date.now(),\n\n    role:\n      \"assistant\",\n\n    content:\n      safeMessage,\n\n    text:\n      safeMessage,\n\n    isError:\n      true,\n\n    createdAt:\n      new Date().toISOString()\n  });\n}\n\nhistory =\n  history.slice(\n    -20\n  );\n\ndata.messagesJson =\n  JSON.stringify(\n    history\n  );\n\ndata.transcript =\n  history\n    .map(\n      function (item) {\n        return (\n          (\n            item.role === \"user\"\n              ? \"You\"\n              : \"SAP Code Agent\"\n          ) +\n          \":\\n\" +\n          item.content\n        );\n      }\n    )\n    .join(\n      \"\\n\\n\"\n    );\n\n/* =========================================================\n * PSE-05 — PREPARE SAFE CHAT RETURN\n *\n * The safe error was already appended to messagesJson in\n * PSE-04. No global error View Action is required.\n * ========================================================= */\n\nmsg.safeError = {\n  title: safeTitle,\n  message: safeMessage,\n  statusCode: statusCode,\n  retryAttempted: retryAttempted,\n  retryExhausted: retryExhausted\n};\n\nmsg.uiError =\n  safeMessage;\n\nmsg.processing =\n  false;\n\nmsg.currentStage =\n  data.currentStage;\n\nmsg.agentPhase =\n  data.agentPhase;\n\n\n/*\n * IMPORTANT:\n * Build a fresh payload object.\n *\n * Do not reuse an existing provider/LLM payload here.\n * This prevents HTTP/runtime/provider objects from leaking\n * into the View Action response and avoids circular JSON\n * serialization errors.\n */\nmsg.payload = {\n  data: {\n    messagesJson:\n      String(\n        data.messagesJson ||\n        \"[]\"\n      ),\n\n    transcript:\n      String(\n        data.transcript ||\n        \"\"\n      ),\n\n    currentStage:\n      String(\n        data.currentStage ||\n        \"understand\"\n      ),\n\n    agentPhase:\n      String(\n        data.agentPhase ||\n        data.currentStage ||\n        \"understand\"\n      ),\n\n    processing:\n      false,\n\n    processingMessage:\n      \"\",\n\n    uiError:\n      safeMessage,\n\n    readyForCode:\n      data.readyForCode === true ||\n      data.readyForCode === \"true\"\n        ? \"true\"\n        : \"false\",\n\n    hasGeneratedCode:\n      data.hasGeneratedCode === true ||\n      data.hasGeneratedCode === \"true\"\n        ? \"true\"\n        : \"false\",\n\n    validationPassed:\n      \"false\",\n\n    conversationId:\n      String(\n        data.conversationId ||\n        \"\"\n      ),\n\n    userMessage:\n      \"\",\n\n    composer: {\n      userMessage:\n        \"\"\n    }\n  }\n};\n\n\n/* =========================================================\n * PSE-05A — SYNCHRONIZE SUBMISSION STATE\n * ========================================================= */\n\nmsg.submission =\n  isPlainObject(\n    msg.submission\n  )\n    ? msg.submission\n    : {};\n\n/*\n * Use an independent plain object rather than assigning\n * msg.payload.data by reference.\n */\nmsg.submission.data =\n  Object.assign(\n    {},\n    msg.payload.data,\n    {\n      composer: {\n        userMessage:\n          \"\"\n      }\n    }\n  );\n\nmsg.submission.messagesJson =\n  msg.payload.data.messagesJson;\n\nmsg.submission.transcript =\n  msg.payload.data.transcript;\n\nmsg.submission.currentStage =\n  msg.payload.data.currentStage;\n\nmsg.submission.agentPhase =\n  msg.payload.data.agentPhase;\n\nmsg.submission.processing =\n  false;\n\nmsg.submission.processingMessage =\n  \"\";\n\nmsg.submission.uiError =\n  safeMessage;\n\nmsg.submission.userMessage =\n  \"\";\n\nmsg.submission.composer = {\n  userMessage:\n    \"\"\n};\n\n\n/*\n * Deliberately DO NOT create:\n *\n * msg.messages.error\n * msg.messages.errorTitle\n *\n * Those existed only for Show Safe Error.\n */\n\n\n/* =========================================================\n * PSE-05B — DIAGNOSTICS\n * ========================================================= */\n\nnode.status({\n  fill:\n    \"red\",\n\n  shape:\n    \"ring\",\n\n  text:\n    safeTitle\n});\n\nnode.warn(\n  JSON.stringify({\n    component:\n      \"Prepare Safe Error\",\n\n    section:\n      \"PSE-05\",\n\n    event:\n      \"safe-chat-return-ready\",\n\n    title:\n      safeTitle,\n\n    statusCode:\n      statusCode,\n\n    retryAttempted:\n      retryAttempted,\n\n    retryExhausted:\n      retryExhausted,\n\n    currentStage:\n      msg.payload.data.currentStage,\n\n    historyMessages:\n      history.length\n  })\n);\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// No external dependencies required.","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":500,"y":540,"wires":[["cb24dce39483af25"]]},{"id":"5f184f9c4d013ac3","type":"axetflows-view-action","z":"6a7c6094850c144e","name":"Show Safe Error","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"<strong><%= messages.errorTitle %></strong><br>\n<%= messages.error %>","messageType":"danger","x":800,"y":540,"wires":[]},{"id":"c172d42c3e84d69e","type":"comment","z":"6a7c6094850c144e","name":"IMPORTANT","info":"The Enabler node is deliberately left without a Project ID because project/model IDs are environment-specific. Open CONFIGURE ME — SAP Code Agent LLM and select an authorized project and model before deployment. No external JavaScript libraries are required.","x":170,"y":40,"wires":[]},{"id":"fa06c3f2e91da071","type":"link in","z":"6a7c6094850c144e","name":"SAP Chat Request","links":["24a3f916d03c4aa6"],"x":420,"y":60,"wires":[["d870761d294014c0"]]},{"id":"c371eacfad14ab9d","type":"link in","z":"6a7c6094850c144e","name":"SAP New Chat","links":["75a22bc1726728e2"],"x":460,"y":400,"wires":[["949bbf5a8839bf91"]]},{"id":"4569ce2211bd3a34","type":"debug","z":"6a7c6094850c144e","name":"Debug LLM Output","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":640,"y":60,"wires":[]},{"id":"bef6f8c9e8906e23","type":"debug","z":"6a7c6094850c144e","name":"Debug Extracted Chat","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":940,"y":60,"wires":[]},{"id":"cb24dce39483af25","type":"function","z":"6a7c6094850c144e","name":"Prepare Chat View Update","func":"/*\n * Prepare Chat View Update\n *\n * Purpose:\n * - prepare the Chat Form after a backend response;\n * - preserve conversation history;\n * - preserve the actual workflow stage;\n * - never force the application to Complete.\n */\n\n/* =========================================================\n * PCV-01 — SOURCE STATE\n * ========================================================= */\n\nfunction isPlainObject(value) {\n  return (\n    value &&\n    typeof value === \"object\" &&\n    !Array.isArray(value)\n  );\n}\n\nconst source =\n  isPlainObject(msg.formData)\n    ? msg.formData\n    : isPlainObject(msg.data)\n      ? msg.data\n      : isPlainObject(\n          msg.submission &&\n          msg.submission.data\n        )\n        ? msg.submission.data\n        : isPlainObject(msg.submission)\n          ? msg.submission\n          : {};\n\n\n/* =========================================================\n * PCV-02 — MESSAGE HISTORY\n * ========================================================= */\n\nlet messagesJson =\n  source.messagesJson ||\n  (\n    msg.submission &&\n    msg.submission.messagesJson\n  ) ||\n  (\n    msg.submission &&\n    msg.submission.data &&\n    msg.submission.data.messagesJson\n  ) ||\n  \"[]\";\n\ntry {\n  const parsed =\n    typeof messagesJson === \"string\"\n      ? JSON.parse(\n          messagesJson\n        )\n      : messagesJson;\n\n  messagesJson =\n    JSON.stringify(\n      Array.isArray(parsed)\n        ? parsed\n        : []\n    );\n} catch (error) {\n  node.warn({\n    component:\n      \"Prepare Chat View Update\",\n\n    section:\n      \"PCV-02\",\n\n    event:\n      \"invalid-messages-json\",\n\n    message:\n      error.message\n  });\n\n  messagesJson =\n    \"[]\";\n}\n\n\n/* =========================================================\n * PCV-03 — RESOLVE REAL WORKFLOW STAGE\n * ========================================================= */\n\nconst currentStage =\n  String(\n    source.currentStage ||\n    (\n      msg.submission &&\n      msg.submission.currentStage\n    ) ||\n    msg.currentStage ||\n    \"understand\"\n  )\n    .trim()\n    .toLowerCase();\n\nconst normalizedStage =\n  [\n    \"understand\",\n    \"code\",\n    \"validate\",\n    \"complete\"\n  ].includes(\n    currentStage\n  )\n    ? currentStage\n    : \"understand\";\n\nconst agentPhase =\n  String(\n    source.agentPhase ||\n    (\n      msg.submission &&\n      msg.submission.agentPhase\n    ) ||\n    msg.agentPhase ||\n    normalizedStage\n  )\n    .trim()\n    .toLowerCase();\n\n\n/* =========================================================\n * PCV-04 — PREPARE REDIRECT INITIALIZATION\n * ========================================================= */\n\nmsg.onInitSubmission = {\n  messagesJson:\n    messagesJson,\n\n  transcript:\n    String(\n      source.transcript ||\n      (\n        msg.submission &&\n        msg.submission.transcript\n      ) ||\n      \"\"\n    ),\n\n  currentStage:\n    normalizedStage,\n\n  agentPhase:\n    agentPhase,\n\n  processing:\n    false,\n\n  processingMessage:\n    \"\",\n\n  readyForCode:\n    String(\n      source.readyForCode ||\n      (\n        msg.submission &&\n        msg.submission.readyForCode\n      ) ||\n      \"false\"\n    ),\n\n  hasGeneratedCode:\n    String(\n      source.hasGeneratedCode ||\n      (\n        msg.submission &&\n        msg.submission.hasGeneratedCode\n      ) ||\n      \"false\"\n    ),\n\n  validationPassed:\n    String(\n      source.validationPassed ||\n      (\n        msg.submission &&\n        msg.submission.validationPassed\n      ) ||\n      \"false\"\n    ),\n\n  conversationId:\n    String(\n      source.conversationId ||\n      (\n        msg.submission &&\n        msg.submission.conversationId\n      ) ||\n      \"\"\n    ),\n\n  composer: {\n    userMessage:\n      \"\"\n  },\n\n  userMessage:\n    \"\"\n};\n\n\n/* =========================================================\n * PCV-05 — COMPATIBILITY COPIES\n * ========================================================= */\n\nmsg.submission =\n  isPlainObject(\n    msg.submission\n  )\n    ? msg.submission\n    : {};\n\nmsg.submission.messagesJson =\n  messagesJson;\n\nmsg.submission.transcript =\n  msg.onInitSubmission.transcript;\n\nmsg.submission.currentStage =\n  normalizedStage;\n\nmsg.submission.agentPhase =\n  agentPhase;\n\nmsg.submission.processing =\n  false;\n\nmsg.submission.processingMessage =\n  \"\";\n\nmsg.submission.readyForCode =\n  msg.onInitSubmission.readyForCode;\n\nmsg.submission.hasGeneratedCode =\n  msg.onInitSubmission.hasGeneratedCode;\n\nmsg.submission.validationPassed =\n  msg.onInitSubmission.validationPassed;\n\nmsg.submission.userMessage =\n  \"\";\n\nmsg.submission.composer = {\n  userMessage:\n    \"\"\n};\n\n\n/* =========================================================\n * PCV-06 — DIAGNOSTIC\n * ========================================================= */\n\nnode.warn({\n  component:\n    \"Prepare Chat View Update\",\n\n  section:\n    \"PCV-06\",\n\n  event:\n    \"redirect-to-chat-prepared\",\n\n  currentStage:\n    normalizedStage,\n\n  agentPhase:\n    agentPhase,\n\n  processing:\n    false\n});\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is started.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":880,"y":280,"wires":[["d6167791045f11a8","7b589e72b219a6fb"]]},{"id":"d6167791045f11a8","type":"debug","z":"6a7c6094850c144e","name":"debug 5","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"true","targetType":"full","statusVal":"","statusType":"auto","x":1000,"y":220,"wires":[]},{"id":"69c9f5fe911c695d","type":"function","z":"6a7c6094850c144e","name":"Save Chat State","func":"/*\n * Save Chat State\n *\n * Stores chat state per authenticated user so that a page refresh\n * can restore messagesJson and the completed response.\n */\n\nif (\n  !msg.submission ||\n  typeof msg.submission !== \"object\"\n) {\n  node.error(\n    \"Save Chat State: msg.submission is missing.\",\n    msg\n  );\n\n  return null;\n}\n\nif (\n  !msg.submission.data ||\n  typeof msg.submission.data !== \"object\"\n) {\n  node.error(\n    \"Save Chat State: msg.submission.data is missing.\",\n    msg\n  );\n\n  return null;\n}\n\nconst data = msg.submission.data;\n\nconst userId = String(\n  msg.userid ||\n  msg.__axetFlowsSecurityContext?.user?.id ||\n  msg.__axetFlowsSecurityContext?.userId ||\n  \"anonymous\"\n);\n\nconst stateKey =\n  \"sapCodeAgentChat:\" + userId;\n\nflow.set(stateKey, {\n  messagesJson:\n    String(data.messagesJson || \"[]\"),\n\n  transcript:\n    String(data.transcript || \"\"),\n\n  currentStage:\n    String(data.currentStage || \"complete\"),\n\n  processing: false,\n\n  conversationId:\n    String(data.conversationId || \"\"),\n\n  savedAt:\n    new Date().toISOString()\n});\n\nnode.warn({\n  stage: \"chat-state-saved\",\n  stateKey: stateKey,\n  messagesJson: data.messagesJson\n});\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is started.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":940,"y":700,"wires":[[]]},{"id":"bfd3514a5ea96b77","type":"function","z":"6a7c6094850c144e","name":"Load Chat State","func":"/*\n * Load Chat State\n *\n * Runs from the Form's onInitForm output.\n * Restores the most recent conversation after Refresh Chat redraws\n * or reloads the current page.\n */\n\nconst userId = String(\n  msg.userid ||\n  msg.__axetFlowsSecurityContext?.user?.id ||\n  msg.__axetFlowsSecurityContext?.userId ||\n  \"anonymous\"\n);\n\nconst stateKey =\n  \"sapCodeAgentChat:\" + userId;\n\nconst stored =\n  flow.get(stateKey) || {\n    messagesJson: \"[]\",\n    transcript: \"\",\n    currentStage: \"understand\",\n    processing: false,\n    conversationId: \"\"\n  };\n\n/*\n * For Form initialization, provide the values through\n * onInitSubmission.\n */\nmsg.onInitSubmission = {\n  messagesJson:\n    stored.messagesJson || \"[]\",\n\n  transcript:\n    stored.transcript || \"\",\n\n  currentStage:\n    stored.currentStage || \"understand\",\n\n  processing: false,\n\n  conversationId:\n    stored.conversationId || \"\",\n\n  composer: {\n    userMessage: \"\"\n  },\n\n  userMessage: \"\"\n};\n\n/*\n * Keep submission synchronized as well.\n */\nmsg.submission =\n  Object.assign(\n    {},\n    msg.submission || {},\n    msg.onInitSubmission\n  );\n\nmsg.submission.data =\n  Object.assign(\n    {},\n    msg.onInitSubmission\n  );\n\nnode.warn({\n  stage: \"chat-state-loaded\",\n  stateKey: stateKey,\n  messagesJson:\n    stored.messagesJson\n});\n\nreturn msg;","outputs":1,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is started.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":840,"y":680,"wires":[[]]},{"id":"ccbd391f199b7f44","type":"axetflows-view-action","z":"6a7c6094850c144e","name":"Refresh Chat","action":"update","redirectPage":null,"downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":1000,"y":560,"wires":[]},{"id":"7b589e72b219a6fb","type":"axetflows-view-action","z":"6a7c6094850c144e","name":"Return to Chat","action":"redirect","redirectPage":"21d415924e0e4841","downloadFile":false,"fileName":"","inputType":"buffer","message":"","messageType":"info","x":1060,"y":400,"wires":[]},{"id":"d08883b726fb2082","type":"use-case","z":"6a7c6094850c144e","name":"","userid":"00uhmmx6l9BYLRayQ417","projectid":"bb580a98-f188-4fd6-ba84-57785a15065f","useCaseCategory":"CA","usecaseid":"UC-0518-FLOW-001","isAI":"","x":920,"y":160,"wires":[]},{"id":"e68b0c7b589217b6","type":"inject","z":"6a7c6094850c144e","name":"","props":[{"p":"payload"},{"p":"topic","vt":"str"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":240,"y":120,"wires":[["5efbd2b9db780d2e"]]},{"id":"55d86cb7372e978c","type":"function","z":"6a7c6094850c144e","name":"Check err","func":"/*\n\n * Check err\n\n *\n\n * Purpose:\n\n * 1. Inspect errors caught from the SAP Code Agent backend.\n\n * 2. Retry transient Enabler/gateway failures once.\n\n * 3. Route permanent or exhausted failures to Prepare Safe Error.\n\n *\n\n * Output 1:\n\n * Retry the original LLM request.\n\n *\n\n * Output 2:\n\n * Prepare a safe user-facing error.\n\n *\n\n * Production diagnostic sections:\n\n *\n\n * CER-01  Error extraction\n\n * CER-02  Error classification\n\n * CER-03  Retry-state handling\n\n * CER-04  Retry preparation\n\n * CER-05  Safe-error routing\n\n */\n\n\n\n/* =========================================================\n\n * CER-01 — EXTRACT AND NORMALIZE ERROR DETAILS\n\n * ========================================================= */\n\n\n\nfunction isPlainObject(value) {\n\n  return (\n\n    value &&\n\n    typeof value === \"object\" &&\n\n    !Array.isArray(value)\n\n  );\n\n}\n\n\n\nfunction asText(value) {\n\n  if (\n\n    value === undefined ||\n\n    value === null\n\n  ) {\n\n    return \"\";\n\n  }\n\n\n\n  if (\n\n    typeof value === \"string\"\n\n  ) {\n\n    return value.trim();\n\n  }\n\n\n\n  try {\n\n    return JSON.stringify(\n\n      value\n\n    );\n\n  } catch (error) {\n\n    return String(\n\n      value\n\n    );\n\n  }\n\n}\n\n\n\nconst errorObject =\n\n  isPlainObject(\n\n    msg.error\n\n  )\n\n    ? msg.error\n\n    : {};\n\n\n\nconst payloadObject =\n\n  isPlainObject(\n\n    msg.payload\n\n  )\n\n    ? msg.payload\n\n    : {};\n\n\n\nconst payloadError =\n\n  isPlainObject(\n\n    payloadObject.error\n\n  )\n\n    ? payloadObject.error\n\n    : {};\n\n\n\nconst nestedPayloadError =\n\n  isPlainObject(\n\n    payloadObject.data\n\n  ) &&\n\n  isPlainObject(\n\n    payloadObject.data.error\n\n  )\n\n    ? payloadObject.data.error\n\n    : {};\n\n\n\nconst errorMessage =\n\n  asText(\n\n    errorObject.message\n\n  ) ||\n\n  asText(\n\n    payloadError.message\n\n  ) ||\n\n  asText(\n\n    nestedPayloadError.message\n\n  ) ||\n\n  asText(\n\n    payloadObject.message\n\n  ) ||\n\n  asText(\n\n    msg.safeError &&\n\n    msg.safeError.message\n\n  ) ||\n\n  asText(\n\n    msg.error\n\n  ) ||\n\n  \"An unexpected backend error occurred.\";\n\n\n\nconst errorName =\n\n  asText(\n\n    errorObject.name\n\n  ) ||\n\n  asText(\n\n    payloadError.name\n\n  ) ||\n\n  \"Error\";\n\n\n\nconst errorStack =\n\n  asText(\n\n    errorObject.stack\n\n  ) ||\n\n  asText(\n\n    payloadError.stack\n\n  );\n\n\n\nconst statusCodeCandidate =\n\n  errorObject.statusCode ||\n\n  errorObject.status ||\n\n  payloadError.statusCode ||\n\n  payloadError.status ||\n\n  nestedPayloadError.statusCode ||\n\n  nestedPayloadError.status ||\n\n  payloadObject.statusCode ||\n\n  payloadObject.status ||\n\n  msg.statusCode ||\n\n  msg.status;\n\n\n\nconst statusCode =\n\n  Number.isFinite(\n\n    Number(\n\n      statusCodeCandidate\n\n    )\n\n  )\n\n    ? Number(\n\n        statusCodeCandidate\n\n      )\n\n    : 0;\n\n\n\nconst normalizedErrorText =\n\n  (\n\n    errorName +\n\n    \" \" +\n\n    errorMessage +\n\n    \" \" +\n\n    errorStack\n\n  )\n\n    .toLowerCase();\n\n\n\nnode.warn(\n  JSON.stringify({\n    component:\n      \"Check err\",\n\n    section:\n      \"CER-01\",\n\n    event:\n      \"backend-error-received\",\n\n    errorName:\n      errorName,\n\n    errorMessage:\n      errorMessage,\n\n    statusCode:\n      statusCode,\n\n    requestMode:\n      msg.agentRequestMode ||\n      \"understand\",\n\n    sourceNode:\n      msg.error &&\n      msg.error.source &&\n      msg.error.source.name\n        ? String(\n            msg.error.source.name\n          )\n        : \"\",\n\n    sourceNodeId:\n      msg.error &&\n      msg.error.source &&\n      msg.error.source.id\n        ? String(\n            msg.error.source.id\n          )\n        : \"\",\n\n    sourceNodeType:\n      msg.error &&\n      msg.error.source &&\n      msg.error.source.type\n        ? String(\n            msg.error.source.type\n          )\n        : \"\"\n  })\n);\n\n\n\n/* =========================================================\n\n * CER-02 — CLASSIFY TRANSIENT AND PERMANENT FAILURES\n\n * ========================================================= */\n\n\n\n/*\n\n * Retry only failures that are reasonably likely to be\n\n * temporary infrastructure or gateway issues.\n\n */\n\n\n\nconst isGatewayTimeout =\n\n  statusCode === 504 ||\n\n  normalizedErrorText.includes(\n\n    \"504\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"gateway timeout\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"gateway time-out\"\n\n  );\n\n\n\nconst isServiceUnavailable =\n\n  statusCode === 503 ||\n\n  normalizedErrorText.includes(\n\n    \"503\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"service unavailable\"\n\n  );\n\n\n\nconst isTooManyRequests =\n\n  statusCode === 429 ||\n\n  normalizedErrorText.includes(\n\n    \"429\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"too many requests\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"rate limit\"\n\n  );\n\n\n\nconst isConnectionFailure =\n\n  normalizedErrorText.includes(\n\n    \"econnreset\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"etimedout\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"socket hang up\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"network error\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"connection reset\"\n\n  );\n\n\n\nconst isEnablerTransientFailure =\n\n  (\n\n    normalizedErrorText.includes(\n\n      \"enabler prompt call failed\"\n\n    ) ||\n\n    normalizedErrorText.includes(\n\n      \"axet.enabler\"\n\n    )\n\n  ) &&\n\n  (\n\n    isGatewayTimeout ||\n\n    isServiceUnavailable ||\n\n    isTooManyRequests ||\n\n    isConnectionFailure\n\n  );\n\n\n\nconst isTransientFailure =\n\n  isGatewayTimeout ||\n\n  isServiceUnavailable ||\n\n  isTooManyRequests ||\n\n  isConnectionFailure ||\n\n  isEnablerTransientFailure;\n\n\n\n/*\n\n * Authentication, permission, malformed-request, and input\n\n * errors should not be retried automatically.\n\n */\n\n\n\nconst isAuthenticationFailure =\n\n  statusCode === 401 ||\n\n  statusCode === 403 ||\n\n  normalizedErrorText.includes(\n\n    \"unauthorized\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"forbidden\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"permission denied\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"access denied\"\n\n  );\n\n\n\nconst isBadRequest =\n\n  statusCode === 400 ||\n\n  statusCode === 404 ||\n\n  statusCode === 422 ||\n\n  normalizedErrorText.includes(\n\n    \"bad request\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"invalid request\"\n\n  ) ||\n\n  normalizedErrorText.includes(\n\n    \"validation error\"\n\n  );\n\n\n\nconst shouldNeverRetry =\n\n  isAuthenticationFailure ||\n\n  isBadRequest;\n\n\n\nnode.warn({\n\n  component:\n\n    \"Check err\",\n\n\n\n  section:\n\n    \"CER-02\",\n\n\n\n  event:\n\n    \"backend-error-classified\",\n\n\n\n  transient:\n\n    isTransientFailure,\n\n\n\n  gatewayTimeout:\n\n    isGatewayTimeout,\n\n\n\n  serviceUnavailable:\n\n    isServiceUnavailable,\n\n\n\n  rateLimited:\n\n    isTooManyRequests,\n\n\n\n  connectionFailure:\n\n    isConnectionFailure,\n\n\n\n  authenticationFailure:\n\n    isAuthenticationFailure,\n\n\n\n  badRequest:\n\n    isBadRequest\n\n});\n\n\n\n/* =========================================================\n\n * CER-03 — RETRY-STATE HANDLING\n\n * ========================================================= */\n\n\n\nconst MAX_RETRIES =\n\n  1;\n\n\n\nconst retryCount =\n\n  Number.isFinite(\n\n    Number(\n\n      msg.sapAgentRetryCount\n\n    )\n\n  )\n\n    ? Number(\n\n        msg.sapAgentRetryCount\n\n      )\n\n    : 0;\n\n\n\nconst retryAvailable =\n\n  retryCount <\n\n  MAX_RETRIES;\n\n\n\nconst shouldRetry =\n\n  isTransientFailure &&\n\n  !shouldNeverRetry &&\n\n  retryAvailable;\n\n\n\n/* =========================================================\n\n * CER-04 — PREPARE RETRY\n\n * ========================================================= */\n\n\n\nif (\n\n  shouldRetry\n\n) {\n\n  msg.sapAgentRetryCount =\n\n    retryCount + 1;\n\n\n\n  msg.isRetry =\n\n    true;\n\n\n\n  msg.retryReason =\n\n    errorMessage;\n\n\n\n  /*\n\n   * Remove the caught error before routing back to the LLM.\n\n   * Preserve messages, query, submission, req/res, security\n\n   * context, and Form button metadata.\n\n   */\n\n  delete msg.error;\n\n  delete msg.safeError;\n\n\n\n  msg.submission =\n\n    isPlainObject(\n\n      msg.submission\n\n    )\n\n      ? msg.submission\n\n      : {};\n\n\n\n  msg.submission.data =\n\n    isPlainObject(\n\n      msg.submission.data\n\n    )\n\n      ? msg.submission.data\n\n      : {};\n\n\n\n  const data =\n\n    msg.submission.data;\n\n\n\n  const requestMode =\n\n    String(\n\n      msg.agentRequestMode ||\n\n      data.requestedAction ||\n\n      \"understand\"\n\n    )\n\n      .trim()\n\n      .toLowerCase();\n\n\n\n  if (\n\n    requestMode === \"generate\" ||\n\n    requestMode === \"revise\"\n\n  ) {\n\n    data.currentStage =\n\n      \"code\";\n\n\n\n    data.agentPhase =\n\n      \"code\";\n\n\n\n    data.processingMessage =\n\n      \"The first attempt timed out. Retrying code generation…\";\n\n  } else if (\n\n    requestMode === \"validate\"\n\n  ) {\n\n    data.currentStage =\n\n      \"validate\";\n\n\n\n    data.agentPhase =\n\n      \"validate\";\n\n\n\n    data.processingMessage =\n\n      \"The first attempt timed out. Retrying code validation…\";\n\n  } else if (\n\n    requestMode === \"complete\"\n\n  ) {\n\n    data.currentStage = \"complete\";\n\n    data.agentPhase = \"complete\";\n\n  }\n\n  else {\n\n    data.currentStage =\n\n      \"understand\";\n\n\n\n    data.agentPhase =\n\n      \"understand\";\n\n\n\n    data.processingMessage =\n\n      \"The first attempt timed out. Retrying your SAP request…\";\n\n  }\n\n\n\n  data.processing =\n\n    true;\n\n\n\n  data.uiError =\n\n    \"\";\n\n\n\n  /*\n\n   * Keep downstream payload shape compatible without\n\n   * replacing the original msg object.\n\n   */\n\n  msg.payload =\n\n    isPlainObject(\n\n      msg.payload\n\n    )\n\n      ? msg.payload\n\n      : {};\n\n\n\n  msg.payload.data =\n\n    data;\n\n\n\n  node.status({\n\n    fill:\n\n      \"yellow\",\n\n\n\n    shape:\n\n      \"ring\",\n\n\n\n    text:\n\n      \"Retrying LLM request\"\n\n  });\n\n\n\n  node.warn({\n\n    component:\n\n      \"Check err\",\n\n\n\n    section:\n\n      \"CER-04\",\n\n\n\n    event:\n\n      \"transient-error-retry-prepared\",\n\n\n\n    retryAttempt:\n\n      msg.sapAgentRetryCount,\n\n\n\n    maximumRetries:\n\n      MAX_RETRIES,\n\n\n\n    requestMode:\n\n      requestMode,\n\n\n\n    errorMessage:\n\n      errorMessage\n\n  });\n\n\n\n  return [\n\n    msg,\n\n    null\n\n  ];\n\n}\n\n\n\n/* =========================================================\n\n * CER-05 — ROUTE TO SAFE ERROR\n\n * ========================================================= */\n\n\n\nmsg.sapAgentRetryCount =\n\n  retryCount;\n\n\n\nmsg.isRetry =\n\n  false;\n\n\n\nmsg.backendError = {\n\n  name:\n\n    errorName,\n\n\n\n  message:\n\n    errorMessage,\n\n\n\n  statusCode:\n\n    statusCode,\n\n\n\n  stack:\n\n    errorStack,\n\n\n\n  transient:\n\n    isTransientFailure,\n\n\n\n  retryAttempted:\n\n    retryCount > 0,\n\n\n\n  retryExhausted:\n\n    isTransientFailure &&\n\n    !retryAvailable,\n\n\n\n  authenticationFailure:\n\n    isAuthenticationFailure,\n\n\n\n  badRequest:\n\n    isBadRequest\n\n};\n\n\n\nmsg.safeError =\n\n  isPlainObject(\n\n    msg.safeError\n\n  )\n\n    ? msg.safeError\n\n    : {};\n\n\n\nmsg.safeError.internalMessage =\n\n  errorMessage;\n\n\n\nmsg.safeError.statusCode =\n\n  statusCode;\n\n\n\nmsg.safeError.retryAttempted =\n\n  retryCount > 0;\n\n\n\nmsg.safeError.retryExhausted =\n\n  isTransientFailure &&\n\n  !retryAvailable;\n\n\n\nnode.status({\n\n  fill:\n\n    \"red\",\n\n\n\n  shape:\n\n    \"ring\",\n\n\n\n  text:\n\n    retryCount > 0\n\n      ? \"LLM retry failed\"\n\n      : \"Backend request failed\"\n\n});\n\n\n\nnode.warn({\n\n  component:\n\n    \"Check err\",\n\n\n\n  section:\n\n    \"CER-05\",\n\n\n\n  event:\n\n    \"safe-error-routing\",\n\n\n\n  retryCount:\n\n    retryCount,\n\n\n\n  maximumRetries:\n\n    MAX_RETRIES,\n\n\n\n  transient:\n\n    isTransientFailure,\n\n\n\n  retryExhausted:\n\n    isTransientFailure &&\n\n    !retryAvailable,\n\n\n\n  statusCode:\n\n    statusCode,\n\n\n\n  errorMessage:\n\n    errorMessage\n\n});\n\n\n\nreturn [\n\n  null,\n\n  msg\n\n];","outputs":2,"setupErrors":0,"functionErrors":0,"closeErrors":0,"initialize":"// Code added here will be run once\n// whenever the node is started.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n\n// You can use module.exports in order to use export mechanism, and use exports objects and functions in other function node.\n// For example: const fnNodeExports = require('@deptapps/function/<function_name>')\n","finalize":"// Code added here will be run when the\n// node is being stopped or re-deployed.\n\n// You can use require(..) in order to hot install NPM dependencies.\n// For example: const lowerCase = require('lower-case@1.1.3')\n\n// You can use importModule(..) in order to hot install ESM NPM dependencies.\n// For example: const chalkNs = await importModule('chalk')\n","x":376.49717999999996,"y":540,"wires":[["d870761d294014c0"],["ecbc067adc783c32"]]},{"id":"74d5dc7181cddcce","type":"enabler-llm","z":"6a7c6094850c144e","name":"Code Agent LLM","model":"gpt-4o","slug":"ntt","projectid":"bb580a98-f188-4fd6-ba84-57785a15065f","x":520,"y":160,"wires":[["d492b7e1bb27abfd","4569ce2211bd3a34"]]},{"id":"5efbd2b9db780d2e","type":"function","z":"6a7c6094850c144e","name":"build fake valid input","func":"// Function node: \"Get Okta ID\"\n// Input: timestamp inject (msg.payload = number)\n// Output: msg.payload replaced with a debug-friendly object showing the Okta ID\n\nconst oktaId =\n    (msg.__axetFlowsSecurit