{"log":{"version":"1.0","timestamp":"2026-08-20T11:34:30.710+00:00"},"info":{"deptAppInfo":{"name":"aXet.SAP - Code Agents","creationDate":"2026-03-25T07:01:16.000+00:00","ownerEmailUser":"Hariharan.Ummadisetti@nttdata.com","tags":null},"deptAppVersionInfo":{"alias":"v4.6.2","descriptionMessage":"aXet.Elevate - Resolved max_tokens and project id ","creationDate":"2026-08-19T12:35:51.000+00:00","creationEmailUser":"Hariharan.Ummadisetti@nttdata.com","usedNodes":[{"id":14066,"typeName":"use-case","moduleVersion":{"moduleName":"deptapps-flows-contrib-nodes-audit","versionAlias":"2.2.5","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14586,"typeName":"deptapps-app-auth-okta","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14588,"typeName":"function","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14589,"typeName":"link in","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14590,"typeName":"link out","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14591,"typeName":"comment","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14592,"typeName":"debug","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14593,"typeName":"inject","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14594,"typeName":"catch","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14595,"typeName":"axetflows-view-action","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14596,"typeName":"axetflows-app","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14600,"typeName":"axetflows-form","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14621,"typeName":"enabler-llm","moduleVersion":{"moduleName":"deptapps-flows-contrib-nodes-enabler","versionAlias":"2.2.14","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14631,"typeName":"file in","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}}],"usedSharedSubflowVersions":[]}},"flowsData":{"flows":[{"id":"cab2b2152508727e","type":"tab","label":"SAP Code Agent UI","disabled":false,"info":"Application shell and chatbot form.","env":[],"protected":false},{"id":"6a7c6094850c144e","type":"tab","label":"SAP Code Agent Backend","disabled":false,"info":"Prompt construction, Enabler LLM, response handling, and errors.","env":[],"protected":false},{"id":"31c112ec636990e1","type":"deptapps-app-auth-okta","configurationName":"OKTA Auto-Assistant Config","dbEngineType":"localStorage","databaseName":"deptapp-user-login-okta","userField":"userId","roleField":"roles","autoConfigured":true,"defaults":true,"defaultProject":"bb580a98-f188-4fd6-ba84-57785a15065f","defaultModel":"gpt-5.3-codex"},{"id":"5439b0c95ce6e66d","type":"axetflows-app","z":"cab2b2152508727e","name":"SAP Code Companion","menu":[{"text":"Menu","icon":"fa fa-sitemap","data":{},"children":[{"id":"chat_menu","text":"SAP Code Agent","icon":"fa fa-code","data":{"form_id":"21d415924e0e4841","form_name":"SAP Code Agent Chat","form_permissions":["ROLE_PUBLIC"]},"children":[],"type":"form"}],"type":"root"}],"welcomePage":"21d415924e0e4841","sidebarMenuOrientation":"left","logoImage":"default","schemeColor":"","customCSS":"/* =========================================================\n   SAP Code Agent — Complete Responsive Application CSS\n   Version: 4.2.0\n\n   Includes:\n   - Responsive application card\n   - Header and workflow stepper\n   - Chat surface and message bubbles\n   - Structured Markdown/code-block rendering\n   - Copy/download actions\n   - Bottom-anchored composer\n   - Disabled Send-button state\n   - Model-neutral prompt-budget counter\n   ========================================================= */\n\n/* =========================================================\n   1. GLOBAL VARIABLES\n   ========================================================= */\n\n:root {\n    --sca-blue: #0a6ed1;\n    --sca-blue-hover: #085caf;\n    --sca-blue-soft: #eaf3fc;\n\n    --sca-page-bg: #f4f7fa;\n    --sca-chat-bg: #f8fafc;\n\n    --sca-text: #1f2937;\n    --sca-muted: #65758b;\n\n    --sca-border: #d8e2ed;\n\n    --sca-success: #15803d;\n    --sca-success-bg: #ecfdf3;\n\n    --sca-warning: #b45309;\n    --sca-warning-bg: #fff7ed;\n\n    --sca-danger: #b42318;\n    --sca-danger-bg: #fff1f0;\n\n    /*\n     * Change this only when the surrounding aXet application\n     * header or footer height changes.\n     */\n    --sca-page-offset: 166px;\n\n    /*\n     * Composer now includes:\n     * - message textarea\n     * - prompt-budget counter\n     */\n    --sca-composer-height: 112px;\n    --sca-input-height: 56px;\n    --sca-budget-height: 22px;\n}\n\nhtml,\nbody {\n    width: 100%;\n    height: 100%;\n    min-height: 100%;\n\n    margin: 0;\n}\n\nbody {\n    overflow: hidden !important;\n\n    background: var(--sca-page-bg);\n    color: var(--sca-text);\n\n    font-family:\n        \"Segoe UI\",\n        Arial,\n        Helvetica,\n        sans-serif;\n}\n\n*,\n*::before,\n*::after {\n    box-sizing: border-box;\n}\n\n/* =========================================================\n   2. MAIN APPLICATION CARD\n   ========================================================= */\n\n.formio-form {\n    position: relative !important;\n\n    width: calc(100% - 40px) !important;\n    max-width: none !important;\n\n    height: calc(100vh - var(--sca-page-offset)) !important;\n\n    min-height: 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n\n    margin: 16px auto !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    background: #ffffff;\n\n    border: 1px solid var(--sca-border);\n    border-radius: 16px;\n\n    box-shadow:\n        0 4px 18px rgba(15, 23, 42, 0.06);\n}\n\n/* Remove default Form.io spacing. */\n\n.formio-form .form-group {\n    margin-bottom: 0 !important;\n}\n\n.formio-form .formio-component,\n.formio-form .form-group,\n.formio-form .card-body {\n    box-sizing: border-box;\n}\n\n/* =========================================================\n   3. FORM.IO LAYOUT WRAPPERS\n   ========================================================= */\n\n.formio-form>.formio-component:has(.sca-chat-surface-host),\n.formio-form>.form-group:has(.sca-chat-surface-host),\n.formio-form>.formio-component:has(#sca-chat-surface),\n.formio-form>.form-group:has(#sca-chat-surface) {\n    flex: 1 1 auto !important;\n\n    min-height: 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n\n    overflow: hidden !important;\n}\n\n/*\n * The composer is anchored at the application-card bottom.\n */\n\n.formio-form>.formio-component:has(.formio-component-composer),\n.formio-form>.form-group:has(.formio-component-composer),\n.formio-form>.formio-component:has(.sca-composer),\n.formio-form>.form-group:has(.sca-composer) {\n    position: absolute !important;\n\n    right: 0 !important;\n    bottom: 0 !important;\n    left: 0 !important;\n\n    z-index: 100 !important;\n\n    width: 100% !important;\n\n    height:\n        var(--sca-composer-height) !important;\n\n    min-height:\n        var(--sca-composer-height) !important;\n\n    max-height:\n        var(--sca-composer-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: visible !important;\n}\n\n/* =========================================================\n   4. HEADER\n   ========================================================= */\n\n.sca-header-host {\n    flex: 0 0 auto;\n\n    width: 100%;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.sca-header {\n    position: relative;\n\n    width: 100%;\n\n    background: #ffffff;\n\n    border-bottom:\n        1px solid #e2e8f0;\n}\n\n.sca-brand {\n    min-height: 86px;\n\n    display: flex;\n    align-items: center;\n    gap: 14px;\n\n    padding: 18px 24px;\n}\n\n.sca-logo {\n    width: 48px;\n    height: 48px;\n    flex: 0 0 48px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 10px;\n\n    background: var(--sca-blue);\n    color: #ffffff;\n\n    font-size: 21px;\n    font-weight: 700;\n\n    box-shadow:\n        0 4px 12px rgba(10, 110, 209, 0.18);\n}\n\n.sca-brand-text {\n    min-width: 0;\n}\n\n.sca-title {\n    color: #10213d;\n\n    font-size: 22px;\n    font-weight: 700;\n    line-height: 1.2;\n}\n\n.sca-subtitle {\n    margin-top: 4px;\n\n    color: var(--sca-muted);\n\n    font-size: 14px;\n    line-height: 1.35;\n}\n\n/* =========================================================\n   5. NEW CHAT BUTTON\n   ========================================================= */\n\n.formio-component-newChat {\n    position: absolute !important;\n\n    top: 22px !important;\n    right: 24px !important;\n\n    z-index: 120 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-newChat .form-group {\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-newChat button,\n.formio-component-newChat .btn {\n    min-height: 40px;\n\n    display: inline-flex !important;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n\n    margin: 0 !important;\n    padding: 0 14px !important;\n\n    border:\n        1px solid #c9d6e5 !important;\n\n    border-radius: 9px !important;\n\n    background: #ffffff !important;\n    color: #14213d !important;\n\n    font-size: 13px;\n    font-weight: 600;\n\n    box-shadow: none !important;\n}\n\n.formio-component-newChat button:hover,\n.formio-component-newChat .btn:hover {\n    border-color:\n        #9eb7d2 !important;\n\n    background:\n        #f7f9fc !important;\n}\n\n/* =========================================================\n   6. WORKFLOW STEPPER\n   ========================================================= */\n\n.sca-stepper {\n    display: flex;\n    align-items: flex-start;\n\n    padding: 16px 38px 20px;\n\n    background: #ffffff;\n\n    border-top:\n        1px solid #eef2f7;\n}\n\n.sca-step {\n    min-width: 78px;\n\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n.sca-step-circle {\n    width: 32px;\n    height: 32px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border:\n        2px solid #b9c8da;\n\n    border-radius: 50%;\n\n    background: #ffffff;\n    color: #64748b;\n\n    font-size: 13px;\n    font-weight: 600;\n\n    transition:\n        background-color 0.25s ease,\n        border-color 0.25s ease,\n        color 0.25s ease,\n        transform 0.2s ease;\n}\n\n.sca-step-label {\n    margin-top: 8px;\n\n    color: #64748b;\n\n    font-size: 12px;\n    font-weight: 600;\n    white-space: nowrap;\n}\n\n.sca-step-line {\n    height: 2px;\n\n    flex: 1 1 auto;\n    min-width: 34px;\n\n    margin:\n        15px 14px 0;\n\n    background: #d6e0eb;\n\n    transition:\n        background-color 0.25s ease,\n        box-shadow 0.25s ease;\n}\n\n.sca-step.is-active .sca-step-circle,\n.sca-step.is-complete .sca-step-circle {\n    border-color:\n        var(--sca-blue);\n\n    background:\n        var(--sca-blue);\n\n    color: #ffffff;\n}\n\n.sca-step.is-active .sca-step-circle {\n    transform: scale(1.06);\n\n    box-shadow:\n        0 0 0 4px rgba(10, 110, 209, 0.12);\n}\n\n.sca-step.is-active .sca-step-label {\n    color: #111827;\n}\n\n.sca-step.is-complete .sca-step-label {\n    color: var(--sca-blue);\n}\n\n.sca-step-line.is-complete {\n    background: var(--sca-blue);\n\n    box-shadow:\n        0 0 0 1px rgba(10, 110, 209, 0.06);\n}\n\n/* =========================================================\n   7. CHAT VIEWPORT\n   ========================================================= */\n\n.sca-chat-surface-host,\n.formio-component-chatSurface,\n.formio-component-chatSurface>.form-group,\n.formio-component-chatSurface .form-group {\n    width: 100% !important;\n    height: 100% !important;\n\n    min-height: 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    background:\n        var(--sca-chat-bg);\n}\n\n#sca-chat-surface,\n.sca-chat-surface {\n    width: 100% !important;\n    height: 100% !important;\n\n    min-height: 0 !important;\n    max-height: none !important;\n\n    flex: 1 1 auto !important;\n\n    display: block !important;\n\n    overflow-x: hidden !important;\n    overflow-y: auto !important;\n\n    padding:\n        20px 24px calc(var(--sca-composer-height) + 20px) !important;\n\n    background:\n        var(--sca-chat-bg);\n\n    scroll-behavior: smooth;\n\n    overscroll-behavior:\n        contain;\n\n    scrollbar-gutter:\n        auto;\n}\n\n/* Firefox scrollbar. */\n\n#sca-chat-surface,\n.sca-chat-surface {\n    scrollbar-width: thin;\n\n    scrollbar-color:\n        #9aa9ba transparent;\n}\n\n/* Chromium/Edge scrollbar. */\n\n#sca-chat-surface::-webkit-scrollbar,\n.sca-chat-surface::-webkit-scrollbar {\n    width: 9px;\n}\n\n#sca-chat-surface::-webkit-scrollbar-track,\n.sca-chat-surface::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n#sca-chat-surface::-webkit-scrollbar-thumb,\n.sca-chat-surface::-webkit-scrollbar-thumb {\n    border:\n        2px solid transparent;\n\n    border-radius: 999px;\n\n    background: #a7b4c3;\n\n    background-clip:\n        padding-box;\n}\n\n#sca-chat-surface::-webkit-scrollbar-thumb:hover,\n.sca-chat-surface::-webkit-scrollbar-thumb:hover {\n    background: #8796a8;\n\n    background-clip:\n        padding-box;\n}\n\n/* =========================================================\n   8. CHAT LOG\n   ========================================================= */\n\n#sca-chat-log,\n.sca-chat-log {\n    width: 100%;\n    min-height: 100%;\n\n    display: flex !important;\n    flex-direction: column;\n    gap: 20px;\n\n    margin: 0;\n    padding: 0;\n}\n\n.sca-message-row {\n    width: 100%;\n    min-width: 0;\n\n    display: flex !important;\n    align-items: flex-start;\n    gap: 12px;\n}\n\n.sca-message-row.assistant {\n    justify-content: flex-start;\n}\n\n.sca-message-row.user {\n    justify-content: flex-end;\n}\n\n/* =========================================================\n   9. AVATARS\n   ========================================================= */\n\n.sca-avatar {\n    width: 40px;\n    height: 40px;\n\n    flex: 0 0 40px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 10px;\n\n    font-size: 14px;\n    font-weight: 700;\n}\n\n.sca-avatar svg {\n    width: 22px;\n    height: 22px;\n\n    display: block;\n\n    fill: currentColor;\n}\n\n.sca-avatar.assistant {\n    background:\n        var(--sca-blue);\n\n    color: #ffffff;\n\n    box-shadow:\n        0 3px 9px rgba(10, 110, 209, 0.18);\n}\n\n.sca-avatar.user {\n    background: #e5edf6;\n    color: #19324f;\n}\n\n/* =========================================================\n   10. MESSAGE BUBBLES\n   ========================================================= */\n\n.sca-message-bubble {\n    position: relative;\n\n    min-width: 0;\n\n    border-radius: 14px;\n\n    white-space: pre-wrap;\n\n    overflow-wrap: anywhere;\n    word-break: normal;\n}\n\n.sca-message-row.assistant .sca-message-bubble {\n    width:\n        calc(100% - 52px) !important;\n\n    max-width:\n        calc(100% - 52px) !important;\n\n    padding:\n        15px 18px 11px;\n\n    background: #ffffff;\n    color: #26374a;\n\n    border:\n        1px solid #d9e3ee;\n\n    border-radius:\n        5px 14px 14px 14px;\n\n    box-shadow:\n        0 2px 8px rgba(15, 23, 42, 0.06);\n}\n\n.sca-message-row.user .sca-message-bubble {\n    width: fit-content;\n\n    max-width:\n        min(68%, 760px);\n\n    padding:\n        12px 15px 10px;\n\n    background: #e7f1fd;\n    color: #1d334d;\n\n    border:\n        1px solid #cee1f5;\n\n    border-radius:\n        14px 5px 14px 14px;\n\n    box-shadow:\n        0 2px 6px rgba(15, 23, 42, 0.045);\n}\n\n.sca-message-content {\n    width: 100%;\n\n    color: inherit;\n\n    font-size: 14px;\n    line-height: 1.6;\n\n    white-space: pre-wrap;\n\n    overflow-wrap: anywhere;\n}\n\n.sca-message-time {\n    display: block;\n\n    margin-top: 8px;\n\n    color: #8290a2;\n\n    font-size: 10px;\n    line-height: 1.2;\n}\n\n/* =========================================================\n   11. LOADING STATE\n   ========================================================= */\n\n.sca-loading-inline {\n    min-height: 24px;\n\n    display: flex;\n    align-items: center;\n    gap: 9px;\n\n    color: #344860;\n\n    font-size: 14px;\n}\n\n.sca-loading-label {\n    display: inline-block;\n\n    color: #344860;\n\n    font-size: 14px;\n\n    line-height: 1.4;\n}\n\n.sca-message-row.is-loading .sca-message-footer {\n    margin-top: 6px;\n}\n\n.sca-spinner {\n    width: 16px;\n    height: 16px;\n\n    flex: 0 0 16px;\n\n    border:\n        2px solid #cad7e5;\n\n    border-top-color:\n        var(--sca-blue);\n\n    border-radius: 50%;\n\n    animation:\n        sca-spin 0.75s linear infinite;\n}\n\n@keyframes sca-spin {\n    to {\n        transform: rotate(360deg);\n    }\n}\n\n/* =========================================================\n   12. STRUCTURED ASSISTANT RESPONSES\n   ========================================================= */\n\n/*\n * Structured assistant output is real DOM produced by the\n * controller, so whitespace should be controlled by the\n * generated paragraph/list elements rather than pre-wrap.\n */\n\n.sca-message-row.assistant .sca-message-content {\n    white-space: normal;\n}\n\n\n/* ---------------------------------------------------------\n   Paragraphs\n   --------------------------------------------------------- */\n\n.sca-response-paragraph {\n    margin:\n        0 0 12px;\n\n    color:\n        inherit;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.65;\n\n    white-space:\n        normal;\n\n    overflow-wrap:\n        anywhere;\n}\n\n.sca-response-paragraph:last-child {\n    margin-bottom:\n        0;\n}\n\n\n/* ---------------------------------------------------------\n   Markdown headings\n   --------------------------------------------------------- */\n\n.sca-response-heading {\n    color:\n        #172b45;\n\n    font-weight:\n        700;\n\n    letter-spacing:\n        -0.01em;\n\n    overflow-wrap:\n        anywhere;\n}\n\n.sca-response-heading-2 {\n    margin:\n        20px 0 11px;\n\n    font-size:\n        18px;\n\n    line-height:\n        1.35;\n}\n\n.sca-response-heading-3 {\n    margin:\n        16px 0 9px;\n\n    font-size:\n        16px;\n\n    line-height:\n        1.4;\n}\n\n.sca-response-heading-4,\n.sca-response-heading-5,\n.sca-response-heading-6 {\n    margin:\n        13px 0 8px;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.45;\n}\n\n.sca-message-content .sca-response-heading:first-child {\n    margin-top:\n        0;\n}\n\n\n/* ---------------------------------------------------------\n   Bold / highlighted response text\n   --------------------------------------------------------- */\n\n.sca-response-strong,\n.sca-message-content strong {\n    color:\n        #10213d;\n\n    font-weight:\n        700;\n}\n\n\n/* ---------------------------------------------------------\n   Root ordered/unordered lists\n   --------------------------------------------------------- */\n\n.sca-response-list {\n    margin:\n        8px 0 15px 22px;\n\n    padding-left:\n        14px;\n\n    color:\n        inherit;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.65;\n}\n\n.sca-response-list>li {\n    margin:\n        8px 0;\n\n    padding-left:\n        4px;\n}\n\n\n/*\n * Explicitly use normal decimal numbering.\n * Individual <li value=\"...\"> values written by the JS\n * renderer preserve model-provided numbering.\n */\n\nol.sca-response-list {\n    list-style-type:\n        decimal;\n}\n\nul.sca-response-list {\n    list-style-type:\n        disc;\n}\n\n\n/* ---------------------------------------------------------\n   Paragraphs belonging to one numbered item\n   --------------------------------------------------------- */\n\n.sca-response-list-paragraph {\n    margin:\n        7px 0 5px;\n\n    color:\n        inherit;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.6;\n\n    white-space:\n        normal;\n}\n\n\n/* ---------------------------------------------------------\n   Nested lists\n   --------------------------------------------------------- */\n\n.sca-response-nested-list {\n    margin:\n        7px 0 6px 20px;\n\n    padding-left:\n        12px;\n}\n\n.sca-response-nested-list>li {\n    margin:\n        4px 0;\n\n    padding-left:\n        2px;\n}\n\nul.sca-response-nested-list {\n    list-style-type:\n        disc;\n}\n\nol.sca-response-nested-list {\n    list-style-type:\n        decimal;\n}\n\n\n/* ---------------------------------------------------------\n   Inline code\n   --------------------------------------------------------- */\n\n.sca-inline-code {\n    display:\n        inline;\n\n    padding:\n        2px 5px;\n\n    border:\n        1px solid #dce4ed;\n\n    border-radius:\n        5px;\n\n    background:\n        #f1f5f9;\n\n    color:\n        #9f1239;\n\n    font-family:\n        Consolas,\n        \"Courier New\",\n        monospace;\n\n    font-size:\n        0.92em;\n\n    white-space:\n        normal;\n}\n\n/* =========================================================\n   13. CODE BLOCKS\n   ========================================================= */\n\n.sca-code-block {\n    width: 100%;\n\n    margin:\n        12px 0 16px;\n\n    overflow: hidden;\n\n    border:\n        1px solid #26364a;\n\n    border-radius: 10px;\n\n    background: #111827;\n}\n\n.sca-code-header {\n    min-height: 38px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n\n    padding:\n        0 10px 0 14px;\n\n    background: #1f2937;\n    color: #cbd5e1;\n\n    border-bottom:\n        1px solid #334155;\n}\n\n.sca-code-language {\n    min-width: 0;\n\n    color: #cbd5e1;\n\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n}\n\n.sca-code-block pre {\n    width: 100%;\n    max-width: 100%;\n\n    margin: 0;\n    padding: 16px;\n\n    overflow-x: auto;\n\n    background: #111827;\n    color: #e5e7eb;\n\n    tab-size: 2;\n}\n\n.sca-code-block code {\n    display: block;\n\n    min-width: max-content;\n\n    color: inherit;\n\n    font-family:\n        Consolas,\n        \"Courier New\",\n        monospace;\n\n    font-size: 13px;\n    line-height: 1.55;\n\n    white-space: pre;\n}\n\n/* =========================================================\n   14. MESSAGE ACTIONS\n   ========================================================= */\n\n.sca-message-footer {\n    min-height: 26px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n\n    margin-top: 8px;\n}\n\n.sca-message-footer .sca-message-time {\n    margin-top: 0;\n}\n\n.sca-message-actions {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n\n    margin-left: auto;\n}\n\n.sca-message-action,\n.sca-code-copy-action {\n    width: 30px;\n    height: 30px;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    margin: 0;\n    padding: 0;\n\n    border:\n        1px solid transparent;\n\n    border-radius: 7px;\n\n    background: transparent;\n    color: #60758c;\n\n    cursor: pointer;\n\n    transition:\n        background-color 0.15s ease,\n        border-color 0.15s ease,\n        color 0.15s ease,\n        transform 0.15s ease;\n}\n\n.sca-message-action:hover {\n    border-color: #c9d8e7;\n\n    background: #eef5fc;\n    color: var(--sca-blue);\n\n    transform:\n        translateY(-1px);\n}\n\n.sca-code-copy-action {\n    color: #cbd5e1;\n}\n\n.sca-code-copy-action:hover {\n    border-color: #53657a;\n\n    background: #334155;\n    color: #ffffff;\n\n    transform:\n        translateY(-1px);\n}\n\n.sca-message-action:focus,\n.sca-code-copy-action:focus {\n    outline: none;\n\n    border-color:\n        var(--sca-blue);\n\n    box-shadow:\n        0 0 0 3px rgba(10, 110, 209, 0.14);\n}\n\n.sca-message-action.is-success {\n    border-color: #86d5a4;\n\n    background:\n        var(--sca-success-bg);\n\n    color:\n        var(--sca-success);\n}\n\n.sca-code-copy-action.is-success {\n    border-color: #4ade80;\n\n    background: #14532d;\n    color: #bbf7d0;\n}\n\n.sca-message-action svg,\n.sca-code-copy-action svg {\n    width: 17px;\n    height: 17px;\n\n    display: block;\n\n    fill: currentColor;\n}\n\n/* =========================================================\n   14A. PROCEED TO CODE ACTION\n   ========================================================= */\n\n/*\n * Container shown below the newest assistant response when\n * implementation generation is available.\n */\n\n.sca-proceed-wrap {\n    width:\n        100%;\n\n    display:\n        flex;\n\n    align-items:\n        center;\n\n    justify-content:\n        space-between;\n\n    gap:\n        14px;\n\n    margin:\n        14px 0 4px;\n\n    padding:\n        12px 14px;\n\n    border:\n        1px solid #d5e4f3;\n\n    border-radius:\n        10px;\n\n    background:\n        #f7fbff;\n}\n\n\n/* ---------------------------------------------------------\n   Proceed button\n   --------------------------------------------------------- */\n\n.sca-proceed-chip {\n    flex:\n        0 0 auto;\n\n    min-width:\n        148px;\n\n    min-height:\n        40px;\n\n    display:\n        inline-flex !important;\n\n    align-items:\n        center !important;\n\n    justify-content:\n        center !important;\n\n    gap:\n        8px;\n\n    margin:\n        0 !important;\n\n    padding:\n        0 15px !important;\n\n    overflow:\n        hidden !important;\n\n    border:\n        1px solid var(--sca-blue) !important;\n\n    border-radius:\n        9px !important;\n\n    background:\n        var(--sca-blue) !important;\n\n    color:\n        #ffffff !important;\n\n    font-family:\n        \"Segoe UI\",\n        Arial,\n        Helvetica,\n        sans-serif !important;\n\n    font-size:\n        13px !important;\n\n    font-weight:\n        600 !important;\n\n    line-height:\n        1 !important;\n\n    white-space:\n        nowrap;\n\n    cursor:\n        pointer;\n\n    box-shadow:\n        0 4px 11px rgba(10, 110, 209, 0.18);\n\n    transition:\n        background-color 0.15s ease,\n        border-color 0.15s ease,\n        box-shadow 0.15s ease,\n        transform 0.15s ease;\n}\n\n\n/*\n * CRITICAL FIX FOR YOUR SCREENSHOT:\n *\n * The current controller injects an SVG play icon.\n * Without explicit dimensions Electron lets the native SVG\n * consume a very large area inside the raw button.\n */\n\n.sca-proceed-chip svg {\n    width:\n        16px !important;\n\n    height:\n        16px !important;\n\n    min-width:\n        16px !important;\n\n    min-height:\n        16px !important;\n\n    max-width:\n        16px !important;\n\n    max-height:\n        16px !important;\n\n    flex:\n        0 0 16px;\n\n    display:\n        block !important;\n\n    fill:\n        currentColor !important;\n}\n\n\n/* ---------------------------------------------------------\n   Normal hover/focus\n   --------------------------------------------------------- */\n\n.sca-proceed-chip:hover:not(:disabled) {\n    border-color:\n        var(--sca-blue-hover) !important;\n\n    background:\n        var(--sca-blue-hover) !important;\n\n    transform:\n        translateY(-1px);\n\n    box-shadow:\n        0 6px 14px rgba(10, 110, 209, 0.22);\n}\n\n.sca-proceed-chip:focus {\n    outline:\n        none !important;\n\n    box-shadow:\n        0 0 0 3px rgba(10, 110, 209, 0.15) !important;\n}\n\n\n/* ---------------------------------------------------------\n   Requirements are not fully ready yet\n   --------------------------------------------------------- */\n\n.sca-proceed-chip.is-warning {\n    border-color:\n        #e8a23a !important;\n\n    background:\n        #ffffff !important;\n\n    color:\n        #9a5800 !important;\n\n    box-shadow:\n        none !important;\n}\n\n.sca-proceed-chip.is-warning:hover:not(:disabled) {\n    border-color:\n        #d78a1f !important;\n\n    background:\n        var(--sca-warning-bg) !important;\n\n    color:\n        #874b00 !important;\n}\n\n\n/* ---------------------------------------------------------\n   Busy/disabled state\n   --------------------------------------------------------- */\n\n.sca-proceed-chip:disabled,\n.sca-proceed-chip.is-busy {\n    border-color:\n        #b9c9d9 !important;\n\n    background:\n        #dbe5ef !important;\n\n    color:\n        #718398 !important;\n\n    cursor:\n        not-allowed !important;\n\n    transform:\n        none !important;\n\n    box-shadow:\n        none !important;\n}\n\n\n/* ---------------------------------------------------------\n   Proceed description\n   --------------------------------------------------------- */\n\n.sca-proceed-hint {\n    min-width:\n        0;\n\n    flex:\n        1 1 auto;\n\n    color:\n        #65758b;\n\n    font-size:\n        12px;\n\n    line-height:\n        1.45;\n}\n\n\n/*\n * Put the action first visually, then the description.\n */\n\n.sca-proceed-chip {\n    order:\n        1;\n}\n\n.sca-proceed-hint {\n    order:\n        2;\n}\n\n\n/* ---------------------------------------------------------\n   Narrow layouts\n   --------------------------------------------------------- */\n\n@media (max-width: 720px) {\n    .sca-proceed-wrap {\n        flex-direction:\n            column;\n\n        align-items:\n            flex-start;\n    }\n\n    .sca-proceed-chip {\n        width:\n            100%;\n\n        min-width:\n            0;\n    }\n\n    .sca-proceed-hint {\n        width:\n            100%;\n    }\n}\n\n/* =========================================================\n   15. COMPOSER\n   ========================================================= */\n\n.formio-component-composer,\n.sca-composer {\n    position: absolute !important;\n\n    right: 0 !important;\n    bottom: 0 !important;\n    left: 0 !important;\n\n    z-index: 110 !important;\n\n    width: 100% !important;\n\n    height:\n        var(--sca-composer-height) !important;\n\n    min-height:\n        var(--sca-composer-height) !important;\n\n    max-height:\n        var(--sca-composer-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    background: #ffffff;\n\n    border-top:\n        1px solid #dce5ef;\n\n    box-shadow:\n        0 -3px 12px rgba(15, 23, 42, 0.035);\n}\n\n.formio-component-composer>.form-group,\n.formio-component-composer .form-group,\n.formio-component-composer .formio-component,\n.formio-component-composer .card-body,\n.sca-composer>.form-group,\n.sca-composer .form-group {\n    min-width: 0;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n/* =========================================================\n   16. USER MESSAGE INPUT\n   ========================================================= */\n\n.formio-component-userMessage {\n    position: absolute !important;\n\n    right: 76px !important;\n    bottom: 12px !important;\n    left: 16px !important;\n\n    width: auto !important;\n\n    height:\n        var(--sca-input-height) !important;\n\n    min-height:\n        var(--sca-input-height) !important;\n\n    max-height:\n        var(--sca-input-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n}\n\n.formio-component-userMessage>.form-group,\n.formio-component-userMessage .form-group,\n.formio-component-userMessage .formio-component {\n    width: 100% !important;\n    height: 100% !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-userMessage label {\n    display: none !important;\n}\n\n.formio-component-userMessage textarea,\n.formio-component-userMessage .form-control {\n    display: block !important;\n\n    width: 100% !important;\n\n    height:\n        var(--sca-input-height) !important;\n\n    min-height:\n        var(--sca-input-height) !important;\n\n    max-height:\n        var(--sca-input-height) !important;\n\n    margin: 0 !important;\n\n    padding:\n        15px 16px !important;\n\n    resize: none !important;\n\n    overflow-x: hidden !important;\n    overflow-y: auto !important;\n\n    border:\n        1px solid #c7d5e5 !important;\n\n    border-radius:\n        14px !important;\n\n    background:\n        #ffffff !important;\n\n    color:\n        #1f2937 !important;\n\n    font-family:\n        \"Segoe UI\",\n        Arial,\n        Helvetica,\n        sans-serif !important;\n\n    font-size:\n        14px !important;\n\n    line-height:\n        1.5 !important;\n\n    box-shadow:\n        0 1px 3px rgba(15, 23, 42, 0.04) !important;\n}\n\n.formio-component-userMessage textarea::placeholder,\n.formio-component-userMessage .form-control::placeholder {\n    color: #7a899c;\n\n    opacity: 1;\n}\n\n.formio-component-userMessage textarea:focus,\n.formio-component-userMessage .form-control:focus {\n    border-color:\n        var(--sca-blue) !important;\n\n    outline:\n        none !important;\n\n    box-shadow:\n        0 0 0 3px rgba(10, 110, 209, 0.12) !important;\n}\n\n/* ---------------------------------------------------------\n   16A. USER MESSAGE — PROCESSING/DISABLED STATE\n   --------------------------------------------------------- */\n\n.formio-component-userMessage textarea:disabled,\n.formio-component-userMessage .form-control:disabled,\n.formio-component-userMessage textarea.sca-input-disabled,\n.formio-component-userMessage .form-control.sca-input-disabled,\n.formio-component-userMessage textarea[data-sca-processing=\"true\"],\n.formio-component-userMessage .form-control[data-sca-processing=\"true\"] {\n    background:\n        #f4f7fa !important;\n\n    color:\n        #7a899c !important;\n\n    border-color:\n        #d5dee8 !important;\n\n    cursor:\n        not-allowed !important;\n\n    opacity:\n        1 !important;\n\n    box-shadow:\n        none !important;\n}\n\n.formio-component-userMessage textarea:disabled::placeholder,\n.formio-component-userMessage .form-control:disabled::placeholder,\n.formio-component-userMessage textarea[data-sca-processing=\"true\"]::placeholder,\n.formio-component-userMessage .form-control[data-sca-processing=\"true\"]::placeholder {\n    color:\n        #9aa7b5 !important;\n\n    opacity:\n        1 !important;\n}\n\n/* =========================================================\n   17. PROMPT BUDGET\n   ========================================================= */\n\n.sca-prompt-budget-host {\n    position: absolute !important;\n\n    top: 10px !important;\n    right: 76px !important;\n    bottom: auto !important;\n    left: 16px !important;\n\n    z-index: 116 !important;\n\n    width: auto !important;\n\n    height:\n        var(--sca-budget-height) !important;\n\n    min-height:\n        var(--sca-budget-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    pointer-events: none;\n}\n\n.sca-prompt-budget-host>.form-group,\n.sca-prompt-budget-host .form-group,\n.sca-prompt-budget-host .formio-component {\n    width: 100% !important;\n    height: 100% !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.sca-prompt-budget {\n    width: 100%;\n    height: 100%;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 5px;\n\n    margin: 0;\n    padding: 0;\n\n    color: var(--sca-muted);\n\n    font-size: 11px;\n    line-height: 1.15;\n}\n\n.sca-prompt-budget-row {\n    width: 100%;\n    min-width: 0;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n}\n\n#sca-prompt-budget-text {\n    min-width: 0;\n\n    overflow: hidden;\n\n    color: #5f6f82;\n\n    font-size: 11px;\n    font-weight: 600;\n\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.sca-prompt-budget-hint {\n    flex: 0 0 auto;\n\n    color: #8a98aa;\n\n    font-size: 10px;\n    white-space: nowrap;\n}\n\n.sca-prompt-budget-track {\n    width: 100%;\n    height: 5px;\n\n    overflow: hidden;\n\n    border-radius: 999px;\n\n    background: #e2e8f0;\n}\n\n.sca-prompt-budget-bar {\n    width: 0;\n    height: 100%;\n\n    border-radius: inherit;\n\n    background: var(--sca-blue);\n\n    transition:\n        width 0.18s ease,\n        background-color 0.18s ease;\n}\n\n.sca-prompt-budget.is-warning #sca-prompt-budget-text,\n.sca-prompt-budget.is-warning .sca-prompt-budget-hint {\n    color: var(--sca-warning);\n}\n\n.sca-prompt-budget.is-warning .sca-prompt-budget-bar {\n    background: #f59e0b;\n}\n\n.sca-prompt-budget.is-exceeded #sca-prompt-budget-text,\n.sca-prompt-budget.is-exceeded .sca-prompt-budget-hint {\n    color: var(--sca-danger);\n\n    font-weight: 700;\n}\n\n.sca-prompt-budget.is-exceeded .sca-prompt-budget-bar {\n    background: #dc2626;\n}\n\n/* =========================================================\n   18. SEND BUTTON\n   ========================================================= */\n\n.formio-component-sendMessage {\n    position: absolute !important;\n\n    right: 16px !important;\n\n    bottom:\n        calc(12px + (var(--sca-input-height) - 46px) / 2) !important;\n\n    top: auto !important;\n    left: auto !important;\n\n    z-index: 120 !important;\n\n    width: 46px !important;\n    height: 46px !important;\n\n    min-width: 46px !important;\n    min-height: 46px !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    transform: none !important;\n}\n\n.formio-component-sendMessage>.form-group,\n.formio-component-sendMessage .form-group,\n.formio-component-sendMessage .formio-component {\n    width: 46px !important;\n    height: 46px !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-sendMessage button,\n.formio-component-sendMessage .btn,\n.sca-send button,\n.sca-send .btn {\n    width: 46px !important;\n    height: 46px !important;\n\n    min-width: 46px !important;\n    min-height: 46px !important;\n\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden;\n\n    border: 0 !important;\n    border-radius: 50% !important;\n\n    background:\n        var(--sca-blue) !important;\n\n    color:\n        #ffffff !important;\n\n    font-size: 0 !important;\n    line-height: 1 !important;\n\n    box-shadow:\n        0 5px 14px rgba(10, 110, 209, 0.28) !important;\n\n    cursor: pointer !important;\n\n    transition:\n        background-color 0.15s ease,\n        transform 0.15s ease,\n        box-shadow 0.15s ease;\n}\n\n.formio-component-sendMessage button i,\n.formio-component-sendMessage .btn i,\n.formio-component-sendMessage button .fa,\n.formio-component-sendMessage .btn .fa,\n.sca-send button i,\n.sca-send .btn i {\n    margin: 0 !important;\n\n    color:\n        #ffffff !important;\n\n    font-size:\n        17px !important;\n\n    line-height:\n        1 !important;\n}\n\n.formio-component-sendMessage button:hover,\n.formio-component-sendMessage .btn:hover,\n.sca-send button:hover,\n.sca-send .btn:hover {\n    background:\n        var(--sca-blue-hover) !important;\n\n    transform:\n        translateY(-1px);\n}\n\n.formio-component-sendMessage button:disabled,\n.formio-component-sendMessage .btn:disabled,\n.sca-send button:disabled,\n.sca-send .btn:disabled {\n    background:\n        #9eb6ce !important;\n\n    opacity: 1 !important;\n\n    cursor:\n        not-allowed !important;\n\n    transform:\n        none !important;\n\n    box-shadow:\n        none !important;\n}\n\n/* =========================================================\n   19. FORM.IO / GLOBAL NOTIFICATIONS\n   ========================================================= */\n\n/*\n * SAP Code Agent already renders safe errors inside the\n * conversation surface.\n *\n * Do not render Form.io's global alert banner as well.\n * This avoids:\n *\n *   <%= messages.errorTitle %>\n *   <%= messages.error %>\n *\n * appearing above the application and avoids duplicate\n * error presentation.\n */\n\nbody>.alert,\nbody>.alert-dismissible,\n.formio-alert {\n    display: none !important;\n}\n\n/* =========================================================\n   20. HIDDEN FORM.IO STATE COMPONENTS\n   ========================================================= */\n\n.sca-state-field,\n.formio-component-messagesJson,\n.formio-component-transcript,\n.formio-component-currentStage,\n.formio-component-agentPhase,\n.formio-component-processing,\n.formio-component-processingMessage,\n.formio-component-readyForCode,\n.formio-component-hasGeneratedCode,\n.formio-component-validationPassed,\n.formio-component-conversationId,\n.formio-component-selectedMessageId,\n.formio-component-selectedUserPrompt,\n.formio-component-selectedMessageContent,\n.formio-component-selectedDownloadFormat,\n.formio-component-downloadResponse,\n.sca-download-field,\n.sca-download-submit {\n    display: none !important;\n}\n\n/* =========================================================\n   21. TABLET\n   ========================================================= */\n\n@media (max-width: 900px) {\n    :root {\n            --sca-page-offset: 144px;\n            --sca-composer-height: 142px;\n            --sca-input-height: 80px;\n            --sca-budget-height: 30px;\n        }\n\n    .formio-form {\n        width:\n            calc(100% - 16px) !important;\n\n        height:\n            calc(100vh - var(--sca-page-offset)) !important;\n\n        margin:\n            8px auto !important;\n\n        border-radius: 12px;\n    }\n\n    .sca-brand {\n        padding:\n            16px 18px;\n    }\n\n    .sca-stepper {\n        padding:\n            15px 18px 18px;\n    }\n\n    .sca-step {\n        min-width: 62px;\n    }\n\n    .sca-step-line {\n        min-width: 20px;\n\n        margin-right: 8px;\n        margin-left: 8px;\n    }\n\n    #sca-chat-surface,\n    .sca-chat-surface {\n        padding-right:\n            18px !important;\n\n        padding-left:\n            18px !important;\n    }\n\n    .formio-component-newChat {\n        top: 18px !important;\n        right: 18px !important;\n    }\n}\n\n/* =========================================================\n   22. MOBILE\n   ========================================================= */\n\n@media (max-width: 620px) {\n    :root {\n        --sca-page-offset: 126px;\n        --sca-composer-height: 136px;\n        --sca-input-height: 74px;\n        --sca-budget-height: 30px;\n    }\n\n    .formio-form {\n        width: 100% !important;\n\n        height:\n            calc(100vh - var(--sca-page-offset)) !important;\n\n        margin: 0 !important;\n\n        border-right: 0;\n        border-left: 0;\n        border-radius: 0;\n    }\n\n    .sca-brand {\n        padding:\n            14px 112px 14px 14px;\n    }\n\n    .sca-logo {\n        width: 42px;\n        height: 42px;\n\n        flex-basis: 42px;\n    }\n\n    .sca-title {\n        font-size: 18px;\n    }\n\n    .sca-subtitle {\n        font-size: 12px;\n    }\n\n    .sca-stepper {\n        padding:\n            14px 10px 16px;\n    }\n\n    .sca-step {\n        min-width: 48px;\n    }\n\n    .sca-step-label {\n        font-size: 10px;\n    }\n\n    .sca-step-line {\n        min-width: 10px;\n\n        margin-right: 4px;\n        margin-left: 4px;\n    }\n\n    #sca-chat-surface,\n    .sca-chat-surface {\n        padding:\n            14px 12px calc(var(--sca-composer-height) + 20px) !important;\n    }\n\n    .sca-chat-log {\n        gap: 16px;\n    }\n\n    .sca-avatar {\n        width: 34px;\n        height: 34px;\n\n        flex-basis: 34px;\n\n        border-radius: 8px;\n    }\n\n    .sca-message-row {\n        gap: 8px;\n    }\n\n    .sca-message-row.assistant .sca-message-bubble {\n        width:\n            calc(100% - 42px) !important;\n\n        max-width:\n            calc(100% - 42px) !important;\n\n        padding:\n            12px 13px 9px;\n    }\n\n    .sca-message-row.user .sca-message-bubble {\n        max-width: 84%;\n\n        padding:\n            11px 13px 9px;\n    }\n\n    .sca-message-content,\n    .sca-response-paragraph,\n    .sca-response-list {\n        font-size: 13px;\n        line-height: 1.55;\n    }\n\n    .sca-response-heading {\n        font-size: 15px;\n    }\n\n    .sca-code-block pre {\n        padding: 13px;\n    }\n\n    .sca-code-block code {\n        font-size: 12px;\n    }\n\n    .formio-component-composer,\n    .sca-composer {\n        height:\n            var(--sca-composer-height) !important;\n\n        min-height:\n            var(--sca-composer-height) !important;\n\n        max-height:\n            var(--sca-composer-height) !important;\n\n        padding:\n            12px 66px 12px 12px !important;\n    }\n\n    .formio-component-userMessage,\n    .formio-component-userMessage textarea,\n    .formio-component-userMessage .form-control {\n        height:\n            var(--sca-input-height) !important;\n\n        min-height:\n            var(--sca-input-height) !important;\n\n        max-height:\n            var(--sca-input-height) !important;\n    }\n\n    \n\n    .sca-prompt-budget-hint {\n        display: none;\n    }\n\n    #sca-prompt-budget-text {\n        width: 100%;\n    }\n\n    .formio-component-sendMessage {\n        top: auto !important;\n        right: 14px !important;\n\n        bottom:\n            calc(12px + (var(--sca-input-height) - 42px) / 2) !important;\n\n        left: auto !important;\n\n        width: 42px !important;\n        height: 42px !important;\n\n        min-width: 42px !important;\n        min-height: 42px !important;\n    }\n\n    .formio-component-sendMessage>.form-group,\n    .formio-component-sendMessage .form-group,\n    .formio-component-sendMessage button,\n    .formio-component-sendMessage .btn,\n    .sca-send button,\n    .sca-send .btn {\n        width: 42px !important;\n        height: 42px !important;\n\n        min-width: 42px !important;\n        min-height: 42px !important;\n    }\n\n    body>.alert,\n    body>.alert-dismissible,\n    .formio-alert {\n        top: 72px !important;\n        right: 12px !important;\n        left: 12px !important;\n\n        min-width: 0 !important;\n        max-width: none !important;\n    }\n}\n\n/* =========================================================\n   23. SAP CODE AGENT\n       SINGLE-PAGE / NO-SIDEBAR / DENSE DESKTOP OVERRIDE\n   =========================================================\n\n   IMPORTANT:\n   - Keep this section LAST in the CSS file.\n   - Do NOT use transform: scale() on the application.\n   - Do NOT use browser/CSS zoom as the permanent solution.\n   - Scoped with body:has(.sca-header-host) so these shell\n     overrides affect only the SAP Code Agent application.\n   ========================================================= */\n\n\n/* =========================================================\n   23A. REMOVE THE APPLICATION SIDEBAR COMPLETELY\n   ========================================================= */\n\nbody:has(.sca-header-host) :where(#sidebar,\n    #sidebar-wrapper,\n    .sidebar,\n    .sidebar-wrapper,\n    .app-sidebar,\n    .main-sidebar,\n    .side-nav,\n    .sidenav,\n    .left-sidebar,\n    .navigation-sidebar,\n    mat-sidenav,\n    mat-drawer) {\n    display: none !important;\n\n    width: 0 !important;\n    min-width: 0 !important;\n    max-width: 0 !important;\n\n    height: 0 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    visibility: hidden !important;\n    pointer-events: none !important;\n\n    overflow: hidden !important;\n}\n\n\n/*\n * Remove any sidebar backdrop that may be left behind\n * by the application shell.\n */\n\nbody:has(.sca-header-host) :where(.sidebar-backdrop,\n    .drawer-backdrop,\n    .sidenav-backdrop) {\n    display: none !important;\n}\n\n\n/* =========================================================\n   23B. REMOVE / DISABLE HAMBURGER AND SIDEBAR TOGGLES\n   ========================================================= */\n\nbody:has(.sca-header-host) :where(.navbar-toggler,\n    .sidebar-toggle,\n    .sidebar-toggler,\n    .sidenav-toggle,\n    .menu-toggle,\n    .hamburger,\n    .hamburger-button,\n    [data-widget=\"pushmenu\"],\n    button[aria-controls*=\"sidebar\" i],\n    button[aria-controls*=\"sidenav\" i],\n    button[aria-label=\"Toggle sidebar\" i],\n    button[aria-label=\"Toggle navigation\" i],\n    button[title=\"Toggle sidebar\" i],\n    button[title=\"Toggle navigation\" i]) {\n    display: none !important;\n\n    width: 0 !important;\n    min-width: 0 !important;\n    max-width: 0 !important;\n\n    height: 0 !important;\n    min-height: 0 !important;\n    max-height: 0 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    opacity: 0 !important;\n    visibility: hidden !important;\n\n    pointer-events: none !important;\n}\n\n\n/* =========================================================\n   23C. RECLAIM THE WIDTH THAT BELONGED TO THE SIDEBAR\n   ========================================================= */\n\n/*\n * Covers the common layout wrappers used by application\n * shells. The :has() scope prevents this from affecting\n * unrelated aXet applications.\n */\n\nbody:has(.sca-header-host) :where(#content-wrapper,\n    #main-content,\n    .content-wrapper,\n    .main-content,\n    .app-content,\n    .page-content,\n    .page-wrapper,\n    .main-panel,\n    .mat-drawer-content,\n    main) {\n    left: 0 !important;\n\n    width: 100% !important;\n    max-width: none !important;\n\n    margin-left: 0 !important;\n    margin-right: 0 !important;\n\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n}\n\n\n/*\n * Neutralise commonly used sidebar width variables.\n * They do nothing if the host does not define them.\n */\n\nbody:has(.sca-header-host) {\n    --sidebar-width: 0px !important;\n    --sidebar-collapsed-width: 0px !important;\n    --sidenav-width: 0px !important;\n\n    overflow-x: hidden !important;\n}\n\n\n/* =========================================================\n   23D. COMPACT THE OUTER aXet HEADER\n   ========================================================= */\n\n/*\n * This reproduces the height/density you are seeing when\n * Chrome is zoomed out, without scaling the entire DOM.\n */\n\nbody:has(.sca-header-host) :where(.app-header,\n    .main-header,\n    header[role=\"banner\"],\n    .mat-toolbar) {\n    min-height: 56px !important;\n    height: 56px !important;\n\n    padding-top: 6px !important;\n    padding-bottom: 6px !important;\n}\n\n\n/*\n * Bootstrap-type outer navigation.\n */\n\nbody:has(.sca-header-host)> :where(.navbar),\nbody:has(.sca-header-host) :where(.main-header .navbar,\n    .app-header .navbar) {\n    min-height: 56px !important;\n    height: 56px !important;\n}\n\n\n/*\n * Once the hamburger disappears, ensure the brand does not\n * retain its old left-hand spacer.\n */\n\nbody:has(.sca-header-host) :where(.navbar-brand,\n    .app-brand,\n    .header-brand) {\n    margin-left: 0 !important;\n}\n\n\n/* =========================================================\n   23E. DESKTOP DENSITY\n   ========================================================= */\n\n@media (min-width: 901px) {\n\n    /*\n     * These are now the main tuning controls.\n     *\n     * If you later want slightly more/less vertical room,\n     * change --sca-page-offset only.\n     */\n\n    body:has(.sca-header-host) {\n        --sca-page-offset: 138px;\n\n        --sca-composer-height: 104px;\n        --sca-input-height: 58px;\n        --sca-budget-height: 22px;\n\n        --sca-card-max-width: 1600px;\n    }\n\n\n    /* -----------------------------------------------------\n       Main application card\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-form {\n        width: calc(100% - 28px) !important;\n        max-width: var(--sca-card-max-width) !important;\n\n        /*\n         * Fallback first; dynamic viewport second.\n         */\n        height:\n            calc(100vh - var(--sca-page-offset)) !important;\n\n        height:\n            calc(100dvh - var(--sca-page-offset)) !important;\n\n        max-height:\n            calc(100dvh - var(--sca-page-offset)) !important;\n\n        min-height: 0 !important;\n\n        margin:\n            10px auto !important;\n\n        border-radius:\n            14px !important;\n\n        box-shadow:\n            0 3px 14px rgba(15, 23, 42, 0.055) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       SAP Code Agent brand header\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-brand {\n        min-height:\n            58px !important;\n\n        gap:\n            10px !important;\n\n        padding:\n            10px 16px !important;\n    }\n\n    body:has(.sca-header-host) .sca-logo {\n        width:\n            36px !important;\n\n        height:\n            36px !important;\n\n        flex:\n            0 0 36px !important;\n\n        border-radius:\n            8px !important;\n\n        font-size:\n            17px !important;\n\n        box-shadow:\n            0 3px 8px rgba(10, 110, 209, 0.16) !important;\n    }\n\n    body:has(.sca-header-host) .sca-title {\n        font-size:\n            18px !important;\n\n        line-height:\n            1.18 !important;\n    }\n\n    body:has(.sca-header-host) .sca-subtitle {\n        margin-top:\n            2px !important;\n\n        font-size:\n            12px !important;\n\n        line-height:\n            1.3 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       New Chat\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-newChat {\n        top:\n            12px !important;\n\n        right:\n            16px !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-newChat button,\n\n    body:has(.sca-header-host) .formio-component-newChat .btn {\n        min-height:\n            34px !important;\n\n        padding:\n            0 11px !important;\n\n        gap:\n            6px !important;\n\n        border-radius:\n            8px !important;\n\n        font-size:\n            12px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Workflow stepper\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-stepper {\n        padding:\n            10px 24px 12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step {\n        min-width:\n            64px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step-circle {\n        width:\n            26px !important;\n\n        height:\n            26px !important;\n\n        font-size:\n            11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step-label {\n        margin-top:\n            6px !important;\n\n        font-size:\n            11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step-line {\n        min-width:\n            30px !important;\n\n        height:\n            2px !important;\n\n        margin:\n            12px 12px 0 !important;\n    }\n\n    body:has(.sca-header-host) .sca-step.is-active .sca-step-circle {\n        transform:\n            scale(1.04) !important;\n\n        box-shadow:\n            0 0 0 3px rgba(10, 110, 209, 0.11) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Chat viewport\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) #sca-chat-surface,\n\n    body:has(.sca-header-host) .sca-chat-surface {\n        padding:\n            14px 18px calc(var(--sca-composer-height) + 14px) !important;\n\n        scrollbar-gutter:\n            stable;\n    }\n\n    body:has(.sca-header-host) #sca-chat-log,\n\n    body:has(.sca-header-host) .sca-chat-log {\n        gap:\n            14px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Message rows / avatars\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-row {\n        gap:\n            10px !important;\n    }\n\n    body:has(.sca-header-host) .sca-avatar {\n        width:\n            34px !important;\n\n        height:\n            34px !important;\n\n        flex:\n            0 0 34px !important;\n\n        border-radius:\n            8px !important;\n\n        font-size:\n            12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-avatar svg {\n        width:\n            18px !important;\n\n        height:\n            18px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Assistant bubble\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-row.assistant .sca-message-bubble {\n        width:\n            calc(100% - 44px) !important;\n\n        max-width:\n            calc(100% - 44px) !important;\n\n        padding:\n            10px 14px 8px !important;\n\n        border-radius:\n            5px 11px 11px 11px !important;\n\n        box-shadow:\n            0 2px 6px rgba(15, 23, 42, 0.05) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       User bubble\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-row.user .sca-message-bubble {\n        max-width:\n            min(72%, 760px) !important;\n\n        padding:\n            9px 12px 8px !important;\n\n        border-radius:\n            11px 5px 11px 11px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Chat typography\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-content,\n    body:has(.sca-header-host) .sca-response-paragraph,\n    body:has(.sca-header-host) .sca-response-list,\n    body:has(.sca-header-host) .sca-response-list-paragraph {\n        font-size:\n            13px !important;\n\n        line-height:\n            1.5 !important;\n    }\n\n    body:has(.sca-header-host) .sca-message-time {\n        margin-top:\n            6px !important;\n\n        font-size:\n            9px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-heading-2 {\n        margin:\n            15px 0 8px !important;\n\n        font-size:\n            16px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-heading-3 {\n        margin:\n            12px 0 7px !important;\n\n        font-size:\n            14px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-heading-4,\n\n    body:has(.sca-header-host) .sca-response-heading-5,\n\n    body:has(.sca-header-host) .sca-response-heading-6 {\n        margin:\n            10px 0 6px !important;\n\n        font-size:\n            13px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Lists\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-response-list {\n        margin:\n            6px 0 11px 18px !important;\n\n        padding-left:\n            12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-list>li {\n        margin:\n            5px 0 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Code blocks\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-code-block {\n        margin:\n            9px 0 12px !important;\n\n        border-radius:\n            8px !important;\n    }\n\n    body:has(.sca-header-host) .sca-code-header {\n        min-height:\n            32px !important;\n\n        padding:\n            0 8px 0 11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-code-block pre {\n        padding:\n            12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-code-block code {\n        font-size:\n            12px !important;\n\n        line-height:\n            1.48 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Message action buttons\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-footer {\n        min-height:\n            22px !important;\n\n        margin-top:\n            5px !important;\n    }\n\n    body:has(.sca-header-host) .sca-message-action,\n\n    body:has(.sca-header-host) .sca-code-copy-action {\n        width:\n            26px !important;\n\n        height:\n            26px !important;\n\n        border-radius:\n            6px !important;\n    }\n\n    body:has(.sca-header-host) .sca-message-action svg,\n\n    body:has(.sca-header-host) .sca-code-copy-action svg {\n        width:\n            15px !important;\n\n        height:\n            15px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Proceed to Code action\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-proceed-wrap {\n        gap:\n            10px !important;\n\n        margin:\n            10px 0 3px !important;\n\n        padding:\n            9px 11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-proceed-chip {\n        min-width:\n            132px !important;\n\n        min-height:\n            34px !important;\n\n        padding:\n            0 12px !important;\n\n        font-size:\n            12px !important;\n\n        border-radius:\n            8px !important;\n    }\n\n    body:has(.sca-header-host) .sca-proceed-chip svg {\n        width:\n            14px !important;\n\n        height:\n            14px !important;\n\n        min-width:\n            14px !important;\n\n        min-height:\n            14px !important;\n\n        max-width:\n            14px !important;\n\n        max-height:\n            14px !important;\n\n        flex:\n            0 0 14px !important;\n    }\n\n    body:has(.sca-header-host) .sca-proceed-hint {\n        font-size:\n            11px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Composer\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-composer,\n\n    body:has(.sca-header-host) .sca-composer {\n        height:\n            var(--sca-composer-height) !important;\n\n        min-height:\n            var(--sca-composer-height) !important;\n\n        max-height:\n            var(--sca-composer-height) !important;\n\n        box-shadow:\n            0 -2px 8px rgba(15, 23, 42, 0.03) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Text input\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-userMessage {\n        right:\n            60px !important;\n\n        bottom:\n            9px !important;\n\n        left:\n            14px !important;\n\n        height:\n            var(--sca-input-height) !important;\n\n        min-height:\n            var(--sca-input-height) !important;\n\n        max-height:\n            var(--sca-input-height) !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-userMessage textarea,\n\n    body:has(.sca-header-host) .formio-component-userMessage .form-control {\n        height:\n            var(--sca-input-height) !important;\n\n        min-height:\n            var(--sca-input-height) !important;\n\n        max-height:\n            var(--sca-input-height) !important;\n\n        padding:\n            10px 13px !important;\n\n        border-radius:\n            11px !important;\n\n        font-size:\n            13px !important;\n\n        line-height:\n            1.42 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Prompt budget\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-prompt-budget-host {\n        top:\n            7px !important;\n\n        right:\n            60px !important;\n\n        left:\n            14px !important;\n\n        height:\n            var(--sca-budget-height) !important;\n\n        min-height:\n            var(--sca-budget-height) !important;\n    }\n\n    body:has(.sca-header-host) .sca-prompt-budget {\n        gap:\n            4px !important;\n\n        font-size:\n            10px !important;\n    }\n\n    body:has(.sca-header-host) #sca-prompt-budget-text {\n        font-size:\n            10px !important;\n    }\n\n    body:has(.sca-header-host) .sca-prompt-budget-hint {\n        font-size:\n            9px !important;\n    }\n\n    body:has(.sca-header-host) .sca-prompt-budget-track {\n        height:\n            4px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Send button\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-sendMessage {\n        right:\n            14px !important;\n\n        bottom:\n            calc(9px + (var(--sca-input-height) - 38px) / 2) !important;\n\n        width:\n            38px !important;\n\n        height:\n            38px !important;\n\n        min-width:\n            38px !important;\n\n        min-height:\n            38px !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-sendMessage>.form-group,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .form-group,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .formio-component {\n        width:\n            38px !important;\n\n        height:\n            38px !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-sendMessage button,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .btn,\n\n    body:has(.sca-header-host) .sca-send button,\n\n    body:has(.sca-header-host) .sca-send .btn {\n        width:\n            38px !important;\n\n        height:\n            38px !important;\n\n        min-width:\n            38px !important;\n\n        min-height:\n            38px !important;\n\n        box-shadow:\n            0 4px 10px rgba(10, 110, 209, 0.22) !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-sendMessage button i,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .btn i,\n\n    body:has(.sca-header-host) .sca-send button i,\n\n    body:has(.sca-header-host) .sca-send .btn i {\n        font-size:\n            15px !important;\n    }\n}\n\n\n/* =========================================================\n   23F. KEEP TABLET/MOBILE FULL-WIDTH AFTER SIDEBAR REMOVAL\n   ========================================================= */\n\n@media (max-width: 900px) {\n\n    body:has(.sca-header-host) .formio-form {\n        max-width:\n            none !important;\n    }\n}\n\n\n/* =========================================================\n   23G. FOCUS VISIBILITY\n   ========================================================= */\n\nbody:has(.sca-header-host):where(button,\n    textarea,\n    input,\n    select,\n    [tabindex]):focus-visible {\n    outline:\n        2px solid var(--sca-blue) !important;\n\n    outline-offset:\n        2px;\n}","customCSSErrors":0,"authConfig":"Okta","sessionExpireTimeInMinutes":"20","basicInternalDb":