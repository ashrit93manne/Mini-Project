{"log":{"version":"1.0","timestamp":"2026-08-20T11:34:30.710+00:00"},"info":{"deptAppInfo":{"name":"aXet.SAP - Code Agents","creationDate":"2026-03-25T07:01:16.000+00:00","ownerEmailUser":"Hariharan.Ummadisetti@nttdata.com","tags":null},"deptAppVersionInfo":{"alias":"v5.0.0","descriptionMessage":"Code Companion - native Form.io file picker (replacing the injected paperclip), persistent conversation history with a sidebar, and the v4.7.0 menu-toggle removal / attachment extraction changes","creationDate":"2026-08-19T12:35:51.000+00:00","creationEmailUser":"Hariharan.Ummadisetti@nttdata.com","usedNodes":[{"id":14066,"typeName":"use-case","moduleVersion":{"moduleName":"deptapps-flows-contrib-nodes-audit","versionAlias":"2.2.5","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14586,"typeName":"deptapps-app-auth-okta","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14588,"typeName":"function","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14589,"typeName":"link in","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14590,"typeName":"link out","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14591,"typeName":"comment","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14592,"typeName":"debug","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14593,"typeName":"inject","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14594,"typeName":"catch","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14595,"typeName":"axetflows-view-action","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14596,"typeName":"axetflows-app","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14600,"typeName":"axetflows-form","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14621,"typeName":"enabler-llm","moduleVersion":{"moduleName":"deptapps-flows-contrib-nodes-enabler","versionAlias":"2.2.14","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}},{"id":14631,"typeName":"file in","moduleVersion":{"moduleName":"node-red","versionAlias":"v6.5.2 (powered by NODE-RED v4.1.1)","wasInstalledViaPrivateNpmRegistry":false,"npmRegistryUrl":"https://registry.npmjs.org/","hasAI":null}}],"usedSharedSubflowVersions":[]}},"flowsData":{"flows":[{"id":"cab2b2152508727e","type":"tab","label":"SAP Code Agent UI","disabled":false,"info":"Application shell and chatbot form.","env":[],"protected":false},{"id":"6a7c6094850c144e","type":"tab","label":"SAP Code Agent Backend","disabled":false,"info":"Prompt construction, Enabler LLM, response handling, and errors.","env":[],"protected":false},{"id":"31c112ec636990e1","type":"deptapps-app-auth-okta","configurationName":"OKTA Auto-Assistant Config","dbEngineType":"localStorage","databaseName":"deptapp-user-login-okta","userField":"userId","roleField":"roles","autoConfigured":true,"defaults":true,"defaultProject":"bb580a98-f188-4fd6-ba84-57785a15065f","defaultModel":"gpt-5.3-codex"},{"id":"5439b0c95ce6e66d","type":"axetflows-app","z":"cab2b2152508727e","name":"SAP Code Companion","menu":[{"text":"Menu","icon":"fa fa-sitemap","data":{},"children":[{"id":"chat_menu","text":"SAP Code Agent","icon":"fa fa-code","data":{"form_id":"21d415924e0e4841","form_name":"SAP Code Agent Chat","form_permissions":["ROLE_PUBLIC"]},"children":[],"type":"form"}],"type":"root"}],"welcomePage":"21d415924e0e4841","sidebarMenuOrientation":"left","logoImage":"default","schemeColor":"","customCSS":"/* =========================================================\n   SAP Code Agent — Complete Responsive Application CSS\n   Version: 4.2.0\n\n   Includes:\n   - Responsive application card\n   - Header and workflow stepper\n   - Chat surface and message bubbles\n   - Structured Markdown/code-block rendering\n   - Copy/download actions\n   - Bottom-anchored composer\n   - Disabled Send-button state\n   - Model-neutral prompt-budget counter\n   ========================================================= */\n\n/* =========================================================\n   1. GLOBAL VARIABLES\n   ========================================================= */\n\n:root {\n    --sca-blue: #0a6ed1;\n    --sca-blue-hover: #085caf;\n    --sca-blue-soft: #eaf3fc;\n\n    --sca-page-bg: #f4f7fa;\n    --sca-chat-bg: #f8fafc;\n\n    --sca-text: #1f2937;\n    --sca-muted: #65758b;\n\n    --sca-border: #d8e2ed;\n\n    --sca-success: #15803d;\n    --sca-success-bg: #ecfdf3;\n\n    --sca-warning: #b45309;\n    --sca-warning-bg: #fff7ed;\n\n    --sca-danger: #b42318;\n    --sca-danger-bg: #fff1f0;\n\n    /*\n     * Change this only when the surrounding aXet application\n     * header or footer height changes.\n     */\n    --sca-page-offset: 166px;\n\n    /*\n     * Composer now includes:\n     * - message textarea\n     * - prompt-budget counter\n     */\n    --sca-composer-base-height: 112px;\n    --sca-input-height: 56px;\n    --sca-budget-height: 22px;\n}\n\nhtml,\nbody {\n    width: 100%;\n    height: 100%;\n    min-height: 100%;\n\n    margin: 0;\n}\n\nbody {\n    overflow: hidden !important;\n\n    background: var(--sca-page-bg);\n    color: var(--sca-text);\n\n    font-family:\n        \"Segoe UI\",\n        Arial,\n        Helvetica,\n        sans-serif;\n}\n\n*,\n*::before,\n*::after {\n    box-sizing: border-box;\n}\n\n/* =========================================================\n   2. MAIN APPLICATION CARD\n   ========================================================= */\n\n.formio-form {\n    position: relative !important;\n\n    width: calc(100% - 40px) !important;\n    max-width: none !important;\n\n    height: calc(100vh - var(--sca-page-offset)) !important;\n\n    min-height: 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n\n    margin: 16px auto !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    background: #ffffff;\n\n    border: 1px solid var(--sca-border);\n    border-radius: 16px;\n\n    box-shadow:\n        0 4px 18px rgba(15, 23, 42, 0.06);\n}\n\n/* Remove default Form.io spacing. */\n\n.formio-form .form-group {\n    margin-bottom: 0 !important;\n}\n\n.formio-form .formio-component,\n.formio-form .form-group,\n.formio-form .card-body {\n    box-sizing: border-box;\n}\n\n/* =========================================================\n   3. FORM.IO LAYOUT WRAPPERS\n   ========================================================= */\n\n.formio-form>.formio-component:has(.sca-chat-surface-host),\n.formio-form>.form-group:has(.sca-chat-surface-host),\n.formio-form>.formio-component:has(#sca-chat-surface),\n.formio-form>.form-group:has(#sca-chat-surface) {\n    flex: 1 1 auto !important;\n\n    min-height: 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n\n    overflow: hidden !important;\n}\n\n/*\n * The composer is anchored at the application-card bottom.\n */\n\n.formio-form>.formio-component:has(.formio-component-composer),\n.formio-form>.form-group:has(.formio-component-composer),\n.formio-form>.formio-component:has(.sca-composer),\n.formio-form>.form-group:has(.sca-composer) {\n    position: absolute !important;\n\n    right: 0 !important;\n    bottom: 0 !important;\n    left: 0 !important;\n\n    z-index: 100 !important;\n\n    width: 100% !important;\n\n    height:\n        var(--sca-composer-height) !important;\n\n    min-height:\n        var(--sca-composer-height) !important;\n\n    max-height:\n        var(--sca-composer-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: visible !important;\n}\n\n/* =========================================================\n   4. HEADER\n   ========================================================= */\n\n.sca-header-host {\n    flex: 0 0 auto;\n\n    width: 100%;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.sca-header {\n    position: relative;\n\n    width: 100%;\n\n    background: #ffffff;\n\n    border-bottom:\n        1px solid #e2e8f0;\n}\n\n.sca-brand {\n    min-height: 86px;\n\n    display: flex;\n    align-items: center;\n    gap: 14px;\n\n    padding: 18px 24px;\n}\n\n.sca-logo {\n    width: 48px;\n    height: 48px;\n    flex: 0 0 48px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 10px;\n\n    background: var(--sca-blue);\n    color: #ffffff;\n\n    font-size: 21px;\n    font-weight: 700;\n\n    box-shadow:\n        0 4px 12px rgba(10, 110, 209, 0.18);\n}\n\n.sca-brand-text {\n    min-width: 0;\n}\n\n.sca-title {\n    color: #10213d;\n\n    font-size: 22px;\n    font-weight: 700;\n    line-height: 1.2;\n}\n\n.sca-subtitle {\n    margin-top: 4px;\n\n    color: var(--sca-muted);\n\n    font-size: 14px;\n    line-height: 1.35;\n}\n\n/* =========================================================\n   5. NEW CHAT BUTTON\n   ========================================================= */\n\n.formio-component-newChat {\n    position: absolute !important;\n\n    top: 22px !important;\n    right: 24px !important;\n\n    z-index: 120 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-newChat .form-group {\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-newChat button,\n.formio-component-newChat .btn {\n    min-height: 40px;\n\n    display: inline-flex !important;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n\n    margin: 0 !important;\n    padding: 0 14px !important;\n\n    border:\n        1px solid #c9d6e5 !important;\n\n    border-radius: 9px !important;\n\n    background: #ffffff !important;\n    color: #14213d !important;\n\n    font-size: 13px;\n    font-weight: 600;\n\n    box-shadow: none !important;\n}\n\n.formio-component-newChat button:hover,\n.formio-component-newChat .btn:hover {\n    border-color:\n        #9eb7d2 !important;\n\n    background:\n        #f7f9fc !important;\n}\n\n/* =========================================================\n   6. WORKFLOW STEPPER\n   ========================================================= */\n\n.sca-stepper {\n    display: flex;\n    align-items: flex-start;\n\n    padding: 16px 38px 20px;\n\n    background: #ffffff;\n\n    border-top:\n        1px solid #eef2f7;\n}\n\n.sca-step {\n    min-width: 78px;\n\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n.sca-step-circle {\n    width: 32px;\n    height: 32px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border:\n        2px solid #b9c8da;\n\n    border-radius: 50%;\n\n    background: #ffffff;\n    color: #64748b;\n\n    font-size: 13px;\n    font-weight: 600;\n\n    transition:\n        background-color 0.25s ease,\n        border-color 0.25s ease,\n        color 0.25s ease,\n        transform 0.2s ease;\n}\n\n.sca-step-label {\n    margin-top: 8px;\n\n    color: #64748b;\n\n    font-size: 12px;\n    font-weight: 600;\n    white-space: nowrap;\n}\n\n.sca-step-line {\n    height: 2px;\n\n    flex: 1 1 auto;\n    min-width: 34px;\n\n    margin:\n        15px 14px 0;\n\n    background: #d6e0eb;\n\n    transition:\n        background-color 0.25s ease,\n        box-shadow 0.25s ease;\n}\n\n.sca-step.is-active .sca-step-circle,\n.sca-step.is-complete .sca-step-circle {\n    border-color:\n        var(--sca-blue);\n\n    background:\n        var(--sca-blue);\n\n    color: #ffffff;\n}\n\n.sca-step.is-active .sca-step-circle {\n    transform: scale(1.06);\n\n    box-shadow:\n        0 0 0 4px rgba(10, 110, 209, 0.12);\n}\n\n.sca-step.is-active .sca-step-label {\n    color: #111827;\n}\n\n.sca-step.is-complete .sca-step-label {\n    color: var(--sca-blue);\n}\n\n.sca-step-line.is-complete {\n    background: var(--sca-blue);\n\n    box-shadow:\n        0 0 0 1px rgba(10, 110, 209, 0.06);\n}\n\n/* =========================================================\n   7. CHAT VIEWPORT\n   ========================================================= */\n\n.sca-chat-surface-host,\n.formio-component-chatSurface,\n.formio-component-chatSurface>.form-group,\n.formio-component-chatSurface .form-group {\n    width: 100% !important;\n    height: 100% !important;\n\n    min-height: 0 !important;\n\n    display: flex !important;\n    flex-direction: column !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    background:\n        var(--sca-chat-bg);\n}\n\n#sca-chat-surface,\n.sca-chat-surface {\n    width: 100% !important;\n    height: 100% !important;\n\n    min-height: 0 !important;\n    max-height: none !important;\n\n    flex: 1 1 auto !important;\n\n    display: block !important;\n\n    overflow-x: hidden !important;\n    overflow-y: auto !important;\n\n    padding:\n        20px 24px calc(var(--sca-composer-height) + 20px) !important;\n\n    background:\n        var(--sca-chat-bg);\n\n    scroll-behavior: smooth;\n\n    overscroll-behavior:\n        contain;\n\n    scrollbar-gutter:\n        auto;\n}\n\n/* Firefox scrollbar. */\n\n#sca-chat-surface,\n.sca-chat-surface {\n    scrollbar-width: thin;\n\n    scrollbar-color:\n        #9aa9ba transparent;\n}\n\n/* Chromium/Edge scrollbar. */\n\n#sca-chat-surface::-webkit-scrollbar,\n.sca-chat-surface::-webkit-scrollbar {\n    width: 9px;\n}\n\n#sca-chat-surface::-webkit-scrollbar-track,\n.sca-chat-surface::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n#sca-chat-surface::-webkit-scrollbar-thumb,\n.sca-chat-surface::-webkit-scrollbar-thumb {\n    border:\n        2px solid transparent;\n\n    border-radius: 999px;\n\n    background: #a7b4c3;\n\n    background-clip:\n        padding-box;\n}\n\n#sca-chat-surface::-webkit-scrollbar-thumb:hover,\n.sca-chat-surface::-webkit-scrollbar-thumb:hover {\n    background: #8796a8;\n\n    background-clip:\n        padding-box;\n}\n\n/* =========================================================\n   8. CHAT LOG\n   ========================================================= */\n\n#sca-chat-log,\n.sca-chat-log {\n    width: 100%;\n    min-height: 100%;\n\n    display: flex !important;\n    flex-direction: column;\n    gap: 20px;\n\n    margin: 0;\n    padding: 0;\n}\n\n.sca-message-row {\n    width: 100%;\n    min-width: 0;\n\n    display: flex !important;\n    align-items: flex-start;\n    gap: 12px;\n}\n\n.sca-message-row.assistant {\n    justify-content: flex-start;\n}\n\n.sca-message-row.user {\n    justify-content: flex-end;\n}\n\n/* =========================================================\n   9. AVATARS\n   ========================================================= */\n\n.sca-avatar {\n    width: 40px;\n    height: 40px;\n\n    flex: 0 0 40px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    border-radius: 10px;\n\n    font-size: 14px;\n    font-weight: 700;\n}\n\n.sca-avatar svg {\n    width: 22px;\n    height: 22px;\n\n    display: block;\n\n    fill: currentColor;\n}\n\n.sca-avatar.assistant {\n    background:\n        var(--sca-blue);\n\n    color: #ffffff;\n\n    box-shadow:\n        0 3px 9px rgba(10, 110, 209, 0.18);\n}\n\n.sca-avatar.user {\n    background: #e5edf6;\n    color: #19324f;\n}\n\n/* =========================================================\n   10. MESSAGE BUBBLES\n   ========================================================= */\n\n.sca-message-bubble {\n    position: relative;\n\n    min-width: 0;\n\n    border-radius: 14px;\n\n    white-space: pre-wrap;\n\n    overflow-wrap: anywhere;\n    word-break: normal;\n}\n\n.sca-message-row.assistant .sca-message-bubble {\n    width:\n        calc(100% - 52px) !important;\n\n    max-width:\n        calc(100% - 52px) !important;\n\n    padding:\n        15px 18px 11px;\n\n    background: #ffffff;\n    color: #26374a;\n\n    border:\n        1px solid #d9e3ee;\n\n    border-radius:\n        5px 14px 14px 14px;\n\n    box-shadow:\n        0 2px 8px rgba(15, 23, 42, 0.06);\n}\n\n.sca-message-row.user .sca-message-bubble {\n    width: fit-content;\n\n    max-width:\n        min(68%, 760px);\n\n    padding:\n        12px 15px 10px;\n\n    background: #e7f1fd;\n    color: #1d334d;\n\n    border:\n        1px solid #cee1f5;\n\n    border-radius:\n        14px 5px 14px 14px;\n\n    box-shadow:\n        0 2px 6px rgba(15, 23, 42, 0.045);\n}\n\n.sca-message-content {\n    width: 100%;\n\n    color: inherit;\n\n    font-size: 14px;\n    line-height: 1.6;\n\n    white-space: pre-wrap;\n\n    overflow-wrap: anywhere;\n}\n\n.sca-message-time {\n    display: block;\n\n    margin-top: 8px;\n\n    color: #8290a2;\n\n    font-size: 10px;\n    line-height: 1.2;\n}\n\n/* =========================================================\n   11. LOADING STATE\n   ========================================================= */\n\n.sca-loading-inline {\n    min-height: 24px;\n\n    display: flex;\n    align-items: center;\n    gap: 9px;\n\n    color: #344860;\n\n    font-size: 14px;\n}\n\n.sca-loading-label {\n    display: inline-block;\n\n    color: #344860;\n\n    font-size: 14px;\n\n    line-height: 1.4;\n}\n\n.sca-message-row.is-loading .sca-message-footer {\n    margin-top: 6px;\n}\n\n.sca-spinner {\n    width: 16px;\n    height: 16px;\n\n    flex: 0 0 16px;\n\n    border:\n        2px solid #cad7e5;\n\n    border-top-color:\n        var(--sca-blue);\n\n    border-radius: 50%;\n\n    animation:\n        sca-spin 0.75s linear infinite;\n}\n\n@keyframes sca-spin {\n    to {\n        transform: rotate(360deg);\n    }\n}\n\n/* =========================================================\n   12. STRUCTURED ASSISTANT RESPONSES\n   ========================================================= */\n\n/*\n * Structured assistant output is real DOM produced by the\n * controller, so whitespace should be controlled by the\n * generated paragraph/list elements rather than pre-wrap.\n */\n\n.sca-message-row.assistant .sca-message-content {\n    white-space: normal;\n}\n\n\n/* ---------------------------------------------------------\n   Paragraphs\n   --------------------------------------------------------- */\n\n.sca-response-paragraph {\n    margin:\n        0 0 12px;\n\n    color:\n        inherit;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.65;\n\n    white-space:\n        normal;\n\n    overflow-wrap:\n        anywhere;\n}\n\n.sca-response-paragraph:last-child {\n    margin-bottom:\n        0;\n}\n\n\n/* ---------------------------------------------------------\n   Markdown headings\n   --------------------------------------------------------- */\n\n.sca-response-heading {\n    color:\n        #172b45;\n\n    font-weight:\n        700;\n\n    letter-spacing:\n        -0.01em;\n\n    overflow-wrap:\n        anywhere;\n}\n\n.sca-response-heading-2 {\n    margin:\n        20px 0 11px;\n\n    font-size:\n        18px;\n\n    line-height:\n        1.35;\n}\n\n.sca-response-heading-3 {\n    margin:\n        16px 0 9px;\n\n    font-size:\n        16px;\n\n    line-height:\n        1.4;\n}\n\n.sca-response-heading-4,\n.sca-response-heading-5,\n.sca-response-heading-6 {\n    margin:\n        13px 0 8px;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.45;\n}\n\n.sca-message-content .sca-response-heading:first-child {\n    margin-top:\n        0;\n}\n\n\n/* ---------------------------------------------------------\n   Bold / highlighted response text\n   --------------------------------------------------------- */\n\n.sca-response-strong,\n.sca-message-content strong {\n    color:\n        #10213d;\n\n    font-weight:\n        700;\n}\n\n\n/* ---------------------------------------------------------\n   Root ordered/unordered lists\n   --------------------------------------------------------- */\n\n.sca-response-list {\n    margin:\n        8px 0 15px 22px;\n\n    padding-left:\n        14px;\n\n    color:\n        inherit;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.65;\n}\n\n.sca-response-list>li {\n    margin:\n        8px 0;\n\n    padding-left:\n        4px;\n}\n\n\n/*\n * Explicitly use normal decimal numbering.\n * Individual <li value=\"...\"> values written by the JS\n * renderer preserve model-provided numbering.\n */\n\nol.sca-response-list {\n    list-style-type:\n        decimal;\n}\n\nul.sca-response-list {\n    list-style-type:\n        disc;\n}\n\n\n/* ---------------------------------------------------------\n   Paragraphs belonging to one numbered item\n   --------------------------------------------------------- */\n\n.sca-response-list-paragraph {\n    margin:\n        7px 0 5px;\n\n    color:\n        inherit;\n\n    font-size:\n        14px;\n\n    line-height:\n        1.6;\n\n    white-space:\n        normal;\n}\n\n\n/* ---------------------------------------------------------\n   Nested lists\n   --------------------------------------------------------- */\n\n.sca-response-nested-list {\n    margin:\n        7px 0 6px 20px;\n\n    padding-left:\n        12px;\n}\n\n.sca-response-nested-list>li {\n    margin:\n        4px 0;\n\n    padding-left:\n        2px;\n}\n\nul.sca-response-nested-list {\n    list-style-type:\n        disc;\n}\n\nol.sca-response-nested-list {\n    list-style-type:\n        decimal;\n}\n\n\n/* ---------------------------------------------------------\n   Inline code\n   --------------------------------------------------------- */\n\n.sca-inline-code {\n    display:\n        inline;\n\n    padding:\n        2px 5px;\n\n    border:\n        1px solid #dce4ed;\n\n    border-radius:\n        5px;\n\n    background:\n        #f1f5f9;\n\n    color:\n        #9f1239;\n\n    font-family:\n        Consolas,\n        \"Courier New\",\n        monospace;\n\n    font-size:\n        0.92em;\n\n    white-space:\n        normal;\n}\n\n/* =========================================================\n   13. CODE BLOCKS\n   ========================================================= */\n\n.sca-code-block {\n    width: 100%;\n\n    margin:\n        12px 0 16px;\n\n    overflow: hidden;\n\n    border:\n        1px solid #26364a;\n\n    border-radius: 10px;\n\n    background: #111827;\n}\n\n.sca-code-header {\n    min-height: 38px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n\n    padding:\n        0 10px 0 14px;\n\n    background: #1f2937;\n    color: #cbd5e1;\n\n    border-bottom:\n        1px solid #334155;\n}\n\n.sca-code-language {\n    min-width: 0;\n\n    color: #cbd5e1;\n\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.08em;\n}\n\n.sca-code-block pre {\n    width: 100%;\n    max-width: 100%;\n\n    margin: 0;\n    padding: 16px;\n\n    overflow-x: auto;\n\n    background: #111827;\n    color: #e5e7eb;\n\n    tab-size: 2;\n}\n\n.sca-code-block code {\n    display: block;\n\n    min-width: max-content;\n\n    color: inherit;\n\n    font-family:\n        Consolas,\n        \"Courier New\",\n        monospace;\n\n    font-size: 13px;\n    line-height: 1.55;\n\n    white-space: pre;\n}\n\n/* =========================================================\n   14. MESSAGE ACTIONS\n   ========================================================= */\n\n.sca-message-footer {\n    min-height: 26px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n\n    margin-top: 8px;\n}\n\n.sca-message-footer .sca-message-time {\n    margin-top: 0;\n}\n\n.sca-message-actions {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n\n    margin-left: auto;\n}\n\n.sca-message-action,\n.sca-code-copy-action {\n    width: 30px;\n    height: 30px;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    margin: 0;\n    padding: 0;\n\n    border:\n        1px solid transparent;\n\n    border-radius: 7px;\n\n    background: transparent;\n    color: #60758c;\n\n    cursor: pointer;\n\n    transition:\n        background-color 0.15s ease,\n        border-color 0.15s ease,\n        color 0.15s ease,\n        transform 0.15s ease;\n}\n\n.sca-message-action:hover {\n    border-color: #c9d8e7;\n\n    background: #eef5fc;\n    color: var(--sca-blue);\n\n    transform:\n        translateY(-1px);\n}\n\n.sca-code-copy-action {\n    color: #cbd5e1;\n}\n\n.sca-code-copy-action:hover {\n    border-color: #53657a;\n\n    background: #334155;\n    color: #ffffff;\n\n    transform:\n        translateY(-1px);\n}\n\n.sca-message-action:focus,\n.sca-code-copy-action:focus {\n    outline: none;\n\n    border-color:\n        var(--sca-blue);\n\n    box-shadow:\n        0 0 0 3px rgba(10, 110, 209, 0.14);\n}\n\n.sca-message-action.is-success {\n    border-color: #86d5a4;\n\n    background:\n        var(--sca-success-bg);\n\n    color:\n        var(--sca-success);\n}\n\n.sca-code-copy-action.is-success {\n    border-color: #4ade80;\n\n    background: #14532d;\n    color: #bbf7d0;\n}\n\n.sca-message-action svg,\n.sca-code-copy-action svg {\n    width: 17px;\n    height: 17px;\n\n    display: block;\n\n    fill: currentColor;\n}\n\n/* =========================================================\n   14A. PROCEED TO CODE ACTION\n   ========================================================= */\n\n/*\n * Container shown below the newest assistant response when\n * implementation generation is available.\n */\n\n.sca-proceed-wrap {\n    width:\n        100%;\n\n    display:\n        flex;\n\n    align-items:\n        center;\n\n    justify-content:\n        space-between;\n\n    gap:\n        14px;\n\n    margin:\n        14px 0 4px;\n\n    padding:\n        12px 14px;\n\n    border:\n        1px solid #d5e4f3;\n\n    border-radius:\n        10px;\n\n    background:\n        #f7fbff;\n}\n\n\n/* ---------------------------------------------------------\n   Proceed button\n   --------------------------------------------------------- */\n\n.sca-proceed-chip {\n    flex:\n        0 0 auto;\n\n    min-width:\n        148px;\n\n    min-height:\n        40px;\n\n    display:\n        inline-flex !important;\n\n    align-items:\n        center !important;\n\n    justify-content:\n        center !important;\n\n    gap:\n        8px;\n\n    margin:\n        0 !important;\n\n    padding:\n        0 15px !important;\n\n    overflow:\n        hidden !important;\n\n    border:\n        1px solid var(--sca-blue) !important;\n\n    border-radius:\n        9px !important;\n\n    background:\n        var(--sca-blue) !important;\n\n    color:\n        #ffffff !important;\n\n    font-family:\n        \"Segoe UI\",\n        Arial,\n        Helvetica,\n        sans-serif !important;\n\n    font-size:\n        13px !important;\n\n    font-weight:\n        600 !important;\n\n    line-height:\n        1 !important;\n\n    white-space:\n        nowrap;\n\n    cursor:\n        pointer;\n\n    box-shadow:\n        0 4px 11px rgba(10, 110, 209, 0.18);\n\n    transition:\n        background-color 0.15s ease,\n        border-color 0.15s ease,\n        box-shadow 0.15s ease,\n        transform 0.15s ease;\n}\n\n\n/*\n * CRITICAL FIX FOR YOUR SCREENSHOT:\n *\n * The current controller injects an SVG play icon.\n * Without explicit dimensions Electron lets the native SVG\n * consume a very large area inside the raw button.\n */\n\n.sca-proceed-chip svg {\n    width:\n        16px !important;\n\n    height:\n        16px !important;\n\n    min-width:\n        16px !important;\n\n    min-height:\n        16px !important;\n\n    max-width:\n        16px !important;\n\n    max-height:\n        16px !important;\n\n    flex:\n        0 0 16px;\n\n    display:\n        block !important;\n\n    fill:\n        currentColor !important;\n}\n\n\n/* ---------------------------------------------------------\n   Normal hover/focus\n   --------------------------------------------------------- */\n\n.sca-proceed-chip:hover:not(:disabled) {\n    border-color:\n        var(--sca-blue-hover) !important;\n\n    background:\n        var(--sca-blue-hover) !important;\n\n    transform:\n        translateY(-1px);\n\n    box-shadow:\n        0 6px 14px rgba(10, 110, 209, 0.22);\n}\n\n.sca-proceed-chip:focus {\n    outline:\n        none !important;\n\n    box-shadow:\n        0 0 0 3px rgba(10, 110, 209, 0.15) !important;\n}\n\n\n/* ---------------------------------------------------------\n   Requirements are not fully ready yet\n   --------------------------------------------------------- */\n\n.sca-proceed-chip.is-warning {\n    border-color:\n        #e8a23a !important;\n\n    background:\n        #ffffff !important;\n\n    color:\n        #9a5800 !important;\n\n    box-shadow:\n        none !important;\n}\n\n.sca-proceed-chip.is-warning:hover:not(:disabled) {\n    border-color:\n        #d78a1f !important;\n\n    background:\n        var(--sca-warning-bg) !important;\n\n    color:\n        #874b00 !important;\n}\n\n\n/* ---------------------------------------------------------\n   Busy/disabled state\n   --------------------------------------------------------- */\n\n.sca-proceed-chip:disabled,\n.sca-proceed-chip.is-busy {\n    border-color:\n        #b9c9d9 !important;\n\n    background:\n        #dbe5ef !important;\n\n    color:\n        #718398 !important;\n\n    cursor:\n        not-allowed !important;\n\n    transform:\n        none !important;\n\n    box-shadow:\n        none !important;\n}\n\n\n/* ---------------------------------------------------------\n   Proceed description\n   --------------------------------------------------------- */\n\n.sca-proceed-hint {\n    min-width:\n        0;\n\n    flex:\n        1 1 auto;\n\n    color:\n        #65758b;\n\n    font-size:\n        12px;\n\n    line-height:\n        1.45;\n}\n\n\n/*\n * Put the action first visually, then the description.\n */\n\n.sca-proceed-chip {\n    order:\n        1;\n}\n\n.sca-proceed-hint {\n    order:\n        2;\n}\n\n\n/* ---------------------------------------------------------\n   Narrow layouts\n   --------------------------------------------------------- */\n\n@media (max-width: 720px) {\n    .sca-proceed-wrap {\n        flex-direction:\n            column;\n\n        align-items:\n            flex-start;\n    }\n\n    .sca-proceed-chip {\n        width:\n            100%;\n\n        min-width:\n            0;\n    }\n\n    .sca-proceed-hint {\n        width:\n            100%;\n    }\n}\n\n/* =========================================================\n   15. COMPOSER\n   ========================================================= */\n\n.formio-component-composer,\n.sca-composer {\n    position: absolute !important;\n\n    right: 0 !important;\n    bottom: 0 !important;\n    left: 0 !important;\n\n    z-index: 110 !important;\n\n    width: 100% !important;\n\n    height:\n        var(--sca-composer-height) !important;\n\n    min-height:\n        var(--sca-composer-height) !important;\n\n    max-height:\n        var(--sca-composer-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    background: #ffffff;\n\n    border-top:\n        1px solid #dce5ef;\n\n    box-shadow:\n        0 -3px 12px rgba(15, 23, 42, 0.035);\n}\n\n.formio-component-composer>.form-group,\n.formio-component-composer .form-group,\n.formio-component-composer .formio-component,\n.formio-component-composer .card-body,\n.sca-composer>.form-group,\n.sca-composer .form-group {\n    min-width: 0;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n/* =========================================================\n   16. USER MESSAGE INPUT\n   ========================================================= */\n\n.formio-component-userMessage {\n    position: absolute !important;\n\n    right: 76px !important;\n    bottom: 12px !important;\n    left: 16px !important;\n\n    width: auto !important;\n\n    height:\n        var(--sca-input-height) !important;\n\n    min-height:\n        var(--sca-input-height) !important;\n\n    max-height:\n        var(--sca-input-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n}\n\n.formio-component-userMessage>.form-group,\n.formio-component-userMessage .form-group,\n.formio-component-userMessage .formio-component {\n    width: 100% !important;\n    height: 100% !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-userMessage label {\n    display: none !important;\n}\n\n.formio-component-userMessage textarea,\n.formio-component-userMessage .form-control {\n    display: block !important;\n\n    width: 100% !important;\n\n    height:\n        var(--sca-input-height) !important;\n\n    min-height:\n        var(--sca-input-height) !important;\n\n    max-height:\n        var(--sca-input-height) !important;\n\n    margin: 0 !important;\n\n    padding:\n        15px 16px !important;\n\n    resize: none !important;\n\n    overflow-x: hidden !important;\n    overflow-y: auto !important;\n\n    border:\n        1px solid #c7d5e5 !important;\n\n    border-radius:\n        14px !important;\n\n    background:\n        #ffffff !important;\n\n    color:\n        #1f2937 !important;\n\n    font-family:\n        \"Segoe UI\",\n        Arial,\n        Helvetica,\n        sans-serif !important;\n\n    font-size:\n        14px !important;\n\n    line-height:\n        1.5 !important;\n\n    box-shadow:\n        0 1px 3px rgba(15, 23, 42, 0.04) !important;\n}\n\n.formio-component-userMessage textarea::placeholder,\n.formio-component-userMessage .form-control::placeholder {\n    color: #7a899c;\n\n    opacity: 1;\n}\n\n.formio-component-userMessage textarea:focus,\n.formio-component-userMessage .form-control:focus {\n    border-color:\n        var(--sca-blue) !important;\n\n    outline:\n        none !important;\n\n    box-shadow:\n        0 0 0 3px rgba(10, 110, 209, 0.12) !important;\n}\n\n/* ---------------------------------------------------------\n   16A. USER MESSAGE — PROCESSING/DISABLED STATE\n   --------------------------------------------------------- */\n\n.formio-component-userMessage textarea:disabled,\n.formio-component-userMessage .form-control:disabled,\n.formio-component-userMessage textarea.sca-input-disabled,\n.formio-component-userMessage .form-control.sca-input-disabled,\n.formio-component-userMessage textarea[data-sca-processing=\"true\"],\n.formio-component-userMessage .form-control[data-sca-processing=\"true\"] {\n    background:\n        #f4f7fa !important;\n\n    color:\n        #7a899c !important;\n\n    border-color:\n        #d5dee8 !important;\n\n    cursor:\n        not-allowed !important;\n\n    opacity:\n        1 !important;\n\n    box-shadow:\n        none !important;\n}\n\n.formio-component-userMessage textarea:disabled::placeholder,\n.formio-component-userMessage .form-control:disabled::placeholder,\n.formio-component-userMessage textarea[data-sca-processing=\"true\"]::placeholder,\n.formio-component-userMessage .form-control[data-sca-processing=\"true\"]::placeholder {\n    color:\n        #9aa7b5 !important;\n\n    opacity:\n        1 !important;\n}\n\n/* =========================================================\n   17. PROMPT BUDGET\n   ========================================================= */\n\n.sca-prompt-budget-host {\n    position: absolute !important;\n\n    top: 10px !important;\n    right: 76px !important;\n    bottom: auto !important;\n    left: 16px !important;\n\n    z-index: 116 !important;\n\n    width: auto !important;\n\n    height:\n        var(--sca-budget-height) !important;\n\n    min-height:\n        var(--sca-budget-height) !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    pointer-events: none;\n}\n\n.sca-prompt-budget-host>.form-group,\n.sca-prompt-budget-host .form-group,\n.sca-prompt-budget-host .formio-component {\n    width: 100% !important;\n    height: 100% !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.sca-prompt-budget {\n    width: 100%;\n    height: 100%;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 5px;\n\n    margin: 0;\n    padding: 0;\n\n    color: var(--sca-muted);\n\n    font-size: 11px;\n    line-height: 1.15;\n}\n\n.sca-prompt-budget-row {\n    width: 100%;\n    min-width: 0;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n}\n\n#sca-prompt-budget-text {\n    min-width: 0;\n\n    overflow: hidden;\n\n    color: #5f6f82;\n\n    font-size: 11px;\n    font-weight: 600;\n\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.sca-prompt-budget-hint {\n    flex: 0 0 auto;\n\n    color: #8a98aa;\n\n    font-size: 10px;\n    white-space: nowrap;\n}\n\n.sca-prompt-budget-track {\n    width: 100%;\n    height: 5px;\n\n    overflow: hidden;\n\n    border-radius: 999px;\n\n    background: #e2e8f0;\n}\n\n.sca-prompt-budget-bar {\n    width: 0;\n    height: 100%;\n\n    border-radius: inherit;\n\n    background: var(--sca-blue);\n\n    transition:\n        width 0.18s ease,\n        background-color 0.18s ease;\n}\n\n.sca-prompt-budget.is-warning #sca-prompt-budget-text,\n.sca-prompt-budget.is-warning .sca-prompt-budget-hint {\n    color: var(--sca-warning);\n}\n\n.sca-prompt-budget.is-warning .sca-prompt-budget-bar {\n    background: #f59e0b;\n}\n\n.sca-prompt-budget.is-exceeded #sca-prompt-budget-text,\n.sca-prompt-budget.is-exceeded .sca-prompt-budget-hint {\n    color: var(--sca-danger);\n\n    font-weight: 700;\n}\n\n.sca-prompt-budget.is-exceeded .sca-prompt-budget-bar {\n    background: #dc2626;\n}\n\n/* =========================================================\n   18. SEND BUTTON\n   ========================================================= */\n\n.formio-component-sendMessage {\n    position: absolute !important;\n\n    right: 16px !important;\n\n    bottom:\n        calc(12px + (var(--sca-input-height) - 46px) / 2) !important;\n\n    top: auto !important;\n    left: auto !important;\n\n    z-index: 120 !important;\n\n    width: 46px !important;\n    height: 46px !important;\n\n    min-width: 46px !important;\n    min-height: 46px !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    transform: none !important;\n}\n\n.formio-component-sendMessage>.form-group,\n.formio-component-sendMessage .form-group,\n.formio-component-sendMessage .formio-component {\n    width: 46px !important;\n    height: 46px !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n.formio-component-sendMessage button,\n.formio-component-sendMessage .btn,\n.sca-send button,\n.sca-send .btn {\n    width: 46px !important;\n    height: 46px !important;\n\n    min-width: 46px !important;\n    min-height: 46px !important;\n\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden;\n\n    border: 0 !important;\n    border-radius: 50% !important;\n\n    background:\n        var(--sca-blue) !important;\n\n    color:\n        #ffffff !important;\n\n    font-size: 0 !important;\n    line-height: 1 !important;\n\n    box-shadow:\n        0 5px 14px rgba(10, 110, 209, 0.28) !important;\n\n    cursor: pointer !important;\n\n    transition:\n        background-color 0.15s ease,\n        transform 0.15s ease,\n        box-shadow 0.15s ease;\n}\n\n.formio-component-sendMessage button i,\n.formio-component-sendMessage .btn i,\n.formio-component-sendMessage button .fa,\n.formio-component-sendMessage .btn .fa,\n.sca-send button i,\n.sca-send .btn i {\n    margin: 0 !important;\n\n    color:\n        #ffffff !important;\n\n    font-size:\n        17px !important;\n\n    line-height:\n        1 !important;\n}\n\n.formio-component-sendMessage button:hover,\n.formio-component-sendMessage .btn:hover,\n.sca-send button:hover,\n.sca-send .btn:hover {\n    background:\n        var(--sca-blue-hover) !important;\n\n    transform:\n        translateY(-1px);\n}\n\n.formio-component-sendMessage button:disabled,\n.formio-component-sendMessage .btn:disabled,\n.sca-send button:disabled,\n.sca-send .btn:disabled {\n    background:\n        #9eb6ce !important;\n\n    opacity: 1 !important;\n\n    cursor:\n        not-allowed !important;\n\n    transform:\n        none !important;\n\n    box-shadow:\n        none !important;\n}\n\n/* =========================================================\n   19. FORM.IO / GLOBAL NOTIFICATIONS\n   ========================================================= */\n\n/*\n * SAP Code Agent already renders safe errors inside the\n * conversation surface.\n *\n * Do not render Form.io's global alert banner as well.\n * This avoids:\n *\n *   <%= messages.errorTitle %>\n *   <%= messages.error %>\n *\n * appearing above the application and avoids duplicate\n * error presentation.\n */\n\nbody>.alert,\nbody>.alert-dismissible,\n.formio-alert {\n    display: none !important;\n}\n\n/* =========================================================\n   20. HIDDEN FORM.IO STATE COMPONENTS\n   ========================================================= */\n\n.sca-state-field,\n.formio-component-messagesJson,\n.formio-component-transcript,\n.formio-component-currentStage,\n.formio-component-agentPhase,\n.formio-component-processing,\n.formio-component-processingMessage,\n.formio-component-readyForCode,\n.formio-component-hasGeneratedCode,\n.formio-component-validationPassed,\n.formio-component-conversationId,\n.formio-component-selectedMessageId,\n.formio-component-selectedUserPrompt,\n.formio-component-selectedMessageContent,\n.formio-component-selectedDownloadFormat,\n.formio-component-downloadResponse,\n.sca-download-field,\n.sca-download-submit {\n    display: none !important;\n}\n\n/* =========================================================\n   21. TABLET\n   ========================================================= */\n\n@media (max-width: 900px) {\n    :root {\n            --sca-page-offset: 144px;\n            --sca-composer-base-height: 142px;\n            --sca-input-height: 80px;\n            --sca-budget-height: 30px;\n        }\n\n    .formio-form {\n        width:\n            calc(100% - 16px) !important;\n\n        height:\n            calc(100vh - var(--sca-page-offset)) !important;\n\n        margin:\n            8px auto !important;\n\n        border-radius: 12px;\n    }\n\n    .sca-brand {\n        padding:\n            16px 18px;\n    }\n\n    .sca-stepper {\n        padding:\n            15px 18px 18px;\n    }\n\n    .sca-step {\n        min-width: 62px;\n    }\n\n    .sca-step-line {\n        min-width: 20px;\n\n        margin-right: 8px;\n        margin-left: 8px;\n    }\n\n    #sca-chat-surface,\n    .sca-chat-surface {\n        padding-right:\n            18px !important;\n\n        padding-left:\n            18px !important;\n    }\n\n    .formio-component-newChat {\n        top: 18px !important;\n        right: 18px !important;\n    }\n}\n\n/* =========================================================\n   22. MOBILE\n   ========================================================= */\n\n@media (max-width: 620px) {\n    :root {\n        --sca-page-offset: 126px;\n        --sca-composer-base-height: 136px;\n        --sca-input-height: 74px;\n        --sca-budget-height: 30px;\n    }\n\n    .formio-form {\n        width: 100% !important;\n\n        height:\n            calc(100vh - var(--sca-page-offset)) !important;\n\n        margin: 0 !important;\n\n        border-right: 0;\n        border-left: 0;\n        border-radius: 0;\n    }\n\n    .sca-brand {\n        padding:\n            14px 112px 14px 14px;\n    }\n\n    .sca-logo {\n        width: 42px;\n        height: 42px;\n\n        flex-basis: 42px;\n    }\n\n    .sca-title {\n        font-size: 18px;\n    }\n\n    .sca-subtitle {\n        font-size: 12px;\n    }\n\n    .sca-stepper {\n        padding:\n            14px 10px 16px;\n    }\n\n    .sca-step {\n        min-width: 48px;\n    }\n\n    .sca-step-label {\n        font-size: 10px;\n    }\n\n    .sca-step-line {\n        min-width: 10px;\n\n        margin-right: 4px;\n        margin-left: 4px;\n    }\n\n    #sca-chat-surface,\n    .sca-chat-surface {\n        padding:\n            14px 12px calc(var(--sca-composer-height) + 20px) !important;\n    }\n\n    .sca-chat-log {\n        gap: 16px;\n    }\n\n    .sca-avatar {\n        width: 34px;\n        height: 34px;\n\n        flex-basis: 34px;\n\n        border-radius: 8px;\n    }\n\n    .sca-message-row {\n        gap: 8px;\n    }\n\n    .sca-message-row.assistant .sca-message-bubble {\n        width:\n            calc(100% - 42px) !important;\n\n        max-width:\n            calc(100% - 42px) !important;\n\n        padding:\n            12px 13px 9px;\n    }\n\n    .sca-message-row.user .sca-message-bubble {\n        max-width: 84%;\n\n        padding:\n            11px 13px 9px;\n    }\n\n    .sca-message-content,\n    .sca-response-paragraph,\n    .sca-response-list {\n        font-size: 13px;\n        line-height: 1.55;\n    }\n\n    .sca-response-heading {\n        font-size: 15px;\n    }\n\n    .sca-code-block pre {\n        padding: 13px;\n    }\n\n    .sca-code-block code {\n        font-size: 12px;\n    }\n\n    .formio-component-composer,\n    .sca-composer {\n        height:\n            var(--sca-composer-height) !important;\n\n        min-height:\n            var(--sca-composer-height) !important;\n\n        max-height:\n            var(--sca-composer-height) !important;\n\n        padding:\n            12px 66px 12px 12px !important;\n    }\n\n    .formio-component-userMessage,\n    .formio-component-userMessage textarea,\n    .formio-component-userMessage .form-control {\n        height:\n            var(--sca-input-height) !important;\n\n        min-height:\n            var(--sca-input-height) !important;\n\n        max-height:\n            var(--sca-input-height) !important;\n    }\n\n    \n\n    .sca-prompt-budget-hint {\n        display: none;\n    }\n\n    #sca-prompt-budget-text {\n        width: 100%;\n    }\n\n    .formio-component-sendMessage {\n        top: auto !important;\n        right: 14px !important;\n\n        bottom:\n            calc(12px + (var(--sca-input-height) - 42px) / 2) !important;\n\n        left: auto !important;\n\n        width: 42px !important;\n        height: 42px !important;\n\n        min-width: 42px !important;\n        min-height: 42px !important;\n    }\n\n    .formio-component-sendMessage>.form-group,\n    .formio-component-sendMessage .form-group,\n    .formio-component-sendMessage button,\n    .formio-component-sendMessage .btn,\n    .sca-send button,\n    .sca-send .btn {\n        width: 42px !important;\n        height: 42px !important;\n\n        min-width: 42px !important;\n        min-height: 42px !important;\n    }\n\n    body>.alert,\n    body>.alert-dismissible,\n    .formio-alert {\n        top: 72px !important;\n        right: 12px !important;\n        left: 12px !important;\n\n        min-width: 0 !important;\n        max-width: none !important;\n    }\n}\n\n/* =========================================================\n   23. SAP CODE AGENT\n       SINGLE-PAGE / NO-SIDEBAR / DENSE DESKTOP OVERRIDE\n   =========================================================\n\n   IMPORTANT:\n   - Keep this section LAST in the CSS file.\n   - Do NOT use transform: scale() on the application.\n   - Do NOT use browser/CSS zoom as the permanent solution.\n   - Scoped with body:has(.sca-header-host) so these shell\n     overrides affect only the SAP Code Agent application.\n   ========================================================= */\n\n\n/* =========================================================\n   23A. REMOVE THE APPLICATION SIDEBAR COMPLETELY\n   ========================================================= */\n\nbody:has(.sca-header-host) :where(#sidebar,\n    #sidebar-wrapper,\n    .sidebar,\n    .sidebar-wrapper,\n    .app-sidebar,\n    .main-sidebar,\n    .side-nav,\n    .sidenav,\n    .left-sidebar,\n    .navigation-sidebar,\n    mat-sidenav,\n    mat-drawer) {\n    display: none !important;\n\n    width: 0 !important;\n    min-width: 0 !important;\n    max-width: 0 !important;\n\n    height: 0 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    visibility: hidden !important;\n    pointer-events: none !important;\n\n    overflow: hidden !important;\n}\n\n\n/*\n * Remove any sidebar backdrop that may be left behind\n * by the application shell.\n */\n\nbody:has(.sca-header-host) :where(.sidebar-backdrop,\n    .drawer-backdrop,\n    .sidenav-backdrop) {\n    display: none !important;\n}\n\n\n/* =========================================================\n   23B. REMOVE / DISABLE HAMBURGER AND SIDEBAR TOGGLES\n   ========================================================= */\n\nbody:has(.sca-header-host) :where(.navbar-toggler,\n    .sidebar-toggle,\n    .sidebar-toggler,\n    .sidenav-toggle,\n    .menu-toggle,\n    .hamburger,\n    .hamburger-button,\n    [data-widget=\"pushmenu\"],\n    button[aria-controls*=\"sidebar\" i],\n    button[aria-controls*=\"sidenav\" i],\n    button[aria-label=\"Toggle sidebar\" i],\n    button[aria-label=\"Toggle navigation\" i],\n    button[title=\"Toggle sidebar\" i],\n    button[title=\"Toggle navigation\" i]) {\n    display: none !important;\n\n    width: 0 !important;\n    min-width: 0 !important;\n    max-width: 0 !important;\n\n    height: 0 !important;\n    min-height: 0 !important;\n    max-height: 0 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    opacity: 0 !important;\n    visibility: hidden !important;\n\n    pointer-events: none !important;\n}\n\n\n/* =========================================================\n   23C. RECLAIM THE WIDTH THAT BELONGED TO THE SIDEBAR\n   ========================================================= */\n\n/*\n * Covers the common layout wrappers used by application\n * shells. The :has() scope prevents this from affecting\n * unrelated aXet applications.\n */\n\nbody:has(.sca-header-host) :where(#content-wrapper,\n    #main-content,\n    .content-wrapper,\n    .main-content,\n    .app-content,\n    .page-content,\n    .page-wrapper,\n    .main-panel,\n    .mat-drawer-content,\n    main) {\n    left: 0 !important;\n\n    width: 100% !important;\n    max-width: none !important;\n\n    margin-left: 0 !important;\n    margin-right: 0 !important;\n\n    padding-left: 0 !important;\n    padding-right: 0 !important;\n}\n\n\n/*\n * Neutralise commonly used sidebar width variables.\n * They do nothing if the host does not define them.\n */\n\nbody:has(.sca-header-host) {\n    --sidebar-width: 0px !important;\n    --sidebar-collapsed-width: 0px !important;\n    --sidenav-width: 0px !important;\n\n    overflow-x: hidden !important;\n}\n\n\n/* =========================================================\n   23D. COMPACT THE OUTER aXet HEADER\n   ========================================================= */\n\n/*\n * This reproduces the height/density you are seeing when\n * Chrome is zoomed out, without scaling the entire DOM.\n */\n\nbody:has(.sca-header-host) :where(.app-header,\n    .main-header,\n    header[role=\"banner\"],\n    .mat-toolbar) {\n    min-height: 56px !important;\n    height: 56px !important;\n\n    padding-top: 6px !important;\n    padding-bottom: 6px !important;\n}\n\n\n/*\n * Bootstrap-type outer navigation.\n */\n\nbody:has(.sca-header-host)> :where(.navbar),\nbody:has(.sca-header-host) :where(.main-header .navbar,\n    .app-header .navbar) {\n    min-height: 56px !important;\n    height: 56px !important;\n}\n\n\n/*\n * Once the hamburger disappears, ensure the brand does not\n * retain its old left-hand spacer.\n */\n\nbody:has(.sca-header-host) :where(.navbar-brand,\n    .app-brand,\n    .header-brand) {\n    margin-left: 0 !important;\n}\n\n\n/* =========================================================\n   23E. DESKTOP DENSITY\n   ========================================================= */\n\n@media (min-width: 901px) {\n\n    /*\n     * These are now the main tuning controls.\n     *\n     * If you later want slightly more/less vertical room,\n     * change --sca-page-offset only.\n     */\n\n    body:has(.sca-header-host) {\n        --sca-page-offset: 138px;\n\n        --sca-composer-base-height: 104px;\n        --sca-input-height: 58px;\n        --sca-budget-height: 22px;\n\n        --sca-card-max-width: 1600px;\n    }\n\n\n    /* -----------------------------------------------------\n       Main application card\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-form {\n        width: calc(100% - 28px) !important;\n        max-width: var(--sca-card-max-width) !important;\n\n        /*\n         * Fallback first; dynamic viewport second.\n         */\n        height:\n            calc(100vh - var(--sca-page-offset)) !important;\n\n        height:\n            calc(100dvh - var(--sca-page-offset)) !important;\n\n        max-height:\n            calc(100dvh - var(--sca-page-offset)) !important;\n\n        min-height: 0 !important;\n\n        margin:\n            10px auto !important;\n\n        border-radius:\n            14px !important;\n\n        box-shadow:\n            0 3px 14px rgba(15, 23, 42, 0.055) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       SAP Code Agent brand header\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-brand {\n        min-height:\n            58px !important;\n\n        gap:\n            10px !important;\n\n        padding:\n            10px 16px !important;\n    }\n\n    body:has(.sca-header-host) .sca-logo {\n        width:\n            36px !important;\n\n        height:\n            36px !important;\n\n        flex:\n            0 0 36px !important;\n\n        border-radius:\n            8px !important;\n\n        font-size:\n            17px !important;\n\n        box-shadow:\n            0 3px 8px rgba(10, 110, 209, 0.16) !important;\n    }\n\n    body:has(.sca-header-host) .sca-title {\n        font-size:\n            18px !important;\n\n        line-height:\n            1.18 !important;\n    }\n\n    body:has(.sca-header-host) .sca-subtitle {\n        margin-top:\n            2px !important;\n\n        font-size:\n            12px !important;\n\n        line-height:\n            1.3 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       New Chat\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-newChat {\n        top:\n            12px !important;\n\n        right:\n            16px !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-newChat button,\n\n    body:has(.sca-header-host) .formio-component-newChat .btn {\n        min-height:\n            34px !important;\n\n        padding:\n            0 11px !important;\n\n        gap:\n            6px !important;\n\n        border-radius:\n            8px !important;\n\n        font-size:\n            12px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Workflow stepper\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-stepper {\n        padding:\n            10px 24px 12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step {\n        min-width:\n            64px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step-circle {\n        width:\n            26px !important;\n\n        height:\n            26px !important;\n\n        font-size:\n            11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step-label {\n        margin-top:\n            6px !important;\n\n        font-size:\n            11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-step-line {\n        min-width:\n            30px !important;\n\n        height:\n            2px !important;\n\n        margin:\n            12px 12px 0 !important;\n    }\n\n    body:has(.sca-header-host) .sca-step.is-active .sca-step-circle {\n        transform:\n            scale(1.04) !important;\n\n        box-shadow:\n            0 0 0 3px rgba(10, 110, 209, 0.11) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Chat viewport\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) #sca-chat-surface,\n\n    body:has(.sca-header-host) .sca-chat-surface {\n        padding:\n            14px 18px calc(var(--sca-composer-height) + 14px) !important;\n\n        scrollbar-gutter:\n            stable;\n    }\n\n    body:has(.sca-header-host) #sca-chat-log,\n\n    body:has(.sca-header-host) .sca-chat-log {\n        gap:\n            14px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Message rows / avatars\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-row {\n        gap:\n            10px !important;\n    }\n\n    body:has(.sca-header-host) .sca-avatar {\n        width:\n            34px !important;\n\n        height:\n            34px !important;\n\n        flex:\n            0 0 34px !important;\n\n        border-radius:\n            8px !important;\n\n        font-size:\n            12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-avatar svg {\n        width:\n            18px !important;\n\n        height:\n            18px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Assistant bubble\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-row.assistant .sca-message-bubble {\n        width:\n            calc(100% - 44px) !important;\n\n        max-width:\n            calc(100% - 44px) !important;\n\n        padding:\n            10px 14px 8px !important;\n\n        border-radius:\n            5px 11px 11px 11px !important;\n\n        box-shadow:\n            0 2px 6px rgba(15, 23, 42, 0.05) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       User bubble\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-row.user .sca-message-bubble {\n        max-width:\n            min(72%, 760px) !important;\n\n        padding:\n            9px 12px 8px !important;\n\n        border-radius:\n            11px 5px 11px 11px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Chat typography\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-content,\n    body:has(.sca-header-host) .sca-response-paragraph,\n    body:has(.sca-header-host) .sca-response-list,\n    body:has(.sca-header-host) .sca-response-list-paragraph {\n        font-size:\n            13px !important;\n\n        line-height:\n            1.5 !important;\n    }\n\n    body:has(.sca-header-host) .sca-message-time {\n        margin-top:\n            6px !important;\n\n        font-size:\n            9px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-heading-2 {\n        margin:\n            15px 0 8px !important;\n\n        font-size:\n            16px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-heading-3 {\n        margin:\n            12px 0 7px !important;\n\n        font-size:\n            14px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-heading-4,\n\n    body:has(.sca-header-host) .sca-response-heading-5,\n\n    body:has(.sca-header-host) .sca-response-heading-6 {\n        margin:\n            10px 0 6px !important;\n\n        font-size:\n            13px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Lists\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-response-list {\n        margin:\n            6px 0 11px 18px !important;\n\n        padding-left:\n            12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-response-list>li {\n        margin:\n            5px 0 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Code blocks\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-code-block {\n        margin:\n            9px 0 12px !important;\n\n        border-radius:\n            8px !important;\n    }\n\n    body:has(.sca-header-host) .sca-code-header {\n        min-height:\n            32px !important;\n\n        padding:\n            0 8px 0 11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-code-block pre {\n        padding:\n            12px !important;\n    }\n\n    body:has(.sca-header-host) .sca-code-block code {\n        font-size:\n            12px !important;\n\n        line-height:\n            1.48 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Message action buttons\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-message-footer {\n        min-height:\n            22px !important;\n\n        margin-top:\n            5px !important;\n    }\n\n    body:has(.sca-header-host) .sca-message-action,\n\n    body:has(.sca-header-host) .sca-code-copy-action {\n        width:\n            26px !important;\n\n        height:\n            26px !important;\n\n        border-radius:\n            6px !important;\n    }\n\n    body:has(.sca-header-host) .sca-message-action svg,\n\n    body:has(.sca-header-host) .sca-code-copy-action svg {\n        width:\n            15px !important;\n\n        height:\n            15px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Proceed to Code action\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-proceed-wrap {\n        gap:\n            10px !important;\n\n        margin:\n            10px 0 3px !important;\n\n        padding:\n            9px 11px !important;\n    }\n\n    body:has(.sca-header-host) .sca-proceed-chip {\n        min-width:\n            132px !important;\n\n        min-height:\n            34px !important;\n\n        padding:\n            0 12px !important;\n\n        font-size:\n            12px !important;\n\n        border-radius:\n            8px !important;\n    }\n\n    body:has(.sca-header-host) .sca-proceed-chip svg {\n        width:\n            14px !important;\n\n        height:\n            14px !important;\n\n        min-width:\n            14px !important;\n\n        min-height:\n            14px !important;\n\n        max-width:\n            14px !important;\n\n        max-height:\n            14px !important;\n\n        flex:\n            0 0 14px !important;\n    }\n\n    body:has(.sca-header-host) .sca-proceed-hint {\n        font-size:\n            11px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Composer\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-composer,\n\n    body:has(.sca-header-host) .sca-composer {\n        height:\n            var(--sca-composer-height) !important;\n\n        min-height:\n            var(--sca-composer-height) !important;\n\n        max-height:\n            var(--sca-composer-height) !important;\n\n        box-shadow:\n            0 -2px 8px rgba(15, 23, 42, 0.03) !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Text input\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-userMessage {\n        right:\n            60px !important;\n\n        bottom:\n            9px !important;\n\n        left:\n            14px !important;\n\n        height:\n            var(--sca-input-height) !important;\n\n        min-height:\n            var(--sca-input-height) !important;\n\n        max-height:\n            var(--sca-input-height) !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-userMessage textarea,\n\n    body:has(.sca-header-host) .formio-component-userMessage .form-control {\n        height:\n            var(--sca-input-height) !important;\n\n        min-height:\n            var(--sca-input-height) !important;\n\n        max-height:\n            var(--sca-input-height) !important;\n\n        padding:\n            10px 13px !important;\n\n        border-radius:\n            11px !important;\n\n        font-size:\n            13px !important;\n\n        line-height:\n            1.42 !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Prompt budget\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .sca-prompt-budget-host {\n        top:\n            7px !important;\n\n        right:\n            60px !important;\n\n        left:\n            14px !important;\n\n        height:\n            var(--sca-budget-height) !important;\n\n        min-height:\n            var(--sca-budget-height) !important;\n    }\n\n    body:has(.sca-header-host) .sca-prompt-budget {\n        gap:\n            4px !important;\n\n        font-size:\n            10px !important;\n    }\n\n    body:has(.sca-header-host) #sca-prompt-budget-text {\n        font-size:\n            10px !important;\n    }\n\n    body:has(.sca-header-host) .sca-prompt-budget-hint {\n        font-size:\n            9px !important;\n    }\n\n    body:has(.sca-header-host) .sca-prompt-budget-track {\n        height:\n            4px !important;\n    }\n\n\n    /* -----------------------------------------------------\n       Send button\n       ----------------------------------------------------- */\n\n    body:has(.sca-header-host) .formio-component-sendMessage {\n        right:\n            14px !important;\n\n        bottom:\n            calc(9px + (var(--sca-input-height) - 38px) / 2) !important;\n\n        width:\n            38px !important;\n\n        height:\n            38px !important;\n\n        min-width:\n            38px !important;\n\n        min-height:\n            38px !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-sendMessage>.form-group,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .form-group,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .formio-component {\n        width:\n            38px !important;\n\n        height:\n            38px !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-sendMessage button,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .btn,\n\n    body:has(.sca-header-host) .sca-send button,\n\n    body:has(.sca-header-host) .sca-send .btn {\n        width:\n            38px !important;\n\n        height:\n            38px !important;\n\n        min-width:\n            38px !important;\n\n        min-height:\n            38px !important;\n\n        box-shadow:\n            0 4px 10px rgba(10, 110, 209, 0.22) !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-sendMessage button i,\n\n    body:has(.sca-header-host) .formio-component-sendMessage .btn i,\n\n    body:has(.sca-header-host) .sca-send button i,\n\n    body:has(.sca-header-host) .sca-send .btn i {\n        font-size:\n            15px !important;\n    }\n}\n\n\n/* =========================================================\n   23F. KEEP TABLET/MOBILE FULL-WIDTH AFTER SIDEBAR REMOVAL\n   ========================================================= */\n\n@media (max-width: 900px) {\n\n    body:has(.sca-header-host) .formio-form {\n        max-width:\n            none !important;\n    }\n}\n\n\n/* =========================================================\n   23G. FOCUS VISIBILITY\n   ========================================================= */\n\nbody:has(.sca-header-host):where(button,\n    textarea,\n    input,\n    select,\n    [tabindex]):focus-visible {\n    outline:\n        2px solid var(--sca-blue) !important;\n\n    outline-offset:\n        2px;\n}\n\n\n/* =========================================================\n   24. FILE ATTACHMENTS\n   =========================================================\n\n   Version 2 layout\n   -----------------\n   Version 1 placed a script-manufactured paperclip button absolutely\n   inside the message textarea. It worked everywhere it was tested and\n   did not appear in the real deployment — the safer replacement is a\n   DECLARED Form.io `file` component (key: attachmentPicker) and a\n   DECLARED `htmlelement` tray host (key: attachmentTrayHost), both\n   added as real form components in build_deptapp.py. Form.io renders\n   them the same way it renders the send button and the message box,\n   which is proven to work; this stylesheet only styles what already\n   exists, never manufactures it.\n\n   That component can no longer sit visually inside the textarea (it is\n   a sibling component with its own wrapper div, not a child our script\n   controls), so the layout changes to a slim toolbar strip ABOVE the\n   message box, occupying its own row inside the composer:\n\n       composer\n        +-- attachment bar   (picker trigger + chip tray, ALWAYS present)\n        +-- prompt budget    (unchanged content, moved down to clear the bar)\n        +-- message textarea (unchanged, no longer needs left padding)\n        +-- send button      (unchanged)\n\n   Composer geometry\n   -----------------\n   --sca-composer-height = --sca-composer-base-height + --sca-attachment-bar-height\n\n   Unlike v1, the bar's height is now CONSTANT rather than conditional\n   on whether a file is attached. A composer that resizes the instant\n   the first file is picked shifts the chat log's scroll position under\n   the user's cursor; reserving the row unconditionally avoids that\n   layout jump entirely, at the cost of a fixed handful of pixels\n   whether or not anything is attached — a trade worth making for a\n   steadier feel.\n   ========================================================= */\n\n:root,\nbody {\n    --sca-attachment-bar-height: 40px;\n\n    --sca-composer-height:\n        calc(var(--sca-composer-base-height) + var(--sca-attachment-bar-height));\n\n    /* Section 17's inset for the prompt-budget row. */\n    --sca-budget-inset-top: calc(var(--sca-attachment-bar-height) + 6px);\n}\n\n/* ---------------------------------------------------------\n   24A. ATTACHMENT BAR\n\n   Top-anchored inside the composer, spanning its width. The\n   picker sits at the left; the tray fills the remaining space\n   and scrolls horizontally if it holds more chips than fit.\n   --------------------------------------------------------- */\n\n.sca-attachment-bar-host {\n    position: absolute !important;\n\n    top: 6px !important;\n    right: 16px !important;\n    left: 16px !important;\n\n    z-index: 118 !important;\n\n    height: calc(var(--sca-attachment-bar-height) - 8px) !important;\n\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: visible !important;\n}\n\n/*\n * Elsewhere in this stylesheet (sections 15/16/18), a container's\n * children are always addressed directly as .formio-component-<key> —\n * .sca-composer > .formio-component-userMessage works with no\n * intermediate wrapper to flatten, and the same holds here. This rule\n * only flattens a .form-group Form.io may render INSIDE one of those\n * named components (around its own internal markup), never the named\n * component's own root: that root is what carries the flex sizing\n * rules below (.formio-component-attachmentPicker { flex: ... }), and\n * collapsing it away with display:contents was what let its child\n * input's position:absolute escape to the whole bar's width instead of\n * staying inside the picker — the bug that made the invisible file\n * input intercept clicks meant for the tray next to it.\n */\n.sca-attachment-bar-host .form-group,\n.sca-attachment-bar-host .card-body {\n    display: contents !important;\n}\n\n/* ---------------------------------------------------------\n   24B. FILE PICKER — DECLARED FORM.IO FILE COMPONENT\n\n   Form.io's default file component renders a full drop-zone\n   with instructional text. That default is a correct, working\n   control on its own — everything below only compacts its\n   appearance into a small pill; if any selector here misses\n   the platform's exact internal markup, the component still\n   renders and still works, just with Form.io's own, plainer\n   look, which is a safe degradation rather than a silent one.\n   --------------------------------------------------------- */\n\n.formio-component-attachmentPicker {\n    flex: 0 0 auto !important;\n\n    width: auto !important;\n    max-width: 168px !important;\n\n    margin: 0 !important;\n}\n\n.formio-component-attachmentPicker label {\n    display: none !important;\n}\n\n.formio-component-attachmentPicker .form-group,\n.formio-component-attachmentPicker .formio-component {\n    margin: 0 !important;\n}\n\n/*\n * The drop-zone / browse control, whatever its exact inner markup.\n * Compacted into a small pill matching the app's existing button\n * language (rounded, bordered, blue-on-hover) rather than the\n * default large dashed rectangle.\n */\n.formio-component-attachmentPicker .fileSelector,\n.formio-component-attachmentPicker [ref=\"fileDrop\"] {\n    /*\n     * A containing block for the real <input type=\"file\"> Form.io's\n     * default template overlays on top of this dropzone at full size\n     * (opacity 0, position:absolute) so clicks anywhere on the visible\n     * pill open the file dialog. Without position:relative here, that\n     * input positions against the nearest ancestor that HAS one —\n     * which turned out to be the whole attachment bar — stretching an\n     * invisible click target across the tray sitting next to it.\n     */\n    position: relative !important;\n\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    gap: 6px !important;\n\n    width: auto !important;\n    max-width: 100% !important;\n    height: calc(var(--sca-attachment-bar-height) - 8px) !important;\n\n    padding: 0 12px !important;\n    margin: 0 !important;\n\n    border: 1px solid var(--sca-border) !important;\n    border-radius: 999px !important;\n\n    background: #ffffff !important;\n\n    color: var(--sca-muted) !important;\n    font-size: 12px !important;\n    font-weight: 600 !important;\n    white-space: nowrap !important;\n\n    cursor: pointer;\n\n    transition:\n        background-color 120ms ease,\n        color 120ms ease,\n        border-color 120ms ease;\n}\n\n.formio-component-attachmentPicker .fileSelector:hover,\n.formio-component-attachmentPicker [ref=\"fileDrop\"]:hover {\n    background: var(--sca-blue-soft) !important;\n    border-color: var(--sca-blue) !important;\n    color: var(--sca-blue) !important;\n}\n\n/*\n * A small paperclip glyph ahead of the (relabelled, by script) text,\n * matching the icon language used elsewhere in the composer.\n */\n.formio-component-attachmentPicker .fileSelector::before,\n.formio-component-attachmentPicker [ref=\"fileDrop\"]::before {\n    content: \"📎\";\n\n    font-size: 13px;\n    line-height: 1;\n}\n\n.formio-component-attachmentPicker .fileSelector i,\n.formio-component-attachmentPicker [ref=\"fileDrop\"] i {\n    display: none !important;\n}\n\n/*\n * Form.io's default dropzone leads with its own instructional text —\n * \"Drop files to attach, or\" — ahead of the browse link decoratePicker()\n * (sca-attachment-ui.js) relabels to \"Attach files\". Left alone that\n * reads as a duplicated, verbose control; hidden here so the compact\n * pill shows only the one label. The <a> itself is untouched and stays\n * the real click target Form.io wires up.\n */\n.formio-component-attachmentPicker .fileSelector span,\n.formio-component-attachmentPicker [ref=\"fileDrop\"] span {\n    display: none !important;\n}\n\n.formio-component-attachmentPicker .fileSelector a,\n.formio-component-attachmentPicker [ref=\"fileDrop\"] a,\n.formio-component-attachmentPicker .browse {\n    color: inherit !important;\n    text-decoration: none !important;\n}\n\n/* Our own chip tray replaces this; see 24D. */\n.formio-component-attachmentPicker .sca-native-file-list-hidden {\n    display: none !important;\n}\n\n.formio-component-attachmentPicker.sca-picker-disabled,\n.formio-component-attachmentPicker[aria-disabled=\"true\"] {\n    opacity: 0.55;\n    pointer-events: none;\n}\n\n/* ---------------------------------------------------------\n   24C. MESSAGE BOX\n\n   No longer needs extra left padding: the picker lives in its\n   own row above the textarea now, not overlapping it.\n   --------------------------------------------------------- */\n\n/* (intentionally no rules here in v2 — kept as a section marker\n   so a future change has an obvious place to look first) */\n\n/* ---------------------------------------------------------\n   24D. ATTACHED-FILE TRAY\n\n   The declared htmlelement (attachmentTrayHost) this script\n   populates. Sits beside the picker, filling the remaining\n   width of the attachment bar; scrolls horizontally rather\n   than wrapping, so the bar's height stays constant however\n   many files are attached.\n   --------------------------------------------------------- */\n\n#sca-attachment-tray {\n    flex: 1 1 auto !important;\n    min-width: 0 !important;\n\n    height: 100% !important;\n\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow-x: auto !important;\n    overflow-y: hidden !important;\n\n    scrollbar-width: thin;\n}\n\n#sca-attachment-tray[hidden] {\n    display: none !important;\n}\n\n#sca-attachment-tray::-webkit-scrollbar {\n    height: 4px;\n}\n\n#sca-attachment-tray::-webkit-scrollbar-thumb {\n    background: #cbd5e1;\n    border-radius: 4px;\n}\n\n/* ---------------------------------------------------------\n   24E. FILE CHIPS\n   --------------------------------------------------------- */\n\n.sca-chip {\n    flex: 0 0 auto;\n\n    max-width: 260px;\n\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n\n    height: 28px;\n    padding: 0 6px 0 8px;\n\n    border: 1px solid var(--sca-border);\n    border-radius: 8px;\n\n    background: #ffffff;\n    color: var(--sca-text);\n\n    font-size: 12px;\n    line-height: 1;\n\n    white-space: nowrap;\n}\n\n.sca-chip-icon {\n    flex: 0 0 auto;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    min-width: 26px;\n    height: 16px;\n    padding: 0 4px;\n\n    border-radius: 4px;\n\n    background: var(--sca-blue-soft);\n    color: var(--sca-blue);\n\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n}\n\n.sca-chip-label {\n    flex: 0 1 auto;\n    min-width: 0;\n\n    overflow: hidden;\n    text-overflow: ellipsis;\n\n    font-weight: 600;\n}\n\n.sca-chip-detail {\n    flex: 0 0 auto;\n\n    color: var(--sca-muted);\n    font-size: 11px;\n}\n\n.sca-chip-remove {\n    flex: 0 0 auto;\n\n    width: 18px;\n    height: 18px;\n\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    padding: 0;\n    margin: 0;\n\n    border: 0;\n    border-radius: 50%;\n\n    background: transparent;\n    color: var(--sca-muted);\n\n    font-size: 15px;\n    line-height: 1;\n\n    cursor: pointer;\n}\n\n.sca-chip-remove:hover {\n    background: #eef2f7;\n    color: var(--sca-text);\n}\n\n.sca-chip-remove:focus-visible {\n    outline: 2px solid var(--sca-blue);\n    outline-offset: 1px;\n}\n\n/* Parsing */\n\n.sca-chip-parsing {\n    border-style: dashed;\n    color: var(--sca-muted);\n}\n\n.sca-chip-parsing .sca-chip-icon {\n    background: transparent;\n    min-width: 16px;\n    padding: 0;\n}\n\n.sca-chip-spinner {\n    display: inline-block;\n\n    width: 12px;\n    height: 12px;\n\n    border: 2px solid var(--sca-blue-soft);\n    border-top-color: var(--sca-blue);\n    border-radius: 50%;\n\n    animation: sca-chip-spin 700ms linear infinite;\n}\n\n@keyframes sca-chip-spin {\n    to {\n        transform: rotate(360deg);\n    }\n}\n\n@media (prefers-reduced-motion: reduce) {\n    .sca-chip-spinner {\n        animation-duration: 2400ms;\n    }\n}\n\n/* Rejected */\n\n.sca-chip-error {\n    border-color: #f3c3bd;\n    background: var(--sca-danger-bg);\n    color: var(--sca-danger);\n}\n\n.sca-chip-error .sca-chip-icon {\n    background: #f9d7d3;\n    color: var(--sca-danger);\n}\n\n.sca-chip-error .sca-chip-detail {\n    max-width: 190px;\n\n    overflow: hidden;\n    text-overflow: ellipsis;\n\n    color: var(--sca-danger);\n}\n\n/* Notice */\n\n.sca-chip-notice {\n    border-color: #f0d5a8;\n    background: var(--sca-warning-bg);\n    color: var(--sca-warning);\n\n    white-space: normal;\n    max-width: none;\n    height: auto;\n\n    padding: 5px 10px;\n    line-height: 1.3;\n}\n\n/* ---------------------------------------------------------\n   24F. ATTACHMENT COUNTER\n\n   Extends the existing prompt-budget readout rather than\n   adding a second row, so the composer keeps one line of\n   status instead of two competing ones.\n   --------------------------------------------------------- */\n\n.sca-attachment-counter {\n    margin-right: auto;\n\n    min-width: 0;\n\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n\n    color: var(--sca-muted);\n    font-size: inherit;\n}\n\n.sca-attachment-counter.is-near-limit {\n    color: var(--sca-warning);\n    font-weight: 600;\n}\n\n.sca-attachment-counter.is-at-limit {\n    color: var(--sca-danger);\n    font-weight: 600;\n}\n\n.sca-attachment-counter[hidden] {\n    display: none !important;\n}\n\n/* ---------------------------------------------------------\n   24G. PROMPT BUDGET — SHIFTED BY THE ATTACHMENT BAR\n   --------------------------------------------------------- */\n\n.sca-prompt-budget-host,\nbody:has(.sca-header-host) .sca-prompt-budget-host {\n    top: var(--sca-budget-inset-top) !important;\n}\n\n/* ---------------------------------------------------------\n   24H. ATTACHMENTS ON A SENT MESSAGE\n\n   Shown under the user's bubble so the conversation records\n   what the model was given, not just what was typed.\n   --------------------------------------------------------- */\n\n.sca-message-attachments {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n\n    margin-top: 8px;\n    padding-top: 8px;\n\n    border-top: 1px solid rgba(255, 255, 255, 0.25);\n}\n\n.sca-message-row.assistant .sca-message-attachments {\n    border-top-color: var(--sca-border);\n}\n\n.sca-message-attachment {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n\n    padding: 3px 8px;\n\n    border-radius: 6px;\n\n    background: rgba(255, 255, 255, 0.18);\n\n    font-size: 11px;\n    line-height: 1.4;\n}\n\n.sca-message-row.assistant .sca-message-attachment {\n    background: var(--sca-blue-soft);\n    color: var(--sca-blue);\n}\n\n.sca-message-attachment-kind {\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    opacity: 0.85;\n}\n\n.sca-message-attachment-name {\n    font-weight: 600;\n}\n\n.sca-message-attachment-note {\n    opacity: 0.8;\n}\n\n/* ---------------------------------------------------------\n   24I. HIDDEN ATTACHMENT STATE FIELDS\n   --------------------------------------------------------- */\n\n.formio-component-attachmentsText,\n.formio-component-attachmentsJson {\n    display: none !important;\n}\n\n/* ---------------------------------------------------------\n   24J. TABLET AND MOBILE\n   --------------------------------------------------------- */\n\n@media (max-width: 900px) {\n    :root,\n    body {\n        --sca-attachment-bar-height: 38px;\n    }\n\n    .formio-component-attachmentPicker {\n        max-width: 140px !important;\n    }\n\n    .sca-chip {\n        max-width: 190px;\n    }\n}\n\n@media (max-width: 620px) {\n    :root,\n    body {\n        --sca-attachment-bar-height: 36px;\n    }\n\n    .formio-component-attachmentPicker {\n        max-width: 44px !important;\n    }\n\n    /*\n     * Too narrow for the label text; the paperclip glyph alone\n     * (24B) still reads as an attach control at this width.\n     */\n    .formio-component-attachmentPicker .fileSelector span,\n    .formio-component-attachmentPicker [ref=\"fileDrop\"] span,\n    .formio-component-attachmentPicker .fileSelector a,\n    .formio-component-attachmentPicker [ref=\"fileDrop\"] a {\n        display: none !important;\n    }\n\n    .sca-chip {\n        max-width: 140px;\n    }\n\n    .sca-chip-detail {\n        display: none;\n    }\n}\n\n\n/* =========================================================\n   25. APPLICATION CHROME — HARDENED MENU REMOVAL\n   =========================================================\n\n   Section 23B already listed the conventional toggle class names and the\n   hamburger was still on screen, because the aXet shell uses none of\n   them. This section widens the net to what the control actually looks\n   like in markup rather than what it might be called, and the\n   SCA-36 script in the controller removes whatever still survives.\n\n   Two mechanisms, on purpose:\n     - CSS applies before first paint, so the control never flashes;\n     - the script catches markup no selector could have predicted, and\n       handles a header the shell mounts after the application.\n\n   Everything here is scoped with body:has(.sca-header-host) so no other\n   aXet application is affected.\n   ========================================================= */\n\n/* ---------------------------------------------------------\n   25A. ANYTHING THE CONTROLLER HAS IDENTIFIED\n\n   The script tags what it finds; this rule makes the removal\n   survive a later re-style by the shell.\n   --------------------------------------------------------- */\n\nbody [data-sca-chrome-hidden=\"true\"] {\n    display: none !important;\n\n    width: 0 !important;\n    height: 0 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    opacity: 0 !important;\n    visibility: hidden !important;\n\n    pointer-events: none !important;\n}\n\n/* ---------------------------------------------------------\n   25B. MENU GLYPHS OUTSIDE THE APPLICATION\n\n   Icon fonts put the glyph in the class name. Hiding the\n   icon's clickable parent — rather than the icon alone —\n   avoids leaving an empty but still-clickable button.\n\n   :not() guards keep this away from the application's own\n   surface, including the composer's paperclip.\n   --------------------------------------------------------- */\n\nbody:has(.sca-header-host)\n    :is(button, a, [role=\"button\"]):not(.formio-form *):not(.sca-header *):not(#sca-attach-button):has(\n        > :is(i, span, svg, em):is(\n                [class*=\"fa-bars\"],\n                [class*=\"fa-navicon\"],\n                [class*=\"fa-reorder\"],\n                [class*=\"bi-list\"],\n                [class*=\"icon-menu\"],\n                [class*=\"menu-icon\"],\n                [class*=\"glyphicon-menu-hamburger\"],\n                [class*=\"mdi-menu\"],\n                [class*=\"pi-bars\"]\n            )\n    ) {\n    display: none !important;\n\n    pointer-events: none !important;\n}\n\n/*\n * The same glyphs when the shell renders them without a\n * wrapping button.\n */\n\nbody:has(.sca-header-host)\n    :is(i, span, em):not(.formio-form *):not(.sca-header *):is(\n        [class*=\"fa-bars\"],\n        [class*=\"fa-navicon\"],\n        [class*=\"fa-reorder\"],\n        [class*=\"bi-list\"],\n        [class*=\"glyphicon-menu-hamburger\"],\n        [class*=\"mdi-menu\"]\n    ) {\n    display: none !important;\n\n    pointer-events: none !important;\n}\n\n/* ---------------------------------------------------------\n   25C. TOGGLES IDENTIFIED BY ACCESSIBLE NAME\n\n   A shell that names its control properly for screen readers\n   is identifiable without knowing its class names at all.\n   --------------------------------------------------------- */\n\nbody:has(.sca-header-host)\n    :is(button, a, [role=\"button\"]):not(.formio-form *):not(.sca-header *):not(#sca-attach-button):is(\n        [aria-label*=\"menu\" i],\n        [aria-label*=\"navigation\" i],\n        [aria-label*=\"sidebar\" i],\n        [aria-label*=\"sidenav\" i],\n        [aria-label*=\"drawer\" i],\n        [title*=\"toggle menu\" i],\n        [title*=\"toggle navigation\" i],\n        [title*=\"toggle sidebar\" i],\n        [aria-controls*=\"sidebar\" i],\n        [aria-controls*=\"sidenav\" i],\n        [aria-controls*=\"drawer\" i],\n        [aria-controls*=\"offcanvas\" i],\n        [data-toggle=\"offcanvas\"],\n        [data-bs-toggle=\"offcanvas\"],\n        [data-widget=\"pushmenu\"]\n    ) {\n    display: none !important;\n\n    pointer-events: none !important;\n}\n\n/* ---------------------------------------------------------\n   25D. CLASS-NAMED TOGGLES\n\n   Kept as a superset of the original 23B list, including the\n   naming conventions Angular Material and PrimeNG shells use.\n   --------------------------------------------------------- */\n\nbody:has(.sca-header-host)\n    :not(.formio-form *):not(.sca-header *):is(\n        .navbar-toggler,\n        .navbar-toggle,\n        .sidebar-toggle,\n        .sidebar-toggler,\n        .sidenav-toggle,\n        .menu-toggle,\n        .menu-toggler,\n        .nav-toggle,\n        .drawer-toggle,\n        .hamburger,\n        .hamburger-button,\n        .hamburger-menu,\n        .hamburger-icon,\n        [class*=\"hamburger\" i],\n        [class*=\"burger-menu\" i],\n        [class*=\"menu-button\" i],\n        [class*=\"toggle-sidebar\" i],\n        [class*=\"sidebar-trigger\" i]\n    ) {\n    display: none !important;\n\n    width: 0 !important;\n    height: 0 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    border: 0 !important;\n\n    opacity: 0 !important;\n    visibility: hidden !important;\n\n    pointer-events: none !important;\n}\n\n/* ---------------------------------------------------------\n   25E. RECLAIM THE SPACE THE TOGGLE OCCUPIED\n\n   Without this the shell's brand keeps the gap the removed\n   control used to fill, and the header reads as misaligned.\n   --------------------------------------------------------- */\n\nbody:has(.sca-header-host)\n    :is(.navbar-brand, .app-brand, .header-brand, .brand, .logo) {\n    margin-left: 0 !important;\n    padding-left: 0 !important;\n}\n\n\n/* =========================================================\n   26. CONVERSATION HISTORY SIDEBAR\n   =========================================================\n\n   Layout strategy\n   ----------------\n   .formio-form is already a `display:flex; flex-direction:column`\n   column stack (section 2), and the composer already breaks out of\n   that flow with `position:absolute` (section 15) anchored to\n   .formio-form's bounds. The sidebar reuses that SAME mechanism rather\n   than introducing a different layout system (grid) alongside it:\n\n     - the sidebar panel is `position:absolute; left:0; top:0; bottom:0`,\n       taken out of the column flow entirely;\n     - the two remaining visible blocks (the app header, the chat\n       surface) get `margin-left: var(--sca-sidebar-width)` to clear it;\n     - the composer's own `left` (currently `0 !important` in section 15)\n       is overridden to the same width, so it doesn't extend under the\n       panel.\n\n   On screens under 900px the panel becomes an overlay instead of a\n   permanent column — position stays absolute, but it now spans the\n   full width and slides in only when data-sca-sidebar-open=\"true\" is\n   set on <body>, exactly mirroring how data-sca-attachments already\n   toggles composer height. The margin-left/composer-left overrides are\n   scoped to the desktop breakpoint only, so mobile content never\n   permanently loses width to a panel that isn't visible by default.\n   ========================================================= */\n\n:root,\nbody {\n    --sca-sidebar-width: 240px;\n}\n\n/* ---------------------------------------------------------\n   26A. DESKTOP — PERMANENT LEFT COLUMN\n   --------------------------------------------------------- */\n\n@media (min-width: 901px) {\n    .sca-sidebar-panel {\n        position: absolute !important;\n\n        top: 0 !important;\n        left: 0 !important;\n        bottom: 0 !important;\n\n        z-index: 130 !important;\n\n        width: var(--sca-sidebar-width) !important;\n\n        display: flex !important;\n        flex-direction: column !important;\n\n        overflow: hidden !important;\n\n        background: #f8fafc !important;\n        border-right: 1px solid var(--sca-border) !important;\n    }\n\n    /*\n     * Both margin-left AND an explicit reduced width: the elements this\n     * targets carry their own width:100% (computed against\n     * .formio-form, not against \"the space left after the sidebar\"),\n     * so margin-left alone would push them 240px past the right edge\n     * rather than narrowing them.\n     */\n    .sca-header-host,\n    .sca-chat-surface-host {\n        margin-left: var(--sca-sidebar-width) !important;\n        width: calc(100% - var(--sca-sidebar-width)) !important;\n    }\n\n    body:has(.sca-header-host) .formio-component-composer,\n    body:has(.sca-header-host) .sca-composer {\n        left: var(--sca-sidebar-width) !important;\n        width: calc(100% - var(--sca-sidebar-width)) !important;\n    }\n\n    /* The desktop panel is always visible; the toggle button is not needed. */\n    #sca-sidebar-toggle {\n        display: none !important;\n    }\n}\n\n/* ---------------------------------------------------------\n   26B. TABLET / MOBILE — OVERLAY\n   --------------------------------------------------------- */\n\n@media (max-width: 900px) {\n    .sca-sidebar-panel {\n        position: absolute !important;\n\n        top: 0 !important;\n        left: 0 !important;\n        bottom: 0 !important;\n\n        z-index: 200 !important;\n\n        width: min(82vw, 300px) !important;\n\n        display: flex !important;\n        flex-direction: column !important;\n\n        overflow: hidden !important;\n\n        background: #f8fafc !important;\n        border-right: 1px solid var(--sca-border) !important;\n\n        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.18) !important;\n\n        transform: translateX(-100%);\n\n        transition: transform 160ms ease;\n    }\n\n    body[data-sca-sidebar-open=\"true\"] .sca-sidebar-panel {\n        transform: translateX(0);\n    }\n\n    /*\n     * A translucent scrim behind the panel, closing it on tap outside —\n     * implemented as a ::before on the form so no extra DOM is needed.\n     */\n    body[data-sca-sidebar-open=\"true\"] .formio-form::before {\n        content: \"\";\n\n        position: absolute;\n        inset: 0;\n\n        z-index: 190;\n\n        background: rgba(15, 23, 42, 0.32);\n    }\n}\n\n/* ---------------------------------------------------------\n   26C. SIDEBAR TOGGLE (mobile/tablet only, 26A hides it on desktop)\n   --------------------------------------------------------- */\n\n#sca-sidebar-toggle {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 34px;\n    height: 34px;\n\n    border: 0;\n    border-radius: 8px;\n\n    background: transparent;\n    color: var(--sca-text);\n\n    font-size: 16px;\n\n    cursor: pointer;\n\n    /*\n     * Above the mobile sidebar (z-index 200) and its scrim (190), not\n     * below them: the same control opens AND closes the panel, so it\n     * has to stay reachable once the panel it toggles is covering the\n     * header it lives in. Harmless on desktop, where 26A hides this\n     * button outright.\n     */\n    position: relative;\n    z-index: 210;\n}\n\n#sca-sidebar-toggle:hover {\n    background: var(--sca-blue-soft);\n    color: var(--sca-blue);\n}\n\n/* ---------------------------------------------------------\n   26D. SIDEBAR HEADER\n   --------------------------------------------------------- */\n\n.sca-sidebar-header-host {\n    flex: 0 0 auto;\n}\n\n.sca-sidebar-title-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n\n    padding: 16px 14px 8px;\n}\n\n.sca-sidebar-title {\n    color: var(--sca-text);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n}\n\n#sca-history-refresh {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 24px;\n    height: 24px;\n\n    border: 0;\n    border-radius: 6px;\n\n    background: transparent;\n    color: var(--sca-muted);\n\n    font-size: 13px;\n    cursor: pointer;\n}\n\n#sca-history-refresh:hover {\n    background: var(--sca-blue-soft);\n    color: var(--sca-blue);\n}\n\n#sca-new-conversation {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n\n    margin: 4px 10px 12px;\n    padding: 9px 12px;\n\n    border: 1px solid var(--sca-blue);\n    border-radius: 10px;\n\n    background: #ffffff;\n    color: var(--sca-blue);\n\n    font-size: 13px;\n    font-weight: 600;\n\n    cursor: pointer;\n\n    transition: background-color 120ms ease;\n}\n\n#sca-new-conversation:hover {\n    background: var(--sca-blue-soft);\n}\n\n#sca-new-conversation::before {\n    content: \"+\";\n\n    font-size: 16px;\n    line-height: 1;\n}\n\n/* ---------------------------------------------------------\n   26E. CONVERSATION LIST (the datagrid Form.io renders)\n   --------------------------------------------------------- */\n\n.formio-component-conversationsGrid {\n    flex: 1 1 auto !important;\n    min-height: 0 !important;\n\n    overflow-y: auto !important;\n\n    padding: 0 8px 12px !important;\n    margin: 0 !important;\n}\n\n/*\n * Flatten Form.io's row/column wrapper divs so each datagrid row reads\n * as one compact, clickable-looking card rather than a dense form.\n */\n.formio-component-conversationsGrid .datagrid-row,\n.formio-component-conversationsGrid table tbody tr {\n    display: flex !important;\n    align-items: center !important;\n\n    margin-bottom: 6px !important;\n    padding: 8px 10px !important;\n\n    border: 1px solid var(--sca-border) !important;\n    border-radius: 10px !important;\n\n    background: #ffffff !important;\n}\n\n.formio-component-conversationsGrid table tbody tr:hover {\n    border-color: var(--sca-blue) !important;\n}\n\n.formio-component-conversationsGrid table,\n.formio-component-conversationsGrid table thead {\n    width: 100% !important;\n}\n\n.formio-component-conversationsGrid table thead {\n    display: none !important;\n}\n\n.formio-component-conversationsGrid table tbody tr {\n    display: grid !important;\n    grid-template-columns: 1fr auto auto !important;\n    align-items: center !important;\n    gap: 4px 8px !important;\n}\n\n.formio-component-conversationsGrid .formio-component-title input,\n.formio-component-conversationsGrid .formio-component-title .form-control {\n    border: 0 !important;\n    background: transparent !important;\n    padding: 0 !important;\n\n    color: var(--sca-text) !important;\n    font-size: 12.5px !important;\n    font-weight: 600 !important;\n\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n\n    pointer-events: none;\n}\n\n.formio-component-conversationsGrid .formio-component-updatedAtLabel {\n    grid-column: 1;\n    grid-row: 2;\n}\n\n.formio-component-conversationsGrid .formio-component-updatedAtLabel input,\n.formio-component-conversationsGrid .formio-component-updatedAtLabel .form-control {\n    border: 0 !important;\n    background: transparent !important;\n    padding: 0 !important;\n\n    color: var(--sca-muted) !important;\n    font-size: 11px !important;\n\n    pointer-events: none;\n}\n\n.formio-component-conversationsGrid label {\n    display: none !important;\n}\n\n.formio-component-conversationsGrid .formio-component-open button,\n.formio-component-conversationsGrid .formio-component-delete button {\n    width: 26px !important;\n    height: 26px !important;\n    min-width: 26px !important;\n\n    padding: 0 !important;\n\n    border-radius: 6px !important;\n\n    font-size: 12px !important;\n}\n\n.formio-component-conversationsGrid .formio-component-open button {\n    background: var(--sca-blue-soft) !important;\n    color: var(--sca-blue) !important;\n    border: 0 !important;\n}\n\n.formio-component-conversationsGrid .formio-component-delete button {\n    background: transparent !important;\n    color: var(--sca-muted) !important;\n    border: 0 !important;\n}\n\n.formio-component-conversationsGrid .formio-component-delete button:hover {\n    background: var(--sca-danger-bg) !important;\n    color: var(--sca-danger) !important;\n}\n\n/*\n * Form.io's own \"Add Another\" affordance is suppressed by\n * disableAddingRemovingRows on the component, but hide it defensively\n * too in case a platform version renders it regardless.\n */\n.formio-component-conversationsGrid .formio-button-add-row,\n.formio-component-conversationsGrid [ref=\"addRow\"] {\n    display: none !important;\n}\n\n/* Empty state: Form.io renders nothing for a zero-row datagrid, which\n   reads as \"broken\" rather than \"no history yet\" — this fills that gap. */\n.formio-component-conversationsGrid table tbody:empty::after {\n    content: \"No past conversations yet.\";\n\n    display: block;\n\n    padding: 20px 6px;\n\n    color: var(--sca-muted);\n    font-size: 12px;\n    text-align: center;\n}\n\n/* ---------------------------------------------------------\n   26F. HIDDEN LOAD-CONVERSATIONS TRIGGER\n\n   A real, clickable Form.io button — never removed from the DOM,\n   only made visually absent, so ScaHistory can still .click() it.\n   Matches the technique section 20 already uses for messagesJson etc.\n   --------------------------------------------------------- */\n\n.formio-component-loadConversations {\n    position: absolute !important;\n\n    width: 1px !important;\n    height: 1px !important;\n\n    padding: 0 !important;\n    margin: -1px !important;\n\n    overflow: hidden !important;\n    clip: rect(0, 0, 0, 0) !important;\n\n    white-space: nowrap !important;\n    border: 0 !important;\n}\n","customCSSErrors":0,"authConfig":"Okta","sessionExpireTimeInMinutes":"20","basicInternalDb":"","oktaDb":"31c112ec636990e1","roles":[],"__wellKnownRes":{},"x":180,"y":260,"wires":[]},{"id":"21d415924e0e4841","type":"axetflows-form","z":"cab2b2152508727e","name":"SAP Code Agent Chat","onDocumentReadyButtonAction":"","formStructure":{"display":"form","settings":{},"components":[{"label":"Conversation History","labelPosition":"top","tooltip":"","customClass":"sca-sidebar-panel","hidden":false,"hideLabel":true,"disabled":false,"tableView":false,"modalEdit":false,"persistent":true,"protected":false,"dbIndex":false,"redrawOn":"","clearOnHide":true,"customDefaultValue":"","calculateValue":"","validate":{"required":false,"pattern":"","customMessage":"","custom":"","customPrivate":false,"json":"","minLength":"","maxLength":"","strictDateValidation":false,"multiple":false,"unique":false},"unique":false,"validateOn":"change","errorLabel":"","key":"sidebarPanel","type":"container","input":true,"components":[{"label":"Sidebar Header","tag":"div","className":"sca-sidebar-header-host","attrs":[{"attr":"","value":""}],"content":"<div class=\"sca-sidebar-title-row\">\n  <span class=\"sca-sidebar-title\">Conversations</span>\n  <button id=\"sca-history-refresh\" type=\"button\" title=\"Refresh conversation list\" aria-label=\"Refresh conversation list\">&#8635;</button>\n</div>\n<button id=\"sca-new-conversation\" type=\"button\">New Conversation</button>","refreshOnChange":false,"customClass":"","hidden":false,"tableView":false,"modalEdit":false,"key":"sidebarHeaderHtml","type":"htmlelement","input":false,"validate":{"required":false,"pattern":"","customMessage":"","custom":"","customPrivate":false,"json":"","minLength":"","maxLength":"","strictDateValidation":false,"multiple":false,"unique":false},"placeholder":"","prefix":"","suffix":"","multiple":false,"defaultValue":null,"protected":false,"unique":false,"persistent":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","labelPosition":"top","description":"","errorLabel":"","hideLabel":false,"tabindex":"","disabled":false,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","widget":null,"validateOn":"change","tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"2e49ba3bb133f598"},{"label":"Conversations","disableAddingRemovingRows":true,"reorder":false,"addAnotherPosition":"bottom","defaultOpen":false,"layoutFixed":false,"enableRowGroups":false,"tableView":false,"validate":{"required":false,"pattern":"","customMessage":"","custom":"","customPrivate":false,"json":"","minLength":"","maxLength":"","strictDateValidation":false,"multiple":false,"unique":false},"key":"conversationsGrid","type":"datagrid","input":true,"components":[{"label":"Title","spellcheck":true,"tableView":true,"key":"title","type":"textfield","input":true,"defaultValue":null,"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"protected":false,"unique":false,"persistent":true,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":true,"tabindex":"","disabled":true,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","validateOn":"change","mask":false,"inputType":"text","inputFormat":"plain","inputMask":"","validate":{"required":false,"pattern":"","customMessage":"","custom":"","customPrivate":false,"json":"","minLength":"","maxLength":"","strictDateValidation":false,"multiple":false,"unique":false},"tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"be1d5fce9608ff27"},{"label":"Updated","spellcheck":true,"tableView":true,"key":"updatedAtLabel","type":"textfield","input":true,"defaultValue":null,"placeholder":"","prefix":"","customClass":"","suffix":"","multiple":false,"protected":false,"unique":false,"persistent":true,"hidden":false,"clearOnHide":true,"refreshOn":"","redrawOn":"","modalEdit":false,"labelPosition":"top","description":"","errorLabel":"","tooltip":"","hideLabel":true,"tabindex":"","disabled":true,"autofocus":false,"dbIndex":false,"customDefaultValue":"","calculateValue":"","validateOn":"change","mask":false,"inputType":"text","inputFormat":"plain","inputMask":"","validate":{"required":false,"pattern":"","customMessage":"","custom":"","customPrivate":false,"json":"","minLength":"","maxLength":"","strictDateValidation":false,"multiple":false,"unique":false},"tags":[],"properties":{},"conditional":{"show":null,"when":null,"eq":"","json":""},"customConditional":"","logic":[],"attributes":{},"overlay":{"style":"","page":"","left":"","top":"","width":"","height":""},"allowCalculateOverride":false,"encrypted":false,"showCharCount":false,"showWordCount":false,"allowMultipleMasks":false,"id":"3572b2f697af6157"},{"label":" ","col